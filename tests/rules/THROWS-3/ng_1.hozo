// THROWS-3（docs/check.md「throws」「never を返す op」）: never を返す op は、値を運ばない例外をちょうど一つ投げる葉で、
// 引数も effects も reads も、catches を持つデコレータも持たない。満たさない条件ごとに一つ
namespace a {
  model Detail { reason: string; }
  exception E;
  exception F;
  exception WithValue: Detail;
  union Both { E; F; }
  state s: list<string>;
  effect add on s.post;
  decorator swallow catches E recovers;
  decorator mark;
  // 1. 葉でない（位置は op の名前）
  op body(): never throws E {          // ERROR: THROWS-3
    return leaf();
  }
  op leaf(): never throws E;
  // 2. 例外がちょうど一つでない（位置は throws。なければ op の名前）
  op none1(): never;                   // ERROR: THROWS-3
  op two(): never throws E, F;        // ERROR: THROWS-3
  op viaUnion(): never throws Both;       // ERROR: THROWS-3
  op twoClauses(): never
    throws E                           // ERROR: THROWS-3
    throws F;
  // 3. 例外が値を運ぶ
  op carries(): never throws WithValue;    // ERROR: THROWS-3
  // 4. 引数を持つ（位置は最初の引数）
  op params(x: string, y: int): never throws E;    // ERROR: THROWS-3
  // 5. effects か reads を持つ（位置はその節）
  op effects1(): never effects add throws E;       // ERROR: THROWS-3
  op reads1(): never
    reads s                            // ERROR: THROWS-3
    throws E;
  // 6. catches を持つデコレータが付いている（位置はそのデコレータ）
  @mark
  @swallow                             // ERROR: THROWS-3
  op caught(): never throws E;
}
