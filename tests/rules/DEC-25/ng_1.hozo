// DEC-25（docs/check.md「デコレータ」）: next() の後ろに文を持つデコレータを、never を返す op に付けた。
// op は、いつも、例外を投げるので、後ろの文が、評価されない
namespace a {
  exception Denied;
  exception Shut;
  model Ticket { ok: boolean; }
  classify Gate of Ticket { Open; Closed; }
  fn ticket(): Ticket;
  fn record();
  decorator fn after(next: fn) {
    next();
    record();
  }
  decorator fn guardedAfter(next: fn) {
    val now = ticket();
    match (now by Gate) {
      Open   => next();
      Closed => throw Shut;
    }
    record();
  }
  @after                                   // ERROR: DEC-25
  fn denied(): never throws Denied;
  @guardedAfter                            // ERROR: DEC-25
  fn refused(): never throws Denied;
}
