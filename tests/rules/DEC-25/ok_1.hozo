// DEC-25: 前で確かめるだけのデコレータ（next() が、最後）は、never を返す op にも付けられる。後ろに文を持つデコレータも、
// never を返さない op には、付けられる
namespace a {
  exception Denied;
  exception Shut;
  model Ticket { ok: boolean; }
  classify Gate of Ticket { Open; Closed; }
  fn ticket(): Ticket;
  fn record();
  decorator fn before(next: fn) {
    record();
    next();
  }
  decorator fn guarded(next: fn) {
    val now = ticket();
    match (now by Gate) {
      Open   => next();
      Closed => throw Shut;
    }
  }
  decorator fn after(next: fn) {
    next();
    record();
  }
  @before @guarded
  fn denied(): never throws Denied;
  @after
  fn work();
}
