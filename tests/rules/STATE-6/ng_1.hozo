// STATE-6（docs/check.md「状態と効果」「直に呼ぶ組み込みの効果」）: list の状態の put と delete は、直には呼べない
// （どの列かを、引数から決める規則がない）。位置は操作の語
namespace a {
  model M { id: string; }
  state rows: list<M>;
  state cur: nullable<M>;
  state title: single<string>;
  op f(m: M) {
    rows.put(m);                         // ERROR: STATE-6
    rows.delete(m);                      // ERROR: STATE-6
    a.rows.delete();                     // ERROR: STATE-6
    rows.post(m);
    cur.post(m);
    cur.put(m);
    cur.delete();
    title.put("t");
  }
}
