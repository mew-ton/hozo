// TYPE-12（docs/types.md「診断」）: op の分類と、別の名前空間の分類のケースで絞り込んだ型（分類はどの名前空間からも使える）
namespace a {
  model M { id: string; }
  fn find(): M?;
  classify Found of find { Hit; Other; }
  classify Kind of M { A; B; }
  fn ok1(m: Found.Hit<M?>): void;
  fn ok2(m: Found.Hit<M>): void;
}
namespace b {
  fn ok3(m: a.Kind.A<a.M>): void;
  fn ok4(m: a.Found.Hit<a.M>): void;
}
