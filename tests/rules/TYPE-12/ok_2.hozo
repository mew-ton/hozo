// TYPE-12（docs/types.md「診断」）: op の分類と、別の名前空間の分類のケースで絞り込んだ型（分類はどの名前空間からも使える）
namespace a {
  model M { id: string; }
  fn find(): M?;
  classify Found of find { Hit; Other; }
  classify Kind of M { A; B; }
  fn ok1(m: M? on Found.Hit): void;
  fn ok2(m: M on Found.Hit): void;
}
namespace b {
  fn ok3(m: a.M on a.Kind.A): void;
  fn ok4(m: a.M on a.Found.Hit): void;
}
