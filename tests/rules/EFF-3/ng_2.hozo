// EFF-3（docs/check.md「状態と効果」）: 効果のユニオンは展開してから数える（二つの効果の union を葉に書けば EFF-3）
namespace a {
  state s: list<string>;
  state t: nullable<string>;
  effect e on s.post;
  effect f on t.post;
  union Both { e; f; }
  union One { e; }
  op viaUnion() effects Both;          // ERROR: EFF-3
  op viaMixed() effects One, f;       // ERROR: EFF-3
}
