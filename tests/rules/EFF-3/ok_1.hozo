// EFF-3（docs/check.md「状態と効果」）: 葉の op が直に持つ効果は一つまで（効果なしも、一つの効果の union も、同じ効果の重複もよい）
namespace a {
  state s: list<string>;
  effect e on s.post;
  union One { e; }
  exception E;
  op one() effects e;
  op withThrows() effects e throws E prevents effects;
  op viaUnion() effects One;
  op twice() effects e, One;
  op zero();
}
