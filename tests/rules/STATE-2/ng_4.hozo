// STATE-2（docs/check.md「状態と効果」「デコレータが運ぶ reads と effects」）: 配線の op に運ばれた効果の名前空間（直に書いた
// 効果なら、その状態の名前空間）も、op の名前空間と違えば error。配線が別の名前空間の op を呼んで行き着く効果（EFF-1）とは
// 違い、デコレータの処理は、状態に直に触れる。位置はそのデコレータの適用
namespace a {
  state s: list<string>;
  effect fn e(x: string): effects s.post;
  decorator fn doing(...targets: any effect): effects targets;
  decorator fn posting(): effects s.post;
  export fn own(x: string) { e(x); }
  // 自分の名前空間の配線に付ければ通る
  @doing(e) @posting
  fn wired(x: string) { own(x); }
}
namespace b {
  state u: list<string>;
  effect fn g(x: string): effects u.post;
  @a.doing(g)
  fn ok(x: string) { a.own(x); }
  @a.doing(a.e)                                  // ERROR: STATE-2
  fn carried(x: string) { a.own(x); }
  @a.posting                                     // ERROR: STATE-2
  fn carriedDirect(x: string) { g(x); }
}
