// STATE-2（docs/check.md「状態と効果」「デコレータが運ぶ reads と effects」）: 葉の op に運ばれた効果の名前空間（直に書いた効果なら、
// その状態の名前空間）が、op の名前空間と違う。位置はそのデコレータの適用
namespace a {
  state s: list<string>;
  state t: nullable<string>;
  effect e(x: string) on s.post;
  effect f(x: string) on t.post;
  union Both { e; f; }
  decorator doing(...targets: any effect) for op effects targets;
  decorator doingE for op effects e;
  decorator posting for op effects s.post;
  @doing(e, f) op ownCarried(x: string, y: string);
  @doingE @posting export op own();
}
namespace b {
  state u: list<string>;
  effect g(x: string) on u.post;
  @a.doing(g)
  op carriedOwn(x: string);
  @a.doing(a.e)                                  // ERROR: STATE-2
  op carried(x: string);
  @a.doing(g, a.Both)                            // ERROR: STATE-2
  op carriedUnion(x: string, y: string, z: string);
  @a.doingE                                      // ERROR: STATE-2
  op carriedFixed();
  @a.posting                                     // ERROR: STATE-2
  op carriedDirect();
  // 配線の op の節には、別の名前空間の効果を書ける（呼び出し先から伝わった効果。EFF-2 が照合する）
  op wire() effects a.e, a.s.post {
    a.own();
  }
}
