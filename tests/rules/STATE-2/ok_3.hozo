// STATE-2（docs/check.md「状態と効果」）: デコレータが運ぶ効果が、付けた op と同じ名前空間のもの。別の名前空間の配線には
// 伝播する（EFF-1）
namespace a {
  state s: list<string>;
  effect e(x: string) on s.post;
  effect f(id: string) on s.delete;
  decorator doing(...targets: any effect) for op effects targets;
  @doing(f, e)
  export op replace(id: string, x: string);
}
namespace b {
  op wiring(id: string, x: string) effects a.f, a.e {
    a.replace(id, x);
  }
}
