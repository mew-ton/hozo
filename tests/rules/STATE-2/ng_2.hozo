// STATE-2（docs/check.md「状態と効果」）: デコレータの halts の効果（宣言に書いたもの）が、付けた op の名前空間と違う
namespace a {
  state s: single<string>;
  effect e() on s.put;
  op f();
}
namespace b {
  exception X;
  decorator haltOnX catches X halts a.e;
  op leaf() throws X;
  @haltOnX                             // ERROR: STATE-2
  op g() {
    leaf();
  }
}
