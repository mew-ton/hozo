// STATE-2（docs/check.md「状態と効果」）: デコレータの halts の効果（宣言に書いたもの）が、付けた op の名前空間と違う
namespace a {
  state s: single<string>;
  effect fn e(): effects s.put;
  fn f();
}
namespace b {
  exception X;
  decorator fn haltOnX(): catches X halts a.e;
  fn leaf(): throws X;
  @haltOnX                             // ERROR: STATE-2
  fn g() {
    leaf();
  }
}
