  model User { id: string; }
  op ok(u: User): User;
}
namespace b {
  op j(u: User): a.User;               // ERROR: RES-1
  op m(): a.Nothing;                   // ERROR: RES-1
  op n(): c.User;                      // ERROR: RES-1
}
