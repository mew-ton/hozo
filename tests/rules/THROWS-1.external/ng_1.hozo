// THROWS-1（docs/check.md「throws」）: 「external なデコレータの throws は Sig と同じく数えない」。
// 境界の内側（ns(O)）から見れば E は肩代わりされていないので、throws の節を書いた配線の op は、E を、その節に書くか、
// 別のデコレータで吸収しなければならない
namespace a {
  exception E;
  exception F;
  @external
  decorator boundary throws E;
  fn leaf(): throws E;
  fn other(): throws F;
  @boundary                            // ERROR: THROWS-1
  fn wiring(): throws F {
    other();
    leaf();
  }
}
