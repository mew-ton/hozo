// THROWS-1（docs/check.md「throws」）: 「external なデコレータの throws は Sig と同じく数えない」。
// 境界の内側（ns(O)）から見れば E は肩代わりされていないので、throws に書くか別のデコレータで吸収しなければならない
namespace a {
  exception E;
  @external
  decorator boundary throws E;
  op leaf() throws E;
  @boundary                            // ERROR: THROWS-1
  op wiring() {
    leaf();
  }
}
