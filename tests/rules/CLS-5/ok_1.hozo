// CLS-5（docs/check.md「ケースの型」）: as の前は、宣言の of の後ろと同じに書いた対象。状態の分類は、対象の状態ごとの as を並べられる。
// as を書かないケースと混ぜてよい
namespace a {
  model M { id: string; }
  scalar Email extends string;
  state token: nullable<string>;
  state profile: nullable<M>;
  op find(): M?;
  classify V1 of M? { Has: M? as M; default; }
  classify V2 of nullable<M> { Has: M? as M; default; }
  classify V3 of string { Valid: string as Email; Other; }
  classify O1 of find { Hit: find as M; default; }
  classify O2 of b.find { Hit: b.find as M; default; }
  classify S1 of token, profile {
    Ready: token as string, profile as M;
    Half: token as string;
    default;
  }
  classify S2 of token { In: a.token as string; default; }
  op f(): M;
}
namespace b {
  op find(): a.M?;
}
