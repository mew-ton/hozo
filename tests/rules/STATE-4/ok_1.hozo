// STATE-4（docs/check.md「状態と効果」）: 遷移の前と後のケースは宛先の分類のケース。宛先が基底の状態なら Empty / HasItems
namespace a {
  state carts: list<string>;
  state orders: list<string>;
  state token: nullable<string>;
  classify Checkout of carts, orders { Shopping; Ordered; Shipped; }
  classify CartFilled of carts { CartFilled; NotCartFilled; }

  effect fn placeOrder(): effects Checkout as Shopping -> Ordered;
  effect fn ship(): effects Checkout as Ordered -> Shipped;
  // any と、ケースの和。前と後が同じケースでもよい
  effect fn reset(): effects Checkout as any -> Shopping;
  effect fn touch(): effects Checkout as Shopping, Ordered -> any;
  effect fn keep(): effects Checkout as Shopping -> Shopping;
  effect fn move(): effects Checkout as Shopping, Ordered -> Ordered, Shipped;
  // condition のケースは condition の名前
  effect fn fill(): effects CartFilled as any -> CartFilled;
  // 基底の状態の組み込みの分類（list / nullable）
  effect fn clearCart(): effects carts as HasItems -> Empty;
  effect fn login(): effects token as Empty -> HasItems;
  effect fn anyCart(): effects carts as any -> Empty, HasItems;
}
