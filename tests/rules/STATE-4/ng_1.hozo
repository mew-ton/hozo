// STATE-4（docs/check.md「状態と効果」）: 遷移の前か後のケースが、宛先の分類のケースでない
namespace a {
  state carts: list<string>;
  state orders: list<string>;
  classify Checkout of carts, orders { Shopping; Ordered; }
  effect fn before(): effects Checkout as Browsing -> Ordered;   // ERROR: STATE-4
  effect fn after(): effects Checkout as Shopping -> Paid;       // ERROR: STATE-4
  // 分類の遷移に、組み込みの分類のケースは書けない
  effect fn builtin(): effects Checkout as Empty -> Ordered;     // ERROR: STATE-4
  // 和の中の一つでも同じ
  effect fn oneOf(): effects Checkout as Shopping, Paid -> any;  // ERROR: STATE-4
}
