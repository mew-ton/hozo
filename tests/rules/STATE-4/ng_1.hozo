// STATE-4（docs/check.md「状態と効果」）: 遷移の前か後のケースが、宛先の分類のケースでない
namespace a {
  state carts: list<string>;
  state orders: list<string>;
  classify Checkout of carts, orders { Shopping; Ordered; }
  effect before on Checkout: Browsing -> Ordered;   // ERROR: STATE-4
  effect after on Checkout: Shopping -> Paid;       // ERROR: STATE-4
  // 分類の遷移に、組み込みの分類のケースは書けない
  effect builtin on Checkout: Empty -> Ordered;     // ERROR: STATE-4
  // 和の中の一つでも同じ
  effect oneOf on Checkout: Shopping | Paid -> any; // ERROR: STATE-4
}
