// STATE-8（docs/check.md「行の遷移」の「操作ごとに書ける形」「行がないこと」）: delete の、書けない形。
// ない側のケースを持たない分類では、delete の効果に as を書けない。後は、ない側のケースだけ
namespace a {
  model Order { id: string; }
  state orders: list<Order>;
  classify Stage of Order { Draft; Accepted; Shipped; }
  classify Life of Order? { Open: Order? as Order; Closed: Order? as Order; Absent: Order? as none; }
  classify Present of Order? { Here: Order? as Order; }
  effect fn d1(order: Order on Stage.Draft): effects orders.delete as Stage.Shipped;   // ERROR: STATE-8
  effect fn d2(order: Order): effects orders.delete as Stage.Shipped;              // ERROR: STATE-8
  effect fn d3(order: Order): effects orders.delete as Present.Here;               // ERROR: STATE-8
  effect fn d4(order: Order): effects orders.delete as Life.Open;                  // ERROR: STATE-8
  effect fn d5(order: Order on Life.Open): effects orders.delete as Life.Closed;   // ERROR: STATE-8
  effect fn d6(order: Order on Life.Open): effects orders.delete as else;          // ERROR: STATE-8
  effect fn d7(order: Order): effects orders.delete as else;                       // ERROR: STATE-8
  effect fn d8(order: Order on Life.Absent): effects orders.delete as Life.Absent; // ERROR: STATE-8
  effect fn d9(order: Order on Life.Absent): effects orders.delete;                // ERROR: STATE-8
}
