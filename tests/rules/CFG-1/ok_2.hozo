// CFG-1（docs/config.md「出力する名前空間」「診断」）: hozo.toml にテーブルのない名前空間は、state や op を持っていても
// 出力しないだけで、エラーにしない。既定の hozo.toml は [a] だけで、user とグローバルにはテーブルがない。
// 設定のない名前空間の op から、設定のある名前空間の op を呼べる（検査は同じに掛かる）
namespace a {
  exception Busy;
  op save(text: string) throws Busy;
}
/** 画面を操作する利用者 */
namespace user {
  state memo: nullable<string>;
  effect writeMemo on memo.post;
  op note(text: string) effects writeMemo;
  op submit(text: string) throws a.Busy {
    note(text);
    a.save(text);
  }
}
op standalone();
