// WIRE-10: try か catch の、片方だけが入れた val は、抜けた後、読めない
namespace a {
  exception Failed;
  model M { id: string; }
  fn load(): M
    throws Failed;
  fn use(m: M);
  fn note();
  fn f() {
    val x;
    try {
      x = load();
    } catch (e) {
      note();
    }
    use(x);                            // ERROR: WIRE-10
  }
}
