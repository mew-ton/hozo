// DEC-1（docs/check.md「デコレータ」、docs/grammar.md「ファイルと宣言」）: `for namespace` のデコレータは namespace に付けられる。
// 同じ名前空間のブロックが複数あれば、付けたデコレータは一つの名前空間にまとまる
namespace marks {
  /** 分かれた文脈（境界づけられたコンテキスト）の印 */
  decorator context(name: string) for namespace;
  decorator core for namespace | op;
}
/** 注文の文脈 */
@marks.context("注文")
namespace a {
  @marks.core
  op f();
}
@marks.core
namespace a {
  op g();
}
namespace a {
  decorator inner for namespace;
  // 適用の名前は、ブロックが書かれた場所（外側の名前空間 a）で解決する
  @inner
  namespace sub {
    op h();
  }
}
