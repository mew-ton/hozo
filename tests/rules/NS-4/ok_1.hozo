// NS-4（docs/check.md「名前空間」）: classify は宣言した名前空間の中で使う
namespace a {
  model M { x: int; }
  classify C of M { A; B; }
  op onA(m: C.A<M>): M;
  op wide(m: M): M;
  op h(m: M): M {
    return match m by C {
      A => onA(m);
      B => wide(m);
    };
  }
}
namespace b {
  op f(): a.M;
}
namespace c {
  op g(): a.M;
}
