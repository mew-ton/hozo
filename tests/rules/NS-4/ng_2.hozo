// NS-4（docs/check.md「名前空間」）: match の C はグローバルの classify でも使えない（文法上修飾できない）
namespace a {
  model M { x: int; }
  op f(): M;
}
classify G of a.M { A; }
namespace b {
  op g(): a.M;
}
namespace c {
  op id(m: a.M): a.M;
  op h(m: a.M): a.M {
    return match m by G {              // ERROR: NS-4
      A => id(m);
    };
  }
}
