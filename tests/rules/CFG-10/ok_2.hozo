// CFG-10 / CFG-13（docs/config.md「単位の対象」「診断」）: どの単位の対象でもない名前空間は、state や op を持っていても
// 出力しないだけで、エラーにしない。既定の hozo.toml の単位は a だけで、user とグローバルを対象にする単位はない。
// 単位の対象でない名前空間の op から、対象の名前空間の op を呼べる（検査は同じに掛かる）。
// a.sub は a の単位の対象（単位は namespace とその子孫を対象にする）
namespace a {
  exception Busy;
  export fn save(text: string): throws Busy;
}
namespace a.sub {
  fn g();
}
/** 画面を操作する利用者 */
namespace user {
  state memo: nullable<string>;
  effect fn writeMemo(): effects memo.post;
  fn note(text: string): effects writeMemo { writeMemo(); }
  fn submit(text: string): throws a.Busy {
    note(text);
    a.save(text);
  }
}
fn standalone();
