// CLS-9（docs/check.md「分類」の「対象のない分類」）: 対象のない分類のケースは、名前だけ。デコレータと、引数で、指せる
namespace actor {
  decorator human for classify of never case;
}
namespace usecase {
  decorator of(actor: any classify of never case) for op;
}
namespace a {
  classify Actor of never {
    /** 客 */
    @actor.human Customer;
    Staff;
  }
  @usecase.of(Actor.Customer)
  op order();
}
