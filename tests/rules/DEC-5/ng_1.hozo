// DEC-5（docs/check.md「デコレータ」）: 効果の前に投げる例外（e は prevented）を recovers で吸収すると、
// 成功のアームでも e は不明になる（warning）
namespace a {
  state s: list<string>;
  effect fn e(): effects s.post;
  exception E;
  decorator fn recoverE(): catches E recovers;
  fn write(): effects e { e(); }
  fn fail(): throws E;
  @recoverE                            // WARN: DEC-5
  fn wiring() {
    fail();
    write();
  }
}
