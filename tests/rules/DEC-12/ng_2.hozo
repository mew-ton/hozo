  decorator d(code: int);
  decorator a3 = d();                  // ERROR: DEC-12
  decorator a4 = d("x");               // ERROR: TYPE-4
  decorator a5 = d(1, 2);              // ERROR: DEC-12
  fn ok(): void;
}
