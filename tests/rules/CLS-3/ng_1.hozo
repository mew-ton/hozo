// CLS-3（docs/check.md「classify / match」）: 対象が二つ以上なのに状態でないものがある（値の分類の対象は型一つ）
namespace a {
  model M { id: string; }
  model N { id: string; }
  state items: list<M>;
  classify Pair of M, N { A; }                   // ERROR: CLS-3, CLS-3
  classify Core of string, int { A; }            // ERROR: CLS-3, CLS-3
  classify Both of M, N { Both; NotBoth; }       // ERROR: CLS-3, CLS-3
}
