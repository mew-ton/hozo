// CLS-3（docs/check.md「classify / match」）: 対象にできるのは「宣言した名前空間」の基底の状態。
// 名前空間ごとに、自分の状態を対象にした分類を持てる（同じ名前の状態でも別の状態）
namespace a {
  state items: list<string>;
  classify Stock of items { None; Some; }
}
namespace other {
  state items: list<string>;
  state extra: nullable<string>;
  classify Stock of items, extra { None; Some; }
}
