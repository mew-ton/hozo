// CLS-3（docs/check.md「classify / match」）: op は一つだけ対象にできる。op と状態、op と型、op 二つは並べられない
namespace a {
  model M { id: string; }
  state items: list<M>;
  fn find(): M?;
  fn find2(): M?;
  classify A1 of find, find2 { X; Other; }       // ERROR: CLS-3, CLS-3
  classify A2 of find, items { X; Other; }       // ERROR: CLS-3
  classify A3 of items, find { X; Other; }       // ERROR: CLS-3
  classify A4 of find, M { X; Other; }           // ERROR: CLS-3, CLS-3
}
