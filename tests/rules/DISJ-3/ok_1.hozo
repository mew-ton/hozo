// DISJ-3（docs/check.md「disjoint」の「検査」）: 同じ状態への効果は、行で見る。違う値を渡していれば、通る。回ごとに、違う行
namespace a {
  model Order { id: string; }
  model Line { id: string; }
  state orders: list<Order>;
  state lines: list<Line>;
  state counter: single<int>;
  exception Declined;
  read fn all(): Order[] reads orders;
  effect fn touch(order: Order): effects orders.put;
  effect fn removeById(id: string): effects orders.delete;
  effect fn addLine(line: Line): effects lines.post;
  effect fn bump(n: int): effects counter.put;
  fn charge(order: Order): throws Declined;
  fn count(x: Order[], y: Order[]): int;
  fn f(a: Order, b: Order, items: Order[]) {
    disjoint {
      touch(a);
      touch(b);
    }
    disjoint for (val o of items) {
      touch(o);
    }
  }
}
