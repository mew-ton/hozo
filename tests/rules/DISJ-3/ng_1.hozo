// DISJ-3: 同じ値。行を受け取らない呼び出し。並びでない状態。disjoint for で、回の変数から始まらない値
namespace a {
  model Order { id: string; }
  model Line { id: string; }
  state orders: list<Order>;
  state lines: list<Line>;
  state counter: single<int>;
  exception Declined;
  read fn all(): Order[] on orders;
  effect fn touch(order: Order) on orders.put;
  effect fn removeById(id: string) on orders.delete;
  effect fn addLine(line: Line) on lines.post;
  effect fn bump(n: int) on counter.put;
  fn charge(order: Order) throws Declined;
  fn count(x: Order[], y: Order[]): int;
  fn f(a: Order, items: Line[]) {
    disjoint {                         // ERROR: DISJ-3
      touch(a);
      touch(a);
    }
    disjoint {                         // ERROR: DISJ-3
      touch(a);
      removeById(a.id);
    }
    disjoint {                         // ERROR: DISJ-3
      bump(1);
      bump(2);
    }
    disjoint for (val l of items) {    // ERROR: DISJ-3
      touch(a);
    }
  }
}
