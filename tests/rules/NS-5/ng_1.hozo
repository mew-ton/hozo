// NS-5（docs/check.md「名前空間」「export」）: 別の名前空間の、export のない op（内部の op）を配線から呼んだ。
// 位置は呼び出しの op の名前。親と子の名前空間も、互いに別の名前空間
namespace a {
  op hidden(): string;
  op f(): string {
    return b.internal();               // ERROR: NS-5
  }
  op g() {
    val x = a.sub.inner();           // ERROR: NS-5
    b.take(x);                         // ERROR: NS-5
  }
  op h(x: string): string {
    return match (x by b.Kind) {
      A => b.internal();               // ERROR: NS-5
      B => b.open();
    };
  }
}
namespace a.sub {
  op inner(): string;
  op up(): string {
    return a.hidden();                 // ERROR: NS-5
  }
}
namespace b {
  classify Kind of string { A; B; }
  op internal(): string;
  op take(x: string);
  export op open(): string;
}
