// TYPE-5（docs/types.md「当てはまる」「インデックスの model」）: インデックスの model には、空のレコードリテラルが当てはまる（空の構造）。
// 省略可能な位置でも、同じ
namespace a {
  model Labels { [name: string]: string; }
  fn take(v: Labels);
  fn takeOptional(v: Labels?);
  fn f(given: Labels) {
    take(given);
    takeOptional(given);
    take({});
    takeOptional({});
  }
}
