// DEC-7（docs/types.md「デコレータの引数」）: any effect on s.put に別の操作の効果を渡した。internal/sema/testdata/rules/DEC-7.hozo から
namespace a {
  state s: single<string>;
  state t: list<string>;
  effect fn put(): effects s.put;
  effect fn post(): effects t.post;
  decorator fn onPut(e: any effect on s.put);
  @onPut(put)
  fn ok1(): void;
  @onPut(post)                         // ERROR: DEC-7
  fn ng1(): void;
}
