// DEC-7（docs/types.md「デコレータの引数」）: any effect on s.put を満たすのは、宛先が組み込みの効果
// { state: s, operation: put } の効果だけ。同じ状態に書き込む遷移の効果は満たさない
namespace a {
  state t: list<string>;
  classify Phase of t { Idle; Busy; }
  effect fn put(): effects t.put;
  effect fn drain(): effects t as HasItems -> Empty;
  effect fn start(): effects Phase as Idle -> Busy;
  decorator fn onPut(e: any effect on t.put);
  @onPut(put)
  fn ok1(): void;
  @onPut(drain)                        // ERROR: DEC-7
  fn ng1(): void;
  @onPut(start)                        // ERROR: DEC-7
  fn ng2(): void;
}
