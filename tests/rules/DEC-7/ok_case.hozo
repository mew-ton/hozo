// DEC-7（docs/types.md「デコレータの引数」）: 分類のケースを受け取る引数。どの分類でも（any case、any case of any）、
// 対象の型で絞る（any case of never、any case of M）、分類の名前で絞る（any case of Actor）。
// いちばん後ろの ? は、引数を省ける印（any case of M? は、対象が M で、省ける引数）
namespace a {
  model M { id: string; }
  classify Actor of never { Customer; }
  classify Role of never { Admin; }
  classify Size of M { Small; Large; }
  decorator fn anyCase(x: any case);
  decorator fn anyCase2(x: any case of any?);
  decorator fn subj(x: any case of never);
  decorator fn typed(x: any case of M);
  decorator fn named(x: any case of Actor);
  decorator fn sized(x: any case of Size);
  decorator fn opt(x: any case of M?);
  classify Known of M? { Yes: M? as M; No: M? as else; }
  decorator fn known(x: any case of Known);
  @anyCase(Size.Small) @subj(Role.Admin) @named(Actor.Customer) @typed(Size.Large) @anyCase2
  fn f();
  @anyCase(Actor.Customer) @anyCase2(Role.Admin) @sized(Size.Large)
  fn g();
  @opt @known(Known.Yes)
  fn h();
  @opt(Size.Small)
  fn i();
}
