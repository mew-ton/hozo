// DEC-7: 設計の図の語彙（docs/vocab.md「設計の図の語彙」）の引数に、対象のある分類のケースを渡した
namespace a {
  model Order { id: string; }
  classify Size of Order { Small; Large; }
  classify Actor of never { Customer; }
  @prd.usecase.of(Size.Small)              // ERROR: DEC-7
  fn f();
  @prd.usecase.of(Actor.Customer, Size.Large)   // ERROR: DEC-7
  fn g();
  @prd.ref(Size.Small)                 // ERROR: DEC-7
  fn h();
}
