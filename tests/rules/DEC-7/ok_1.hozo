// DEC-7（docs/types.md「デコレータの引数」）: 性質に合う効果、ユニオンのメンバーの例外
namespace a {
  state s: single<string>;
  effect fn put(): effects s.put;
  exception E;
  exception F;
  union Errors { E; F; }
  decorator fn onPut(e: any effect on s.put);
  decorator fn onError(error: Errors);
  @onPut(put)
  fn ok1(): void;
  @onError(E)
  fn ok2(): void;
  @onError(E | F)
  fn ok3(): void;
}
