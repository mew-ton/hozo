// RES-4（docs/resolve.md「位置ごとに受け付ける種類」の「配線の呼び出しの名前」「呼び出しの読み分け」）: 呼べるのは、op、read、
// effect と、状態から辿った post / put / delete。効果の union、操作を付けない状態、classify（遷移は直に呼べない）、
// 例外、型は呼べない。束縛や引数の名前が先に当たれば、値を指す（値は呼べない）
namespace a {
  model M { id: string; }
  exception E;
  state rows: list<M>;
  state cur: nullable<M>;
  effect add(m: M) on rows.post;
  effect set(m: M) on cur.post;
  union Writes { add; set; }
  classify Stock of rows { None; Some; }
  op f(m: M, rows: M[]) {
    Writes(m);                           // ERROR: RES-4
    cur(m);                              // ERROR: RES-4
    Stock(m);                            // ERROR: RES-4
    E(m);                                // ERROR: RES-4
    M(m);                                // ERROR: RES-4
    m(m);                                // ERROR: RES-4
    rows.post(m);                        // ERROR: RES-3
    cur.get(m);                          // ERROR: RES-3
    a.rows.post(m);
  }
}
