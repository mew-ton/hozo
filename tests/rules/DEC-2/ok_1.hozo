// DEC-2（docs/check.md「デコレータ」。文法で閉じる）: 節（throws / catches / reads / effects）を持てるのは、
// 関数に付けるデコレータ（decorator fn）だけ。for で付ける先を書いたデコレータは、節を持たない（op を含む並びでも）
namespace a {
  exception E;
  state s: list<string>;
  effect fn e(): effects s.post;
  decorator ok for op, field;
  decorator fn ok2(): throws E;
  decorator fn ok3(table: any state): reads table;
  decorator fn ok4(...targets: any effect): effects targets;
  decorator ok5 for effect, op;
  decorator ok6 for effect;
  fn f();
}
