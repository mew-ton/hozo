// DEC-2（docs/check.md「デコレータ」）: op を含む targets なら throws / catches / reads / effects を持てる。
// 節を持たなければ、op を含まない targets でよい（対象 effect を含む）
namespace a {
  exception E;
  state s: list<string>;
  effect fn e(): effects s.post;
  decorator ok for op | field throws E;
  decorator ok2 throws E;
  decorator ok3(table: any state) for op reads table;
  decorator ok4(...targets: any effect) effects targets;
  decorator ok5 for effect | op reads s effects e;
  decorator ok6 for effect;
  fn f();
}
