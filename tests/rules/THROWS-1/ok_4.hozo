// THROWS-1（docs/check.md「throw」）: throw の例外を throws に書く。デコレータが吸収してもよい
namespace a {
  model M { id: string; }
  exception E;
  exception F;
  classify Kind of M { A; B; }
  decorator swallow catches E recovers;
  op fail(): never throws F;
  op f(m: M): M throws E | F {
    return match m by Kind {
      A => throw E;
      B => fail();
    };
  }
  @swallow
  op g(m: M): M {
    return match m by Kind {
      A => m;
      B => throw E;
    };
  }
}
