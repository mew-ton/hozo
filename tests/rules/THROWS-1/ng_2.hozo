// THROWS-1（docs/check.md「throws」）: デコレータが吸収するのは E だけで、節を書いた配線の op から、F が漏れている
namespace a {
  exception E;
  exception F;
  exception G;
  decorator recoverE catches E recovers;
  fn leaf(): throws E, F, G;
  @recoverE                            // ERROR: THROWS-1
  fn wiring(): throws G {
    leaf();
  }
}
