// THROWS-1（docs/check.md「throws」「throw」）: アームの本体の throw の例外も、節を書いた配線の op は、その節に書くか、
// デコレータが吸収する。never を返す op の例外も同じ
namespace a {
  model M { id: string; }
  exception E;
  exception F;
  classify Kind of M { A; B; }
  fn fail(): never throws F;
  fn f(m: M): M throws F {             // ERROR: THROWS-1
    return match (m by Kind) {
      A => fail();
      B => throw E;
    };
  }
  fn g(m: M): M throws E {             // ERROR: THROWS-1
    return match (m by Kind) {
      A => throw E;
      B => fail();
    };
  }
}
