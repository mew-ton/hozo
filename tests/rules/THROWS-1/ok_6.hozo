// THROWS-1（docs/check.md「節に書く要素」）: 配線の op は、throws を書かなくてよい。例外は、本体（呼び出し先、アームの throw、
// 効果の呼び出し）と、デコレータ（足すもの、受けるもの）から計算する。for のブロックと、disjoint のアームの中の呼び出しも同じ。
// 書いていない op を、別の配線の op が呼んでも、同じ。葉の op と、効果は、書く（そこが、定義）
namespace a {
  model M { id: string; }
  state rows: list<M>;
  classify Kind of M { A; B; }
  exception E;
  exception F;
  exception Taken;
  exception Limited;
  decorator limited throws Limited;
  decorator recoverE catches E recovers;
  effect fn add(m: M): throws Taken effects rows.post;
  fn leaf(m: M): throws E;
  fn fail(): never throws F;
  fn inner(m: M) {
    leaf(m);
  }
  fn outer(m: M) {
    inner(m);
  }
  fn arms(m: M): M {
    return match (m by Kind) {
      A => throw E;
      B => fail();
    };
  }
  fn writes(m: M) {
    add(m);
  }
  @limited
  fn decorated(m: M) {
    leaf(m);
  }
  @recoverE
  fn recovered(m: M) {
    leaf(m);
  }
  fn each(ms: M[]) {
    for (val m of ms) {
      leaf(m);
    }
  }
  fn apart(x: M, y: M) {
    disjoint {
      leaf(x);
      leaf(y);
    }
  }
  // 節を書いた op は、今までどおり、確かめる: 書いていない op（outer）の例外 E を、書いている
  fn declared(m: M): throws E {
    outer(m);
  }
}
