// THROWS-1（docs/check.md「throws」）: match のアームの呼び出し先の例外も数える
namespace a {
  model M { id: string; }
  classify C of M { A; B; }
  exception E;
  op risky(m: M) throws E;
  op safe(m: M);
  op wiring(m: M) {                    // ERROR: THROWS-1
    match (m by C) {
      A => risky(m);
      B => safe(m);
    };
  }
}
