// THROWS-1（docs/check.md「read と効果」「配線からの呼び出し」）: 効果が投げる例外を、配線が throws に書けば、通る。
// 投げたとき、その効果は、起きていない（prevents effects と言える）。デコレータが吸収しても、通る。
// read の呼び出しと、直に呼ぶ組み込みの効果は、例外を増やさない
namespace a {
  model M { id: string; }
  state rows: list<M>;
  state seen: list<M>;
  exception Taken;
  read fn all(): M[] reads rows;
  effect fn add(m: M): throws Taken effects rows.post;
  effect fn note(m: M): effects seen.post;
  decorator quiet(error: any exception, then: any effect) for op catches error halts then;
  fn f(m: M): throws Taken prevents effects {
    add(m);
  }
  @quiet(Taken, note)
  fn g(m: M) {
    add(m);
  }
  fn h(m: M): M[] {
    rows.post(m);
    return all();
  }
}
