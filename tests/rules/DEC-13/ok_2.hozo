// DEC-13（docs/check.md「デコレータ」、docs/grammar.md「decorator の宣言」）: @repeatable の印を持つデコレータは、一つの宣言に
// 何度でも付けられる（別名を通しても）。標準の語彙の db.where も同じ
namespace a {
  model M { @db.text id: string; @db.text kind: string; }
  @db.table
  state rows: list<M>;
  @repeatable
  decorator tag(name: string) for read, op, field, model;
  decorator hot = tag("hot");
  @db.list @db.where("kind", "a") @db.where("id", "x")
  @tag("a") @tag("b") @hot @hot
  read fn some(): M[] reads rows;
  @tag("x") @tag("x")
  fn f(): M[] { return some(); }
  @tag("m") @tag("n")
  model N { @tag("f") @tag("g") id: string; }
}
