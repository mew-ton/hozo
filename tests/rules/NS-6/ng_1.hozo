// NS-6（docs/check.md「名前空間」「配線からの呼び出し」）: read と効果を呼べるのは、宣言した名前空間（状態の持ち主）の配線だけ。
// 別の名前空間は、その名前空間の op を通す。位置は呼び出しの名前
effect fn global(): effects shared.post;
state shared: list<string>;
namespace a {
  model M { id: string; }
  state rows: list<M>;
  read fn byId(id: string): M? reads rows;
  effect fn add(m: M): effects rows.post;
  export fn find(id: string): M? { return byId(id); }
}
namespace a.child {
  fn f(m: a.M): a.M? {
    a.add(m);                            // ERROR: NS-6
    return a.byId(m.id);                 // ERROR: NS-6
  }
}
namespace b {
  classify K of a.M { One; Other; }
  fn g(m: a.M): a.M? {
    a.add(m);                            // ERROR: NS-6
    global();                            // ERROR: NS-6
    val found = a.byId(m.id);          // ERROR: NS-6
    return match (m by K) {
      One     => a.byId(m.id);           // ERROR: NS-6
      else    => found;
    };
  }
}
