// MATCH-8（docs/check.md「throw」）: throw に書けるのは、値を運ばない例外一つ（どの名前空間のものでも）。
// 値を運ぶ例外を投げるのは、葉の op
namespace a {
  model M { id: string; }
  model Detail { reason: string; }
  exception Plain;
  exception WithModel: Detail;
  classify Kind of M { A; B; C; }
  op reject(m: M): M throws WithModel;
  op f(m: M): M throws Plain | WithModel | b.Remote {
    return match m by Kind {
      A => throw Plain;
      B => throw b.Remote;
      C => reject(m);
    };
  }
  op g(m: M) throws Plain {
    match m by Kind {
      A | B => throw Plain;
      C => none;
    };
  }
}
namespace b {
  exception Remote;
}
