// TYPE-11（docs/types.md「診断」「インデックスの model」）: インデックスのキーの型が string でも、元が string の scalar でもない。internal/sema/testdata/rules/TYPE-11.hozo から
namespace a {
  scalar Num extends int;
  model Ng1 { [n: int]: int; }             // ERROR: TYPE-11
  model Ng2 { [n: Num]: int; }             // ERROR: TYPE-11
  fn f(a: Ng1): Ng2;
}
