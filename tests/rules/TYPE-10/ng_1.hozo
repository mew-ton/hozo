// TYPE-10（docs/types.md「診断」）: model P is U omit f の f が U にない、is の循環。internal/sema/testdata/rules/TYPE-10.hozo から
namespace a {
  model User { id: string; hash: string; }
  model P is User omit nope;           // ERROR: TYPE-10
  model S is T omit id;
  model T is S omit id;                // ERROR: TYPE-10
  op f(): User;
}
