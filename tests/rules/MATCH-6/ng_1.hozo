// MATCH-6（docs/check.md「classify / match」）: subject の型が Classify.subject に渡せない。internal/sema/testdata/rules/MATCH-6.hozo から
namespace a {
  model M { id: string; }
  model N { name: string; }
  classify C of M { A; }
  fn use(n: N): void;
  fn f(n: N): void {
    match (n by C) {                     // ERROR: MATCH-6
      A => use(n);
    };
  }
  fn g(s: string): void {
    match (s by C) {                     // ERROR: MATCH-6
      A => none;
    };
  }
}
