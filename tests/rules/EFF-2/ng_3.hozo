// EFF-2（docs/check.md「状態と効果」「デコレータが運ぶ reads と effects」）: 配線の op に書いた effects が、デコレータが運ぶ
// 効果を落としている。書いた節は、その op の効果の全体を言うので、運ばれた効果も書く。呼び出し元の節も同じ
namespace a {
  state s: list<string>;
  state log: list<string>;
  effect e() on s.post;
  effect note() on log.post;
  decorator doing(...targets: any effect) for op effects targets;
  decorator posting for op effects log.post;
  // 運ばれた note が足りない
  @doing(note)                               // ERROR: EFF-2
  op missing() effects e {
    e();
  }
  // 直に書いた効果を運ぶデコレータ。同じ宛先の宣言 note は、別の効果
  @posting                                   // ERROR: EFF-2
  op wrong() effects e, note {
    e();
  }
  @doing(note)
  op carrying() {
    e();
  }
  // 呼び出し先の配線に運ばれた note が、呼ぶ側の節に足りない
  op caller() effects e {                  // ERROR: EFF-2
    carrying();
  }
}
