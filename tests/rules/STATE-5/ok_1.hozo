// STATE-5（docs/check.md「葉の op」）: 葉は、人が中身を書く op で、状態に触れない。throws は書ける。状態を読み書きするのは、
// read と効果を呼ぶ配線。配線の op は、reads / effects の節を書ける（本体と照合しない: ok_2）
namespace a {
  model M { id: string; }
  exception Invalid(reason: string);
  state rows: list<M>;
  effect fn add(m: M): effects rows.post;
  read fn byId(id: string): M? reads rows;
  fn normalize(m: M): M throws Invalid;
  fn find(id: string): M? reads rows {
    return byId(id);
  }
  fn insert(m: M): effects add throws Invalid {
    val row = normalize(m);
    add(row);
  }
  // デコレータが運ぶ分は、葉の節ではない
  decorator counting(table: any state) for op reads table;
  @counting(rows)
  fn count(): int;
}
