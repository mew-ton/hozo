// WIRE-11: 値を入れられないもの。引数、for の変数、値と一緒に宣言した val、二度目、別のアームが入れる val、for の外の val
namespace a {
  model M { id: string; }
  op one(m: M): M;
  op use(m: M);
  op f(m: M, ms: M[]) {
    m = one(m);                        // ERROR: WIRE-11
    val a = one(m);
    a = one(m);                        // ERROR: WIRE-11
    val b;
    b = one(m);
    b = one(m);                        // ERROR: WIRE-11
    val c;
    disjoint {
      c = one(m);
      c = one(a);                      // ERROR: WIRE-11
    }
    val d;
    for (val i of ms) {
      i = one(m);                      // ERROR: WIRE-11
      d = one(i);                      // ERROR: WIRE-11
    }
    d = one(m);
    use(b);
    use(c);
    use(d);
  }
}
