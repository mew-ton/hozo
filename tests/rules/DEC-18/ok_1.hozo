// DEC-18（docs/check.md「デコレータ」）: デコレータの宣言の、分類のケース。名前で絞る、対象で絞る、両方で絞る
namespace a {
  model M { id: string; }
  classify Actor of never { Customer; }
  classify Size of M { Small; Large; }
  decorator any1 for classify case;
  decorator byName for classify Size case;
  decorator bySubject for classify of never case;
  decorator both(x: any classify Actor of never case) for classify Actor of never case;
  classify Other of never { @any1 @bySubject A; }
  classify Sized of M { @any1 Tiny; Huge; }
}
