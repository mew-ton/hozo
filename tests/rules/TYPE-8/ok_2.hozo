// TYPE-8（docs/types.md「match の型」）: 「返らない」アームは除く。そろえる型は、ほかのすべてが渡せる型（T と T? は T?、
// 絞り込んだ型と T は T）。リテラルだけなら、その種類の核の型。レコードリテラルは、そろえた型に当てはめる
namespace a {
  scalar Email extends string;
  model M { id: string; }
  exception E;
  classify C of M { A; B; D; }
  op m(x: M): M;
  op opt(x: M): M?;
  op fail(): never throws E;
  op email(): Email;
  op name(x: M): string;
  op use(x: M?): void;
  op useM(x: M): void;
  op useInt(n: int): void;
  op useString(s: string): void;
  op f(x: M): void throws E {
    // 返らないアームを除いて M
    const r1 = match x by C { A => m(x); B => throw E; D => fail(); };
    useM(r1);
    // T と T? は T?
    const r2 = match x by C { A => m(x); B, D => opt(x); };
    use(r2);
    // 絞り込んだ型 case(C, [A], M) と M は M
    const r3 = match x by C { A => x; B, D => m(x); };
    useM(r3);
  }
  op f2(x: M): void {
    // リテラルだけなら、その種類の核の型
    const r4 = match x by C { A => 1; B, D => 2; };
    useInt(r4);
    // scalar の値は元の型に渡せるので、Email と string は string にそろう
    const r5 = match x by C { A => email(); B, D => name(x); };
    useString(r5);
    // レコードリテラルは、型の決まったアームの型に当てはめる。none があれば optional
    const r6 = match x by C { A => m(x); B => { id: "new" }; D => none; };
    use(r6);
  }
  // すべてのアームが返らない match は「返らない」
  op g(x: M): M throws E {
    return match x by C { A, B => throw E; D => fail(); };
  }
}
