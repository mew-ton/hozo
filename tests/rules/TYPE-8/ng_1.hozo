// TYPE-8（docs/types.md「診断」）: match のアームの型がそろわない。internal/sema/testdata/rules/TYPE-8.hozo から
namespace a {
  model M { id: string; }
  model N { name: string; }
  classify C of M { A; B; }
  op m(x: M): M;
  op n(x: M): N;
  op v(x: M): void;
  op use(x: M?): void;
  op differ(x: M): void {
    val r = match (x by C) {           // ERROR: TYPE-8
      A => m(x);
      B => n(x);
    };
    use(r);
  }
  op mixed(x: M): void {
    val r = match (x by C) {           // ERROR: TYPE-8
      A => m(x);
      B => v(x);
    };
    use(r);
  }
}
