// TYPE-8（docs/types.md「match の型」の 4〜6）: 値のある本体と「値がない」が混ざる、ほかのすべてが渡せる型がない、
// リテラルの種類が混ざる（int と float も別の種類）、リテラルやレコードリテラルがそろえた型に渡せない（そのアームの位置）
namespace a {
  scalar Email extends string;
  model M { id: string; }
  model N { name: string; }
  classify C of M { A; B; }
  fn m(x: M): M;
  fn v(x: M): void;
  fn use(x: M?): void;
  fn useInt(n: int): void;
  fn useFloat(n: float): void;
  fn useString(s: string): void;
  fn email(): Email;
  fn valueAndNoValue(x: M): void {
    val r = match (x by C) {           // ERROR: TYPE-8
      A => x;
      B => v(x);
    };
    use(r);
  }
  fn literalKinds(x: M): void {
    val r = match (x by C) {           // ERROR: TYPE-8
      A => 1;
      B => "one";
    };
    useInt(r);
  }
  fn intAndFloat(x: M): void {
    val r = match (x by C) {           // ERROR: TYPE-8
      A => 1;
      B => 1.5;
    };
    useFloat(r);
  }
  fn literalToModel(x: M): void {
    val r = match (x by C) {
      A => m(x);
      B => 1;                          // ERROR: TYPE-8
    };
    use(r);
  }
  // scalar にそろえた match に、リテラルは渡せない（TYPE-1）
  fn literalToScalar(x: M): void {
    val r = match (x by C) {
      A => email();
      B => "none";                     // ERROR: TYPE-1
    };
    useString(r);
  }
  fn recordToOther(x: M, n: N): void {
    val r = match (x by C) {
      A => m(x);
      B => { name: n.name };           // ERROR: TYPE-5, BIND-4
    };
    use(r);
  }
}
