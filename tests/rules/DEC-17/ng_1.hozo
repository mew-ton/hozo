// DEC-17（docs/check.md「デコレータ」「デコレータが運ぶ reads と effects」）: reads の節を持つデコレータが、配線の op
// （本体を持つ op）に付いている。位置はそのデコレータの適用
namespace a {
  model M { id: string; }
  state rows: list<M>;
  read byId(id: string): M? on rows;
  decorator counting(table: any state) for op reads table;
  @counting(rows)
  op count(): int;
  @counting(rows)                      // ERROR: DEC-17
  op find(id: string): M? {
    return byId(id);
  }
}
