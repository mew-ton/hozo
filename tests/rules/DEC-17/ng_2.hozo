// DEC-17（docs/check.md「デコレータ」）: effects の節を持つデコレータが、配線の op に付いている。残りの引数に何も渡して
// いなくても、節を持つデコレータは配線に付けられない。節を持つデコレータが二つなら、それぞれに一つ
namespace a {
  model M { id: string; }
  state rows: list<M>;
  effect add on rows.post;
  decorator doing(...targets: any effect) for op effects targets;
  decorator reading(table: any state) for op reads table;
  decorator fixed for op reads rows effects add;
  @doing(add)
  op insert(m: M);
  @doing(add)                          // ERROR: DEC-17
  op wire(m: M) {
    insert(m);
  }
  @doing                               // ERROR: DEC-17
  op wireNothing(m: M) {
    insert(m);
  }
  @fixed                               // ERROR: DEC-17
  @reading(rows)                       // ERROR: DEC-17
  op wireBoth(m: M) {
    insert(m);
  }
}
