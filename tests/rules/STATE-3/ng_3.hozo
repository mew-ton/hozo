// STATE-3（docs/check.md「状態と効果」）: 当たった状態は、list<T> として残りの検査を続ける
// （list の状態なので、bind には書けない: BIND-6。post はできる）
namespace a {
  scalar Token extends string;
  state tokens: list<Token?>;          // ERROR: STATE-3
  bind tokens to a.*;                  // ERROR: BIND-6
  effect add() on tokens.post;
  op g(t: Token);
  op all(): Token[] {
    return tokens;
  }
}
