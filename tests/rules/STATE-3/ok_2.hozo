// STATE-3（docs/types.md「形の書き方」）: single<T?> と nullable<T?> は T?（nullable<T>）と同じ型なので、当たらない。
// 形は nullable で、post も delete もできる
namespace a {
  model M { id: string; }
  state a1: single<M?>;
  state a2: nullable<M?>;
  state a3: M?;
  state a4: single<string??>;
  // T[]? は nullable（要素は T[]）
  state a5: single<string[]?>;
  effect fn fill() on a1.post;
  effect fn clear() on a1.delete;
  effect fn drop() on a3.delete;
  fn first(): M? {
    return a1;
  }
}
