// STATE-3（docs/check.md「状態と効果」）: list の状態の要素は optional にしない
namespace a {
  model M { id: string; }
  state maybe: nullable<M>;
  state one: single<M>;
  state many: list<M>;
  // 要素の中の optional（インデックスの値、配列の要素）は、要素の型そのものの optional ではない
  model Attrs { [name: string]: string?; }
  state attrs: single<Attrs>;
  state slots: list<M?[]>;
}
