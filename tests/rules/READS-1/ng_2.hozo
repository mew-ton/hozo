// READS-1（docs/check.md「状態と効果」「デコレータが運ぶ reads と effects」）: 配線の op にデコレータが運ぶ reads も、付いた op の
// 名前空間の状態（か、その read）でなければならない。デコレータの処理は、op を呼ばずに状態に直に触れるので、配線が別の
// 名前空間の op を呼んで行き着く状態（READS-1/ok_1.hozo の viaStore）とは違う。位置はそのデコレータの適用
namespace a {
  state own: list<string>;
  decorator from(table: any state) for op reads table;
  decorator fromRead for op reads b.firstUser;
  @from(own)
  op ok(): string[] {
    return b.all();
  }
  @from(b.users)                                 // ERROR: READS-1
  op wired(): string[] {
    return b.all();
  }
  @fromRead                                      // ERROR: READS-1
  op wiredRead(): string[] {
    return own;
  }
}
namespace b {
  state users: list<string>;
  read firstUser(): string? on users;
  export op all(): string[] { return users; }
}
