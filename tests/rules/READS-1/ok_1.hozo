// READS-1（docs/check.md「reads」「デコレータが運ぶ reads と effects」）: デコレータが、自分の名前空間の状態を reads として運ぶ
// 葉の op。別の名前空間の配線には、R として伝わる。配線の op の reads の節には、別の名前空間の状態（と read）も書ける
// （呼び出し先から伝わったもの。READS-2）
namespace a {
  state users: list<string>;
  state token: nullable<string>;
  read fn first(): string? reads users;
  decorator counting(table: any state) for op reads table;
  decorator peeking for op reads first, token;
  @counting(users)
  export fn count(): int;
  @peeking
  fn peek(): string?;
  fn viaStore(): string[] reads b.rows, b.firstRow {
    return b.all();
  }
}
namespace b {
  state rows: list<string>;
  read fn firstRow(): string? reads rows;
  export fn all(): string[] reads rows { return rows; }
  fn size(): int reads a.users {
    return a.count();
  }
}
