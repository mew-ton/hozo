// READS-1（docs/check.md「状態と効果」「デコレータが運ぶ reads と effects」）: 葉の op にデコレータが運ぶ reads は、付いた op の
// 名前空間の状態（か、その read）でなければならない。位置はそのデコレータの適用
state shared: list<string>;
namespace a {
  state own: list<string>;
  read fn first(): string? reads own;
  decorator fn from(table: any state): reads table;
  decorator fn fromUsers(): reads b.users;
  decorator fn fromRead(): reads b.firstUser;
  decorator fn fromOwnRead(): reads first;
  @from(own)
  fn j(): string[];
  @fromOwnRead
  fn j2(): string?;
  @from(b.users)                                 // ERROR: READS-1
  fn k(): string[];
  @from(shared)                                  // ERROR: READS-1
  fn l(): string[];
  @fromUsers                                     // ERROR: READS-1
  fn m(): string[];
  @fromRead                                      // ERROR: READS-1
  fn m2(): string?;
  @from(b.token)                                 // ERROR: READS-1
  @fromOwnRead
  fn n(): string[];
}
namespace b {
  state users: list<string>;
  state token: nullable<string>;
  read fn firstUser(): string? reads users;
  // 自分の名前空間の葉に付ければ通る
  @a.fromUsers
  fn own(): string[];
  @a.fromRead
  fn own2(): string?;
}
