// READS-1（docs/check.md「reads」「デコレータが運ぶ reads と effects」）: デコレータが、自分の名前空間の状態を reads として運ぶ
// 葉の op（読む op）。op は reads を書かなくてよく、書いてもよい（重複は一つと数える）。別の名前空間の配線には、R として伝わる
namespace a {
  model M { @db.key @db.text id: string; @db.text name: string; }
  @db.table(M)
  state rows: list<M>;
  @db.find(rows, "id")
  export op find(id: string): M?;
  @db.list(rows, "name")
  op named(name: string): M[];
  @db.list(rows)
  op all(): M[] reads rows;
}
namespace b {
  op lookup(id: string): a.M? reads a.rows {
    return a.find(id);
  }
}
