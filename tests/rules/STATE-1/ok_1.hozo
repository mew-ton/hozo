// STATE-1（docs/check.md「状態と効果」「状態の形」の表）: list と nullable には post / put / delete、single には put
namespace a {
  state s: single<string>;
  state l: list<string>;
  state n: nullable<string>;
  effect fn put() on s.put;
  effect fn lpost() on l.post;
  effect fn lput() on l.put;
  effect fn ldel() on l.delete;
  effect fn npost() on n.post;
  effect fn nput() on n.put;
  effect fn ndel() on n.delete;
}
