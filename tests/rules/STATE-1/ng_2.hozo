// STATE-1（docs/check.md「状態の形」）: single は常に一列なので、増やす（post）ことも減らす（delete）こともできない。
// 同じ操作が nullable ならできる
namespace a {
  scalar Token extends string;
  state session: single<Token>;
  state token: nullable<Token>;
  effect fn dropSession(): effects session.delete;   // ERROR: STATE-1
  effect fn newSession(): effects session.post;      // ERROR: STATE-1
  effect fn dropToken(): effects token.delete;
  effect fn newToken(): effects token.post;
}
