// STATE-1（docs/check.md「状態の形」）: 空になりうる状態は nullable<T>。空にするのは delete、空から入れるのは post
namespace a {
  scalar Token extends string;
  state token: nullable<Token>;
  /** 手元のトークンを消す */
  effect fn removeToken() on token.delete;
  /** トークンを保存する */
  effect fn saveToken() on token.post;
  /** トークンを入れ替える */
  effect fn refreshToken() on token.put;
}
