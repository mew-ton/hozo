// DEC-19: 包んだ関数の引数は、デコレータの本体の、文と、match のアームの本体に、呼び出しとして書ける。名前は、自由
namespace a {
  exception Denied;
  model Ticket { ok: boolean; }
  fn ticket(): Ticket;
  classify Gate of Ticket { Open; Closed; }
  fn record();
  decorator fn audited(next: fn) {
    next();
    record();
  }
  decorator fn guarded(body: fn) {
    val t = ticket();
    match (t by Gate) {
      Open   => body();
      Closed => throw Denied;
    }
  }
  @audited @guarded
  fn f();
}
namespace b {
  // proceed は、ふつうの op の名前: 配線からも、デコレータの本体からも、呼べる
  fn proceed();
  fn g() {
    proceed();
  }
  decorator fn stepped(next: fn) {
    proceed();
    next();
  }
  @stepped
  fn h();
}
namespace c {
  // 包んだ関数の引数は、本体の中で、同じ名前の op を隠す（修飾して書けば、その op を呼ぶ）
  fn inner();
  decorator fn shadowing(inner: fn) {
    c.inner();
    inner();
  }
  @shadowing
  fn k();
}
