// DEC-19（docs/check.md「デコレータ」）: next() を、try のブロックの、最初の文でない位置と、catch のブロックの中に書いた
namespace a {
  fn note();
  decorator fn late(next: fn) {
    try {
      note();
      next();                           // ERROR: DEC-19
    } catch (e) {
      throw e;
    }
  }
  decorator fn retry(next: fn) {
    try {
      next();
    } catch (e) {
      next();                           // ERROR: DEC-19
    }
  }
  fn f();
}
