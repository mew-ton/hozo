// DEC-19（docs/check.md「デコレータ」）: proceed() を、try のブロックの、最初の文でない位置と、catch のブロックの中に書いた
namespace a {
  fn note();
  decorator fn late() {
    try {
      note();
      proceed();                           // ERROR: DEC-19
    } catch (e) {
      throw e;
    }
  }
  decorator fn retry() {
    try {
      proceed();
    } catch (e) {
      proceed();                           // ERROR: DEC-19
    }
  }
  fn f();
}
