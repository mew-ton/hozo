// DEC-19（docs/check.md「デコレータ」）: next() を、書けない所に書いた: 引数を書いた。for か disjoint の中
namespace a {
  fn notify(id: string);
  fn ids(): string[];
  decorator fn withArgs(next: fn) {
    next("x");                          // ERROR: DEC-19
  }
  decorator fn inLoop(next: fn) {
    val all = ids();
    for (val id of all) {
      notify(id);
      next();                           // ERROR: DEC-19
    }
    next();
  }
  fn f();
}
