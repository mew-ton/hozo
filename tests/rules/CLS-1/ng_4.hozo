// CLS-1（docs/check.md「classify / match」「残りのケース」）: 残りのケース（as else）と default の両方。どちらも残りを言う。
// 位置は、後ろに書いた方
namespace a {
  model M { id: string; }
  op find(): M?;
  classify Hit of find {
    Found: find as M;
    Missing: find as else;
    default;                           // ERROR: CLS-1
  }
  classify Hit2 of find {
    Found: find as M;
    default;
    Missing: find as else;             // ERROR: CLS-1
  }
}
