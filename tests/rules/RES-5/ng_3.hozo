// RES-5（docs/resolve.md「診断」）: 配線の値の位置で、別の名前空間（かグローバル）の状態は名前で読めない。
// match by C の状態の分類も、宣言した名前空間の配線だけが読める。組み込みの効果を直に呼べるのも、持ち主の名前空間の配線だけ
state shared: list<string>;
classify Shared of shared { None; Some; }
namespace a {
  state s: list<string>;
  state t: nullable<string>;
  classify Phase of s { Idle; Busy; }
  export fn all(): string[] reads s { return s; }
  effect fn add(x: string): effects s.post;
  read fn first(): string? reads s;
}
namespace b {
  fn f(xs: string[]);
  fn g();
  fn ng() {
    f(a.s);                                                    // ERROR: RES-5
    f(shared);                                                 // ERROR: RES-5
    match (a.t by nullable) { None => g(); Some => none; }; // ERROR: RES-5
    match (by a.Phase) { Idle => g(); Busy => none; };           // ERROR: RES-5
    match (by Shared) { None => g(); Some => none; };            // ERROR: RES-5
    a.s.post("x");                                             // ERROR: RES-5
    shared.post("x");                                          // ERROR: RES-5
  }
}
