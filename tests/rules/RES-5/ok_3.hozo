// RES-5（docs/check.md「状態の参照」）: 状態を名前で読めるのは持ち主の名前空間の配線だけ。ほかの名前空間は、その op を通して読む。
// 修飾して書いても、今の名前空間の状態なら同じ
namespace a {
  state s: list<string>;
  classify Phase of s { Idle; Busy; }
  export fn all(): string[] reads s { return s; }
  fn own(): string[] {
    return a.s;
  }
  fn g();
  // 組み込みの効果を直に呼べるのも、持ち主の名前空間の配線（修飾して書いても同じ）
  fn push(x: string) {
    s.post(x);
    a.s.post(x);
  }
  fn phase() {
    match (by a.Phase) { Idle => g(); Busy => none; };
  }
}
namespace b {
  fn f(xs: string[]);
  fn ok() {
    val xs = a.all();
    f(xs);
  }
}
