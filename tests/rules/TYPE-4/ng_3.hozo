// TYPE-4（docs/types.md「デコレータの引数」）: 残りの引数に渡した値は、一つずつ、残りの引数の ParamType で受ける。
// 型で受ける値の型が合わない、any の引数にリスト・リテラル・`|` の集合（例外と効果のほか）は渡せない
namespace a {
  state rows: list<string>;
  state cur: nullable<string>;
  effect fn add(): effects rows.post;
  effect fn add2(): effects rows.post;
  effect fn set(): effects cur.post;
  effect fn drop(): effects rows.delete;
  union Posts { add; add2; }
  decorator posts(...es: any effect on rows.post) for op effects es;
  decorator tags(first: string, ...more: string | int);
  decorator states(...ts: any state) for op reads ts;
  @posts(add, add2, Posts)
  fn ok(x: string, y: string);
  @tags("a", "b", 1)
  fn okTags();
  @tags("a", true)                               // ERROR: TYPE-4
  fn badTag();
  @tags("a", 1.5, "c")                           // ERROR: TYPE-4
  fn badTag2();
  @posts([add, add2])                            // ERROR: TYPE-4
  fn listToAny(x: string);
  @posts("add")                                  // ERROR: TYPE-4
  fn literalToAny(x: string);
  @states(rows, cur)
  fn okStates(): string[];
  @states(rows | cur)                            // ERROR: TYPE-4
  fn setToState(): string[];
}
