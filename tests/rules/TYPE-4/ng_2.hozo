// TYPE-4（docs/types.md「デコレータの引数」）: デコレータの引数のリテラルが Param.type に渡せない
namespace a {
  decorator fn d(n: int | float);
  @d(1.5)
  @http.retry("x")                     // ERROR: TYPE-4
  fn k(): void;
  decorator fn l(xs: string[]);
  @l(["a", 1])                         // ERROR: TYPE-4
  fn m(): void;
  @l("a")                              // ERROR: TYPE-4
  fn p(): void;
}
