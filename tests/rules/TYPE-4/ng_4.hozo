// TYPE-4（docs/types.md「呼び出しの引数」）: read、効果（宣言と、直に呼ぶ組み込みの効果）、throw の引数も、op の呼び出しと
// 同じ規則で確かめる: 値の型が引数の型に渡せない、渡した値の数が引数の数を超える
namespace a {
  model M { id: string; }
  model N { id: string; }
  exception Busy(wait: Duration, note: string?);
  exception Plain;
  state rows: list<M>;
  state cur: nullable<M>;
  read fn byId(id: string): M? reads rows;
  effect fn add(m: M): effects rows.post;
  classify K of M { A; B; C; D; }
  fn f(m: M, n: N, count: int): M? throws Busy {
    add(n);                              // ERROR: TYPE-4
    add(m, m);                           // ERROR: TYPE-4
    rows.post(n);                        // ERROR: TYPE-4
    rows.post(m, m);                     // ERROR: TYPE-4
    cur.put("x");                        // ERROR: TYPE-4
    cur.delete(m);                       // ERROR: TYPE-4
    val a1 = byId(count);              // ERROR: TYPE-4
    val a2 = byId("x", "y");           // ERROR: TYPE-4
    use(a1, a2);
    return match (m by K) {
      A => throw Busy("soon");           // ERROR: TYPE-4
      B => throw Busy(5m, 1);            // ERROR: TYPE-4
      C => throw Busy(5m, "x", "y");     // ERROR: TYPE-4
      D => throw Busy(5m);
    };
  }
  fn use(x: M?, y: M?);
}
