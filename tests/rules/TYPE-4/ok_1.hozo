// TYPE-4（docs/types.md「互換」）: 写す op を通した model、リテラルの型、リストの位置にリスト、scalar を元の型に（規則 11）
namespace a {
  scalar Email extends string;
  model M { id: string; }
  model N { id: string; extra: int; }
  fn takeM(m: M): void;
  fn takeInt(n: int): void;
  fn takeOpt(n: int?): void;
  fn takeString(s: string): void;
  fn n(): N;
  fn email(): Email;
  fn toM(n: N): M;
  fn i(): void {
    val x = n();
    val m = toM(x);
    takeM(m);
    takeInt(1);
    takeOpt(none);
    val e = email();
    takeString(e);
  }
  decorator l(xs: string[]);
  @l(["a", "b"])
  fn m(): void;
}
