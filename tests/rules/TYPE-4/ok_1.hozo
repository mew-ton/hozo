// TYPE-4（docs/types.md「互換」）: 写す op を通した model、リテラルの型、リストの位置にリスト、scalar を元の型に（規則 11）
namespace a {
  scalar Email extends string;
  model M { id: string; }
  model N { id: string; extra: int; }
  op takeM(m: M): void;
  op takeInt(n: int): void;
  op takeOpt(n: int?): void;
  op takeString(s: string): void;
  op n(): N;
  op email(): Email;
  op toM(n: N): M;
  op i(): void {
    const x = n();
    const m = toM(x);
    takeM(m);
    takeInt(1);
    takeOpt(none);
    const e = email();
    takeString(e);
  }
  decorator l(xs: string[]);
  @l(["a", "b"])
  op m(): void;
}
