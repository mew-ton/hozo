// MATCH-4（docs/check.md「classify / match」）: 絞り込まれた型は、そのケースの位置と広い位置に渡せる
namespace a {
  model M { id: string; }
  classify C of M { A; B; }
  fn onA(m: M on C.A): void;
  fn wide(m: M): void;
  fn onAorB(m: M on C.A): void;
  fn ok(m: M): void {
    match (m by C) {
      A => onA(m);
      B => wide(m);
    };
  }
}
