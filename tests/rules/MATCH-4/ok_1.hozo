// MATCH-4（docs/check.md「classify / match」）: 絞り込まれた型は、そのケースの位置と広い位置に渡せる
namespace a {
  model M { id: string; }
  classify C of M { A; B; }
  op onA(m: C.A<M>): void;
  op wide(m: M): void;
  op onAorB(m: C.A<M>): void;
  op ok(m: M): void {
    match m by C {
      A => onA(m);
      B => wide(m);
    };
  }
}
