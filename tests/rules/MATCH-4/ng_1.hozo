// MATCH-4（docs/check.md「classify / match」）: アームの中で subject は絞り込まれた型になる。internal/sema/testdata/rules/MATCH-4.hozo から
namespace a {
  model M { id: string; }
  classify C of M { A; B; }
  op onA(m: C.A<M>): void;
  op onB(m: C.B<M>): void;
  op wide2(m: M): void;
  op f(m: M): void {
    match (m by C) {
      A => onB(m);                     // ERROR: MATCH-4
      B => onB(m);
    };
  }
  op h(m: M, n: M): void {
    match (m by C) {
      A => onA(n);                     // ERROR: TYPE-4
      B => wide2(m);
    };
  }
}
