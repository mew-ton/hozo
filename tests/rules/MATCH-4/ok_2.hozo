// MATCH-4（docs/check.md「classify / match」）: 対象と同じ Atom をそのまま渡した引数だけの規則。対象でない引数は、
// アームの中でもそのままの型で渡す
namespace a {
  model M { id: string; }
  state items: list<M>;
  classify Stock of items { None; Some; }
  fn wide(m: M): void;
  fn ok(m: M): void {
    match (items by list) {
      Empty => wide(m);
      HasItems => wide(m);
    };
    match (by Stock) {
      None => wide(m);
      Some => wide(m);
    };
  }
}
