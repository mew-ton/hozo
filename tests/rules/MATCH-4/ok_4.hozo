// MATCH-4（docs/types.md「残りのケースでの対象の型」「アームの中の対象の型」）: 残りのケース（as else）のアームの中の対象の型。
// variant で残りのアームがちょうど一つなら、そのアームの型。presence と、残りのアームが二つ以上の variant は、外のまま
namespace a {
  model M { id: string; }
  model N { id: string; }
  model O { id: string; }
  union Two { Ready: M; Missing: N; }
  union Three { Ready: M; Missing: N; Broken: O; }
  op find(): M?;
  classify Hit of find { Found: find as M; NotFound: find as else; }
  classify K2 of Two { IsReady: Two as M; Rest: Two as else; }
  classify K3 of Three { IsReady: Three as M; Rest: Three as else; }
  op takeM(m: M): void;
  op takeN(n: N): void;
  op takeOpt(m: M?): void;
  op takeThree(t: Three): void;
  op f(two: Two, three: Three): void {
    val m = find();
    match (m by Hit) {
      Found    => takeM(m);
      NotFound => takeOpt(m);
    };
    match (two by K2) {
      IsReady => takeM(two);
      Rest    => takeN(two);
    };
    match (three by K3) {
      IsReady => takeM(three);
      Rest    => takeThree(three);
    };
  }
}
