// MATCH-4（docs/types.md「アームの中の対象の型」）: as のケース、by nullable の Some、状態の分類の as で、アームの中の対象は
// 書いた型になる。絞り込みは、対象と同じ Atom と、それを先頭に持つより長いパス、レコードリテラルの中の値に掛かる
namespace a {
  model Profile { nick: string; }
  model M { id: string; profile: Profile; }
  model In { m: M?; }
  model Wrap { m: M; note: string?; }
  state current: M?;
  fn find(): M?;
  classify Found of find { Hit: find as M; Miss: find as else; }
  classify Session of current { In: current as M; Out: current as else; }
  fn takeM(m: M): void;
  fn takeString(s: string): void;
  fn takeWrap(w: Wrap): void;
  fn f(in: In): void {
    val m = find();
    match (m by Found) {
      Hit     => takeM(m);
      else    => none;
    };
    // より長いパス（m.id、m.profile.nick）は、絞り込まれた型から辿る
    match (m by Found) {
      Hit     => takeString(m.profile.nick);
      else    => none;
    };
    // レコードリテラルの中の値
    match (m by Found) {
      Hit     => takeWrap({ m: m, note: m.id });
      else    => none;
    };
    // 対象がフィールドのパスでも同じ
    match (in.m by Found) {
      Hit     => takeM(in.m);
      else    => none;
    };
    match (in.m by nullable) {
      Some => takeString(in.m.id);
      None => none;
    };
  }
  // 状態を対象にした絞り込み: アームの中のその状態の名前は、match が読んだ値を指す
  fn g(): void {
    match (current by nullable) {
      Some => takeM(current);
      None => none;
    };
    match (by Session) {
      In      => takeString(current.id);
      else    => none;
    };
  }
  // アームの本体の値にも掛かる
  fn h(): M? {
    val m = find();
    return match (m by Found) {
      Hit     => m;
      else    => none;
    };
  }
}
