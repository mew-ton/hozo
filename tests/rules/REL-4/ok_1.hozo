// REL-4（docs/check.md「throws」）: 書いた関係が計算と一致する
namespace a {
  state s: list<string>;
  effect e on s.post;
  exception E;
  op write() effects e;
  op fail() throws E;
  op kept() throws E keeps effects {
    write();
    fail();
  }
  op prevented() throws E prevents effects {
    fail();
    write();
  }
}
