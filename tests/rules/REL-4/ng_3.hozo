// REL-4（docs/check.md「計算」の手順 0）: 運ぶ節を持つデコレータが付いていても、本体が行き着く効果の状態は、本体から計算
// する。本体も行き着く効果を運んでいれば、本体から決めた状態と、書いた関係が違うとき、状態は unknown で、書いた関係と
// 食い違う
namespace a {
  state s: list<string>;
  state log: list<string>;
  effect fn e() on s.post;
  effect fn note() on log.post;
  exception E;
  decorator doing(...targets: any effect) for op effects targets;
  fn fail() throws E;
  // 本体の e は、例外の前なので kept
  @doing(note)                               // ERROR: REL-4
  fn body() throws E prevents effects {
    e();
    fail();
  }
  // 運ばれた e を、本体も例外の前に行う
  @doing(e)                                  // ERROR: REL-4
  fn same() throws E prevents effects {
    e();
    fail();
  }
}
