// REL-4（docs/check.md「throws」）: 効果の後に投げる例外を prevents と書いた（計算は kept）
namespace a {
  state s: list<string>;
  effect fn e(): effects s.post;
  exception E;
  fn write(): effects e { e(); }
  fn fail(): throws E;
  fn wiring(): throws E prevents effects {  // ERROR: REL-4
    write();
    fail();
  }
}
