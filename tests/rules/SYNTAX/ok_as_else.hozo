// SYNTAX（docs/grammar.md「classify」「予約語」）: as の後ろの else（残りのケース）。else は予約語だが、
// フィールド名の位置には書ける
namespace a {
  model M { id: string; else: string; }
  fn find(): M?;
  fn take(s: string);
  classify Hit of find {
    /** 見つかった */
    Found: find as M;
    /** 見つからなかった */
    Missing: find as else;
  }
  fn f() {
    val m = find();
    match (m by Hit) {
      Found   => take(m.else);
      Missing => none;
    };
  }
}
