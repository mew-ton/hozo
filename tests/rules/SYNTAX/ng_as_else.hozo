// SYNTAX（docs/grammar.md「classify」「予約語」）: else は予約語で、書けるのは as の後ろと、match の最後のアームの頭
// （とフィールド名の位置）だけ。宣言の名前、引数の名前、型の位置、ケースの名前には書けない。else の後ろに型の続きは書けない
namespace a {
  model M { id: string; }
  fn find(): M?;
  model else { id: string; }                           // ERROR: SYNTAX
  fn byParam(else: string);                            // ERROR: SYNTAX
  fn byType(m: else);                                  // ERROR: SYNTAX
  classify D of find {
    Found: find as M;
    else: find as else;                                // ERROR: SYNTAX
  }
  classify Q of find {
    Found: find as M;
    Missing: find as else?;                            // ERROR: SYNTAX
  }
  classify Bare of find {
    Found: find as M;
    Missing: else;                                     // ERROR: SYNTAX
  }
}
