// SYNTAX（docs/grammar.md「decorator の宣言」の CoreMark）: 核の印は並べてよく、順は問わない。outer は、節の頭でだけ、意味を持つ
namespace a {
  model M { id: string; }
  state rows: list<M>;
  exception Offline;
  exception TooLarge;
  @repeatable
  decorator where(column: string, value: string | int | float | boolean) for read;
  @entry @repeatable
  decorator fn viaNetwork(host: string): outer throws Offline;
  @repeatable @entry
  decorator fn viaProxy(host: string): throws TooLarge prevents effects outer throws Offline;
  @hint @repeatable
  decorator fn note(text: string);
  @hint
  decorator tag(name: string) for model, read;
  @where("kind", "a") @where("size", 1) @where("ratio", 0.5) @where("open", true)
  @tag("some")
  read fn some(): M[] reads rows;
  @viaNetwork("a") @viaProxy("p") @viaNetwork("b") @note("x")
  fn fetch(): M[];
  // outer は、予約語ではない: 名前に使える
  fn outer(outer: int): int;
}
