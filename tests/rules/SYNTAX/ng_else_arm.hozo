// SYNTAX（docs/grammar.md「配線」の ElseArm）: else のアームは、ケースを名前で並べたアームを一つ以上書いた後ろに、最後に一つだけ
namespace a {
  model M { id: string; }
  classify K of M { A; B; C; }
  fn use(m: M);
  fn f();
  // else のアームの後ろに、アームは書けない（後ろのアームは捨てられ、else が残りを受ける）
  fn elseNotLast(m: M) {
    match (m by K) {
      A    => use(m);
      else => none;
      B    => f();                               // ERROR: SYNTAX
    };
  }
  fn twoElse(m: M) {
    match (m by K) {
      A    => use(m);
      else => none;
      else => f();                               // ERROR: SYNTAX
    };
  }
  // else だけの match、else から始まる match は書けない
  fn elseOnly(m: M) {
    match (m by K) {
      else => f();                               // ERROR: SYNTAX
    };
  }
  // else は、ケースの並びの中には書けない（予約語）。誤りのあるアームは捨てられる
  fn elseInList(m: M) {
    match (m by K) {
      A, else => f();                            // ERROR: SYNTAX
      A, B, C => none;
    };
  }
  // else は、遷移のケースにも、束縛の名前にも書けない
  state carts: list<M>;
  effect fn clear() on carts: else -> Empty;        // ERROR: SYNTAX
  fn bindElse(m: M) {
    val else = f2(m);                          // ERROR: SYNTAX
  }
  fn f2(m: M): M;
}
