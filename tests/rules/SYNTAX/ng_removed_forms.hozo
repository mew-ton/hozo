// SYNTAX（docs/grammar.md「関数の宣言」「exception / effect / read」「op」「配線」）: なくした書き方は、新しい書き方をメッセージで示して
// 構文エラーにする。誤りのある宣言は捨てられ、残りの宣言は検査される
namespace a {
  model M { id: string; }
  state rows: list<M>;
  // 例外が運ぶ値は、引数で書く（exception X(value: T);）
  exception Old: M;                              // ERROR: SYNTAX
  exception OldInline: { reason: string; };      // ERROR: SYNTAX
  // 引数のない例外は括弧を書かない
  exception Empty();                             // ERROR: SYNTAX
  // 効果と read は、引数がなくても括弧を書く
  effect fn old: effects rows.post;              // ERROR: SYNTAX
  read fn noParens: M[] reads rows;              // ERROR: SYNTAX
  // any read という引数の種類はない
  decorator anyRead(target: any read);           // ERROR: SYNTAX
  exception E;
  exception F;
  classify K of M { A; B; }
  // 節の並びの区切りは ","（"|" は、なくした書き方）。"," として読み進めるので、op は残る
  fn pipes(m: M): M throws E | F {               // ERROR: SYNTAX
    return match (m by K) {
      A => throw E;
      B => throw F;
    };
  }
  // 引数のない例外を投げるときも、括弧を書かない
  fn parens(m: M): M throws E {
    return match (m by K) {
      A => throw E();                            // ERROR: SYNTAX
      B => m;
    };
  }
  effect fn add(m: M): effects rows.post;
  read fn all(): M[] reads rows;
  fn ok(m: M): M[] {
    add(m);
    return all();
  }
}

// 配線の const と、丸括弧のない match の頭（docs/grammar.md「配線」）
namespace removedWiring {
  model M { id: string; }
  classify K of M { A; B; }
  fn g(): M;
  fn h(m: M);
  fn f() {
    const x = g();                     // ERROR: SYNTAX
  }
  fn k(m: M) {
    match m by K { A => h(m); B => h(m); };   // ERROR: SYNTAX
  }
}

// デコレータの宣言の classify … case と、分類そのもの（docs/grammar.md「decorator の宣言」）
namespace removedCaseKind {
  decorator a for classify case;                     // ERROR: SYNTAX
  decorator b for classify of never case;            // ERROR: SYNTAX
  decorator c(x: any classify Actor case) for op;    // ERROR: SYNTAX
  decorator d for classify;                          // ERROR: SYNTAX
}

// 頭に fn のない関数の宣言と、op fn（docs/grammar.md「関数の宣言」）
namespace removedFnHead {
  model M { id: string; }
  state rows: list<M>;
  op oldOp(m: M): M;                             // ERROR: SYNTAX
  export op oldExported(m: M): M;                // ERROR: SYNTAX
  read oldRead(): M[] reads rows;                // ERROR: SYNTAX
  effect oldEffect(m: M): effects rows.post;     // ERROR: SYNTAX
  op fn both(m: M): M;                           // ERROR: SYNTAX
  fn leaf(m: M): M;
  read fn all(): M[] reads rows;
  effect fn add(m: M): effects rows.post;
  fn ok(m: M): M[] {
    val x = leaf(m);
    add(x);
    return all();
  }
}

// 関数の末尾（docs/grammar.md「関数の宣言」「exception / effect / read」）: 節の前の「:」、on、状態の遷移の「:」
namespace removedFnTail {
  model M { id: string; }
  state rows: list<M>;
  exception E;
  classify K of M { A; B; }
  // 「)」の後ろに、戻り値か節を書くなら、「:」で始める
  fn noColon(m: M) throws E;                     // ERROR: SYNTAX
  fn noColonBody(m: M) throws E {                // ERROR: SYNTAX
    return match (m by K) { A => throw E; B => m; };
  }
  // 「:」の後ろに、何もない
  fn emptyType(m: M):;                           // ERROR: SYNTAX
  fn emptyTypeBody(m: M): { leaf(m); }           // ERROR: SYNTAX
  // read と効果の、状態との関係は、reads と effects で書く（on は、なくした書き方）
  read fn oldOn(): M[] on rows;                  // ERROR: SYNTAX
  effect fn oldOnEffect(m: M) on rows.post;      // ERROR: SYNTAX
  effect fn noColonEffect(m: M) effects rows.post;   // ERROR: SYNTAX
  read fn noColonRead() reads rows;              // ERROR: SYNTAX
  // デコレータの宣言の、付ける先の並びの区切りは「,」（「|」は、なくした書き方）
  decorator oldTargets for model | state;        // ERROR: SYNTAX
  decorator targets for model, state;
  // 状態の遷移は、as で書く（宛先の後ろの「:」は、なくした書き方）
  effect fn oldTransition(): effects rows: HasItems -> Empty;   // ERROR: SYNTAX
  // キーが決まっていない構造は、インデックスの model で書く（Record<K, V> は、なくした書き方）
  model OldRecord { attrs: Record<string, M>; }  // ERROR: SYNTAX
  model ByName { [name: string]: M; }
  model NewIndex { attrs: ByName; }
  fn leaf(m: M);
  read fn all(): M[] reads rows;
  effect fn add(m: M): effects rows.post;
  effect fn clear(): effects rows as HasItems -> Empty;
  fn ok(m: M): M[] throws E {
    val x = match (m by K) { A => throw E; B => m; };
    add(x);
    clear();
    return all();
  }
}
