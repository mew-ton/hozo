// SYNTAX（docs/grammar.md「識別子」「decorator の宣言」）: デコレータを指す名前で予約語を書けるのは、最後の要素だけ。
// 残りの引数は最後に一つだけで、型は渡す値一つの型（? も [] も付けない）。op の引数には書けない。
// reads と effects の節の区切りは ","（"|" は、なくした書き方。docs/grammar.md「op」）
namespace a {
  state rows: list<string>;
  effect fn add(): effects rows.post;
  decorator fn ok(...targets: any effect): effects targets;
  decorator fn notLast(...xs: any effect, y: string);                 // ERROR: SYNTAX
  decorator fn twoRests(...xs: any effect, ...ys: any state);         // ERROR: SYNTAX
  decorator fn optionalRest(...xs: any effect?);                      // ERROR: SYNTAX
  decorator fn optionalRest2(...xs: string?);                         // ERROR: SYNTAX
  decorator fn arrayRest(...xs: string[]);                            // ERROR: SYNTAX
  decorator fn keywordParam(...to: string);                           // ERROR: SYNTAX
  decorator fn readsPipe(a: any state, b: any state): reads a | b;     // ERROR: SYNTAX
  decorator fn effectsPipe(a: any effect, b: any effect): effects a | b;   // ERROR: SYNTAX
  decorator fn noElement(): reads;                                       // ERROR: SYNTAX
  decorator a.qualified;                                           // ERROR: SYNTAX
  decorator badTarget for namespace;                               // ERROR: SYNTAX
  fn rest(...xs: string);                                          // ERROR: SYNTAX
  @a.op.x                                                          // ERROR: SYNTAX
  fn middle();
  @ok(add)
  fn good(x: string);
}
