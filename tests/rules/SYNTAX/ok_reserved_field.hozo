// 予約語はフィールド名を書く位置では使える（docs/grammar.md「識別子」の FieldName / Path、「予約語」、「決めたこと」）:
// model のフィールド、その場で書く model、override の後ろの名前、レコードリテラルのキー、値のパスの二つ目以降。
// `{ "op": "foo" }` のようなオブジェクトを返す API を書けるようにするため
namespace a {
  model Target {
    model: string;
    namespace: string?;
  }
  /** デコレータの適用 */
  model Wrap {
    op: string;
    decorator: string;
    state: Target;
    match: int;
    /** 型の位置の予約語と同じ名前でもよい */
    string: string;
    list: string[];
    default: boolean;
    true: boolean?;
  }
  // override の後ろの名前
  model Slim extends Wrap {
    override decorator: never;
    override match: never;
    override default: never;
    override true: never;
  }

  // その場で書く model（ユニオンのアーム、例外の値）
  union Page {
    Ready: { state: string; op: string; };
    Failed: Slim;
  }
  exception Rejected: { by: string; none: string?; };

  classify Kind of Target {
    Core;
    default;
  }

  op fetch(): Wrap;
  op store(w: Wrap): Wrap throws Rejected;
  op label(target: Target, text: string): string;
  op describe(target: Target): string;
  op show(w: Slim): Page;
  // 継承した model は別の型なので、写す op を通す
  op slim(w: Wrap): Slim;

  // 値のパス（res.op、res.state.model）、レコードリテラルのキー、match の対象
  op run(): Page throws Rejected {
    const res = fetch();
    const name = label(res.state, res.op);
    const kind = match res.state by Kind {
      Core => describe(res.state);
      default => none;
    };
    const saved = store({
      op: name,
      decorator: res.decorator,
      state: { model: res.state.model, namespace: kind },
      match: res.match,
      string: res.string,
      list: res.list,
      default: true,
      true: none,
    });
    const slimmed = slim(saved);
    return show(slimmed);
  }
}
