// 予約語はフィールド名を書く位置では使える（docs/grammar.md「識別子」の FieldName / Path、「予約語」、「決めたこと」）:
// model のフィールド、その場で書く model、override の後ろの名前、レコードリテラルのキー、値のパスの二つ目以降。
// `{ "op": "foo" }` のようなオブジェクトを返す API を書けるようにするため
namespace a {
  model Target {
    model: string;
    namespace: string?;
  }
  /** デコレータの適用 */
  model Wrap {
    op: string;
    decorator: string;
    state: Target;
    match: int;
    /** 型の位置の予約語と同じ名前でもよい */
    string: string;
    list: string[];
    default: boolean;
    true: boolean?;
  }
  // override の後ろの名前
  model Slim extends Wrap {
    override decorator: never;
    override match: never;
    override default: never;
    override true: never;
  }

  // その場で書く model（ユニオンのアーム）。例外の引数の名前は Ident なので、予約語は書けない
  union Page {
    Ready: { state: string; op: string; };
    Failed: Slim;
  }
  exception Rejected(reason: string, detail: string?);

  classify Kind of Target {
    Core;
    Other;
  }

  fn fetch(): Wrap;
  fn store(w: Wrap): Wrap throws Rejected;
  fn label(target: Target, text: string): string;
  fn describe(target: Target): string;
  fn show(w: Slim): Page;
  // 継承した model は別の型なので、写す op を通す
  fn slim(w: Wrap): Slim;

  // 値のパス（res.op、res.state.model）、レコードリテラルのキー、match の対象
  fn run(): Page throws Rejected {
    val res = fetch();
    val name = label(res.state, res.op);
    val kind = match (res.state by Kind) {
      Core => describe(res.state);
      else    => none;
    };
    val saved = store({
      op: name,
      decorator: res.decorator,
      state: { model: res.state.model, namespace: kind },
      match: res.match,
      string: res.string,
      list: res.list,
      default: true,
      true: none,
    });
    val slimmed = slim(saved);
    return show(slimmed);
  }
}
