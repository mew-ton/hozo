// 予約語を書けるのはフィールド名の位置だけ（docs/grammar.md「予約語」）。宣言の名前、引数の名前、束縛の名前、
// 名前空間や型の名前の要素、呼び出す op の名前には書けない。値を省いたレコードのキー（{ op }）は同じ名前の束縛か
// 引数を指すので、予約語は書けない。誤りのある宣言は捨てられ、残りの宣言は検査される
namespace a {
  model Wrap { op: string; state: string; }
  model match { id: string; }                          // ERROR: SYNTAX
  fn state(): Wrap;                                    // ERROR: SYNTAX
  fn byParam(op: string): Wrap;                        // ERROR: SYNTAX
  fn byType(w: a.model): Wrap;                         // ERROR: SYNTAX
  decorator fn mark(to: string);                          // ERROR: SYNTAX
  fn fetch(): Wrap;
  fn store(w: Wrap): Wrap;
  fn run(): Wrap {
    val res = fetch();
    val model = fetch();                             // ERROR: SYNTAX
    val called = res.op();                           // ERROR: SYNTAX
    val short = store({ op, state: res.state });     // ERROR: SYNTAX
    return store({ op: res.op, state: res.state });
  }
}
namespace a.namespace {                                // ERROR: SYNTAX
  fn f();
}
