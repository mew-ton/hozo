// SYNTAX（docs/grammar.md）: export、reads、extends / override、as、throw、never、形の語を型の位置に書く。
// is と omit は予約語ではないので、名前に使える
namespace a {
  scalar Email extends string;
  model User { id: string; email: string; hash: string; override: string; }
  model PublicUser extends User {
    override hash: never;
    override email: Email;
    override override: never;
    nick: nullable<string>;
    tags: list<string>;
    one: single<Email>;
  }
  exception Gone;
  state users: list<User>;
  state omit: string;
  read byId(is: string): User? on users;
  export op find(is: string): User? reads users { return byId(is); }
  op gone(): never throws Gone;
  op nameOf(u: User): string;
  classify Found of find { Hit: find as User; Other: find as else; }
  op name(is: string): string throws Gone {
    val u = find(is);
    return match (u by a.Found) {
      Hit     => nameOf(u);
      else    => throw Gone;
    };
  }
  op title(): string {
    return omit;
  }
}
