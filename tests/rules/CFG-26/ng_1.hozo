// CFG-26（docs/config.md「解釈するトランスパイラ」）: 本体のない、@hint でないデコレータが、単位の対象の宣言に付いているが、
// 設定のどのトランスパイラも解釈しない（warning。付いた位置）。宣言、model のフィールド、分類のケースを見る
namespace a {
  decorator fn wrap();
  decorator mark for field, state;
  decorator tag for case of never;
  /** 本体のあるデコレータには、出さない */
  decorator fn logged() { proceed(); }
  /** @hint のデコレータには、出さない */
  @hint
  decorator note for op, field;

  model M {
    @mark                              // WARN: CFG-26
    @note
    id: string;
  }

  classify Role of never {
    @tag                               // WARN: CFG-26
    Admin;
    Member;
  }

  @wrap                                // WARN: CFG-26
  @logged
  @note
  fn f(): M;
}
