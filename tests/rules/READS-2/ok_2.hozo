// READS-2（docs/check.md「reads」「デコレータが運ぶ reads と effects」）: reads の節を持つデコレータは、配線の op にも付けられる。
// 運ばれた状態は、本体が行き着く状態と合わせて、その配線が読む状態になり、呼び出し元へ伝わる。配線は reads を書かなくて
// よく、書くなら、運ばれた状態も書く
namespace a {
  state rows: list<string>;
  state log: list<string>;
  state token: nullable<string>;
  read fn first(): string? reads rows;
  decorator counting(table: any state) for op reads table;
  decorator peeking for op reads first, token;
  fn g();
  // 節を書かない配線: 運ばれた log は、本体の rows の後ろで、読む状態に入る
  @counting(log)
  fn omitted(): string? {
    return first();
  }
  // 節を書いた配線: 本体が行き着く rows と、運ばれた log の両方を書く（順序は問わない）
  @counting(log)
  fn written(): string? reads log, rows {
    return first();
  }
  // 本体が状態を読まない配線: 読む状態は、運ばれたものだけ（read の名前で運ばれたものは、その宛先の状態）
  @peeking
  fn carriedOnly(): reads rows, token {
    g();
  }
  // 本体も読む状態を運んでも、同じ状態一つ
  @counting(rows)
  fn same(): string? reads rows {
    return first();
  }
  // 呼び出し元へ伝わる: 節を書かない配線が運ばれた状態も、呼ぶ側の読む状態に入る
  fn caller(): string? reads rows, log {
    return omitted();
  }
  fn callerOmitted(): string? {
    return omitted();
  }
}
namespace b {
  // 別の名前空間の配線にも伝わる
  export fn across(): string? reads a.rows, a.log {
    return a.written2();
  }
}
namespace a {
  @counting(log)
  export fn written2(): string? {
    return first();
  }
}
