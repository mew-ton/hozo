// READS-2（docs/check.md「状態と効果」「reads」）: 配線の op に書いた reads が、本体から計算した読む状態と集合として等しくない。
// 位置は op
namespace a {
  state users: list<string>;
  state token: nullable<string>;
  read fn byName(name: string): string? reads users;
  fn find(name: string): string? reads users { return byName(name); }
  fn pure(name: string): string;
  fn show(t: string?);
  // 足りない
  fn missing(name: string): string? reads token {    // ERROR: READS-2
    show(token);
    return find(name);
  }
  // 余分
  fn extra(name: string): string? reads users, token {   // ERROR: READS-2
    return find(name);
  }
  // 読まないのに書いた
  fn none1(name: string): string reads users {       // ERROR: READS-2
    return pure(name);
  }
}
