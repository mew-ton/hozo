// READS-2（docs/check.md「reads」）: 配線の op は reads を書かなくてよい。書いた場合は、計算と集合として等しいこと
// （順序は問わない）。read の名前で書いても、その宛先の状態として数える。別の名前空間の状態（と read）も書ける
namespace a {
  scalar Token extends string;
  state token: nullable<Token>;
  state rows: list<string>;
  bind token to a.*;
  classify Phase of rows { Idle; Busy; }
  fn take(t: Token?): string;
  read fn rowByName(name: string): string? on rows;
  fn find(name: string): string? reads rowByName { return rowByName(name); }
  fn g();
  fn omitted(name: string): string? {
    return find(name);
  }
  fn written(name: string): string? reads rows {
    return find(name);
  }
  fn byName(): Token? reads token {
    return token;
  }
  fn bySubject() reads rows {
    match (rows by list) { Empty => g(); HasItems => none; };
  }
  fn byClassify() reads a.rows {
    match (by Phase) { Idle => g(); Busy => none; };
  }
  fn byBind(): string reads token {
    return take();
  }
  // 状態を名前で渡した位置は明示で、bind は埋めないが、読むことに変わりはない
  fn explicit(): string reads token {
    return take(token);
  }
  // read の名前と、その状態の名前の両方を書いても、同じ状態一つ
  fn both(name: string): string? reads rowByName, rows {
    return rowByName(name);
  }
  fn across(name: string): string[] reads b.items, rows {
    val x = find(name);
    g2(x);
    return b.all();
  }
  fn g2(x: string?);
}
namespace b {
  state items: list<string>;
  export fn all(): string[] reads items { return items; }
}
