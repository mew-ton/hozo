// MATCH-2（docs/check.md「classify / match」）: 組み込みの分類に default はない
namespace a {
  state carts: list<string>;
  state token: nullable<string>;
  op f();
  op ng() {
    match carts by list {              // ERROR: MATCH-2
      Empty => f();
      default => none;
    };
    match token by nullable {          // ERROR: MATCH-2
      Empty => f();
      HasItems => none;
      default => none;
    };
  }
}
