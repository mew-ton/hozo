// MATCH-2（docs/check.md「classify / match」）: 状態の分類での match も、ケースの集合が分類のケースと等しいこと
namespace a {
  state carts: list<string>;
  state orders: list<string>;
  state token: nullable<string>;
  classify Checkout of carts, orders { Shopping; Ordered; }
  classify Session of token { LoggedIn; default; }
  op f();
  op ng() {
    match by Checkout {                // ERROR: MATCH-2
      Shopping => f();
    };
    // 状態の分類のケースに、組み込みの分類のケースは混ざらない
    match by Checkout {                // ERROR: MATCH-2
      Shopping => f();
      Ordered => none;
      Empty => none;
    };
    match by Session {                 // ERROR: MATCH-2
      LoggedIn => f();
    };
  }
}
