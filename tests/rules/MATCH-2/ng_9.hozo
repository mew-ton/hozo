// MATCH-2（docs/check.md「標準の分類」）: 値を対象にした標準の分類でも、その形のケースを尽くす（list に、nullable のケースの名前を書くのも、知らない名前）
namespace a {
  model In { token: string?; lines: string[]; }
  fn f();
  fn ng(in: In) {
    match (in.token by nullable) { Some => f(); };                 // ERROR: MATCH-2
    match (in.lines by list) { Empty => f(); Some => none; };          // ERROR: MATCH-2
  }
}
