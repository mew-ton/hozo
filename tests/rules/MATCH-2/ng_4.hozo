// MATCH-2（docs/check.md「classify / match」）: hasDefault が false なのに default のアームがある
namespace a {
  model M { id: string; }
  classify C of M { A; B; }
  op use(m: M): void;
  op noDefault(m: M): void {
    match m by C {                     // ERROR: MATCH-2
      A | B => use(m);
      default => none;
    };
  }
}
