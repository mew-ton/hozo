// MATCH-2（docs/check.md「アームが受けるケース」）: else のアームがあっても、名前で並べたケースは、その分類のケースで、
// 一つの match に一度だけ（else のアームが消すのは「足りない」だけ）
namespace a {
  model M { id: string; }
  classify D of M { A; B; C; D; E; }
  op use(m: M): void;
  op unknownWithElse(m: M): void {
    match (m by D) {                     // ERROR: MATCH-2
      A, Z => use(m);
      else => none;
    };
    match (m by D) {                     // ERROR: MATCH-2
      A => use(m);
      B, A => none;
      else => none;
    };
  }
}
