// MATCH-2（docs/check.md「classify / match」）: ケースが足りない。internal/sema/testdata/rules/MATCH-2.hozo から
namespace a {
  model M { id: string; }
  classify C of M { A; B; }
  op use(m: M): void;
  op missing(m: M): void {
    match (m by C) {                     // ERROR: MATCH-2
      A => use(m);
    };
  }
}
