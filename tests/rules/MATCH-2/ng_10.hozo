// MATCH-2（docs/check.md「classify / match」「残りのケース」）: 残りのケース（as else）も、ほかのケースと同じに、アームが受ける。
// 名前で並べず、else のアームもなければ、足りない
namespace a {
  model M { id: string; }
  fn find(): M?;
  classify Hit of find { Found: find as M; Missing: find as else; }
  fn use(m: M);
  fn ng() {
    val m = find();
    match (m by Hit) {                   // ERROR: MATCH-2
      Found => use(m);
    };
  }
}
