// DOC-1（docs/check.md「名前空間」）: @param / @throws / @see が存在する名前を指す。配線が伝播させる例外も @throws に書ける
namespace a {
  model M { id: string; }
  exception E;
  /**
   * 葉。
   *
   * @param m 入力
   * @throws E 失敗
   * @see wiring
   */
  op leaf(m: M): M throws E;
  /**
   * 配線。E は leaf から伝播する。
   *
   * @throws E leaf の失敗
   */
  op wiring(m: M): M throws E {
    return leaf(m);
  }
}
