// DEC-20: どの道も、next() を、ちょうど一度呼ぶか、例外を投げる
namespace a {
  exception Denied;
  model Ticket { ok: boolean; }
  fn ticket(): Ticket;
  classify Gate of Ticket { Open; Closed; }
  decorator fn guarded(next: fn) {
    val t = ticket();
    match (t by Gate) {
      Open   => next();
      Closed => throw Denied;
    }
  }
  @guarded
  fn f();
}
