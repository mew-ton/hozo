// DEC-20 に当たらない: try の文は、try のブロックの中の回数で数える（next() は、try のブロックの最初の文）
namespace a {
  fn note();
  decorator fn noted(next: fn) {
    try {
      next();
      note();
    } catch (e) {
      note();
      throw e;
    }
  }
  decorator fn quiet(next: fn) {
    try {
      next();
    } catch (e) {
    }
  }
  fn f();
}
