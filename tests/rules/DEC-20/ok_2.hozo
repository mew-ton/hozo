// DEC-20 に当たらない: try の文は、try のブロックの中の回数で数える（proceed() は、try のブロックの最初の文）
namespace a {
  fn note();
  decorator fn noted() {
    try {
      proceed();
      note();
    } catch (e) {
      note();
      throw e;
    }
  }
  decorator fn quiet() {
    try {
      proceed();
    } catch (e) {
    }
  }
  fn f();
}
