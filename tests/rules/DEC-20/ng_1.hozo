// DEC-20（docs/check.md「デコレータ」）: デコレータの本体に、next() を、ちょうど一度呼ばずに終わる道がある
namespace a {
  exception Denied;
  model Ticket { ok: boolean; }
  fn ticket(): Ticket;
  classify Gate of Ticket { Open; Closed; }
  fn record();
  decorator fn never(next: fn) {                   // ERROR: DEC-20
    record();
  }
  decorator fn twice(next: fn) {                   // ERROR: DEC-20
    next();
    next();
  }
  decorator fn sometimes(next: fn) {               // ERROR: DEC-20
    val t = ticket();
    match (t by Gate) {
      Open   => next();
      Closed => record();
    }
  }
  fn f();
}
