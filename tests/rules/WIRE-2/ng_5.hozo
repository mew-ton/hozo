// WIRE-2（docs/check.md「配線」「配線からの呼び出し」）: read の呼び出しは値を持つので、束縛せずには書けない。効果の呼び出しは
// 値を持たないので、束縛も return もできない
namespace a {
  model M { id: string; }
  state rows: list<M>;
  read fn byId(id: string): M? reads rows;
  effect fn add(m: M): effects rows.post;
  fn f(m: M): M? {
    byId(m.id);                          // ERROR: WIRE-2
    val done = add(m);                 // ERROR: WIRE-2 // WARN: WIRE-8
    val done2 = rows.post(m);          // ERROR: WIRE-2 // WARN: WIRE-8
    return add(m);                       // ERROR: WIRE-2
  }
}
