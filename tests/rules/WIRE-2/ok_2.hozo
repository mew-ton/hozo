// WIRE-2（docs/check.md「配線」）: 「返らない」式は、文（本体の最後）か return に書ける。返らないアームと値のないアームだけの
// match は、文として書ける
namespace a {
  model M { id: string; }
  exception E;
  classify C of M { A; B; }
  fn fail(): never throws E;
  fn log(m: M): void;
  fn f(m: M): void throws E {
    match (m by C) { A => throw E; B => log(m); };
    match (m by C) { A => none; B => fail(); };
    fail();
  }
  fn g(): M throws E {
    return fail();
  }
}
