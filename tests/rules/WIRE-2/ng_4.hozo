// WIRE-2（docs/check.md「配線」）: 「返らない」式は束縛できない。値のあるアーム（値そのもの）を持つ match を文に書けない
namespace a {
  model M { id: string; }
  exception E;
  classify C of M { A; B; }
  op fail(): never throws E;
  op use(m: M): void;
  op f(m: M): void throws E {
    const x = fail();                  // ERROR: WIRE-2
    use(x);
  }
  op g(m: M): void throws E {
    const y = match m by C { A => throw E; B => fail(); };   // ERROR: WIRE-2
    use(y);
  }
  op h(m: M): void {
    match m by C { A => m; B => none; };                     // ERROR: WIRE-2
  }
}
