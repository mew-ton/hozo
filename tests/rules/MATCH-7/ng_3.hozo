// MATCH-7（docs/check.md「classify / match」）: by list / by nullable の対象が、その形の状態でない
namespace a {
  state carts: list<string>;
  state token: nullable<string>;
  state title: single<string>;
  fn f();
  fn ng() {
    match (carts by nullable) { Empty => f(); HasItems => none; };     // ERROR: MATCH-7
    match (token by list) { Empty => f(); HasItems => none; };         // ERROR: MATCH-7
    // single には組み込みの分類がない
    match (title by list) { Empty => f(); HasItems => none; };         // ERROR: MATCH-7
    match (title by nullable) { Empty => f(); HasItems => none; };     // ERROR: MATCH-7
  }
}
