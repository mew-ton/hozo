// MATCH-7（docs/check.md「標準の分類」）: by list / by nullable の対象は値。状態に限らない（引数のフィールド、束縛）
namespace a {
  model M { id: string; }
  model In { token: string?; lines: M[]; }
  state maybe: M?;
  fn f();
  fn find(): M?;
  fn all(): M[];
  fn ok(in: In) {
    match (in.token by nullable) { None => f(); Some => none; };
    match (in.lines by list) { Empty => f(); HasItems => none; };
    val m = find();
    match (m by nullable) { None => f(); Some => none; };
    val ms = all();
    match (ms by list) { Empty, HasItems => f(); };
    // 状態は、名前で書けば値になる。T? と書いた状態も nullable
    match (maybe by nullable) { None => f(); Some => none; };
  }
}
