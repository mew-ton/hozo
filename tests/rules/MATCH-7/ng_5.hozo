// MATCH-7（docs/check.md「classify / match」）: 標準の分類の対象は値で、状態に限らないが、型は合っていなければならない
namespace a {
  model M { id: string; }
  model In { token: string?; lines: M[]; name: string; }
  state token: nullable<string>;
  state title: single<string>;
  fn f();
  fn ng(in: In) {
    match (in.token by list) { Empty => f(); HasItems => none; };      // ERROR: MATCH-7
    match (in.lines by nullable) { Empty => f(); HasItems => none; };  // ERROR: MATCH-7
    match (in.name by nullable) { Empty => f(); HasItems => none; };   // ERROR: MATCH-7
    match (token by list) { Empty => f(); HasItems => none; };         // ERROR: MATCH-7
    match (title by nullable) { Empty => f(); HasItems => none; };     // ERROR: MATCH-7
  }
}
