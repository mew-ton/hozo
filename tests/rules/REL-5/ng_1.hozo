// REL-5（docs/check.md「throws」）: 一つの ThrowsClause に prevents と keeps の両方がある。internal/sema/testdata/rules/REL-5.hozo から
namespace a {
  state s: list<string>;
  effect e on s.post;
  exception E;
  exception F;
  op a1() effects e throws E prevents effects keeps effects;     // ERROR: REL-5
  op a2() effects e throws E | F keeps effects prevents effects; // ERROR: REL-5
}
