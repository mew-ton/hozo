// REL-5（docs/check.md「throws」）: 節ごとに prevents か keeps のどちらか一つ。節が違えば例外ごとに書き分けられる
namespace a {
  state s: list<string>;
  effect fn e(): effects s.post;
  exception E;
  exception F;
  decorator fn doing(...targets: any effect): effects targets;
  @doing(e) fn ok(): throws E keeps effects;
  @doing(e) fn split(): throws E prevents effects throws F keeps effects;
}
