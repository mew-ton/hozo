// TYPE-18: 効果が、void のほかを返す。read が、戻り値を省く、void か never を返す
namespace a {
  model M { id: string; }
  state rows: list<M>;
  effect fn add(m: M): M effects rows.post;      // ERROR: TYPE-18
  effect fn drop(m: M): never effects rows.post; // ERROR: TYPE-18
  read fn noResult(): reads rows;                    // ERROR: TYPE-18
  read fn voidResult(): void reads rows;            // ERROR: TYPE-18
  read fn neverResult(): never reads rows;          // ERROR: TYPE-18
}
