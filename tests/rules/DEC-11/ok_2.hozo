// DEC-11（docs/types.md「デコレータの引数」、docs/grammar.md「デコレータの適用」）: 宣言が残りの引数を持てば、ほかの Param の
// 数を超えて位置で渡した値は、書いた順に、残りの引数の値になる。0 個でもよい。名前付きのデコレータの固定した引数も同じ
namespace a {
  state s: list<string>;
  state t: nullable<string>;
  effect fn e1(): effects s.post;
  effect fn e2(): effects t.put;
  union Both { e1; e2; }
  decorator all(...targets: any effect) for op effects targets;
  decorator some(first: int, second: string?, ...more: string | int);
  @all
  fn rest0();
  @all()
  fn rest0b();
  @all(e1)
  fn rest1(x: string);
  @all(e1, e2)
  fn rest2(x: string, y: string);
  @all(e1 | e2, Both)
  fn restSets(x: string);
  @some(1, "s", "a", 2, "c")
  fn restAfterFixed();
  @some(1)
  fn restAfterFixed0();
  @some(second: "t", first: 1)
  fn restNone();
  decorator fixed = some(1, "s", "a", "b");
  decorator fixedAll = all(e1, e2);
  @fixed
  fn restAlias();
  @fixedAll
  fn restAlias2(x: string, y: string);
}
