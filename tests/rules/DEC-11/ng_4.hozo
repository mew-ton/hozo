// DEC-11（docs/types.md「デコレータの引数」）: 残りの引数には、名前では渡せない。残りの引数のほかの必須の Param は要る。
// 残りの引数のほかの Param に二度渡せない
namespace a {
  state s: list<string>;
  effect fn e1(): effects s.post;
  decorator all(...targets: any effect) for op effects targets;
  decorator some(first: int, second: string?, ...more: string);
  @all(targets: e1)                    // ERROR: DEC-11
  fn restNamed(x: string);
  @some                                // ERROR: DEC-11
  fn restMissingFixed();
  @some(1, "s", more: "a")             // ERROR: DEC-11
  fn restNamed2();
  @some(1, "s", "a", second: "t")      // ERROR: DEC-11
  fn restTwice();
}
