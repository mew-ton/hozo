// サンプル shop-server の仕様（README.md）。DB の状態を持つ名前空間 store。
// 状態に触れるのは、read（読む）と効果（書く）だけ。どちらも本体を持たず、中身は、付けた db の語彙のデコレータから go-sqlite が出す
// （docs/plugin-go-sqlite.md「read の中身」「効果の中身」）。表は、read なら reads の状態、効果なら宛先（effects の後ろ）の状態で、列は、引数の名前。
// read と効果を呼べるのは、この名前空間の中だけ。ほかの名前空間は、ここの op（どれも、read か効果を呼ぶだけの配線）を通して読み書きする。
// 十の op はどれも export（P33）: 九つは server が呼び、addUser は人が書くコード（起動とテスト）が呼ぶ。
// 単位 gen/store では go-sqlite が read と効果の中身を出し、単位 gen/storemem では人が書く。
// createUser は、例外を投げる効果（docs/check.md「read と効果」）: 表の一意の制約に当たったら、type.EmailTaken（@db.conflict）。

/** 保存。DB の状態の持ち主 */
namespace store {
  @db.table
  state users: list<type.User>;

  @db.table
  state sessions: list<type.Session>;

  @db.table
  state orders: list<type.Order>;

  @db.table
  state notifications: list<type.Notification>;

  // ---- 読む: read は、表から何を引くかを言う。引数の名前が、比べる列 ----

  /** email が同じユーザー */
  @db.find
  read fn userByEmail(email: type.Email): type.User? reads users;

  /** 識別子が同じユーザー */
  @db.find
  read fn userById(id: type.UserId): type.User? reads users;

  /** トークンが同じセッション */
  @db.find
  read fn sessionByToken(token: type.Token): type.Session? reads sessions;

  /** そのユーザーの注文。足した順 */
  @db.list
  read fn ordersOfUser(userId: type.UserId): type.Order[] reads orders;

  /** そのユーザーの、いちばん新しい注文。まだ注文がなければ、ない */
  @db.find
  @db.latest("placedAt")
  read fn latestOrderOf(userId: type.UserId): type.Order? reads orders;

  // ---- 書く: 効果は、表に何をするかを言う ----

  /** ユーザーを登録する。同じ email（か、同じ識別子）のユーザーが、もういれば、投げる */
  @db.insert @db.conflict(type.EmailTaken)
  effect fn createUser(user: type.User): throws type.EmailTaken effects users.post;

  /** ログインセッションを作る */
  @db.insert
  effect fn createSession(session: type.Session): effects sessions.post;

  /** ログインセッションを消す */
  @db.delete
  effect fn deleteSession(token: type.Token): effects sessions.delete;

  /** 注文を作る */
  @db.insert
  effect fn createOrder(order: type.Order): effects orders.post;

  /** ユーザーへの通知を記録する */
  @db.insert
  effect fn notifyUser(notification: type.Notification): effects notifications.post;

  // ---- ほかの名前空間が呼ぶ op: read か効果を呼ぶだけの配線 ----

  /** email からユーザーを引く */
  export fn findUser(email: type.Email): type.User? {
    return userByEmail(email);
  }

  /** 識別子からユーザーを引く */
  export fn findUserById(id: type.UserId): type.User? {
    return userById(id);
  }

  /** トークンからセッションを引く */
  export fn findSession(token: type.Token): type.Session? {
    return sessionByToken(token);
  }

  /** ユーザーの注文を、足した順に返す */
  export fn listOrders(userId: type.UserId): type.Order[] {
    return ordersOfUser(userId);
  }

  /** ユーザーの、いちばん新しい注文を返す。まだ注文がなければ、値がない */
  export fn latestOrder(userId: type.UserId): type.Order? {
    return latestOrderOf(userId);
  }

  /** ユーザーを足す */
  export fn addUser(user: type.User): throws type.EmailTaken {
    createUser(user);
  }

  /** セッションを足す */
  export fn addSession(session: type.Session) {
    createSession(session);
  }

  /** そのトークンのセッションを消す */
  export fn removeSession(token: type.Token) {
    deleteSession(token);
  }

  /** 注文と、その通知の記録を、一緒に足す。どちらも足すか、どちらも足さない */
  @db.transaction
  export fn placeOrder(order: type.Order, notification: type.Notification) {
    createOrder(order);
    notifyUser(notification);
  }

  /** 通知の記録を、一つ足す */
  export fn recordNotice(notification: type.Notification) {
    notifyUser(notification);
  }

  // ---- 読んだ結果の分類 ----

  /** その email が登録済みか */
  classify Registration of findUser {
    Registered:   findUser as type.User;
    Unregistered: findUser as else;
  }

  /** その識別子のユーザーがいるか */
  classify Account of findUserById {
    Found:   findUserById as type.User;
    Missing: findUserById as else;
  }

  /** そのトークンでログインしているか */
  classify Login of findSession {
    LoggedIn:  findSession as type.Session;
    LoggedOut: findSession as else;
  }
}
