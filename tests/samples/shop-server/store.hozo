// サンプル shop-server の仕様（README.md）。DB の状態を持つ名前空間 store。
// 状態に触れるのは、read（読む）と効果（書く）だけ。どちらも本体を持たず、中身は、付けた db の語彙のデコレータから go-sqlite が出す
// （docs/plugin-go-sqlite.md「read の中身」「効果の中身」）。表は、宣言の on の状態で、列は、引数の名前。
// read と効果を呼べるのは、この名前空間の中だけ。ほかの名前空間は、ここの op（どれも、read か効果を呼ぶだけの配線）を通して読み書きする。
// 九つの op はどれも export（P33）: 八つは server が呼び、addUser は人が書くコード（起動とテスト）が呼ぶ。
// 単位 gen/store では go-sqlite が read と効果の中身を出し、単位 gen/storemem では人が書く。

/** 保存。DB の状態の持ち主 */
namespace store {
  @db.table
  state users: list<type.User>;

  @db.table
  state sessions: list<type.Session>;

  @db.table
  state orders: list<type.Order>;

  @db.table
  state notifications: list<type.Notification>;

  // ---- 読む: read は、表から何を引くかを言う。引数の名前が、比べる列 ----

  /** email が同じユーザー */
  @db.find
  read userByEmail(email: type.Email): type.User? on users;

  /** 識別子が同じユーザー */
  @db.find
  read userById(id: type.UserId): type.User? on users;

  /** トークンが同じセッション */
  @db.find
  read sessionByToken(token: type.Token): type.Session? on sessions;

  /** そのユーザーの注文。足した順 */
  @db.list
  read ordersOfUser(userId: type.UserId): type.Order[] on orders;

  /** そのユーザーの、いちばん新しい注文。まだ注文がなければ、ない */
  @db.find
  @db.latest("placedAt")
  read latestOrderOf(userId: type.UserId): type.Order? on orders;

  // ---- 書く: 効果は、表に何をするかを言う ----

  /** ユーザーを登録する */
  @db.insert
  effect createUser(user: type.User) on users.post;

  /** ログインセッションを作る */
  @db.insert
  effect createSession(session: type.Session) on sessions.post;

  /** ログインセッションを消す */
  @db.delete
  effect deleteSession(token: type.Token) on sessions.delete;

  /** 注文を作る */
  @db.insert
  effect createOrder(order: type.Order) on orders.post;

  /** ユーザーへの通知を記録する */
  @db.insert
  effect notifyUser(notification: type.Notification) on notifications.post;

  // ---- ほかの名前空間が呼ぶ op: read か効果を呼ぶだけの配線 ----

  /** email からユーザーを引く */
  export op findUser(email: type.Email): type.User? {
    return userByEmail(email);
  }

  /** 識別子からユーザーを引く */
  export op findUserById(id: type.UserId): type.User? {
    return userById(id);
  }

  /** トークンからセッションを引く */
  export op findSession(token: type.Token): type.Session? {
    return sessionByToken(token);
  }

  /** ユーザーの注文を、足した順に返す */
  export op listOrders(userId: type.UserId): type.Order[] {
    return ordersOfUser(userId);
  }

  /** ユーザーの、いちばん新しい注文を返す。まだ注文がなければ、値がない */
  export op latestOrder(userId: type.UserId): type.Order? {
    return latestOrderOf(userId);
  }

  /** ユーザーを足す */
  export op addUser(user: type.User) {
    createUser(user);
  }

  /** セッションを足す */
  export op addSession(session: type.Session) {
    createSession(session);
  }

  /** そのトークンのセッションを消す */
  export op removeSession(token: type.Token) {
    deleteSession(token);
  }

  /** 注文と、その通知の記録を、一緒に足す。どちらも足すか、どちらも足さない */
  @db.transaction
  export op placeOrder(order: type.Order, notification: type.Notification) {
    createOrder(order);
    notifyUser(notification);
  }

  // ---- 読んだ結果の分類 ----

  /** その email が登録済みか */
  classify Registration of findUser {
    Registered:   findUser as type.User;
    Unregistered: findUser as else;
  }

  /** その識別子のユーザーがいるか */
  classify Account of findUserById {
    Found:   findUserById as type.User;
    Missing: findUserById as else;
  }

  /** そのトークンでログインしているか */
  classify Login of findSession {
    LoggedIn:  findSession as type.Session;
    LoggedOut: findSession as else;
  }
}
