// サンプル shop-server の仕様（README.md）。DB の状態を持つ名前空間 store。
// 状態を名前で読めるのはこの名前空間の中だけなので、ほかの名前空間は、ここの op を通して読み書きする。九つの op はどれも export（P33）: 八つは server が呼び、addUser は人が書くコード（起動とテスト）が呼ぶ。
// op の中身は、読む先（reads）と効果から決まる。単位 gen/store では go-sqlite が状態ごとの型として出し、単位 gen/storemem では人が書く。

/** 保存。DB の状態の持ち主 */
namespace store {
  @db
  state users: list<type.User>;

  @db
  state sessions: list<type.Session>;

  @db
  state orders: list<type.Order>;

  @db
  state notifications: list<type.Notification>;

  // ---- 読む（効果を持たない op） ----

  /** email からユーザーを引く */
  export op findUser(email: type.Email): type.User? reads users;

  /** 識別子からユーザーを引く */
  export op findUserById(id: type.UserId): type.User? reads users;

  /** トークンからセッションを引く。トークンがなければ、ない */
  export op findSession(token: type.Token?): type.Session? reads sessions;

  /** ユーザーの注文を、足した順に返す */
  export op listOrders(userId: type.UserId): type.Order[] reads orders;

  // ---- 読んだ結果の分類 ----

  /** その email が登録済みか */
  classify Registration of findUser {
    Registered: findUser as type.User;
    default;
  }

  /** その識別子のユーザーがいるか */
  classify Account of findUserById {
    Found: findUserById as type.User;
    default;
  }

  /** そのトークンでログインしているか */
  classify Login of findSession {
    LoggedIn: findSession as type.Session;
    default;
  }

  // ---- 書く ----

  /** ユーザーを登録する */
  effect createUser on users.post;

  /** ログインセッションを作る */
  effect createSession on sessions.post;

  /** ログインセッションを消す */
  effect deleteSession on sessions.delete;

  /** 注文を作る */
  effect createOrder on orders.post;

  /** ユーザーに通知する */
  effect notifyUser on notifications.post;

  /** ユーザーを足す */
  export op addUser(user: type.User) effects createUser;

  /** セッションを足す */
  export op addSession(session: type.Session) effects createSession;

  /** そのトークンのセッションを消す */
  export op removeSession(token: type.Token) effects deleteSession;

  /** 注文を足す */
  export op addOrder(order: type.Order) effects createOrder;

  /** 通知を足す */
  export op addNotification(notification: type.Notification) effects notifyUser;
}
