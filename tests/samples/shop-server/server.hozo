// サンプル shop-server の仕様（README.md）。HTTP の入口と業務の流れを持つ名前空間 server。
// 保存先には触れない: 読み書きは store の op を、外への配送は mailer の op を呼ぶ。
// 人が書く op（本体のない op）は九つで、どれも状態に触れない。export を付けたのは HTTP の入口の八つだけで、ほかの十二は内部の op（P33）。
// 入力の model のフィールドは、要求のどこから読むかを http の語彙のデコレータで言う（docs/plugin-go-http.md「対象」）: 一つの項目は @http.header / @http.query / @http.body（名前を省けば、フィールドの名前）、本文の全体を一つの model で受け取るなら @http.bodyObj。項目がないときの扱いも、デコレータで言う: @http.required なら 400（PlaceOrderInput の lines）、@http.default(v) なら v（GetOrdersInput の page は 1）、どちらもなければ、零値のまま（省略可能な token は、値がない）。
// トークンのない要求は、store を呼ぶ前に、ここで断る（分類 Credential）: store.findSession は、列と同じ型のトークンだけを受け取る。login には、サンプルの中のプラグインの語彙のデコレータ @rate.limited を付けた（継ぎ目。P38）。

/** サーバー。HTTP の入口と、業務の流れ */
namespace server {
  // ---- 入力と結果 ----

  /** ログインの本文 */
  model Credentials { email: type.Email; password: type.Password; }

  /** ログインの入力 */
  model LoginInput {
    @http.bodyObj body: Credentials;
  }

  /** ログインの結果 */
  model LoginOk { user: type.PublicUser; token: type.Token; }

  /** トークンだけを運ぶ入力 */
  model AuthInput {
    @http.header("Authorization") token: type.Token?;
  }

  /** 注文一覧の入力 */
  model GetOrdersInput {
    @http.header("Authorization") token: type.Token?;
    /** 1 から数えるページ番号 */
    @http.query @http.default(1) page: int;
  }

  /** 注文の入力 */
  model PlaceOrderInput {
    @http.header("Authorization") token: type.Token?;
    @http.required @http.body lines: type.OrderLine[];
  }

  /** 注文の、一行の要約 */
  model OrderSummary { id: type.OrderId; lines: int; }

  /** 自分のページ */
  model MyPage { user: type.PublicUser; latest: type.Order?; summaries: OrderSummary[]; }

  // ---- ログイン ----

  /** ログインする */
  @http.post("/login")
  @rate.limited
  export fn login(in: LoginInput): LoginOk {
    val user = store.findUser(in.body.email);
    return match (user by store.Registration) {
      Registered   => issueSession(user, in.body.password);
      Unregistered => throw type.InvalidCredentials;
    }
  }

  /** パスワードを確かめて、セッションを作る */
  fn issueSession(user: type.User, password: type.Password): LoginOk {
    checkPassword(user, password);
    val session = newSession(user);
    store.addSession(session);
    val publicUser = toPublicUser(user);
    return { user: publicUser, token: session.token };
  }

  /** パスワードが合わなければ InvalidCredentials（人が書く） */
  fn checkPassword(user: type.User, password: type.Password):
    throws type.InvalidCredentials;

  /** トークンと期限を決める（人が書く） */
  fn newSession(user: type.User): type.Session;

  /** ユーザーを、外に見せる形に写す（人が書く） */
  fn toPublicUser(user: type.User): type.PublicUser;

  // ---- 誰が呼んだか ----

  /** 要求がトークンを持ってきたか */
  classify Credential of type.Token? {
    Presented: type.Token? as type.Token;
    Absent:    type.Token? as else;
  }

  /** 呼んだ人のセッション。トークンがなければ、ログインしていなければ、またはセッションの期限が過ぎていれば Unauthorized */
  @prd.ref(design.Requirement.PRD_001)
  fn authenticate(token: type.Token?): type.Session {
    return match (token by Credential) {
      Presented => sessionOf(token);
      Absent    => throw type.Unauthorized;
    }
  }

  /** そのトークンのセッション。ログインしていなければ、またはセッションの期限が過ぎていれば Unauthorized */
  fn sessionOf(token: type.Token): type.Session {
    val session = store.findSession(token);
    return match (session by store.Login) {
      LoggedIn  => requireFresh(session);
      LoggedOut => throw type.Unauthorized;
    }
  }

  /** 期限が過ぎていないセッションを、そのまま返す。過ぎていれば Unauthorized。時計を使う（人が書く） */
  fn requireFresh(session: type.Session): type.Session
    throws type.Unauthorized;

  /** ログアウトする */
  @http.post("/logout")
  @audited
  export fn logout(in: AuthInput) {
    val session = authenticate(in.token);
    store.removeSession(session.token);
  }

  /** 自分の情報を返す */
  @http.get("/me")
  export fn getMe(in: AuthInput): type.PublicUser {
    val session = authenticate(in.token);
    val user = store.findUserById(session.userId);
    return match (user by store.Account) {
      Found   => toPublicUser(user);
      Missing => throw type.Unauthorized;
    }
  }

  // ---- 注文 ----

  /** 自分の注文の一覧を返す */
  @http.get("/orders")
  @prd.ref(design.Requirement.PRD_002)
  export fn getOrders(in: GetOrdersInput): type.Order[] {
    val session = authenticate(in.token);
    val orders = store.listOrders(session.userId);
    return pageOf(orders, in.page);
  }

  /** 一覧から、そのページの分を取り出す（人が書く） */
  fn pageOf(orders: type.Order[], page: int): type.Order[];

  /** 自分のいちばん新しい注文を返す。まだ注文がなければ、値がない */
  @http.get("/orders/latest")
  export fn getLatestOrder(in: AuthInput): type.Order? {
    val session = authenticate(in.token);
    return store.latestOrder(session.userId);
  }

  /** 自分のページ: 自分の情報と、いちばん新しい注文と、注文ごとの要約を、まとめて返す */
  @http.get("/me/page")
  export fn getMyPage(in: AuthInput): MyPage {
    val session = authenticate(in.token);
    val user, latest, orders;
    disjoint {
      {
        val found = store.findUserById(session.userId);
        user = match (found by store.Account) {
          Found   => toPublicUser(found);
          Missing => throw type.Unauthorized;
        }
      }
      latest = store.latestOrder(session.userId);
      orders = store.listOrders(session.userId);
    }
    val summaries: OrderSummary[];
    disjoint for (val order of orders) {
      summaries collect summarize(order);
    }
    return myPage(user, latest, summaries);
  }

  /** 注文を、一行の要約にする（人が書く） */
  fn summarize(order: type.Order): OrderSummary;

  /** 見せる形にまとめる（人が書く） */
  fn myPage(user: type.PublicUser, latest: type.Order?, summaries: OrderSummary[]): MyPage;

  /** 注文する。注文と、その通知の記録は、一緒に残す。通知の配送に失敗しても、どちらも残る */
  @http.post("/orders")
  @prd.ref(design.Requirement.PRD_001, design.Requirement.PRD_002)
  export fn placeOrder(in: PlaceOrderInput): type.Order {
    val session = authenticate(in.token);
    val order = newOrder(session, in.lines);
    val notice = composeNotice(order);
    store.placeOrder(order, notice);
    mailer.send(notice);
    return order;
  }

  /** 識別子と時刻を決めて、注文を作る（人が書く） */
  fn newOrder(session: type.Session, lines: type.OrderLine[]): type.Order;

  /** 通知の文面を作る（人が書く） */
  fn composeNotice(order: type.Order): type.Notification;

  /** 自分の注文の通知を、もう一度、送る。一つ失敗したら、そこで止まり、送れた分の記録は、残る */
  @http.post("/orders/notices")
  export fn resendNotices(in: AuthInput): type.Notification[] {
    val session = authenticate(in.token);
    val orders = store.listOrders(session.userId);
    val sent: type.Notification[];
    for (val order of orders) {
      val notice = composeNotice(order);
      mailer.send(notice);
      store.recordNotice(notice);
      sent collect notice;
    }
    return sent;
  }

  // ---- 本体のあるデコレータ（docs/grammar.md「デコレータの本体」） ----

  /** op の中身が、正常に終わった後に、その op が呼ばれたことを、記録する。中身が例外を投げたら、記録しない */
  decorator fn audited() {
    proceed();
    recordAudit();
  }

  /** 呼ばれたことを、記録する（人が書く。記録の先は、実装が決める） */
  fn recordAudit();
}
