// サンプル shop-server の仕様（README.md）。共有の型の名前空間 type。
// 保存（store.hozo）、サーバー（server.hozo）、配送（mailer.hozo）が同じ型を使う。
// 書き方は docs/decisions.md の P1〜P39 と、「決めたこと」のその後の決定を当てはめた形。まだ実装のない書き方を含む（README.md「まだないもの」）。
// 表の model（store.hozo の @db.table の状態の要素: User、Session、Order、Notification）のフィールドは、しまい方のデコレータ（@db.text、@db.datetime、@db.json）をちょうど一つ持つ（docs/plugin-go-sqlite.md「しまい方」）。どのフィールドも省略可能でないので、どの列も NOT NULL（同「表」）。

/** 共有の型。どの担い手にも属さない */
namespace type {
  // ---- 値の型 ----

  /** ユーザーの識別子 */
  scalar UserId extends string;

  /** メールアドレス */
  @valid.format("email")
  scalar Email extends string;

  /** パスワード（平文。入力でだけ使う） */
  @valid.length(min: 8, max: 128)
  scalar Password extends string;

  /** ログインセッションのトークン */
  scalar Token extends string;

  /** 注文の識別子 */
  scalar OrderId extends string;

  /** 商品の識別子 */
  scalar ItemId extends string;

  // ---- model ----

  /** ユーザー */
  model User {
    @db.key    @db.text id: UserId;
    @db.unique @db.text email: Email;
    @db.text @valid.length(min: 1, max: 100) name: string;
    /** パスワードのハッシュ */
    @db.text hash: string;
  }

  /** 外に見せるユーザー（ハッシュを持たない） */
  model PublicUser extends User {
    override hash: never;
  }

  /** ログインセッション */
  model Session {
    @db.key       @db.text token: Token;
    @db.ref(User) @db.text userId: UserId;
    @db.datetime expiresAt: datetime;
  }

  /** 注文の一行 */
  model OrderLine {
    item: ItemId;
    @valid.min(1) quantity: int;
  }

  /** 注文 */
  model Order {
    @db.key       @db.text id: OrderId;
    @db.ref(User) @db.text userId: UserId;
    @db.json lines: OrderLine[];
    @db.datetime placedAt: datetime;
    /** 届ける日（決まっていれば） */
    @db.date deliverOn: date?;
    /** 届ける時刻の、いちばん早いもの（決まっていれば） */
    @db.time deliverFrom: time?;
  }

  /** ユーザーへの通知 */
  model Notification {
    @db.ref(User) @db.text userId: UserId;
    @db.text message: string;
  }

  // ---- 例外 ----

  /** メールアドレスかパスワードが一致しない */
  @http.status(401)
  exception InvalidCredentials;

  /** 認証されていない */
  @http.status(401)
  exception Unauthorized;

  /** 通知を送れなかった（ステータスを持たない） */
  exception NotificationFailed;

  /** その email のユーザーが、もういる（ステータスを持たない: 投げる store.addUser は、HTTP の入口から呼ばれない） */
  exception EmailTaken;
}
