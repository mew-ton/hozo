// サンプル shop-server の仕様（README.md）。設計の図が持つ名前の名前空間 design: 担い手と、要求。
// どちらも、対象のない分類（docs/check.md「分類」の「対象のない分類」）のケースで、値を持たない。単位を置かない（コードを出さない）。
// 担い手は、ユースケースのデコレータ（client.hozo の @prd.usecase.of）が指し、要求は、設計の側のデコレータ（server.hozo の @prd.ref）が指す
// （docs/vocab.md「設計の図の語彙」）。要求ごとの、テストの入れ物は、フローの単位（hozo.toml の 8）が出す
// （docs/plugin-go-design.md「要求の、テストの入れ物の口」）。

/** 設計の図が持つ名前: 担い手と、要求 */
namespace design {
  /** 担い手 */
  classify Actor of never {
    /** 店で買う人 */
    @prd.actor.human Customer;
  }

  /** 要求 */
  classify Requirement of never {
    /** ログインしていない人は、注文できない */
    PRD_001;
    /** 注文したら、その注文が、自分の注文の一覧に出る */
    PRD_002;
  }
}
