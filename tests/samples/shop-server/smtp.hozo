// サンプル shop-server の仕様（README.md）。メールを SMTP で送る仕組みの語彙 smtp。
// この語彙を提供するプラグインはないので、サンプルの中で宣言する。どのトランスパイラも読まないので、印（読む者がなければ、何も出ない。P37。読む者がいる方の例は、plugins/go-ratelimit の語彙 rate）。

/** SMTP でメールを送る仕組みの語彙 */
namespace smtp {
  /** この op は、SMTP のサーバーにメールを送る。付いた op は純粋でなくなる */
  decorator fn sendMail();
}
