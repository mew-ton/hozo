// サンプル order-app の仕様（README.md）。製作の名前空間 production。
// 受注製作の行一つに、製作の仕事が一つ。作り終えたときに、出来上がりを量る: 大きさと重さが決まるのは、ここ。

/** 製作。注文を受けてから作るものの仕事 */
namespace production {
  /** 製作の仕事の識別子 */
  scalar JobId extends string;

  /** 製作の仕事 */
  model Job {
    @db.key id: JobId;
    orderId: type.OrderId;
    line: type.LineId;
    sku: type.Sku;
    name: string;
    quantity: type.Quantity;
    /** 客が書いた、作り方の希望 */
    request: string?;
    /** 納期。受け付けた時刻 + 商品の納期 */
    dueAt: datetime;
    startedAt: datetime?;
    finishedAt: datetime?;
    /** 出来上がりを量った大きさと重さ（行の全部の分） */
    measured: type.Measurement?;
  }

  @db.table
  state jobs: list<Job>;

  /** 製作の仕事の進み具合。進め方は、下の二つの効果（startJob、finishJob）の行の遷移だけ: Queued -> InProduction -> Finished */
  classify Progress of Job {
    /** まだ手を付けていない */
    Queued;
    /** 作っている */
    InProduction;
    /** 作り終えて、量った */
    Finished;
  }

  /** 引いた仕事があるか */
  classify Known of Job? {
    Found: Job? as Job;
    Missing: Job? as else;
  }

  /** その仕事は、ない */
  @http.status(404)
  exception NoJob;

  /** まだ手を付けていない仕事ではない */
  @http.status(409)
  exception NotQueued;

  /** 作っている途中の仕事ではない */
  @http.status(409)
  exception NotInProduction;

  // ---- 状態に触れるもの ----

  /** その識別子の仕事 */
  @db.find
  read fn jobById(id: JobId): Job? reads jobs;

  /** その注文の仕事 */
  @db.list
  read fn jobsOfOrder(orderId: type.OrderId): Job[] reads jobs;

  /** 作り終えていない仕事。納期の近い順（人が書く: 値がないことと、古い順の並べ方） */
  read fn openJobs(): Job[] reads jobs;

  /** 仕事を、一つ足す。まだ手を付けていない仕事として入る */
  effect fn addJob(job: Job): effects jobs.post as Progress.Queued;

  /** 作り始めた: 始めた時刻を入れる（人が書く） */
  effect fn startJob(job: Job on Progress.Queued, at: datetime): effects jobs.put as Progress.InProduction;

  /** 作り終えて、量った: 終えた時刻と、量った大きさを入れる（人が書く） */
  effect fn finishJob(job: Job on Progress.InProduction, measured: type.Measurement, at: datetime): effects jobs.put as Progress.Finished;

  // ---- 受け付けたとき ----

  /** 受注製作の行を、一つずつ、仕事にする。行がなければ、何も足さない */
  export fn enqueue(orderId: type.OrderId, lines: ordering.MadeLine[]) {
    val now = clock.now();
    for (val line of lines) {
      val job = planJob(orderId, line, now);
      addJob(job);
    }
  }

  /** 行から仕事を作り、納期を決める（人が書く） */
  fn planJob(orderId: type.OrderId, line: ordering.MadeLine, now: datetime): Job;

  // ---- 引く ----

  /** 作り終えていない仕事の一覧。納期の近い順 */
  export fn queue(): Job[] {
    return openJobs();
  }

  /** 注文の仕事の一覧 */
  export fn ofOrder(orderId: type.OrderId): Job[] {
    return jobsOfOrder(orderId);
  }

  /** 仕事を引く */
  fn require(id: JobId): Job {
    val found = jobById(id);
    return match (found by Known) {
      Found   => found;
      Missing => throw NoJob;
    }
  }

  // ---- 作る ----

  /** 作り始めた */
  export fn start(id: JobId): Job {
    val job = require(id);
    val now = clock.now();
    match (job by Progress) {
      Queued                 => startJob(job, now);
      InProduction, Finished => throw NotQueued;
    }
    return require(id);
  }

  /** 作り終えて、量った。出来上がりの大きさと重さが、ここで決まる */
  export fn finish(id: JobId, measured: type.Measurement): Job {
    val job = require(id);
    val now = clock.now();
    match (job by Progress) {
      InProduction     => finishJob(job, measured, now);
      Queued, Finished => throw NotInProduction;
    }
    return require(id);
  }
}
