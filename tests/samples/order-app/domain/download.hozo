// サンプル order-app の仕様（README.md）。ダウンロードの名前空間 download。
// ダウンロードの行は、箱が要らない。注文を受け付けたときに、すぐ渡す（権利を足す）。

/** ダウンロード。ダウンロードで渡す商品の、取る権利 */
namespace download {
  /** 取る権利。注文のダウンロードの行一つに、一つ */
  model Grant {
    @db.key orderId: type.OrderId;
    @db.key line: type.LineId;
    asset: type.AssetId;
    name: string;
    grantedAt: datetime;
    /** 取れる期限 */
    expiresAt: datetime;
  }

  @db.table
  state grants: list<Grant>;

  /** 取る権利を、いつまで持てるか */
  state grantLifetime: single<duration>;

  /** 一度に作る URL が、使える長さ */
  state linkLifetime: single<duration>;

  /** 引いた権利があるか */
  classify Entitlement of Grant? {
    Granted: Grant? as Grant;
    Ungranted: Grant? as else;
  }

  /** その行を取る権利は、ない */
  @http.status(404)
  exception NotGranted;

  /** 取れる期限が過ぎた */
  @http.status(410)
  exception GrantExpired;

  /** ファイルの置き場に届かない */
  @http.status(503)
  exception AssetsUnavailable;

  /** その注文の権利 */
  @db.list
  read fn grantsOfOrder(orderId: type.OrderId): Grant[] reads grants;

  /** その行の権利 */
  @db.find
  read fn grantOf(orderId: type.OrderId, line: type.LineId): Grant? reads grants;

  /** 権利を、まとめて足す */
  effect fn addGrants(added: Grant[]): effects grants.post;

  /** ダウンロードの行を、取れるようにする。行がなければ、何も足さない */
  export fn grant(orderId: type.OrderId, lines: ordering.DigitalLine[]) {
    val now = clock.now();
    val entitled = entitle(orderId, lines, now, grantLifetime);
    addGrants(entitled);
  }

  /** 行ごとに権利を作り、期限を決める（人が書く） */
  fn entitle(orderId: type.OrderId, lines: ordering.DigitalLine[], now: datetime, lifetime: duration): Grant[];

  /** 注文の権利の一覧 */
  export fn granted(orderId: type.OrderId): Grant[] {
    return grantsOfOrder(orderId);
  }

  /** その行のファイルを取る URL を作る。URL は、短い間だけ使える */
  export fn link(orderId: type.OrderId, line: type.LineId): type.Url
    throws NotGranted, GrantExpired, AssetsUnavailable
  {
    val found = grantOf(orderId, line);
    return match (found by Entitlement) {
      Granted   => linkOf(found);
      Ungranted => throw NotGranted;
    }
  }

  /** 期限の内の権利だけが、URL になる */
  fn linkOf(grant: Grant): type.Url
    throws GrantExpired, AssetsUnavailable
  {
    val now = clock.now();
    val request = stillValid(grant, now, linkLifetime);
    return fetchLink(request);
  }

  /** 期限を確かめて、URL の依頼にする（人が書く）。期限が過ぎていれば GrantExpired */
  fn stillValid(grant: Grant, now: datetime, lifetime: duration): assets.LinkRequest
    throws GrantExpired;

  /** ファイルの置き場に、URL を頼む */
  @outside.failsAs(AssetsUnavailable)
  fn fetchLink(request: assets.LinkRequest): type.Url {
    return assets.link(request);
  }
}
