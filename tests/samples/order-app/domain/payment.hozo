// サンプル order-app の仕様（README.md「難しい問題」）。支払いの名前空間 payment。
// 送料は梱包するまで決まらないので、注文のときに請求する額は決まらない。決まっているのは、上限（商品の代金 + 送料の上限）だけ。
//   注文のとき   : 客は、上限の額に同意する。相手（psp）は、その額の枠を確保する。金は動かない（Held）。
//   送料が決まる : 商品の代金 + 送料（上限で切る）で、請求を確定する（Settled）。上限を超えた分は、店が持つ（absorbed）。
//   枠の期限が近い: 受注製作が長引いたときは、上限の額で先に確定し（Prepaid）、送料が決まったら、差額を返す。
//   ダウンロードだけの注文は、送料がないので、客が同意したその場で請求が確定する。

/** 支払い。客が何に同意し、いくら請求したか */
namespace payment {
  /** 注文一つの支払い */
  model Payment {
    @db.key    orderId: type.OrderId;
    @db.unique session: psp.SessionId;
    /** 商品の代金 */
    itemsTotal: type.Yen;
    /** 送料の上限。ダウンロードだけの注文は 0 */
    shippingCeiling: type.Yen;
    /** 客が同意する額: 商品の代金 + 送料の上限。請求は、これを超えない */
    limit: type.Yen;
    /** 客が同意して、枠を確保した時刻 */
    securedAt: datetime?;
    /** 枠の期限 */
    holdExpiresAt: datetime?;
    /** 請求を確定した額 */
    captured: type.Yen?;
    /** 決まった送料のうち、客に請求する額（上限で切った後） */
    shippingCharged: type.Yen?;
    /** 決まった送料が上限を超えた分。店が持つ */
    absorbed: type.Yen?;
    /** 返した額（上限の額で先に確定したときの差額） */
    refunded: type.Yen?;
    /** 送料が決まって、請求する額が最後まで決まった時刻 */
    settledAt: datetime?;
    /** 枠を手放した時刻 */
    releasedAt: datetime?;
    /** 上限の額での、先の確定に、最後に失敗した時刻。失敗していなければ、ない */
    prepayFailedAt: datetime?;
    /** その失敗の理由（デコレータの中身が、受けた例外から書く） */
    prepayFailure: string?;
  }

  /** 送料が決まったときに決まる額（charged が数える） */
  model Charge {
    /** 請求を確定する額: 商品の代金 + 請求する送料 */
    captured: type.Yen;
    /** 決まった送料のうち、客に請求する額（上限で切った後） */
    shippingCharged: type.Yen;
    /** 決まった送料が上限を超えた分。店が持つ。超えなければ、ない */
    absorbed: type.Yen?;
    /** 上限の額で先に確定してあったときに、返す額。先に確定していなければ、ない */
    refund: type.Yen?;
  }

  /** 相手から届いた通知。同じ通知を二度扱わないための記録 */
  model Seen {
    @db.key id: psp.EventId;
    at: datetime;
  }

  @db.table
  state payments: list<Payment>;

  @db.table
  state seen: list<Seen>;

  /** 枠の期限の、どれだけ前に、先に請求を確定するか */
  state holdMargin: single<duration>;

  // ---- 分類 ----

  /**
   * 支払いの状態。進め方は、効果の行の遷移だけ（「状態に触れるもの」）:
   *   createPayment          : Pending で入る
   *   replaceSessionOf       : Pending -> Pending（支払いの画面を差し替える）
   *   holdSecured            : Pending -> Held
   *   chargeSecured          : Pending -> Settled（送料がない注文）
   *   recordPrepaid          : Held -> Prepaid
   *   recordSettled          : Held, Prepaid -> Settled
   *   recordReleased         : Held -> Released
   */
  classify Standing of Payment {
    /** 支払いの画面を開いた。客は、まだ同意していない */
    Pending;
    /** 客が同意して、枠を確保した。請求は、まだ確定していない */
    Held;
    /** 枠の期限が近かったので、上限の額で、先に請求を確定した。送料が決まったら、差額を返す */
    Prepaid;
    /** 請求する額が、最後まで決まった */
    Settled;
    /** 枠を手放した。請求しない */
    Released;
  }

  /** 請求の決め方。送料の上限があるか（箱で送るものがあるか）で決まる */
  classify Billing of Payment {
    /** 枠を確保して、送料が決まってから、請求を確定する */
    Deferred;
    /** 送料がないので、客が同意したその場で、請求が確定する */
    Immediate;
  }

  /** 引いた支払いがあるか */
  classify Known of Payment? {
    Found: Payment? as Payment;
    Missing: Payment? as else;
  }

  /** その通知は、もう扱ったか */
  classify Redelivery of Seen? {
    Redelivered: Seen? as Seen;
    FirstDelivery: Seen? as else;
  }

  // ---- 例外 ----

  /**
   * 支払いの画面を開けない（支払いを引き受ける仕組みに届かない）。金は動いていない。
   * 金が動く呼び出し（請求の確定、返金、枠を手放す）の失敗は、言い換えない: http.NetworkError と http.ServerError のまま伝える。
   * そのとき、金が動いたかどうかは、分からない（README.md「分かったこと」の F5）。
   */
  @http.status(503)
  exception ProviderUnavailable;

  /** その注文の支払いは、ない */
  @http.status(404)
  exception NoPayment;

  /** 客が、もう同意している */
  @http.status(409)
  exception AlreadySecured;

  /** 客が、まだ同意していない（か、枠を手放した）ので、請求できない */
  @http.status(409)
  exception NotSecured;

  // ---- 状態に触れるもの ----

  /** その注文の支払い */
  @db.find
  read fn paymentOf(orderId: type.OrderId): Payment? reads payments;

  /** その支払いの画面の支払い */
  @db.find
  read fn paymentBySession(session: psp.SessionId): Payment? reads payments;

  /** 枠の期限が deadline より前の、まだ請求を確定していない支払い。期限の近い順（人が書く: 比較と並べ方） */
  read fn holdsExpiringBefore(deadline: datetime): Payment[] reads payments;

  /** その識別子の通知の記録 */
  @db.find
  read fn seenEvent(id: psp.EventId): Seen? reads seen;

  /** 支払いを作る。まだ同意していない支払いとして入る */
  @db.insert
  effect fn createPayment(payment: Payment): effects payments.post as Standing.Pending;

  /** 支払いの画面を差し替える。まだ同意していない支払いにだけ、できる（人が書く） */
  effect fn replaceSessionOf(payment: Payment on Standing.Pending, session: psp.SessionId): effects payments.put as Standing.Pending;

  /** 客が同意して、枠を確保した: 同意した時刻と、枠の期限を入れる（人が書く） */
  effect fn holdSecured(payment: Payment on Standing.Pending, holdExpiresAt: datetime?, at: datetime): effects payments.put as Standing.Held;

  /** 客が同意して、その場で請求が確定した: 同意した時刻と、確定した額（同意した額）を入れる（人が書く） */
  effect fn chargeSecured(payment: Payment on Standing.Pending, at: datetime): effects payments.put as Standing.Settled;

  /** 上限の額で、先に請求を確定した: 確定した額（同意した額）を入れる（人が書く） */
  effect fn recordPrepaid(payment: Payment on Standing.Held, at: datetime): effects payments.put as Standing.Prepaid;

  /** 先の確定に、失敗した: 時刻と理由を、支払いに残す。枠は、確保したまま（人が書く） */
  effect fn notePrepayFailure(payment: Payment on Standing.Held, at: datetime): effects payments.put as Standing.Held;

  /** 請求する額が、最後まで決まった: 決まった額と、時刻を入れる（人が書く） */
  effect fn recordSettled(payment: Payment on Standing.Held | Standing.Prepaid, charge: Charge, at: datetime): effects payments.put as Standing.Settled;

  /** 枠を手放した: 手放した時刻を入れる（人が書く） */
  effect fn recordReleased(payment: Payment on Standing.Held, at: datetime): effects payments.put as Standing.Released;

  /** 通知を、扱ったと記録する */
  @db.insert
  effect fn remember(event: Seen): effects seen.post;

  // ---- 注文のとき: 支払いの画面を開く ----

  /** 注文の支払いの画面を開く。まだ同意していない注文なら、何度でも開き直せる */
  export fn begin(order: ordering.Order, returnTo: type.Url): psp.Session {
    val existing = paymentOf(order.id);
    return match (existing by Known) {
      Found   => reopen(order, existing, returnTo);
      Missing => openFirst(order, returnTo);
    }
  }

  /** はじめて開く */
  fn openFirst(order: ordering.Order, returnTo: type.Url): psp.Session {
    val session = openSession(order, returnTo);
    val payment = pending(order, session);
    createPayment(payment);
    return session;
  }

  /** 開き直せるのは、まだ同意していない支払いだけ */
  fn reopen(order: ordering.Order, payment: Payment, returnTo: type.Url): psp.Session {
    return match (payment by Standing) {
      Pending => replaceSession(order, payment, returnTo);
      else    => throw AlreadySecured;
    }
  }

  /** 新しい支払いの画面に差し替える */
  fn replaceSession(order: ordering.Order, payment: Payment on Standing.Pending, returnTo: type.Url): psp.Session {
    val session = openSession(order, returnTo);
    replaceSessionOf(payment, session.id);
    return session;
  }

  /** 箱で送るものがあれば、上限の額の枠を確保する画面。ダウンロードだけなら、その場で請求する画面 */
  fn openSession(order: ordering.Order, returnTo: type.Url): psp.Session {
    return match (order.physical by ordering.Delivery) {
      ToShip        => openHold(order, order.physical, returnTo);
      NothingToShip => openCharge(order, returnTo);
    }
  }

  /** 商品の代金 + 送料の上限の枠を確保する画面を開く */
  @outside.failsAs(ProviderUnavailable)
  fn openHold(order: ordering.Order, part: ordering.PhysicalPart, returnTo: type.Url): psp.Session {
    val request = limitOf(order, part, returnTo);
    return psp.openHold(request);
  }

  /** 商品の代金を、その場で請求する画面を開く */
  @outside.failsAs(ProviderUnavailable)
  fn openCharge(order: ordering.Order, returnTo: type.Url): psp.Session {
    val request = totalOf(order, returnTo);
    return psp.openCharge(request);
  }

  /** 商品の代金 + 送料の上限を、同意する額にする（人が書く） */
  fn limitOf(order: ordering.Order, part: ordering.PhysicalPart, returnTo: type.Url): psp.SessionRequest;

  /** 商品の代金を、同意する額にする（人が書く） */
  fn totalOf(order: ordering.Order, returnTo: type.Url): psp.SessionRequest;

  /** まだ同意していない支払いを作る（人が書く） */
  fn pending(order: ordering.Order, session: psp.Session): Payment;

  // ---- 相手からの通知: 客が同意した ----

  /** その通知で、新しく支払いの枠を確保できた注文 */
  classify Securing of type.OrderId? {
    NewlySecured: type.OrderId? as type.OrderId;
    NoChange: type.OrderId? as else;
  }

  /**
   * 相手からの通知を扱う。同じ通知が二度届いても、二度は扱わない。
   * この通知で、新しく、客の同意が取れた注文があれば、その識別子を返す。なければ、ない。
   */
  @pact.promise("客", "同じ通知が二度届いても、注文を二度は受け付けない")
  export fn record(event: psp.Event): type.OrderId? {
    val delivered = seenEvent(event.id);
    return match (delivered by Redelivery) {
      Redelivered   => none;
      FirstDelivery => recordNew(event);
    }
  }

  /** はじめて届いた通知。扱ったと記録する。することがあるのは、客の同意（Secured）の通知だけで、ほかの通知（Echo）は、受け取るだけ */
  fn recordNew(event: psp.Event): type.OrderId? {
    val now = clock.now();
    remember({ id: event.id, at: now });
    return match (event by psp.Meaning) {
      Secured => secure(event, now);
      Echo    => none;
    }
  }

  /** 客の同意の通知。知らない支払いの画面のものは、何もしない */
  fn secure(event: psp.Event on psp.Meaning.Secured, now: datetime): type.OrderId? {
    val payment = paymentBySession(event.session);
    return match (payment by Known) {
      Found   => secureFound(payment, event, now);
      Missing => none;
    }
  }

  /** まだ同意していなかった支払いだけが、新しく確保される */
  fn secureFound(payment: Payment, event: psp.Event on psp.Meaning.Secured, now: datetime): type.OrderId? {
    return match (payment by Standing) {
      Pending => markSecured(payment, event, now);
      else    => none;
    }
  }

  /**
   * 同意を記録する。箱で送るものがある支払いは、枠を確保した（Held）。
   * 送料がない支払い（ダウンロードだけ）は、その場で請求が確定している（Settled）。
   */
  fn markSecured(payment: Payment on Standing.Pending, event: psp.Event on psp.Meaning.Secured, now: datetime): type.OrderId {
    // 請求のしかたは、別の名前で分ける: match の対象は、アームの中で、その分類のケースに絞り込んだ型になり、
    // Standing.Pending の絞り込みを、持たなくなる（docs/types.md「アームの中の対象の型」）
    val billed = payment;
    match (billed by Billing) {
      Deferred  => holdSecured(payment, event.holdExpiresAt, now);
      Immediate => chargeSecured(payment, now);
    }
    return payment.orderId;
  }

  // ---- 引く ----

  /** 注文の支払い。支払いの画面をまだ開いていなければ、ない */
  export fn ofOrder(orderId: type.OrderId): Payment? {
    return paymentOf(orderId);
  }

  /** 注文の支払い。なければ NoPayment */
  fn require(orderId: type.OrderId): Payment {
    val found = paymentOf(orderId);
    return match (found by Known) {
      Found   => found;
      Missing => throw NoPayment;
    }
  }

  // ---- 送料が決まった: 請求する額を、最後まで決める ----

  /**
   * 送料が決まったので、請求する額を決める。客に請求する送料は、fee と上限の小さい方。上限を超えた分は、店が持つ。
   * 枠を確保してあれば、商品の代金 + 請求する送料で、請求を確定する。上限の額で先に確定してあれば、差額を返す。
   * もう決まっていれば、何もしない（二度呼んでも、請求は一度）。
   */
  @pact.promise("客", "請求は、同意した額（商品の代金 + 送料の上限）を超えない")
  @pact.promise("客", "請求の確定は、注文一つに一度だけ")
  export fn settle(orderId: type.OrderId, fee: type.Yen) {
    val payment = require(orderId);
    match (payment by Standing) {
      Held               => capture(payment, fee);
      Prepaid            => refundDifference(payment, fee);
      Settled            => none;
      Pending, Released => throw NotSecured;
    }
  }

  /** 枠から、請求を確定する。枠の期限が過ぎていれば、金は動かず、記録も変わらない。相手に届かなければ、金が動いたかどうかは、分からない */
  fn capture(payment: Payment on Standing.Held, fee: type.Yen):
    throws psp.HoldExpired prevents effects
  {
    val now = clock.now();
    val charge = charged(payment, fee);
    val request = captureOf(payment, charge);
    psp.capture(request);
    recordSettled(payment, charge, now);
  }

  /** 先に確定した上限の額と、決まった額の差を、返す */
  fn refundDifference(payment: Payment on Standing.Prepaid, fee: type.Yen) {
    val now = clock.now();
    val charge = charged(payment, fee);
    val request = refundOf(payment, charge);
    psp.refund(request);
    recordSettled(payment, charge, now);
  }

  /**
   * 請求する額を決める（人が書く）: 請求する送料 = fee と送料の上限の小さい方。店が持つ分 = fee が上限を超えた分。
   * 請求する額 = 商品の代金 + 請求する送料。先に上限の額で確定してあれば、返す額 = 上限の額 - 請求する額。
   */
  fn charged(payment: Payment, fee: type.Yen): Charge;

  /** 請求を確定する額の依頼（人が書く） */
  fn captureOf(payment: Payment, charge: Charge): psp.AmountRequest;

  /** 返す額の依頼（人が書く）。差が 0 でも、依頼は作る */
  fn refundOf(payment: Payment, charge: Charge): psp.AmountRequest;

  // ---- 枠の期限が近い: 上限の額で、先に確定する ----

  /** 先の確定の失敗の、分け方。呼ぶ人のいない op（時計で動く op）は、想定した失敗を、返す相手がいないので、状態に残す */
  classify PrepayFailure of any exception {
    /** 想定した失敗: 枠が切れていた、相手に届かない。支払いに残して、次に時計が動いたときに、もう一度試す */
    Expected: any exception as psp.HoldExpired | http.NetworkError | http.ServerError;
    /** 想定していない失敗: そのまま伝えて、繰り返しを止める */
    Unexpected: any exception as else;
  }

  /**
   * 枠の期限が近い支払いを、期限の近い順に、一つずつ、上限の額で、先に請求を確定する。誰にも呼ばれずに動く。
   * 一つの確定が失敗しても、残りは、続ける: 想定した失敗は、prepay が受けて、支払いに残す。
   * ここまで届く失敗は、想定していないもので、繰り返しは、そこで止まる。
   */
  @clock.tick(every: 10m)
  fn prepayExpiring() {
    val now = clock.now();
    val deadline = ahead(now, holdMargin);
    val expiring = holdsExpiringBefore(deadline);
    for (val payment of expiring) {
      prepayHeld(payment, now);
    }
  }

  /** now から margin だけ先の時刻（人が書く） */
  fn ahead(now: datetime, margin: duration): datetime;

  /** 枠を確保してある支払いだけを、先に確定する */
  fn prepayHeld(payment: Payment, now: datetime) {
    match (payment by Standing) {
      Held => prepay(payment, now);
      else => none;
    }
  }

  /**
   * 上限の額で、請求を確定する。想定した失敗（枠が切れていた、相手に届かない）は、支払いに残して、終わる。
   * 次に時計が動いたときに、もう一度、試される
   */
  fn prepay(payment: Payment on Standing.Held, now: datetime) {
    try {
      val request = limitCaptureOf(payment);
      psp.capture(request);
      recordPrepaid(payment, now);
    } catch (e by PrepayFailure) {
      Expected => notePrepayFailure(payment, now);
      Unexpected => throw e;
    }
  }

  /** 上限の額（同意した額）で請求を確定する依頼（人が書く）。送料は、まだ決まっていない */
  fn limitCaptureOf(payment: Payment on Standing.Held): psp.AmountRequest;

  // ---- 枠を手放す ----

  /** 期限切れにした注文に、後から同意が届いたとき: 枠を手放す。請求しない */
  export fn release(orderId: type.OrderId) {
    val payment = require(orderId);
    match (payment by Standing) {
      Held => letGo(payment);
      else => none;
    }
  }

  /** 枠を手放して、記録する */
  fn letGo(payment: Payment on Standing.Held) {
    val request = holdOf(payment);
    psp.release(request);
    val now = clock.now();
    recordReleased(payment, now);
  }

  /** 手放す枠の依頼（人が書く） */
  fn holdOf(payment: Payment on Standing.Held): psp.SessionRef;
}
