// サンプル order-app の仕様（README.md「難しい問題」）。受け付けた後の流れの名前空間 fulfilment。
// 状態を持たない。概念（注文、支払い、在庫、製作、ダウンロード、出荷、配送業者、知らせ）をまたぐ順番だけを持つ。
// 混ざった注文は、ここで、種類ごとの担い手に分かれる: ダウンロードは、すぐ渡す。受注製作は、仕事にする。在庫は、棚から出してよくする。
// 箱で送る二つは、一つの出荷にまとめて、そろうのを待つ。

/** 受け付けた後の流れ。注文を、渡し終えるまで進める */
namespace fulfilment {
  // ---- 客が支払いに同意した ----

  /**
   * 客の同意が取れた注文を、受け付けて、渡す準備を始める。
   * 期限切れにした後で同意が届いた注文は、受け付けない: 確保した枠を手放す（在庫は、もう戻してある）。
   */
  export fn secured(orderId: type.OrderId) {
    val order = ordering.byId(orderId);
    match (order by ordering.Standing) {
      AwaitingPayment => acceptAndBegin(order);
      Accepted        => none;
      Expired         => payment.release(order.id);
    }
  }

  /** 受け付けて、始めて、知らせる */
  @db.transaction
  fn acceptAndBegin(order: ordering.Order on ordering.Standing.AwaitingPayment) {
    val accepted = ordering.accept(order);
    begin(accepted);
    notice.accepted(accepted);
  }

  /** 混ざった注文を、種類ごとの担い手に分ける。ダウンロードの行は、ここで渡し終える */
  @prd.promise("客", "ダウンロードの商品は、箱で送るものを待たずに、受け付けたときに渡す")
  @prd.promise("客", "箱で送るものは、一つの注文につき、一つの荷物で届く")
  fn begin(order: ordering.Order) {
    download.grant(order.id, order.digital);
    match (order.physical by ordering.Delivery) {
      ToShip        => beginPhysical(order.id, order.physical);
      NothingToShip => none;
    }
  }

  /** 箱で送る部分: 受注製作の行は仕事に、在庫の行は棚から出してよくし、両方をそろえる出荷を開く */
  fn beginPhysical(orderId: type.OrderId, part: ordering.PhysicalPart) {
    production.enqueue(orderId, part.made);
    inventory.confirm(orderId);
    shipping.open(orderId, part);
  }

  // ---- そろえる: 二つの入口が、同じ出荷に品目を置く ----

  /** 在庫の行を、棚から出して、そろえ場所に置いた */
  @db.transaction
  export fn picked(orderId: type.OrderId, line: type.LineId): shipping.Shipment {
    inventory.pick(orderId, line);
    return shipping.gather(orderId, line, none);
  }

  /** 受注製作の行を、作り終えて、量って、そろえ場所に置いた。出来上がりの大きさが、ここで出荷に届く */
  @db.transaction
  export fn made(id: production.JobId, measured: type.Measurement): shipping.Shipment {
    val job = production.finish(id, measured);
    return shipping.gather(job.orderId, job.line, measured);
  }

  // ---- 梱包の台: 出荷一つについて、いま何ができるか ----

  /** 梱包の台に見せるもの。進み具合によって、ある項目が違う */
  model Station {
    progress: shipping.Progress;
    /** そろっていて、まだ梱包していないとき: 入る箱の種類と、それぞれの送料 */
    options: shipping.BoxOption[]?;
    /** 梱包が済んで、まだ送り状を買っていないとき: 配送業者の見積もり */
    offers: carrier.Quote[]?;
    /** 注文の支払い。送料の上限と、請求が確定したかを見せる */
    charge: payment.Payment?;
  }

  /** 梱包の台に見せるものを集める */
  export fn station(id: shipping.ShipmentId): Station {
    val progress = shipping.progress(id);
    val options = optionsFor(progress);
    val offers = offersFor(progress);
    val charge = payment.ofOrder(progress.shipment.orderId);
    return { progress: progress, options: options, offers: offers, charge: charge };
  }

  /** まだ梱包していない出荷には、箱の選択肢を出す */
  fn optionsFor(progress: shipping.Progress): shipping.BoxOption[]? {
    return match (progress.parcel by shipping.Packing) {
      Packed   => none;
      Unpacked => optionsIfGathered(progress.shipment);
    }
  }

  /** 箱の選択肢を出せるのは、そろった出荷だけ */
  fn optionsIfGathered(shipment: shipping.Shipment): shipping.BoxOption[]? {
    return match (shipment by shipping.Gathered) {
      Complete => shipping.boxOptions(shipment);
      Awaiting => none;
    }
  }

  /** まだ送り状を買っていない出荷には、見積もりを出す */
  fn offersFor(progress: shipping.Progress): carrier.Quote[]? {
    return match (progress.label by shipping.Labelling) {
      Labelled   => none;
      Unlabelled => offersIfPacked(progress);
    }
  }

  /** 見積もりを取れるのは、荷物（箱と重さ）が決まった後だけ */
  fn offersIfPacked(progress: shipping.Progress): carrier.Quote[]? {
    return match (progress.parcel by shipping.Packing) {
      Packed   => offers(progress.parcel, progress.shipment.destination);
      Unpacked => none;
    }
  }

  /** 荷物の見積もりを、いま使っている配送業者から取る */
  fn offers(parcel: shipping.Parcel, destination: type.Address): carrier.Quote[] {
    val origin = shipping.shipFrom();
    return carrier.quotes(parcel, origin, destination);
  }

  // ---- 送り状を買う: 送料が決まったので、先に請求を確定する ----

  /**
   * 選んだ配送業者で、送り状を買う。
   * 順番: 決まった送料で、客への請求を確定する → 配送業者から送り状を買う（店の金が動く）→ 記録する。
   * 請求できない荷物（枠の期限切れ）には、送り状を買わない。途中で失敗したら、もう一度呼べる: 請求の確定は、二度は起きない。
   */
  @prd.promise("店", "請求を確定できない荷物には、送り状を買わない")
  export fn dispatch(id: shipping.ShipmentId, choice: carrier.Choice): shipping.Label {
    val sealed = shipping.sealed(id);
    payment.settle(sealed.shipment.orderId, sealed.parcel.fee);
    val origin = shipping.shipFrom();
    val label = carrier.book(choice, sealed.parcel, origin, sealed.shipment.destination);
    shipping.attachLabel(label);
    return label;
  }

  // ---- 渡す、届く ----

  /** 配送業者に渡した。客に、決まった送料と、確定した請求と、追跡番号を知らせる */
  export fn handedOver(id: shipping.ShipmentId): shipping.Shipment {
    val dispatched = shipping.handOver(id);
    val order = ordering.byId(dispatched.shipment.orderId);
    val charge = payment.ofOrder(order.id);
    notice.shipped(order, dispatched.parcel, dispatched.label, charge);
    return dispatched.shipment;
  }

  /**
   * 配送業者の通知が言っている、荷物の動き。届いた時刻があるかどうかで、型から決まる。
   * 通知は、荷物一つにつき、いくつも届く（運んでいる途中、不在、返送など）。店がすることがあるのは、届いたという通知だけで、
   * ほかの通知は、受け取ったとだけ答える: 答えなければ、相手が送り直し続ける。だから、その場合にも名前を付けて、何もしない枝を書く。
   */
  classify Arrival of datetime? {
    /** 届いた */
    Arrived: datetime? as datetime;
    /** まだ届いていない（運んでいる途中、不在、返送など）。店は、何もしない */
    Underway: datetime? as else;
  }

  /** 配送業者から、荷物の動きの通知が届いた。届いたという通知なら、出荷に記録する。ほかの動きの通知は、受け取るだけ */
  export fn tracked(event: carriergw.TrackingEvent) {
    match (event.deliveredAt by Arrival) {
      Arrived  => shipping.delivered(event.trackingNumber, event.deliveredAt);
      Underway => none;
    }
  }
}
