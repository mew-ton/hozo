// サンプル order-app の仕様（README.md）。在庫の名前空間 inventory。
// 在庫の行は、注文のときに取り置き、棚から出したとき（ピッキング）に減らす。

/** 在庫。棚に何がいくつあり、どの注文のために取り置いてあるか */
namespace inventory {
  /** 商品ごとの在庫の数 */
  model Level {
    @db.key sku: type.Sku;
    /** 棚にある数 */
    onHand: int;
    /** そのうち、注文のために取り置いてある数 */
    reserved: int;
  }

  /** 取り置き。注文の在庫の行一つに、一つ */
  model Reservation {
    @db.key orderId: type.OrderId;
    @db.key line: type.LineId;
    sku: type.Sku;
    name: string;
    quantity: type.Quantity;
    /** 注文を受け付けて、棚から出してよくなった時刻。支払いを待っている間は、ない */
    confirmedAt: datetime?;
    /** 棚から出した時刻。まだ出していなければ、ない */
    pickedAt: datetime?;
  }

  @db.table
  state levels: list<Level>;

  @db.table
  state reservations: list<Reservation>;

  /** 在庫が足りない */
  @http.status(409)
  exception OutOfStock(sku: type.Sku);

  /** その行の取り置きは、ない */
  @http.status(404)
  exception NotReserved;

  /** もう棚から出してある */
  @http.status(409)
  exception AlreadyPicked;

  // ---- 状態に触れるもの ----

  /** skus のどれかに当たる在庫の数（人が書く: 集合に入っているか） */
  read fn levelsOf(skus: type.Sku[]): Level[] reads levels;

  /** その商品の在庫の数 */
  @db.find
  read fn levelOf(sku: type.Sku): Level? reads levels;

  /** その行の取り置き */
  @db.find
  read fn reservationOf(orderId: type.OrderId, line: type.LineId): Reservation? reads reservations;

  /** その注文の取り置き */
  @db.list
  read fn reservationsOfOrder(orderId: type.OrderId): Reservation[] reads reservations;

  /** 棚から出してよくなった取り置きのうち、まだ出していないもの（人が書く: 値があること、ないこと） */
  read fn toPick(): Reservation[] reads reservations;

  /** 在庫の数を、まとめて書き換える */
  effect fn saveLevels(changed: Level[]): effects levels.put;

  /** 取り置きを、まとめて足す */
  effect fn addReservations(added: Reservation[]): effects reservations.post;

  /** 棚から出した: 出した時刻を入れる（人が書く） */
  effect fn markPicked(reservation: Reservation on Picking.OnShelf, at: datetime): effects reservations.put as Picking.Picked;

  /** その注文の取り置きに、棚から出してよくなった時刻を入れる。棚にあるか出したか（Picking）は、変えない: as を書かない put */
  effect fn confirmReservations(orderId: type.OrderId, at: datetime): effects reservations.put;

  /** その注文の取り置きを消す。戻した取り置きは、残さない（取り置きは、なくなることが意味） */
  @db.delete
  effect fn dropReservations(orderId: type.OrderId): effects reservations.delete;

  // ---- 取り置く ----

  /** 取り置きの結果: 書き換える在庫の数と、足す取り置き */
  model Allocation {
    levels: Level[];
    reservations: Reservation[];
  }

  /** 注文の在庫の行を取り置く。一つでも足りなければ、どれも取り置かない */
  @db.transaction
  export fn reserve(orderId: type.OrderId, lines: ordering.StockedLine[]) {
    val skus = skusOf(lines);
    val current = levelsOf(skus);
    val allocation = allocate(orderId, lines, current);
    saveLevels(allocation.levels);
    addReservations(allocation.reservations);
  }

  /** 行の商品の識別子（人が書く） */
  fn skusOf(lines: ordering.StockedLine[]): type.Sku[];

  /** 取り置く数を数える。足りない商品があれば OutOfStock（人が書く） */
  fn allocate(orderId: type.OrderId, lines: ordering.StockedLine[], current: Level[]): Allocation
    throws OutOfStock;

  // ---- 戻す ----

  /** 期限切れになった注文の取り置きを戻す */
  @db.transaction
  export fn release(orderId: type.OrderId) {
    val held = reservationsOfOrder(orderId);
    val skus = skusOfHeld(held);
    val current = levelsOf(skus);
    val restored = restore(held, current);
    saveLevels(restored);
    dropReservations(orderId);
  }

  /** 取り置きの商品の識別子（人が書く） */
  fn skusOfHeld(held: Reservation[]): type.Sku[];

  /** 取り置いた数を、在庫の数に戻す（人が書く） */
  fn restore(held: Reservation[], current: Level[]): Level[];

  // ---- 受け付けたとき ----

  /** 注文を受け付けた。取り置いた行を、棚から出してよくする */
  export fn confirm(orderId: type.OrderId) {
    val now = clock.now();
    confirmReservations(orderId, now);
  }

  // ---- 棚から出す ----

  /** 棚から出すものの一覧 */
  export fn pickList(): Reservation[] {
    return toPick();
  }

  /** 引いた取り置きがあるか */
  classify Held of Reservation? {
    Reserved: Reservation? as Reservation;
    Unreserved: Reservation? as else;
  }

  /** 取り置きを、もう棚から出したか */
  classify Picking of Reservation {
    /** まだ棚にある */
    OnShelf;
    /** 棚から出した */
    Picked;
  }

  /** 引いた在庫の数があるか */
  classify Stocked of Level? {
    Counted: Level? as Level;
    Uncounted: Level? as else;
  }

  /** 取り置いた行を、棚から出した。在庫の数を減らす */
  @db.transaction
  export fn pick(orderId: type.OrderId, line: type.LineId) {
    val found = reservationOf(orderId, line);
    match (found by Held) {
      Reserved   => pickReserved(found);
      Unreserved => throw NotReserved;
    }
  }

  /** まだ棚にある取り置きだけを、出せる */
  fn pickReserved(reservation: Reservation) {
    match (reservation by Picking) {
      OnShelf => takeFromShelf(reservation);
      Picked  => throw AlreadyPicked;
    }
  }

  /** 在庫の数を減らし、取り置きを、棚から出したことにする */
  fn takeFromShelf(reservation: Reservation on Picking.OnShelf) {
    val level = levelOf(reservation.sku);
    val now = clock.now();
    match (level by Stocked) {
      Counted   => shipOut(level, reservation);
      Uncounted => throw NotReserved;
    }
    markPicked(reservation, now);
  }

  /** 出した分を、棚の数と取り置きの数から引く */
  fn shipOut(level: Level, picked: Reservation) {
    val changed = minus(level, picked);
    saveLevels(changed);
  }

  /** 出した分を引いた在庫の数（人が書く） */
  fn minus(level: Level, picked: Reservation): Level[];
}
