// サンプル order-app の仕様（README.md）。客への知らせの名前空間 notice。
// 知らせが送れなくても、注文と出荷の流れは止めない（@bestEffort）。何を書くかは、葉の op の中。

/** 知らせ。客に、何が起きたかを伝える */
namespace notice {
  /** 知らせを送るときの失敗の、分け方 */
  classify Delivery of any exception {
    /** 送れなかった */
    Undelivered: any exception as mailer.Undelivered;
    /** そのほかの失敗 */
    Other: any exception as else;
  }

  /** 送れなかったことを、呼び出し元に伝えない（値を返さない op にだけ付く）。そのほかの失敗は、そのまま伝える */
  decorator fn bestEffort() {
    try {
      proceed();
    } catch (e by Delivery) {
      Undelivered => none;
      Other => throw e;
    }
  }

  /** 注文を受け付けた。見るための鍵、ダウンロード、送料の見積もりと上限と「梱包の後に決まる」こと、納期を伝える */
  @bestEffort
  export fn accepted(order: ordering.Order) {
    val mail = acceptedMail(order);
    mailer.send(mail);
  }

  /** 発送した。決まった送料と、請求を確定した額と、追跡番号を伝える。送料が見積もりと違うときは、その理由も */
  @bestEffort
  export fn shipped(order: ordering.Order, parcel: shipping.Parcel, label: shipping.Label, charge: payment.Payment?) {
    val mail = shippedMail(order, parcel, label, charge);
    mailer.send(mail);
  }

  /** 受け付けの知らせを書く（人が書く） */
  fn acceptedMail(order: ordering.Order): mailer.Mail;

  /** 発送の知らせを書く（人が書く） */
  fn shippedMail(order: ordering.Order, parcel: shipping.Parcel, label: shipping.Label, charge: payment.Payment?): mailer.Mail;
}
