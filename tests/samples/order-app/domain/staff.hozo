// サンプル order-app の仕様（README.md）。担当者の名前空間 staff。
// 客はアカウントを持たない（注文の鍵で見る）。ログインするのは、店の担当者だけ。仕事は三つ: 製作、梱包（そろえるのも）、管理。

/** 担当者。誰が、どの仕事をしてよいか */
namespace staff {
  /** 担当者の識別子 */
  scalar MemberId extends string;

  /** パスワード（平文。入力でだけ使う） */
  @valid.length(min: 8, max: 128)
  scalar Password extends string;

  /** 担当者 */
  model Member {
    @db.key    id: MemberId;
    @db.unique loginName: string;
    name: string;
    /** パスワードのハッシュ */
    hash: string;
    /** 製作の仕事をしてよい */
    maker: boolean;
    /** そろえる、梱包する、渡す仕事をしてよい */
    packer: boolean;
    /** 配送業者を管理してよい */
    admin: boolean;
  }

  /** 外に見せる担当者（ハッシュを持たない） */
  model PublicMember extends Member {
    override hash: never;
  }

  /** ログインセッション */
  model Session {
    @db.key token: type.Token;
    @db.ref(Member) memberId: MemberId;
    expiresAt: Time;
  }

  @db.table
  state members: list<Member>;

  @db.table
  state sessions: list<Session>;

  /** ログイン名かパスワードが一致しない */
  @http.status(401)
  exception InvalidCredentials;

  // ---- 状態に触れるもの ----

  /** そのログイン名の担当者 */
  @db.find
  read fn memberByLoginName(loginName: string): Member? on members;

  /** その識別子の担当者 */
  @db.find
  read fn memberById(id: MemberId): Member? on members;

  /** そのトークンのセッション */
  @db.find
  read fn sessionByToken(token: type.Token): Session? on sessions;

  /** セッションを作る。ログインしていなかったトークンが、ログインしたことになる */
  @db.insert
  effect fn createSession(session: Session) on sessions.post as Login.LoggedOut -> Login.LoggedIn;

  /**
   * セッションを消す（人が書く）。消せるのは、あるセッションだけ。セッションは、なくなることが意味: ログアウトした後に、残す記録はない。
   * db の語彙の @db.delete は、列の条件を引数に取り、行を受け取れないので、付けていない（README.md「分かったこと」の F54）。
   */
  effect fn deleteSession(session: Session) on sessions.delete as Login.LoggedIn -> Login.LoggedOut;

  // ---- 分類 ----

  /** そのログイン名の担当者がいるか */
  classify Account of Member? {
    Enrolled: Member? as Member;
    Unknown: Member? as else;
  }

  /** 要求が、トークンを持ってきたか */
  classify Credential of type.Token? {
    Presented: type.Token? as type.Token;
    Absent: type.Token? as else;
  }

  /** そのトークンでログインしているか。セッションの行がないことが、「ログインしていない」という状態 */
  classify Login of Session? {
    LoggedIn: Session? as Session;
    LoggedOut: Session? as none;
  }

  // 仕事ごとに、分類を一つ。一人が複数の仕事を持てる（maker と packer の両方が真の担当者がいる）ので、
  // 三つの仕事を一つの分類のケースにはしない（ケースは排他）。

  /** 製作の担当か */
  classify MakerDuty of Member {
    /** 製作の仕事をしてよい */
    Maker;
    /** 製作の仕事は、してはいけない */
    NotMaker;
  }

  /** 梱包の担当か */
  classify PackerDuty of Member {
    /** そろえる、梱包する、渡す仕事をしてよい */
    Packer;
    /** 梱包の仕事は、してはいけない */
    NotPacker;
  }

  /** 管理の担当か */
  classify AdminDuty of Member {
    /** 配送業者を管理してよい */
    Admin;
    /** 管理の仕事は、してはいけない */
    NotAdmin;
  }

  // ---- ログイン ----

  /** ログインの結果 */
  model LoggedIn {
    member: PublicMember;
    token: type.Token;
  }

  /** ログインする */
  export fn login(loginName: string, password: Password): LoggedIn
    throws InvalidCredentials
  {
    val member = memberByLoginName(loginName);
    return match (member by Account) {
      Enrolled => issueSession(member, password);
      Unknown  => throw InvalidCredentials;
    }
  }

  /** パスワードを確かめて、セッションを作る */
  fn issueSession(member: Member, password: Password): LoggedIn
    throws InvalidCredentials
  {
    checkPassword(member, password);
    val now = clock.now();
    val session = newSession(member, now);
    createSession(session);
    val publicMember = toPublic(member);
    return { member: publicMember, token: session.token };
  }

  /** パスワードが合わなければ InvalidCredentials（人が書く） */
  fn checkPassword(member: Member, password: Password)
    throws InvalidCredentials;

  /** トークンと期限を決める（人が書く） */
  fn newSession(member: Member, now: Time): Session;

  /** 外に見せる形に写す（人が書く） */
  fn toPublic(member: Member): PublicMember;

  /** ログアウトする。トークンがなければ、何もしない */
  export fn logout(token: type.Token?) {
    match (token by Credential) {
      Presented => endSession(token);
      Absent    => none;
    }
  }

  /** そのトークンのセッションがあれば、消す。もうなければ、何もしない */
  fn endSession(token: type.Token) {
    val session = sessionByToken(token);
    match (session by Login) {
      LoggedIn  => deleteSession(session);
      LoggedOut => none;
    }
  }

  // ---- 誰が呼んだか ----

  /** 呼んだ担当者。トークンがない、ログインしていない、期限が過ぎている、のどれでも Unauthorized */
  fn whoIs(token: type.Token?): Member
    throws type.Unauthorized
  {
    return match (token by Credential) {
      Presented => memberOf(token);
      Absent    => throw type.Unauthorized;
    }
  }

  /** そのトークンの担当者 */
  fn memberOf(token: type.Token): Member
    throws type.Unauthorized
  {
    val session = sessionByToken(token);
    return match (session by Login) {
      LoggedIn  => freshMember(session);
      LoggedOut => throw type.Unauthorized;
    }
  }

  /** 期限の内のセッションの担当者 */
  fn freshMember(session: Session): Member
    throws type.Unauthorized
  {
    val now = clock.now();
    val fresh = requireFresh(session, now);
    val member = memberById(fresh.memberId);
    return match (member by Account) {
      Enrolled => member;
      Unknown  => throw type.Unauthorized;
    }
  }

  /** 期限が過ぎていないセッションを、そのまま返す。過ぎていれば Unauthorized（人が書く） */
  fn requireFresh(session: Session, now: Time): Session
    throws type.Unauthorized;

  /** 製作の担当として呼んでいることを確かめる */
  export fn asMaker(token: type.Token?)
    throws type.Unauthorized, type.Forbidden
  {
    val member = whoIs(token);
    match (member by MakerDuty) {
      Maker    => none;
      NotMaker => throw type.Forbidden;
    }
  }

  /** 梱包の担当として呼んでいることを確かめる */
  export fn asPacker(token: type.Token?)
    throws type.Unauthorized, type.Forbidden
  {
    val member = whoIs(token);
    match (member by PackerDuty) {
      Packer    => none;
      NotPacker => throw type.Forbidden;
    }
  }

  /** 管理の担当として呼んでいることを確かめる */
  export fn asAdmin(token: type.Token?)
    throws type.Unauthorized, type.Forbidden
  {
    val member = whoIs(token);
    match (member by AdminDuty) {
      Admin    => none;
      NotAdmin => throw type.Forbidden;
    }
  }
}
