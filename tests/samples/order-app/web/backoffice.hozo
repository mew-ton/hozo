// サンプル order-app の仕様（README.md「画面」）。担当者の画面の名前空間 backoffice（ブラウザ）。
// 三つの仕事の画面: 製作（仕事の一覧）、そろえる（棚から出すものの一覧）、梱包の台（出荷一つ）。管理の画面が一つ: 配送業者。
// 梱包の台のページ（StationPage）のアームが、「箱は、そろうまで決められない。送料は、箱で決まる」の順番を、そのまま画面にしたもの。

/** 担当者の画面。作る、そろえる、梱包する、渡す、配送業者を管理する */
namespace backoffice {
  // ---- 状態 ----

  /** ログインのトークン。空なら、ログインしていない */
  @browser.localStorage
  state token: nullable<type.Token>;

  // staffApi への呼び出しでは、入力のうち Token 型の位置を token で埋める
  bind token to staffApi.*;

  /** 操作が通らなかった理由。次の操作で消える */
  state problem: nullable<Problem>;

  @browser.page.path
  state location: single<browser.page.Route>;

  @browser.page.query
  state query: single<browser.page.Query>;

  /** 操作が通らなかった理由（値の集合は、下の効果の名前が決める） */
  model Problem {
    reason: string;
  }

  // ---- 効果 ----

  /** トークンを保存する */
  effect fn saveToken(token: type.Token): effects token as None -> Some;

  /** トークンを消す */
  effect fn removeToken(): effects token.delete;

  /** 理由を消す */
  effect fn clearProblem(): effects problem.delete;

  /** ログイン名かパスワードが違う */
  effect fn sayWrongCredentials(): effects problem.put;

  /** その操作は、もうできない（ほかの人が先に進めた）。開き直せば、いまの状態が出る */
  effect fn sayStale(): effects problem.put;

  /** 入れた値が、受け付けられない（箱の種類がない、重すぎる、もう登録してある） */
  effect fn sayRejected(): effects problem.put;

  /** 客に請求できない: 支払いの枠の期限が過ぎている。送り状は買っていない。管理の担当に渡す */
  effect fn sayCannotCharge(): effects problem.put;

  /** 配送業者が、その荷物を引き受けない。送り状は買っていない。請求は、確定している。ほかの見積もりを選ぶ */
  effect fn sayCarrierRefused(): effects problem.put;

  /** 外部の仕組みに届かなかった。請求と送り状が、どこまで進んだかは、分からない。開き直して、確かめる */
  effect fn sayUnknownOutcome(): effects problem.put;

  /** 画面を移す */
  effect fn goToLogin(): effects location.put;
  effect fn goToShipments(): effects location.put;
  effect fn goToStation(id: shipping.ShipmentId): effects location.put;
  /** 同じ画面を、開き直す */
  effect fn reload(): effects location.put;

  // ---- デコレータ ----

  /**
   * error が起きたら、op を終わらせて、then の効果を行う。
   *
   * @param error 受ける例外
   * @param then  代わりに行う効果
   */
  @repeatable
  decorator fn recover(error: any exception, then: any effect):
    catches error halts then;

  /** 一時的に表示できない */
  model Unavailable {}

  /** サーバーに届かないときは、ページの代わりに Unavailable を描く */
  decorator unavailableOnFailure = browser.page.fallback(http.NetworkError | http.ServerError, Unavailable);

  /** ログインしていない、またはその仕事の担当でないときは、ログインの画面へ移す */
  decorator staffOnly = recover(type.Unauthorized | type.Forbidden, goToLogin);

  // ---- ログイン ----

  /** ログインのページ */
  union LoginPage {
    Form: { problem: Problem?; };
  }

  fn loginVm(problem: Problem?): LoginPage;

  @browser.page.route("/login")
  fn openLogin(): LoginPage {
    return loginVm(problem);
  }

  /** ログインする */
  @browser.page.interaction(page: openLogin, when: LoginPage.Form)
  @recover(staff.InvalidCredentials, sayWrongCredentials)
  @recover(http.NetworkError | http.ServerError, sayUnknownOutcome)
  fn onLogin(loginName: string, password: staff.Password) {
    val ok = staffApi.login({ body: { loginName, password } });
    saveToken(ok.token);
    clearProblem();
    goToShipments();
  }

  /** ログアウトする。サーバーに届かなくても、手元のトークンは消す */
  fn onLogout() {
    requestLogout();
    removeToken();
    goToLogin();
  }

  /** サーバーのセッションを消してもらう。結果は見ない */
  @ignoreFailure
  fn requestLogout() {
    staffApi.logout({});
  }

  /** 結果を見ない呼び出し */
  decorator fn ignoreFailure():
    catches http.NetworkError, http.ServerError ignores;

  // ---- 製作 ----

  /** 製作のページ。仕事を、納期の近い順に並べる */
  union ProductionPage {
    Ready: { queued: production.Job[]; inProduction: production.Job[]; problem: Problem?; };
    /** 作るものがない */
    Empty: {};
    Unavailable: Unavailable;
  }

  fn productionVm(jobs: production.Job[], problem: Problem?): ProductionPage;

  @staffOnly
  @unavailableOnFailure
  @browser.page.route("/production")
  fn openProduction(): ProductionPage {
    val jobs = staffApi.jobs({});
    return productionVm(jobs, problem);
  }

  /** 作り始めた */
  @browser.page.interaction(page: openProduction, when: ProductionPage.Ready)
  @staffOnly
  @recover(production.NoJob | production.NotQueued, sayStale)
  @recover(http.NetworkError | http.ServerError, sayUnknownOutcome)
  fn onStartJob(id: production.JobId) {
    val started = staffApi.startJob({ id });
    seen(started);
    reload();
  }

  /** 作り終えた。出来上がりを量って、入れる。ここで入れた大きさと重さが、箱と送料を決める材料になる */
  @browser.page.interaction(page: openProduction, when: ProductionPage.Ready)
  @staffOnly
  @recover(production.NoJob | production.NotInProduction | shipping.NoShipment | shipping.UnknownItem, sayStale)
  @recover(http.NetworkError | http.ServerError, sayUnknownOutcome)
  fn onFinishJob(job: production.Job) {
    val measured = askMeasurement(job);
    val shipment = staffApi.finishJob({ id: job.id, measured });
    placedIn(shipment);
    reload();
  }

  /** 出来上がりの大きさと重さを聞く */
  @browser.page.dialog("MeasurementDialog")
  fn askMeasurement(job: production.Job): type.Measurement;

  /** 始めた仕事を、画面に出す（描き方は、ここでは決めない） */
  fn seen(job: production.Job);

  /** 品目を置いた出荷を、画面に出す: どのそろえ場所に置くか、あと何を待っているか */
  fn placedIn(shipment: shipping.Shipment);

  // ---- そろえる ----

  /** 棚から出すもののページ */
  union PickingPage {
    Ready: { picks: inventory.Reservation[]; problem: Problem?; };
    Empty: {};
    Unavailable: Unavailable;
  }

  fn pickingVm(picks: inventory.Reservation[], problem: Problem?): PickingPage;

  @staffOnly
  @unavailableOnFailure
  @browser.page.route("/picking")
  fn openPicking(): PickingPage {
    val picks = staffApi.picks({});
    return pickingVm(picks, problem);
  }

  /** 棚から出して、そろえ場所に置いた */
  @browser.page.interaction(page: openPicking, when: PickingPage.Ready)
  @staffOnly
  @recover(inventory.NotReserved | inventory.AlreadyPicked | shipping.NoShipment | shipping.UnknownItem, sayStale)
  @recover(http.NetworkError | http.ServerError, sayUnknownOutcome)
  fn onPicked(pick: inventory.Reservation) {
    val shipment = staffApi.picked({ orderId: pick.orderId, line: pick.line });
    placedIn(shipment);
    reload();
  }

  // ---- 出荷の一覧 ----

  /** 出荷の一覧のページ。そろうのを待っているもの、梱包できるもの、渡すのを待っているものに分ける */
  union ShipmentsPage {
    Ready: { waiting: shipping.Progress[]; toPack: shipping.Progress[]; toHandOver: shipping.Progress[]; };
    Empty: {};
    Unavailable: Unavailable;
  }

  fn shipmentsVm(all: shipping.Progress[]): ShipmentsPage;

  @staffOnly
  @unavailableOnFailure
  @browser.page.route("/shipments")
  fn openShipments(): ShipmentsPage {
    val all = staffApi.shipments({});
    return shipmentsVm(all);
  }

  /** 出荷一つの、梱包の台を開く */
  @browser.page.interaction(page: openShipments, when: ShipmentsPage.Ready)
  fn onOpenStation(id: shipping.ShipmentId) {
    clearProblem();
    goToStation(id);
  }

  // ---- 梱包の台 ----

  /** 梱包の台のページの query（/station?id=…） */
  model StationQuery {
    id: shipping.ShipmentId;
  }

  /**
   * 梱包の台のページ。アームは、出荷の進み具合で、アームごとに、できる操作が一つずつ違う。
   * 箱を選べるのは ChooseBox だけ。配送業者を選べるのは ChooseCarrier だけ。
   */
  union StationPage {
    /** まだそろっていない。置いてある品目と、待っている品目を見せる。箱は、選べない */
    Waiting: { shipment: shipping.Shipment; };
    /**
     * そろった。入る箱の種類を、小さい順に、それぞれの送料と一緒に見せる。客に約束した見積もりと上限も見せる。
     * 上限を超える箱には、「超えた分は、店が持つ」と出す
     */
    ChooseBox: { shipment: shipping.Shipment; options: shipping.BoxOption[]; problem: Problem?; };
    /** 梱包した。送料が決まった。配送業者の見積もりを見せる。選ぶと、客への請求が確定して、送り状を買う */
    ChooseCarrier: { shipment: shipping.Shipment; parcel: shipping.Parcel; offers: carrier.Quote[]; charge: payment.Payment?; problem: Problem?; };
    /** 送り状を買った。印刷して、貼って、渡す */
    HandOver: { shipment: shipping.Shipment; parcel: shipping.Parcel; label: shipping.Label; problem: Problem?; };
    /** 渡した */
    Gone: { shipment: shipping.Shipment; label: shipping.Label; };
    Unavailable: Unavailable;
  }

  fn stationVm(station: fulfilment.Station, problem: Problem?): StationPage;

  @staffOnly
  @browser.page.fallback(shipping.NoShipment | carrier.NoCarrier | http.NetworkError | http.ServerError, Unavailable)
  @browser.page.route("/station", from: query)
  fn openStation(query: StationQuery): StationPage {
    val station = staffApi.station({ id: query.id });
    return stationVm(station, problem);
  }

  /** 選んだ箱の送料が、客に約束した上限を超えるか */
  classify Overrun of type.Yen? {
    /** 超える。超えた分は、店が持つ */
    OverCeiling: type.Yen? as type.Yen;
    /** 超えない */
    WithinCeiling: type.Yen? as else;
  }

  /**
   * 梱包した: 選んだ箱の種類と、量った重さを入れる。送料が、ここで決まる。
   * 上限を超える箱を選んだときは、店が持つ額を見せて、確かめてから進む。
   */
  @browser.page.interaction(page: openStation, when: StationPage.ChooseBox)
  @staffOnly
  @recover(shipping.NoShipment | shipping.NotGathered | shipping.AlreadyPacked, sayStale)
  @recover(shipping.UnknownBox | shipping.OverWeight | shipping.Undeliverable, sayRejected)
  @recover(http.NetworkError | http.ServerError, sayUnknownOutcome)
  fn onPack(id: shipping.ShipmentId, option: shipping.BoxOption, weight: type.Grams) {
    match (option.overCeiling by Overrun) {
      OverCeiling   => confirmAbsorb(option.overCeiling);
      WithinCeiling => none;
    }
    val parcel = staffApi.pack({ id, box: option.box.code, weight });
    sealed(parcel);
    reload();
  }

  /** 店が持つ額を見せて、確かめる。やめれば、梱包は記録しない */
  @browser.page.dialog("AbsorbOverCeilingDialog")
  fn confirmAbsorb(over: type.Yen);

  /** 決まった送料を、画面に出す */
  fn sealed(parcel: shipping.Parcel);

  /**
   * 配送業者を選んで、送り状を買う。先に、客への請求が確定する。
   * 通らなかったときの理由は、三つに分ける: 請求できない（送り状は買っていない）、配送業者が引き受けない（請求は確定している）、
   * 届かなかった（どこまで進んだか分からない）。
   */
  @browser.page.interaction(page: openStation, when: StationPage.ChooseCarrier)
  @staffOnly
  @recover(shipping.NoShipment | shipping.NotPacked | shipping.AlreadyLabelled, sayStale)
  @recover(payment.NoPayment | payment.NotSecured | psp.HoldExpired, sayCannotCharge)
  @recover(carrier.UnknownCarrier | carrier.NotEnabled | carriergw.Refused, sayCarrierRefused)
  @recover(http.NetworkError | http.ServerError, sayUnknownOutcome)
  fn onBuyLabel(id: shipping.ShipmentId, offer: carrier.Quote) {
    val label = staffApi.buyLabel({ id, carrier: offer.carrier, service: offer.service });
    printLabel(label.document);
    reload();
  }

  /** 送り状を印刷する */
  @nav.save
  fn printLabel(document: type.Url);

  /** 配送業者に渡した */
  @browser.page.interaction(page: openStation, when: StationPage.HandOver)
  @staffOnly
  @recover(shipping.NoShipment | shipping.NotPacked | shipping.NotLabelled | shipping.AlreadyHandedOver | ordering.NoOrder, sayStale)
  @recover(http.NetworkError | http.ServerError, sayUnknownOutcome)
  fn onHandOver(id: shipping.ShipmentId) {
    val shipment = staffApi.handOver({ id });
    gone(shipment);
    goToShipments();
  }

  /** 渡した出荷を、画面に出す */
  fn gone(shipment: shipping.Shipment);

  // ---- 配送業者の管理 ----

  /** 配送業者のページ */
  union CarriersPage {
    Ready: { carriers: carrier.Carrier[]; problem: Problem?; };
    /** 一つも登録していない */
    Empty: { problem: Problem?; };
    Unavailable: Unavailable;
  }

  fn carriersVm(carriers: carrier.Carrier[], problem: Problem?): CarriersPage;

  @staffOnly
  @unavailableOnFailure
  @browser.page.route("/carriers")
  fn openCarriers(): CarriersPage {
    val carriers = staffApi.carriers({});
    return carriersVm(carriers, problem);
  }

  /** 配送業者を登録する */
  @staffOnly
  @recover(carrier.AlreadyRegistered, sayRejected)
  @recover(http.NetworkError | http.ServerError, sayUnknownOutcome)
  fn onRegisterCarrier() {
    val carrier = askCarrier();
    staffApi.registerCarrier({ carrier });
    reload();
  }

  /** 配送業者の名前と、契約の番号を聞く */
  @browser.page.dialog("CarrierDialog")
  fn askCarrier(): carrier.Carrier;

  /** 配送業者を使う、使わないを切り替える */
  @browser.page.interaction(page: openCarriers, when: CarriersPage.Ready)
  @staffOnly
  @recover(carrier.UnknownCarrier, sayStale)
  @recover(http.NetworkError | http.ServerError, sayUnknownOutcome)
  fn onSwitchCarrier(code: carrier.CarrierCode, enabled: boolean) {
    val changed = staffApi.setCarrierEnabled({ code, enabled });
    switched(changed);
    reload();
  }

  /** 切り替えた配送業者を、画面に出す */
  fn switched(changed: carrier.Carrier);
}
