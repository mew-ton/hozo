// docs/config.md「単位の対象」: どの単位の対象でもない名前空間。外部のシステムをモデルに含める。
// state と op を持つが、出力しないだけでエラーにはならない
/** 配送業者（外部のシステム。コードは生成しない） */
namespace carrier {
  // 出力しない名前空間の宣言にも、印は同じに付けられる
  /** 引き受けた荷物 */
  @marks.context("配送")
  state parcels: list<shop.Order>;
  /** 荷物を引き受ける */
  effect accept(order: shop.Order) on parcels.post;

  /** 営業時間外 */
  exception Closed;

  // 出力しない名前空間にも、状態の持ち主の規則（STATE-2）などの検査は同じに掛かる
  /** 荷物を引き受ける */
  @marks.context("配送")
  export op pickup(order: shop.Order)
    effects accept
    throws Closed prevents effects
  {
    checkOpen();
    accept(order);
  }
  /** 営業時間の中か確かめる */
  op checkOpen() throws Closed;
}
