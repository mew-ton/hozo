// docs/config.md「単位の対象」: hozo.toml の単位の対象の名前空間（出力する側）
/** 店（コードを生成する側） */
namespace shop {
  model Line { item: string; count: int; }
  // docs/requirements.md「モデルが先」決まったこと: 印は宣言に付ける（名前空間には付けられない。docs/grammar.md「ファイルと宣言」）
  // docs/ir.md「デコレータの適用」: DeclBase.decorators
  /** 注文 */
  @marks.context("販売")
  model Order { id: string; }

  /** カートの行 */
  state carts: list<Line>;
  /** 注文 */
  @marks.context("販売")
  state orders: list<Order>;

  /** カートに行を足す */
  effect addLine on carts.post;
  /** 注文を作る */
  effect createOrder on orders.post;

  /** 在庫がない */
  exception OutOfStock;

  export op addToCart(line: Line)
    effects addLine
    throws OutOfStock prevents effects;

  // docs/check.md「計算」手順 i の throws: @marks.requirement が marks.NotApproved を E に足す（prevents effects）。
  // op 自身の throws には書かない
  /** 注文を確定する */
  @marks.requirement("PRD-12")
  op placeOrder(): Order
    effects createOrder;

  // docs/config.md「単位の対象」: 単位の対象の名前空間の配線から、対象でない名前空間（外部のシステム）の op を呼ぶ。
  // 呼び先の例外は、どの名前空間のものでも宣言する（THROWS-1）
  /** 注文を確定して、配送業者に渡す */
  export op fulfill(): Order
    throws marks.NotApproved, carrier.Closed
  {
    const order = placeOrder();
    carrier.pickup(order);
    return order;
  }
}
