// docs/emit-go.md「出力の対象」: hozo.toml に単位はあるが、そのトランスパイラ（pick）が何も選ばない名前空間。何も出力しない。
// 検査は同じに掛かる
/** 在庫 */
namespace stock {
  scalar ItemId extends string;

  /** 引き当てた注文 */
  state reserved: list<shop.Order>;
  /** 注文の分を引き当てる */
  effect hold on reserved.post;

  /** 在庫が足りない */
  exception Short;

  // docs/emit-go.md「出力の対象」5: shop の配線から呼ばれる、別の名前空間の op。shop の Deps に載り、本体は辿られない
  /** 在庫を確かめて引き当てる */
  export op reserve(order: shop.Order)
    throws Short
  {
    count(order);
    keep(order);
  }
  op count(order: shop.Order)
    throws Short;
  op keep(order: shop.Order)
    effects hold;
}
