// テストの語彙。plugins/pick がこのデコレータを読んで、既定の出力の対象を選ぶ（plugins/pick/pick.json）。

/** テストの語彙 */
namespace t {
  /** 起点にする op（select の roots） */
  decorator entry;
  /** 選ぶが、本体は辿らない op（select の stops） */
  decorator stop;
  /** pick が包む関数を引き受けるデコレータ（select の wraps） */
  decorator cache;
  /** 起点に選ぶ状態（select の states） */
  decorator store for state;
  /** どのプラグインも読まない印 */
  decorator note(text: string);
}
