// 出力の対象のサンプル（docs/emit-go.md「出力の対象」）。
// 各ブロックの `// docs/...「見出し」` は、その構文が確かめる文書の見出し。見出し → 構文の対応は README.md。

/** 店。プラグイン pick が選んだ宣言だけを出力する */
namespace shop {
  // docs/emit-go.md「出力の対象」6: 型は、選ばれた op・状態が参照するものと、それらが参照するもの。
  // Line の item は別の名前空間 stock の型。stock の出力はその型を持たないので、shop のパッケージに複製する（docs/emit-go.md「配置」）
  model Line { item: stock.ItemId; count: int = 1; }
  model Order { id: string; lines: Line[]; }
  model Receipt { orderId: string; }
  /** 記録 */
  model Audit { at: string; }
  // 選ばれない op（saveForLater）と選ばれない状態（drafts）だけが参照する型。出力しない
  model Draft { note: string; }

  // docs/emit-go.md「出力の対象」3: 選ばれた配線（openCart）が match で読む状態
  /** カートの行 */
  state carts: list<Line>;
  // 同 3: 選ばれた葉の op（placeOrder）の効果の宛先の状態
  /** 注文 */
  state orders: list<Order>;
  // 同 1: select の states で選ぶ状態（どの op も触れない。保存先のプラグインが選ぶ形）
  /** 操作の記録 */
  @t.store
  state audits: list<Audit>;
  // どこからも選ばれない状態。出力しない
  /** 下書き */
  state drafts: list<Draft>;

  /** カートに行を足す */
  effect addLine on carts.post;
  /** 注文を作る */
  effect createOrder on orders.post;
  /** 下書きを残す */
  effect saveDraft on drafts.post;

  // docs/emit-go.md「出力の対象」1〜2: 起点の op から、配線の呼び出しを辿る
  // docs/emit-go.md「デコレータ」: @t.note はどのプラグインも読まない印。何も生成しない
  /**
   * 注文を確定して、領収書を返す。
   */
  @t.entry
  @t.note("買い物の出口")
  op checkout(): Receipt
    throws stock.Short
  {
    const order = placeOrder();
    stock.reserve(order);
    notify(order);
    const receipt = issue(order);
    return receipt;
  }

  // 同 3 と docs/emit-go.md「state」: 効果を持つ葉の op は、その効果の宛先の状態の単位の命令になる
  /** 注文を作る */
  op placeOrder(): Order
    effects createOrder;

  // docs/emit-go.md「出力の対象」2: stops の op は選ぶが、本体は辿らない。配線でも葉と同じ扱いで、口だけを出す。
  // 本体が呼ぶ sendMail と logSent は選ばれない
  /** 注文を知らせる */
  @t.stop
  op notify(order: Order)
  {
    sendMail(order);
    logSent();
  }
  op sendMail(order: Order);
  op logSent();

  // docs/emit-go.md「デコレータ」: プラグインが wraps で引き受けたデコレータの適用（@t.cache）だけが包む関数になる。
  // 同じ op の @t.note は印のまま
  /** 領収書を出す */
  @t.cache
  @t.note("領収書")
  op issue(order: Order): Receipt;

  // docs/emit-go.md「出力の対象」3: 配線が match で読む状態（carts）
  /** カートを開く */
  @t.entry
  op openCart()
  {
    match carts by list {
      Empty    => showEmpty();
      HasItems => showCart();
    };
  }
  op showEmpty();
  op showCart();

  // どこからも辿られない op。出力しない（エラーでも warning でもない）
  /** あとで買う */
  op saveForLater(draft: Draft)
    effects saveDraft;
  @t.note("未着手")
  op addToCart(line: Line)
    effects addLine;
}
