// 名前空間 shop の前半。単位 2（in = ["shop/api.hozo"]）の対象の宣言はこのファイルのものだけ（docs/config.md「in」）。

/** 店 */
namespace shop {
  /** 品物。id は別の名前空間 stock の型 */
  model Item { id: stock.ItemId; name: string; }
  /** 領収書 */
  model Receipt { item: Item; }

  /** 売れた品物 */
  state items: list<Item>;
  /** 品物を足す */
  effect fn addItem(item: Item): effects items.post;

  // docs/plugin-go.md「出力の対象」: nightly は shop/batch.hozo で宣言した配線。単位 2 では in の外（単位の対象でない）なので、
  // 単位の対象の配線 open が呼んでいる分だけ、本体のない op（Leaves の口）として出す。単位 3（in なし）では本体を出す
  /** 品物を売る */
  @t.api
  fn open(item: Item): Receipt
    throws stock.Short
  {
    stock.reserve(item.id);
    save(item);
    nightly(item);
    val receipt = issue(item);
    return receipt;
  }

  /** 品物を記録する */
  fn save(item: Item):
    effects addItem
  {
    addItem(item);
  }

  /** 領収書を出す */
  fn issue(item: Item): Receipt;
}
