// サーバー側の名前空間。web（web.hozo）から呼ばれる。各ブロックの `// docs/...「見出し」` は、その構文が確かめる文書の見出し。

/** ユーザーとセッションを持つ API */
namespace api {
  /** ユーザーの識別子 */
  scalar UserId extends string;
  /** ログインセッションのトークン */
  scalar Token extends string;
  // docs/ir.md「型」: scalar の base が別の scalar への ref
  scalar AdminToken extends Token;

  model User {
    @db.key id: UserId;
    name: string;
    /** 表に出さない */
    secret: string;
    hash: string;
    // docs/ir.md「正規化」: `T??` は `T?`（optional は入れ子にしない）
    nick: string??;
    // docs/ir.md「型」: array / record
    tags: string[];
    attrs: Record<string, string[]>;
  }
  // docs/ir.md「正規化」: `model D extends B { override a: never; ... }` は fields を展開し extends に記録
  model PublicUser extends User {
    override secret: never;
    override hash: never;
  }

  model Session { token: Token; userId: UserId; }

  @db.table state users: list<User>;
  @db.table state sessions: list<Session>;

  // docs/ir.md「state / exception / effect」: 引数を持つ例外（運ぶ値は params）。値を運ばない例外の params は []
  /**
   * 入力が不正
   *
   * @param reason 不正の理由
   */
  @http.status(400)
  exception Invalid(reason: string);
  /** 認証されていない */
  @http.status(401)
  exception Unauthorized;
  /** 見つからない */
  @http.status(404)
  exception NotFound;
  /** 応答が返らない */
  exception Timeout;

  // docs/ir.md「正規化」: ユニオンのメンバー（set）。throws に書けば例外の FQN に展開。メンバーにユニオンがあれば平らに展開
  union ClientError { Unauthorized; NotFound; }
  union AnyError { ClientError; Timeout; }

  // docs/ir.md「state / exception / effect」: 効果の params（受け取る値）
  /** セッションを作る */
  effect createSession(session: Session) on sessions.post;
  /** セッションを消す */
  effect deleteSession(token: Token?) on sessions.delete;
  /** 最終アクセスを更新する */
  effect touchUser(id: UserId) on users.put;

  // docs/ir.md「read」: read の宣言（params、returns、state）。docs/grammar.md「decorator の宣言」: 対象 read と @repeatable
  /**
   * 識別子が同じユーザー
   *
   * @param id 引くユーザーの識別子
   */
  @db.find
  read userById(id: UserId): User? on users;
  /** そのユーザーの、生きているセッション */
  @db.list
  @db.where("revoked", false)
  @db.where("kind", "web")
  read sessionsOf(userId: UserId): Session[] on sessions;

  // docs/check.md「計算」手順 i の throws（DEC-10）: external の例外は、境界の外（web）から見たときだけ Sig に入る
  /** ネットワーク越しに呼ぶ */
  @external
  decorator remote throws Timeout;
  decorator requiresAuth throws Unauthorized prevents effects;

  // docs/check.md「bind」4: web.token の位置は model の中の Token?（path ["in", "token"]）。id は呼び出し側が渡す
  model GetUserInput { token: Token?; id: UserId; }

  /**
   * ユーザーを一人返す。
   *
   * @param in 認証と識別子
   * @throws NotFound 識別子のユーザーがいない
   * @throws Timeout 応答が返らない（external の例外も @throws に書ける。docs/check.md DOC-1）
   * @see PublicUser
   */
  @remote
  @requiresAuth
  export op getUser(in: GetUserInput): PublicUser
    throws NotFound;

  model Credentials { name: string; password: string; }
  model LoginInput { creds: Credentials; remember: boolean?; }

  // docs/check.md「葉の op」: 葉は状態に触れない（reads / effects の節を書けない）。throws は書ける
  op issue(in: LoginInput): Session throws Invalid;
  op verify(id: UserId) throws ClientError;

  // docs/check.md「配線からの呼び出し」: 効果の呼び出し。docs/check.md「計算」手順 0（配線）: 上の行の issue が Invalid を
  // 投げるとき、下の行の createSession は prevented（書いた relations は計算と照合する。REL-4）
  @remote
  export op login(in: LoginInput): Session
    effects createSession
    throws Invalid prevents effects
  {
    const session = issue(in);
    createSession(session);
    return session;
  }

  // docs/check.md「bind」4: 引数そのものが位置（path ["token"]）。web から見た params は空になる
  @remote
  export op logout(token: Token?)
    effects deleteSession
  {
    deleteSession(token);
  }

  // docs/check.md「計算」手順 0（配線）: ユニオンを展開した E。上の行の touchUser は、下の行の verify の例外のとき kept。
  // docs/ir.md「正規化」の `throws A, B にユニオン`
  export op touch(id: UserId)
    effects touchUser
    throws ClientError keeps effects
  {
    touchUser(id);
    verify(id);
  }

  // ---- docs/ir.md「版」の 0.3 で足した形 ----

  // docs/ir.md「正規化」: 形の語（どの型の位置でも）は array / optional / そのままの型。`nullable<T?>` は optional(T)
  model Shapes { ids: list<UserId>; nick: nullable<string>; one: single<Token>; twice: nullable<string?>; }
  // docs/ir.md「正規化」: `state s: T;` は type に正規化した型を置き、shape と element をそこから決める
  state current: Token?;
  state motd: string;

  /** 管理者の識別子 */
  scalar AdminId extends UserId;
  // docs/ir.md「正規化」: `model D extends B { override a: never; override b: T; c: U; }`。fields は B の並びのまま
  // Override を当て、足したフィールドは末尾。override したフィールドの説明は override に書いたもの（なければなし）
  /** 管理者 */
  model Admin extends User {
    override id: AdminId;
    /** 表に出す名前 */
    @db.unique override name;
    @db.unique override secret;
    override hash: never;
    level: int;
  }

  // docs/ir.md「正規化」: `export op f()` は exported。`reads a, b`、複数の reads は ReadRef の列一つ（直に書いた状態は direct、
  // read の名前は named。重複は最初の出現に寄せる）
  // docs/check.md「reads」: 配線の R は、呼んだ read の宛先の状態（行の順）。書いた reads は、状態の集合で照合する（READS-2）
  op whenLive(user: User?, live: Session[]): User?;
  /** 識別子からユーザーを引く */
  export op findUser(id: UserId): User? reads users, sessionsOf reads users {
    const user = userById(id);
    const live = sessionsOf(id);
    return whenLive(user, live);
  }
  // docs/ir.md「型」: never は Op.returns にだけ現れる。docs/check.md「純粋」: throws は純粋さを変えない
  op unauthorized(): never throws Unauthorized;
  // docs/check.md「純粋」: デコレータがなく、状態を読まず、効果を持たない
  op nameOf(user: User): string;

  // docs/ir.md「classify」: op の分類。docs/ir.md「正規化」: ケースの `X as T`（X が型か op なら state を持たない）
  // docs/check.md「ケースの判定」: 型で決まる分類（presence）
  classify Lookup of findUser {
    Found: findUser as User;
    Missing: findUser as else;
  }
  // docs/ir.md「正規化」: ケースの `X as T` の X が状態なら、state にその FQN
  classify SignedIn of current {
    Yes: current as Token;
    No: current as else;
  }

  // docs/ir.md「配線」: アームの narrowed（as のケースでは書いた型）、本体の throw。else のアームの cases は、それが受けるケース
  // docs/check.md「計算」手順 0: アームの throw は、例外がそれだけの呼び出し。docs/check.md「reads」: 呼び出し先の R が伝わる
  op currentName(id: UserId): string
    throws NotFound
  {
    const user = findUser(id);
    return match user by Lookup {
      Found => nameOf(user);
      else  => throw NotFound;
    };
  }

  // docs/ir.md「正規化」: 配線の値の位置の状態の名前は Atom の state（match の対象、アームの本体の値）。アームの none は body の none
  // docs/check.md「reads」: match の対象と Atom が参照する状態
  op tokenOrNone(): Token?
  {
    return match current by nullable {
      HasItems => current;
      Empty    => none;
    };
  }

  // docs/ir.md「正規化」: 修飾して書いた状態の名前も Atom の state
  op greeting(): string
  {
    return api.motd;
  }

  // docs/ir.md「配線」: 状態の分類での match の narrowed は state を持つ。「返らない」アーム（never を返す op の呼び出し）
  op guard(): Token
    throws Unauthorized
  {
    return match by SignedIn {
      Yes => current;
      No  => unauthorized();
    };
  }

  // ---- docs/ir.md「版」の 0.5 で足した形 ----

  // docs/ir.md「decorator」: reads / effects の節（引数名は `$param:名前`。効果のユニオンは展開）、残りの引数（Param.rest）、
  // 対象 effect。docs/grammar.md「識別子」: 予約語のデコレータ名（宣言、適用、別名の先、@see）
  /** 表から、列が引数の値と同じ一行を引く */
  decorator find(table: any state, column: string?) for op reads table;
  /** 並べた効果を、書いた順に行う */
  decorator effects(...targets: any effect) for op effects targets reads sessions;
  /** この効果が書く表 */
  decorator into(table: any state) for effect;
  // docs/ir.md「正規化」: 名前付きデコレータの固定した引数も、残りの引数は list の Arg 一つ
  decorator both = effects(createSession, Cleanup);

  // docs/ir.md「decorator」の targets の effect: 効果の宣言の decorators
  /** 名前を変える */
  @into(users)
  effect renameUser(id: UserId, name: string) on users.put;
  union Cleanup { deleteSession; renameUser; }

  // docs/ir.md「正規化」: op に付いたデコレータの reads / effects の節は Op.carried（Op.reads / Op.effects には足さない）
  // docs/check.md「デコレータが運ぶ reads と effects」: 葉の op が直に読む状態は、Op.carried.reads の要素の状態
  /**
   * 名前からユーザーを引く。
   *
   * @see find
   * @see api.effects
   */
  @find(users, "name")
  export op findByName(name: string): User?;
  // docs/ir.md「正規化」: 残りの引数に渡した値は list の Arg 一つ（一つずつ ref か refs）
  // docs/check.md「計算」手順 0（葉）: F は運ばれた効果、rel は op の throws の relations
  @effects(createSession, deleteSession | renameUser)
  export op rotate(id: UserId, name: string)
    throws Invalid prevents effects;
  // 残りの引数に何も渡さない（items は []）。reads の節の sessions だけが運ばれる
  @effects
  op idle();
  @both
  op viaAlias(session: Session);

  // docs/check.md「計算」手順 0（配線）と「reads」: 運ばれた効果と状態は、op が書いたものと同じに呼び出し元へ伝わる
  op renew(id: UserId, name: string): User?
    throws Invalid
  {
    rotate(id, name);
    return findByName(name);
  }

  // docs/check.md「デコレータが運ぶ reads と effects」と「計算」手順 0（配線）の「運ばれた効果」: 運ぶ節を持つデコレータは、
  // 配線の op にも付けられる。運ばれたもの（Op.carried）は、本体が行き着くものの後ろに並ぶ。本体も行き着く効果（renameUser）は
  // 位置を変えず、rel は、本体から決めた状態（prevented）と、デコレータの分（関係を書いていないので unknown）が違うので unknown
  @find(motd)
  @effects(touchUser, renameUser)
  op renewAudited(id: UserId, name: string): User?
    throws Invalid
  {
    rotate(id, name);
    return findByName(name);
  }
  // 節を書いた配線は、運ばれたものも書く（READS-2、EFF-2）。運ばれた効果の rel は、葉と同じに、書いた prevents から決まる（REL-4 は
  // 食い違わない）
  @find(motd)
  @effects(touchUser, renameUser)
  op renewDeclared(id: UserId, name: string): User?
    effects createSession, deleteSession, renameUser, touchUser
    reads sessions, users, motd
    throws Invalid prevents effects
  {
    rotate(id, name);
    return findByName(name);
  }
  // 配線に運ばれたものも、呼び出し元へ伝わる
  export op renewAgain(id: UserId, name: string): User?
    throws Invalid
  {
    return renewDeclared(id, name);
  }

  // ---- docs/ir.md「版」の 0.6 で足した形 ----

  // docs/ir.md「正規化」: 配線の呼び出しの callee（read、効果の宣言、直に呼ぶ組み込みの効果）、`throw E(a, b)` の args
  // docs/check.md「直に呼ぶ組み込みの効果」: nullable の post / put は要素の型の値一つ、delete は引数なし。list の post も値一つ
  // docs/check.md「節に書く要素」: 直に呼んだ効果は direct で、同じ宛先の宣言（createSession）とは別の効果
  classify Strength of Credentials { Weak; Strong; }
  op mint(user: User): Token;
  op sessionOf(user: User, token: Token): Session;
  export op signIn(id: UserId, creds: Credentials): Token?
    effects sessions.post, current.post, current.put, current.delete
    reads userById
    throws Invalid, NotFound
  {
    const user = userById(id);
    const token = match user by Lookup {
      Found   => mint(user);
      Missing => throw NotFound;
    };
    const session = match user by Lookup {
      Found   => sessionOf(user, token);
      Missing => throw NotFound;
    };
    sessions.post(session);
    current.post(token);
    api.current.put(token);
    return match creds by Strength {
      Weak   => throw Invalid("weak password");
      Strong => keep(token);
    };
  }
  op keep(token: Token): Token? {
    current.delete();
    return token;
  }

  // ---- docs/ir.md「版」の 0.7 で足した形 ----

  // docs/ir.md「classify」: 残りのケース（`対象 as else`）は、ほかのケースと同じに cases に入り、as の by は else
  // docs/check.md「残りのケース」: presence の残りは、値がないとき。docs/types.md「残りのケースでの対象の型」: 対象の型のまま
  classify Membership of findUser {
    Member: findUser as User;
    Stranger: findUser as else;
  }
  /** 見せ方。名前だけか、ユーザーの全体 */
  union Shown {
    Brief: string;
    Whole: User;
  }
  // docs/check.md「残りのケース」: variant の残りは、ほかのケースが書いていない型のアーム。
  // docs/types.md「残りのケースでの対象の型」: 残りのアームがちょうど一つなら、そのアームの型
  classify Detail of Shown {
    Short: Shown as string;
    Full: Shown as else;
  }
  // docs/ir.md「配線」: 残りのケースのアームも、名前で書ける。narrowed は、対象の型が外と違うアームにだけ出る
  op memberName(id: UserId): string
    throws NotFound
  {
    const user = findUser(id);
    return match user by Membership {
      Member   => nameOf(user);
      Stranger => throw NotFound;
    };
  }
  op shownName(shown: Shown): string
  {
    return match shown by Detail {
      Short => shown;
      Full  => nameOf(shown);
    };
  }

  // ---- docs/ir.md「版」の 0.8 で足した形 ----

  // docs/check.md「閉じた分類」「ケースの判定」: 残りのケースを書かない分類も、型で決まる。値がない側は、どのケースでもない
  classify Arrival of findUser {
    Arrived: findUser as User;
  }
  /** ユーザーの、いまの使われ方 */
  classify Standing of User { Fresh; Active; Idle; Dormant; Closed; }
  // docs/ir.md「配線」: else のアームの cases は、ほかのアームが並べなかったケース（分類の宣言の順）で、else は true。
  // docs/types.md「アームの中の対象の型」の 1: 受けるケースが二つ以上の else のアームでは、対象は絞り込まれない
  op standingName(user: User): string
    throws NotFound
  {
    return match user by Standing {
      Closed => throw NotFound;
      else   => nameOf(user);
    };
  }
  // 名前で並べたアーム（区切りは ","）は、cases が書かれた順で、else は false
  op standingNote(user: User): string
  {
    return match user by Standing {
      Idle, Fresh => "new or idle";
      Active      => nameOf(user);
      else        => "gone";
    };
  }
  // 受けるケースがちょうど一つの else のアームは、そのケースを名前で書いたアームと同じに絞り込まれる
  op arrivedName(id: UserId): string
    throws NotFound
  {
    const user = findUser(id);
    return match user by Membership {
      Stranger => throw NotFound;
      else     => nameOf(user);
    };
  }
  // ケースが一つの分類での match。値がないことは、分類の誤り（docs/check.md「閉じた分類」）で、throws には現れない
  op onlyArrived(id: UserId): string
  {
    const user = findUser(id);
    return match user by Arrival {
      Arrived => nameOf(user);
    };
  }

  // ---- docs/ir.md「版」の 0.9 で足した形 ----

  // docs/check.md「ない側のケース」: T? を対象にした分類の、値がない側。Fresh か Lapsed かは述語、Unknown は型で決まる
  /** ユーザーの、登録の状態 */
  classify Enrolment of User? {
    Fresh: User? as User;
    Lapsed: User? as User;
    /** いない */
    Unknown: User? as none;
  }
  // docs/check.md「行の遷移」: 効果が、受け取った行の状態をどう変えるか。書き込む状態と操作は、今までどおり on の後ろ
  /** ユーザーを足す。Fresh で入る */
  effect enrol(user: User) on users.post as Standing.Fresh;
  /** ユーザーを休ませる */
  effect rest(user: User, since: Time) on users.put as Standing.Fresh, Standing.Active -> Standing.Idle;
  /** ユーザーを閉じる。どの使われ方からでも */
  effect closeUser(user: User) on users.put as any -> Standing.Closed;
  /** ユーザーを書き換える。後の使われ方は、決まっていない */
  effect amend(user: User) on users.put as Standing.Idle -> else;
  /** ユーザーを消す。消せるのは、登録が切れたユーザーだけ */
  effect forget(user: User) on users.delete as Enrolment.Lapsed -> Enrolment.Unknown;
  // docs/check.md「行の遷移」の「呼ぶ側の検査」: 前のケースを並べた効果は、そのケースを受けるアームの中で呼ぶ
  op restUser(user: User, now: Time)
  {
    match user by Standing {
      Fresh, Active => rest(user, now);
      else          => none;
    };
  }
  op forgetUser(id: UserId)
  {
    const user = userById(id);
    match user by Enrolment {
      Lapsed         => forget(user);
      Fresh, Unknown => none;
    };
  }
}
