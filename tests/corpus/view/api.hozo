// サーバー側の名前空間。web（web.hozo）から呼ばれる。各ブロックの `// docs/...「見出し」` は、その構文が確かめる文書の見出し。

/** ユーザーとセッションを持つ API */
namespace api {
  /** ユーザーの識別子 */
  scalar UserId extends string;
  /** ログインセッションのトークン */
  scalar Token extends string;
  // docs/ir.md「型」: scalar の base が別の scalar への ref
  scalar AdminToken extends Token;

  model User {
    @db.key id: UserId;
    name: string;
    /** 表に出さない */
    secret: string;
    hash: string;
    // docs/ir.md「正規化」: `T??` は `T?`（optional は入れ子にしない）
    nick: string??;
    // docs/ir.md「型」: array / record
    tags: string[];
    attrs: Record<string, string[]>;
  }
  // docs/ir.md「正規化」: `model D extends B { override a: never; ... }` は fields を展開し extends に記録
  model PublicUser extends User {
    override secret: never;
    override hash: never;
  }

  model Session { token: Token; userId: UserId; }

  @db.table(User) state users: list<User>;
  @db.table(Session) state sessions: list<Session>;

  // docs/ir.md「正規化」: 例外のその場の model は `api.Invalid.Value` に合成し、value を ref にする
  /** 入力が不正 */
  @http.status(400)
  exception Invalid: { reason: string; };
  /** 認証されていない */
  @http.status(401)
  exception Unauthorized;
  /** 見つからない */
  @http.status(404)
  exception NotFound;
  /** 応答が返らない */
  exception Timeout;

  // docs/ir.md「正規化」: ユニオンのメンバー（set）。throws に書けば例外の FQN に展開。メンバーにユニオンがあれば平らに展開
  union ClientError { Unauthorized; NotFound; }
  union AnyError { ClientError; Timeout; }

  /** セッションを作る */
  effect createSession on sessions.post;
  /** セッションを消す */
  effect deleteSession on sessions.delete;
  /** 最終アクセスを更新する */
  effect touchUser on users.put;

  // docs/check.md「計算」手順 i の throws（DEC-10）: external の例外は、境界の外（web）から見たときだけ Sig に入る
  /** ネットワーク越しに呼ぶ */
  @external
  decorator remote throws Timeout;
  decorator requiresAuth throws Unauthorized prevents effects;

  // docs/check.md「bind」4: web.token の位置は model の中の Token?（path ["in", "token"]）。id は呼び出し側が渡す
  model GetUserInput { token: Token?; id: UserId; }

  /**
   * ユーザーを一人返す。
   *
   * @param in 認証と識別子
   * @throws NotFound 識別子のユーザーがいない
   * @throws Timeout 応答が返らない（external の例外も @throws に書ける。docs/check.md DOC-1）
   * @see PublicUser
   */
  @remote
  @requiresAuth
  export op getUser(in: GetUserInput): PublicUser
    throws NotFound;

  model Credentials { name: string; password: string; }
  model LoginInput { creds: Credentials; remember: boolean?; }

  // docs/check.md「計算」手順 0（葉）: rel(Invalid, createSession) = prevented
  @remote
  export op login(in: LoginInput): Session
    effects createSession
    throws Invalid prevents effects;

  // docs/check.md「bind」4: 引数そのものが位置（path ["token"]）。web から見た params は空になる
  @remote
  export op logout(token: Token?)
    effects deleteSession;

  // docs/check.md「計算」手順 0（葉）: ユニオンを展開した E と keeps。docs/ir.md「正規化」の `throws A | B にユニオン`
  export op touch(id: UserId)
    effects touchUser
    throws ClientError keeps effects;

  // ---- docs/ir.md「版」の 0.3 で足した形 ----

  // docs/ir.md「正規化」: 形の語（どの型の位置でも）は array / optional / そのままの型。`nullable<T?>` は optional(T)
  model Shapes { ids: list<UserId>; nick: nullable<string>; one: single<Token>; twice: nullable<string?>; }
  // docs/ir.md「正規化」: `state s: T;` は type に正規化した型を置き、shape と element をそこから決める
  state current: Token?;
  state motd: string;

  /** 管理者の識別子 */
  scalar AdminId extends UserId;
  // docs/ir.md「正規化」: `model D extends B { override a: never; override b: T; c: U; }`。fields は B の並びのまま
  // Override を当て、足したフィールドは末尾。override したフィールドの説明は override に書いたもの（なければなし）
  /** 管理者 */
  model Admin extends User {
    override id: AdminId;
    /** 表に出す名前 */
    @db.unique override name;
    @db.unique override secret;
    override hash: never;
    level: int;
  }

  // docs/ir.md「正規化」: `export op f()` は exported。`reads a, b`、複数の reads は FQN の列一つ
  // docs/check.md「reads」: 葉の op の R は Op.reads
  /** 識別子からユーザーを引く */
  export op findUser(id: UserId): User? reads users, sessions reads users;
  // docs/ir.md「型」: never は Op.returns にだけ現れる。docs/check.md「純粋」: throws は純粋さを変えない
  op unauthorized(): never throws Unauthorized;
  // docs/check.md「純粋」: デコレータがなく、状態を読まず、効果を持たない
  op nameOf(user: User): string;

  // docs/ir.md「classify」: op の分類。docs/ir.md「正規化」: ケースの `X as T`（X が型か op なら state を持たない）
  // docs/check.md「ケースの判定」: 型で決まる分類（presence）
  classify Lookup of findUser {
    Found: findUser as User;
    default;
  }
  // docs/ir.md「正規化」: ケースの `X as T` の X が状態なら、state にその FQN
  classify SignedIn of current {
    Yes: current as Token;
    default;
  }

  // docs/ir.md「配線」: アームの narrowed（as のケースでは書いた型）、本体の throw
  // docs/check.md「計算」手順 0: アームの throw は、例外がそれだけの呼び出し。docs/check.md「reads」: 呼び出し先の R が伝わる
  op currentName(id: UserId): string
    throws NotFound
  {
    const user = findUser(id);
    return match user by Lookup {
      Found   => nameOf(user);
      default => throw NotFound;
    };
  }

  // docs/ir.md「正規化」: 配線の値の位置の状態の名前は Atom の state（match の対象、アームの本体の値）。アームの none は body の none
  // docs/check.md「reads」: match の対象と Atom が参照する状態
  op tokenOrNone(): Token?
  {
    return match current by nullable {
      HasItems => current;
      Empty    => none;
    };
  }

  // docs/ir.md「正規化」: 修飾して書いた状態の名前も Atom の state
  op greeting(): string
  {
    return api.motd;
  }

  // docs/ir.md「配線」: 状態の分類での match の narrowed は state を持つ。「返らない」アーム（never を返す op の呼び出し）
  op guard(): Token
    throws Unauthorized
  {
    return match by SignedIn {
      Yes     => current;
      default => unauthorized();
    };
  }

  // ---- docs/ir.md「版」の 0.5 で足した形 ----

  // docs/ir.md「decorator」: reads / effects の節（引数名は `$param:名前`。効果のユニオンは展開）、残りの引数（Param.rest）、
  // 対象 effect。docs/grammar.md「識別子」: 予約語のデコレータ名（宣言、適用、別名の先、@see）
  /** 表から、列が引数の値と同じ一行を引く */
  decorator find(table: any state, column: string?) for op reads table;
  /** 並べた効果を、書いた順に行う */
  decorator effects(...targets: any effect) for op effects targets reads sessions;
  /** この効果が書く表 */
  decorator into(table: any state) for effect;
  // docs/ir.md「正規化」: 名前付きデコレータの固定した引数も、残りの引数は list の Arg 一つ
  decorator both = effects(createSession, Cleanup);

  // docs/ir.md「decorator」の targets の effect: 効果の宣言の decorators
  /** 名前を変える */
  @into(users)
  effect renameUser on users.put;
  union Cleanup { deleteSession; renameUser; }

  // docs/ir.md「正規化」: op に付いたデコレータの reads / effects の節は Op.carried（Op.reads / Op.effects には足さない）
  // docs/check.md「デコレータが運ぶ reads と effects」: 直に読む状態は、Op.reads の後ろに Op.carried.reads
  /**
   * 名前からユーザーを引く。
   *
   * @see find
   * @see api.effects
   */
  @find(users, "name")
  export op findByName(name: string): User? reads sessions;
  // docs/ir.md「正規化」: 残りの引数に渡した値は list の Arg 一つ（一つずつ ref か refs）
  // docs/check.md EFF-3: 運ばれる効果は数えない（自分で書いた効果は一つまで）
  @effects(createSession, deleteSession | renameUser)
  export op rotate(id: UserId, name: string)
    effects touchUser
    throws Invalid prevents effects;
  // 残りの引数に何も渡さない（items は []）。reads の節の sessions だけが運ばれる
  @effects
  op idle();
  @both
  op viaAlias(session: Session);

  // docs/check.md「計算」手順 0（配線）と「reads」: 運ばれた効果と状態は、op が書いたものと同じに呼び出し元へ伝わる
  op renew(id: UserId, name: string): User?
    throws Invalid
  {
    rotate(id, name);
    return findByName(name);
  }
}
