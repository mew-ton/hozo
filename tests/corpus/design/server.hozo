// 設計書（mew-ton/drafts の hozo/README.md）§3.4、§5〜§11 の `server` の例を一つにまとめたもの。
// 設計書の言葉をそのまま写す。写せなかった箇所と足した宣言は、同じディレクトリの README.md に一覧する。
// 各ブロックの上の `// §n.m` は、設計書のどの節の例かを示す。`// 追加:` は設計書にない宣言。

// §6.5: valid が持たない制約は、ユーザーが valid の名前空間にデコレータとして足す（§3.2）
namespace valid {
  /** 末尾の 1 桁が、前の 4 桁から計算したチェックディジットと一致する */
  decorator checkDigit for scalar | field;
}

namespace server {
  // ---- §6.5 scalar（値の型） ----

  /** メールアドレス */
  @valid.format("email")
  scalar Email extends string;

  /** ユーザーの識別子 */
  scalar UserId extends string;

  /** ログインセッションのトークン */
  scalar Token extends string;

  /** パスワード（平文。入力でだけ使う） */
  @valid.length(min: 8, max: 128)
  scalar Password extends string;

  /** 社員番号（英大文字 3 字 + 数字 5 桁。末尾はチェックディジット） */
  @valid.pattern("^[A-Z]{3}[0-9]{5}$")
  @valid.checkDigit
  scalar EmployeeCode extends string;

  // 追加: §5.2 の User.status が参照する型
  /** ユーザーの状態（"active" / "unverified" / "suspended"。値の集合は実装が決める） */
  scalar UserStatus extends string;

  // 追加: §7.3 / §11 が参照する注文まわりの識別子と状態
  /** 注文の識別子 */
  scalar OrderId extends string;

  /** 注文の状態（"pending" / "paid" / "shipped" / "cancelled"。値の集合は実装が決める） */
  scalar OrderStatus extends string;

  /** 商品の識別子 */
  scalar ItemId extends string;

  /** 保証プランの識別子 */
  scalar PlanId extends string;

  // ---- §5.2 model と状態 ----

  model User {
    @db.key    id: UserId;
    @db.unique email: Email;
    // §6.5 の `model User { @valid.length(min: 1, max: 100) name: string; }` をここに併合（README.md）
    @valid.length(min: 1, max: 100) name: string;
    hash: string;
    status: UserStatus;
  }

  model Session {
    @db.key token: Token;
    userId: UserId;
    expiresAt: Time;
  }

  model PublicUser extends User {
    override hash: never;
  }

  @db.table
  state users: list<User>;

  @db.table
  state sessions: list<Session>;

  // 追加: §7.3 / §10.2 / §11 が参照する model と状態
  /** 商品 */
  model Item {
    @db.key id: ItemId;
    name: string;
    price: int;
    /** メーカー保証が付く */
    hasMakerWarranty: boolean;
    /** ヤマダ電機の専用保証の対象 */
    yamadaEligible: boolean;
  }

  /** カートの一行 */
  model CartLine {
    item: Item;
    quantity: int;
  }

  /** カートの一行に付けた保証 */
  model WarrantyLine {
    line: CartLine;
    plan: PlanId;
  }

  /** 注文 */
  model Order {
    @db.key id: OrderId;
    @db.ref(User) userId: UserId;
    status: OrderStatus;
    lines: CartLine[];
    placedAt: Time;
  }

  /** 注文一覧の一行 */
  model OrderSummary {
    id: OrderId;
    status: OrderStatus;
    placedAt: Time;
  }

  /** ユーザーへの通知 */
  model Notification {
    userId: UserId;
    message: string;
  }

  /** パスワードの再設定の依頼 */
  model PasswordReset {
    email: Email;
    expiresAt: Time;
  }

  @db.table
  state items: list<Item>;

  @db.table
  state carts: list<CartLine>;

  @db.table
  state orders: list<Order>;

  @db.table
  state notifications: list<Notification>;

  @db.table
  state passwordResets: list<PasswordReset>;

  // ---- §6.1 exception ----

  /** メールアドレスかパスワードが一致しない */
  @http.status(401)
  exception InvalidCredentials;

  model Violation { field: string; constraint: string; }
  model Violations { items: Violation[]; }

  /** 入力の形式が不正（どのフィールドがどの制約に違反したかを運ぶ） */
  @http.status(400)
  exception ClientError(value: Violations);

  /** 認証されていない */
  @http.status(401)
  exception Unauthorized;

  /** 権限がない */
  @http.status(403)
  exception Forbidden;

  // ---- §6.2 effect ----

  /** ログインセッションを作成する */
  effect createSession(login: LoginOk) on sessions.post;

  // ---- §8.1 デコレータの宣言 ----

  // 4xx は設計判断なので op ごとのデコレータで宣言する
  // op の本体より前に投げるので、すべての効果を打ち消す（§7.3）
  decorator requiresAuth throws Unauthorized prevents effects;
  decorator validated throws ClientError prevents effects;

  // ---- §7.1 op の宣言 ----

  model LoginInput {
    @http.header(name: "Authorization") token: Token?;
    @http.bodyObj body: LoginInputBody;
  }
  model LoginInputBody { email: Email; password: Password; }
  model LoginOk { user: PublicUser; token: Token; }

  @http.status(403)
  exception NotVerified;
  @http.status(403)
  exception Suspended;
  @http.status(409)
  exception AlreadyLoggedIn;

  // 追加: login の、状態に触れない部分（入力の照合）。葉の op は reads / effects を書けない（STATE-5。README.md の表の 15）
  op authenticate(in: LoginInput): LoginOk
    throws InvalidCredentials, NotVerified, Suspended, AlreadyLoggedIn;

  // §7.1 の原文は葉の op。効果を持つので、葉 authenticate と効果 createSession を呼ぶ配線にした。
  // 上の行の例外のとき、下の行の効果が起きていないこと（prevents effects）は、検査器が本体から確かめる（REL-4）
  @http.post("/login")
  @validated
  op login(in: LoginInput): LoginOk
    effects createSession
    throws InvalidCredentials, NotVerified, Suspended, AlreadyLoggedIn prevents effects
  {
    const ok = authenticate(in);
    createSession(ok);
    return ok;
  }

  // ---- §7.3 例外と効果の関係 ----

  // 追加: §7.3 の例が参照する入力・効果・例外
  /** 注文の取り消しの入力 */
  model CancelInput {
    orderId: OrderId;
  }

  /** 注文の入力 */
  model OrderInput {
    userId: UserId;
    lines: CartLine[];
  }

  /** 返金する（注文の状態を返金済みにする） */
  effect refund(orderId: OrderId) on orders.put;

  /** 注文を作成する */
  effect createOrder(order: Order) on orders.post;

  /** ユーザーに通知する */
  effect notifyUser(notice: Notification) on notifications.post;

  /** 返金の処理は受け付けたが、完了の確認が取れない */
  exception RefundPending;

  /** 通知を送れなかった */
  exception NotificationFailed;

  // 追加: §7.3 の例の、状態に触れない部分（葉の op。README.md の表の 15）
  /** 返金の完了を確かめ、取り消した注文を返す */
  op confirmRefund(in: CancelInput): Order
    throws RefundPending;
  /** 入力から注文を作る */
  op newOrder(in: OrderInput): Order;
  /** 注文の通知を作る */
  op composeNotice(order: Order): Notification
    throws NotificationFailed;

  // 効果 refund を呼んだ後の行が RefundPending を投げるので、そのとき refund は起きている（keeps effects）
  op cancelOrder(in: CancelInput): Order
    effects refund
    throws RefundPending keeps effects   // 返金の処理は受け付けたが、完了の確認が取れない
  {
    refund(in.orderId);
    return confirmRefund(in);
  }

  // 追加: §7.3 の `placeOrder` の二つの効果を、効果ごとの op に分けたもの（README.md の表の 14）
  /** 注文を保存する */
  op saveOrder(in: OrderInput): Order
    effects createOrder
  {
    const order = newOrder(in);
    createOrder(order);
    return order;
  }

  /** 注文したユーザーに通知する */
  op sendOrderNotice(order: Order)
    effects notifyUser
    throws NotificationFailed prevents effects
  {
    const notice = composeNotice(order);
    notifyUser(notice);
  }

  // §7.3 の原文は葉の op に `effects createOrder | notifyUser` と
  // `throws NotificationFailed keeps createOrder prevents notifyUser` を書く。葉の op は効果を書けず、
  // prevents / keeps の目的語は effects だけなので、配線にした。NotificationFailed のとき createOrder は
  // 起きていて（kept）、notifyUser は起きていない（prevented）ことは、検査器が本体から計算する。
  op placeOrder(in: OrderInput): Order
    throws NotificationFailed
  {
    const order = saveOrder(in);
    sendOrderNotice(order);
    return order;
  }

  // ---- §3.4 コメント ----

  // 追加: §3.4 の例が参照する効果と例外
  /** 再設定メールを送る */
  effect sendResetMail(reset: PasswordReset) on passwordResets.post;

  // 追加: requestPasswordReset の、状態に触れない部分（README.md の表の 15）
  op newPasswordReset(email: Email): PasswordReset
    throws RateLimited;

  /** 同じアドレスに短時間で送りすぎた */
  @http.status(429)
  exception RateLimited;

  /**
   * パスワードの再設定メールを送る。
   *
   * @param email 再設定するアカウントのメールアドレス
   * @throws RateLimited 同じアドレスに短時間で送りすぎた
   * @see login
   */
  @http.post("/password-reset")
  op requestPasswordReset(email: Email)
    effects sendResetMail
    throws RateLimited prevents effects
  {
    const reset = newPasswordReset(email);
    sendResetMail(reset);
  }

  // 仕様に入らない、書き手向けのメモ

  // ---- §9 配線（server 側） ----

  /** ログインセッションを削除する */
  effect deleteSession(token: Token?) on sessions.delete;

  model LogoutInput {
    @http.header(name: "Authorization") token: Token?;
  }

  // トークンがない・無効な場合のログアウトは何もしない（401 にしない）
  @http.post("/logout")
  export op logout(in: LogoutInput)
    effects deleteSession
  {
    deleteSession(in.token);
  }

  // ---- 追加: browser（§10.2、§11）が呼ぶ server の op ----
  // §11.1 の fetchMe に付く @redirectToLogin がスコープ外（docs/decisions.md）なので、
  // getMe / getOrders には @requiresAuth を付けない（付ければ browser.fetchMe が THROWS-1 に落ちる。README.md）。

  /** 自分の情報を取る入力 */
  model MeInput {
    @http.header(name: "Authorization") token: Token?;
  }

  /** ログインしているユーザー自身を返す */
  @http.get("/me")
  export op getMe(in: MeInput): PublicUser;

  /** 注文一覧の入力 */
  model GetOrdersInput {
    @http.header(name: "Authorization") token: Token?;
    /** 1 から数えるページ番号 */
    @http.default(1) @http.query page: int;
    /** 絞り込む状態。省略すればすべて */
    @http.query status: OrderStatus?;
  }

  /** ログインしているユーザーの注文一覧を返す */
  @http.get("/orders")
  export op getOrders(in: GetOrdersInput): OrderSummary[];

  /** 商品を取る入力 */
  model GetItemInput {
    @http.query id: ItemId;
  }

  /** 商品を一つ返す（認証は要らない） */
  @http.get("/item")
  export op getItem(in: GetItemInput): Item;

  /** カートに入れる入力 */
  model AddToCartInput {
    @http.header(name: "Authorization") token: Token?;
    @http.bodyObj item: Item;
  }

  /** カートに一行足す */
  effect addCartLine(line: CartLine) on carts.post;

  // 追加: addToCart の、状態に触れない部分（README.md の表の 15）
  op newCartLine(in: AddToCartInput): CartLine;

  /** 商品をカートに入れる */
  @http.post("/cart")
  export op addToCart(in: AddToCartInput): CartLine
    effects addCartLine
  {
    const line = newCartLine(in);
    addCartLine(line);
    return line;
  }

  /** 保証を付ける入力 */
  model AttachWarrantyInput {
    @http.header(name: "Authorization") token: Token?;
    @http.body line: CartLine;
    @http.body plan: PlanId;
  }

  /** カートの一行に保証を付ける */
  effect attachWarrantyToLine(line: WarrantyLine) on carts.put;

  // 追加: attachWarranty の、状態に触れない部分（README.md の表の 15）
  op withWarranty(in: AttachWarrantyInput): WarrantyLine;

  /** カートの一行に保証プランを付ける */
  @http.post("/cart/warranty")
  export op attachWarranty(in: AttachWarrantyInput): WarrantyLine
    effects attachWarrantyToLine
  {
    const line = withWarranty(in);
    attachWarrantyToLine(line);
    return line;
  }
}
