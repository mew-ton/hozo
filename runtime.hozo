// 生成したコードが import する補助の設計（docs/plugin-go-http.md「補助の設計」、決定 D804）。名前空間 hozo.runtime.gohttp。
// **設計の段**: まだ、単位の対象ではなく、コードにならない。go-http が今出す補助（docs/plugin-go-http.md「補助」）のうち、request body の
// 読み方だけを書いた。型は、出力先の言語の語彙を持たない（docs/requirements.md「型の仕組みは、出力先の語彙を持たない」）ので、Go の
// *http.Request や []byte ではなく、値の形で書く。書けなかった所は docs/open.md「語彙とプラグイン」。

/** go-http が生成したハンドラが使う、要求の読み方 */
namespace hozo.runtime.gohttp {
  /** 届いた request body。読む前のもの */
  model RawBody {
    /** 送られてきた大きさ（バイト） */
    size: int;
    /** 中身の文字列 */
    text: string;
  }

  /** request body の JSON のオブジェクト（キーから、値の JSON へ） */
  model BodyObject {
    /** キーの並び */
    keys: string[];
  }

  /** 本文の項目一つの、値の JSON */
  model ItemJSON {
    /** 値の JSON の文字列 */
    text: string;
  }

  /** request body が上限より大きい（413、body: too large） */
  exception TooLarge;
  /** request body が JSON のオブジェクトとして読めない（400、body: invalid JSON） */
  exception InvalidJSON;
  /** 必須の項目がない（400、<場所> <名前>: missing） */
  exception Missing(place: string, name: string);

  /** request body を、上限まで読み、JSON のオブジェクトにする */
  fn readBody(body: RawBody, limit: int): BodyObject
    throws TooLarge, InvalidJSON;

  /** オブジェクトの、キー name の値。キーがないか、値が null なら、ない */
  fn bodyItem(object: BodyObject, name: string): ItemJSON?;

  /** 本文の項目が、送られたか */
  classify Sent of ItemJSON? {
    /** 送られた（null でない値がある） */
    Present: ItemJSON? as ItemJSON;
    /** 送られていない（キーがないか、値が null） */
    Absent: ItemJSON? as else;
  }

  /** 必須の項目一つを読む（http.required）。送られていなければ Missing */
  export fn readRequiredItem(object: BodyObject, name: string): ItemJSON {
    val item = bodyItem(object, name);
    return match (item by Sent) {
      Present => item;
      Absent => throw Missing("body", name);
    }
  }
}
