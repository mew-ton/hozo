  "repository": {
    "field-names": {
      "comment": "フィールド名の位置（: の前、. の後ろ）の予約語は予約語として塗らない（docs/grammar.md「識別子」の FieldName / Path）。予約語が : の前や . の後ろに来る構文はほかにない",
      "patterns": [
        {
          "name": "variable.other.property.hozo",
          "match": "\\b(?:namespace|model|scalar|union|state|fn|op|exception|effect|read|classify|decorator|bind|export|override|extends|of|on|to|by|for|as|effects|reads|throws|prevents|keeps|catches|recovers|halts|ignores|any|case|val|return|match|disjoint|collect|else|throw|try|catch|none|true|false|default)\\b(?=\\s*:)"
        },
        {
          "name": "variable.other.property.hozo",
          "match": "(?\u003c=\\.)(?:namespace|model|scalar|union|state|fn|op|exception|effect|read|classify|decorator|bind|export|override|extends|of|on|to|by|for|as|effects|reads|throws|prevents|keeps|catches|recovers|halts|ignores|any|case|val|return|match|disjoint|collect|else|throw|try|catch|none|true|false|default)\\b"
        }
      ]
    },
    "override-name": {
      "comment": "override の後ろの一語もフィールド名の位置（docs/grammar.md「model」の Override）。予約語は予約語として塗らない。override そのものは修飾の予約語。予約語でないフィールド名には scope を付けない",
      "match": "\\b(override)\\s+((?:namespace|model|scalar|union|state|fn|op|exception|effect|read|classify|decorator|bind|export|override|extends|of|on|to|by|for|as|effects|reads|throws|prevents|keeps|catches|recovers|halts|ignores|any|case|val|return|match|disjoint|collect|else|throw|try|catch|none|true|false|default))\\b",
      "captures": {
        "1": {
          "name": "storage.modifier.hozo"
        },
        "2": {
          "name": "variable.other.property.hozo"
        }
      }
    },
    "comments": {
      "patterns": [
        {
          "include": "#doc-comment"
        },
        {
          "include": "#block-comment"
        },
        {
          "include": "#line-comment"
        }
      ]
    },
    "doc-comment": {
      "comment": "docs/grammar.md「ドキュメンテーションコメント」。タグは行の頭（* の後ろ）にだけ置ける",
      "name": "comment.block.documentation.hozo",
      "begin": "/\\*\\*(?!/)",
      "end": "\\*/",
      "patterns": [
        {
          "match": "(?:^|(?\u003c=\\*))\\s*(@param)(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": {
              "name": "storage.type.class.jsdoc"
            },
            "2": {
              "name": "variable.other.jsdoc"
            }
          }
        },
        {
          "match": "(?:^|(?\u003c=\\*))\\s*(@(?:throws|see))(?:\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*))?",
          "captures": {
            "1": {
              "name": "storage.type.class.jsdoc"
            },
            "2": {
              "name": "variable.other.jsdoc"
            }
          }
        },
        {
          "comment": "デコレータのタグ: 行の頭の、@ と、. を含む名前（後ろは、空白か、行の終わり）。宣言の前のデコレータと、同じ scope",
          "match": "(?:^|(?\u003c=\\*))\\s*(@[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+)(?=\\s|$)",
          "captures": {
            "1": {
              "name": "entity.name.function.decorator.hozo"
            }
          }
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.hozo",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "line-comment": {
      "name": "comment.line.double-slash.hozo",
      "match": "//.*$"
    },
    "string": {
      "comment": "TextBlock（複数行の文字列）を Quoted より先に拾う（docs/grammar.md「リテラル」）",
      "patterns": [
        {
          "name": "string.quoted.triple.hozo",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "name": "string.quoted.double.hozo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        }
      ]
    },
    "string-escape": {
      "name": "constant.character.escape.hozo",
      "match": "\\\\(?:[\"\\\\ntr]|u\\{[0-9A-Fa-f]+\\})"
    },
    "number": {
      "comment": "Int / Float / Duration（docs/grammar.md「リテラル」）。Duration は単位を含む",
      "name": "constant.numeric.hozo",
      "match": "(?\u003c![A-Za-z0-9_.])(?:-?[0-9]+\\.[0-9]+|[0-9]+(?:ms|s|m|h|d)|-?[0-9]+)\\b"
    },
    "arrow": {
      "comment": "-\u003e は状態の遷移（docs/grammar.md「exception / effect / read」の Transition）、=\u003e は match のアーム（同「配線」の MatchArm）",
      "name": "keyword.operator.arrow.hozo",
      "match": "-\u003e|=\u003e"
    },
    "rest": {
      "comment": "... はデコレータの宣言の残りの引数（docs/grammar.md「decorator の宣言」の RestParam）",
      "name": "keyword.operator.rest.hozo",
      "match": "\\.\\.\\."
    },
    "core-marks": {
      "comment": "@repeatable、@entry、@hint は核の印でデコレータではない（docs/grammar.md「予約語」）",
      "name": "storage.modifier.hozo",
      "match": "@(?:repeatable|entry|hint)\\b"
    },
    "decorator": {
      "comment": "@ から DecoratorRef まで。最後の要素は予約語でもよい（@http.default、@effects。docs/grammar.md「識別子」）。予約語のパターンより先に拾い、予約語として塗らない",
      "name": "entity.name.function.decorator.hozo",
      "match": "@[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*"
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(model|scalar|union|exception|classify)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.hozo"
            },
            "2": {
              "name": "entity.name.type.hozo"
            }
          }
        },
        {
          "comment": "デコレータの宣言の名前は DecoratorName で、予約語でもよい（decorator default(…)。docs/grammar.md「識別子」）。decorator の直後の fn は、関数に付けるデコレータの頭（同「decorator の宣言」）。名前付きのデコレータの = の後ろ（DecoratorRef）は、適用と同じくデコレータの名前",
          "match": "\\b(decorator)\\s+(?:(fn)\\s+)?([A-Za-z_][A-Za-z0-9_]*)(?:\\s*=\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*))?",
          "captures": {
            "1": {
              "name": "keyword.declaration.hozo"
            },
            "2": {
              "name": "keyword.declaration.hozo"
            },
            "3": {
              "name": "entity.name.function.hozo"
            },
            "4": {
              "name": "entity.name.function.decorator.hozo"
            }
          }
        },
        {
          "comment": "関数（op、read、効果）の名前は、fn の直後（docs/grammar.md「関数の宣言」）。fn の前の read と effect は、予約語のパターンが塗る",
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.hozo"
            },
            "2": {
              "name": "entity.name.function.hozo"
            }
          }
        },
        {
          "match": "\\b(state)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.hozo"
            },
            "2": {
              "name": "variable.other.hozo"
            }
          }
        }
      ]
    },
    "contextual": {
      "patterns": [
        {
          "comment": "for の対象: field は for の後ろ（, で続く位置を含む）でだけ文脈キーワード。対象の並びは、節の頭（throws / catches / reads / effects）か、, のほかの記号で終わる",
          "begin": "\\b(for)\\b",
          "end": "(?=[^\\s,A-Za-z0-9_])|(?=\\b(?:throws|catches|reads|effects)\\b)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.hozo"
            }
          },
          "patterns": [
            {
              "name": "keyword.other.hozo",
              "match": "\\bfield\\b"
            },
            {
              "match": "\\b(case)\\s+(of)\\s+(?:(any)\\b|(string|boolean|int|float|datetime|date|time|duration|void|never|list|nullable|single)\\b|((?:[A-Za-z_][A-Za-z0-9_]*\\.)*[A-Z][A-Za-z0-9_]*))",
              "captures": {
                "1": {
                  "name": "keyword.control.hozo"
                },
                "2": {
                  "name": "keyword.control.hozo"
                },
                "3": {
                  "name": "keyword.control.hozo"
                },
                "4": {
                  "name": "support.type.primitive.hozo"
                },
                "5": {
                  "name": "entity.name.type.hozo"
                }
              }
            },
            {
              "include": "#keywords"
            }
          ]
        },
        {
          "match": "\\b(case)\\s+(of)\\s+(?:(any)\\b|(string|boolean|int|float|datetime|date|time|duration|void|never|list|nullable|single)\\b|((?:[A-Za-z_][A-Za-z0-9_]*\\.)*[A-Z][A-Za-z0-9_]*))",
          "captures": {
            "1": {
              "name": "keyword.control.hozo"
            },
            "2": {
              "name": "keyword.control.hozo"
            },
            "3": {
              "name": "keyword.control.hozo"
            },
            "4": {
              "name": "support.type.primitive.hozo"
            },
            "5": {
              "name": "entity.name.type.hozo"
            }
          }
        },
        {
          "comment": "outer は、節 outer throws の頭でだけ文脈キーワード（docs/grammar.md「decorator の宣言」の ThrowsClause）",
          "name": "keyword.other.hozo",
          "match": "\\bouter(?=\\s+throws\\b)"
        },
        {
          "comment": "any の種類: variant は any の後ろでだけ文脈キーワード",
          "match": "\\b(any)\\s+(variant)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.hozo"
            },
            "2": {
              "name": "keyword.other.hozo"
            }
          }
        },
        {
          "comment": "状態の操作: post / put / delete は on 状態. の後ろでだけ文脈キーワード（デコレータの引数の絞り any effect on 状態.操作。docs/grammar.md「decorator の宣言」の AnyType）",
          "match": "\\b(on)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\.(post|put|delete)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.hozo"
            },
            "3": {
              "name": "keyword.other.hozo"
            }
          }
        },
        {
          "comment": "effects の節の「状態.操作」（docs/grammar.md「exception / effect / read」の BuiltinEffect と、「op」の EffectElem）: 要素の最後の . の後ろの post / put / delete。節は ; か { か次の節の頭で終わる。節の中の as（行の遷移と、状態の遷移）は、as の後ろの型の位置",
          "begin": "\\b(effects)\\b",
          "end": "(?=[;{])|(?=\\b(?:throws|catches|effects|reads|prevents|keeps|recovers|halts|ignores)\\b)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.hozo"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "comment": "as の後ろの型の位置。ケースの as の後ろの型（docs/grammar.md「classify」の CaseTyping。, で次の CaseTyping が続く）と、遷移のケース（同「exception / effect / read」の RowClause と Transition: as C.D、as else、as HasItems -\u003e Empty。-\u003e は、状態の遷移の矢印、any と else は予約語）。; か { まで続く",
              "begin": "\\b(as)\\b",
              "end": "(?=[;{])",
              "beginCaptures": {
                "1": {
                  "name": "keyword.control.hozo"
                }
              },
              "patterns": [
                {
                  "include": "#arrow"
                },
                {
                  "include": "#type"
                },
                {
                  "include": "#keywords"
                }
              ]
            },
            {
              "name": "keyword.other.hozo",
              "match": "(?\u003c=\\.)(?:post|put|delete)\\b(?!\\s*\\.)"
            }
          ]
        },
        {
          "comment": "配線で直に呼ぶ「状態.操作(…)」（docs/grammar.md「配線」の Call）: . の後ろで、直後が ( の post / put / delete",
          "name": "keyword.other.hozo",
          "match": "(?\u003c=\\.)(?:post|put|delete)(?=\\s*\\()"
        }
      ]
    },
    "type": {
      "comment": "型の位置に現れるもの。核の型、\u003c \u003e の中、大文字で始まる名前、絞り込んだ型の on（docs/grammar.md「型」の OnType: T on C.K | C.K2。on の後ろのケースは、大文字で始まる名前の規則が拾い、| には scope を付けない）",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#core-types"
        },
        {
          "include": "#generic"
        },
        {
          "name": "keyword.control.hozo",
          "match": "\\bon\\b"
        },
        {
          "name": "entity.name.type.hozo",
          "match": "\\b(?:[A-Za-z_][A-Za-z0-9_]*\\.)*[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "core-types": {
      "comment": "核の型と形の名前（docs/grammar.md「予約語」「型」の 13 語）。予約語ではないので、型の位置の規則（#type）の中でだけ塗る。token.TypeNames から生成",
      "name": "support.type.primitive.hozo",
      "match": "\\b(?:string|boolean|int|float|datetime|date|time|duration|void|never|list|nullable|single)\\b"
    },
    "generic": {
      "begin": "\u003c",
      "end": "\u003e",
      "patterns": [
        {
          "include": "#type"
        }
      ]
    },
    "type-positions": {
      "patterns": [
        {
          "comment": ": の後ろ（フィールド、引数、返り値、状態、例外の値、遷移のケース、ケースの as）。値の位置の : も通るが、小文字で始まる名前は型にしない。any の種類もここに来る",
          "begin": ":",
          "end": "(?=[=;,(){}\\[\\]])|(?=\\b(?:throws|effects|reads|catches|prevents|keeps)\\b)",
          "patterns": [
            {
              "include": "#arrow"
            },
            {
              "include": "#field-names"
            },
            {
              "include": "#contextual"
            },
            {
              "include": "#type"
            },
            {
              "include": "#string"
            },
            {
              "include": "#number"
            },
            {
              "include": "#keywords"
            }
          ]
        },
        {
          "comment": "extends / of の後ろ（元の model、scalar の元の型、分類の対象）。of の後ろの op や状態の名前は小文字で始まるので、scope が付かない",
          "begin": "\\b(extends|of)\\b",
          "end": "(?=[;{])",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.hozo"
            }
          },
          "patterns": [
            {
              "include": "#type"
            }
          ]
        },
        {
          "comment": "as の後ろの型の位置。ケースの as の後ろの型（docs/grammar.md「classify」の CaseTyping。, で次の CaseTyping が続く）と、遷移のケース（同「exception / effect / read」の RowClause と Transition: as C.D、as else、as HasItems -\u003e Empty。-\u003e は、状態の遷移の矢印、any と else は予約語）。; か { まで続く",
          "begin": "\\b(as)\\b",
          "end": "(?=[;{])",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.hozo"
            }
          },
          "patterns": [
            {
              "include": "#arrow"
            },
            {
              "include": "#type"
            },
            {
              "include": "#keywords"
            }
          ]
        },
        {
          "comment": "match の by の後ろの分類の名前（修飾できる。docs/grammar.md「配線」の Match）。標準の分類 list / nullable は形の語として塗る",
          "begin": "\\b(by)\\b",
          "end": "(?=[;{])",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.hozo"
            }
          },
          "patterns": [
            {
              "include": "#type"
            }
          ]
        },
        {
          "comment": "throws / catches / throw の後ろの例外の名前。throw の引数の括弧（docs/grammar.md「配線」の Throw）の手前で終わり、引数は値の位置として塗る",
          "begin": "\\b(throws|catches|throw)\\b",
          "end": "(?=[;{(])|(?=\\b(?:throws|catches|effects|reads|prevents|keeps|recovers|halts|ignores)\\b)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.hozo"
            }
          },
          "patterns": [
            {
              "include": "#type"
            }
          ]
        }
      ]
    },
    "keywords": {
      "comment": "予約語。docs/grammar.md「予約語」の表の順。token.Keywords から生成",
      "patterns": [
        {
          "include": "#keywords.declaration"
        },
        {
          "include": "#keywords.modifier"
        },
        {
          "include": "#keywords.control"
        },
        {
          "include": "#keywords.constant"
        }
      ]
    },
    "keywords.declaration": {
      "name": "keyword.declaration.hozo",
      "match": "\\b(?:namespace|model|scalar|union|state|fn|op|exception|effect|read|classify|decorator|bind)\\b"
    },
    "keywords.modifier": {
      "name": "storage.modifier.hozo",
      "match": "\\b(?:export|override)\\b"
    },
    "keywords.control": {
      "name": "keyword.control.hozo",
      "match": "\\b(?:extends|of|on|to|by|for|as|effects|reads|throws|prevents|keeps|catches|recovers|halts|ignores|any|case|val|return|match|disjoint|collect|else|throw|try|catch)\\b"
    },
    "keywords.constant": {
      "name": "constant.language.hozo",
      "match": "\\b(?:none|true|false)\\b"
    }
  }
}
