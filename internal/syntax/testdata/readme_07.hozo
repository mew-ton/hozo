// 設計書 §7.1 op の宣言、§7.3 例外と効果の関係。
// `token?: Token` は `token: Token?` に直した。

namespace server {
  model LoginInput {
    @http.header(name: "Authorization") token: Token?;
    @http.body body: LoginInputBody;
  }
  model LoginInputBody { email: Email; password: Password; }
  model LoginOk { user: PublicUser; token: Token; }

  @http.status(403)
  exception NotVerified;
  @http.status(403)
  exception Suspended;
  @http.status(409)
  exception AlreadyLoggedIn;

  @http.post("/login")
  @validated
  fn login(in: LoginInput): LoginOk
    effects createSession
    throws InvalidCredentials, NotVerified, Suspended, AlreadyLoggedIn prevents effects;
}

fn cancelOrder(in: CancelInput): Order
  effects refund
  throws RefundPending keeps effects;   // 返金の処理は受け付けたが、完了の確認が取れない

// §7.3 の `fn placeOrder(in: OrderInput): Order effects createOrder | notifyUser
// throws NotificationFailed keeps createOrder prevents notifyUser;` は書けない: 葉の op が直に持てる効果は一つまで
// （docs/decisions.md「設計書から離れた決定」S8）で、prevents / keeps の目的語は effects だけ（同 S9）。
// 効果ごとの葉の op を配線でつなぐ。NotificationFailed のとき createOrder は kept、notifyUser は prevented と計算される。
fn saveOrder(in: OrderInput): Order
  effects createOrder;

fn sendOrderNotice(order: Order):
  effects notifyUser
  throws NotificationFailed prevents effects;

fn placeOrder(in: OrderInput): Order
  throws NotificationFailed
{
  val order = saveOrder(in);
  sendOrderNotice(order);
  return order;
}
