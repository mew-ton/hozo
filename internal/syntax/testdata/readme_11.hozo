// 設計書 §11.2 ページとルーティング。
// §11.1 の fetchMe / fetchOrders（`@redirectToLogin` / `@cache`）はスコープ外（決定 D791、D792）なので外した。
// `status?: server.OrderStatus` は `status: server.OrderStatus?` に直し、
// ユニオンのアームの中のフィールドの末尾に `;` を足した（docs/grammar.md「model」）。
// `page: PosInt = 1` の既定値は外した（フィールドの既定値は書けない。docs/grammar.md「決めたこと」）。

namespace browser {
  model OrdersQuery { page: PosInt; status: server.OrderStatus?; }

  /** 一時的に表示できない */
  model Unavailable {}
  /** 注文一覧を一時的に表示できない */
  model OrdersUnavailable {}

  union OrderPage {
    Ready: { userName: string; orders: OrderRow[]; };
    Empty: { userName: string; };
    Unavailable: OrdersUnavailable;
  }

  // 共通のエラー表示: 汎用の page.fallback に引数を固定した別名
  decorator unavailableOnFailure = page.fallback(http.NetworkError | http.ServerError, Unavailable);

  fn orderPageVm(me: server.PublicUser, orders: server.OrderSummary[]): OrderPage;

  /** 注文一覧の既定の URL に置き換える */
  effect fn transitionToOrders(): effects location.put;

  // このページだけ別の表示にする。fallback が吸収するので throws は書かない
  // OrdersUnavailable は OrderPage のアームの型
  @page.fallback(http.NetworkError | http.ServerError, OrdersUnavailable)
  @page.route("/orders", from: query, onInvalid: transitionToOrders)
  fn openOrders(query: OrdersQuery): OrderPage
  {
    val me     = fetchMe();
    val orders = fetchOrders(query);
    return orderPageVm(me, orders);
  }

  union ProfilePage {
    Ready: { userName: string; };
    Unavailable: Unavailable;
  }
  fn profilePageVm(me: server.PublicUser): ProfilePage;

  // 共通のエラー表示を使う。Unavailable は ProfilePage のアームの型
  @unavailableOnFailure
  @page.route("/profile")
  fn openProfile(): ProfilePage
  {
    val me = fetchMe();
    return profilePageVm(me);
  }
}
