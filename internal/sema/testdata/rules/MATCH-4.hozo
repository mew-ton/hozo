// MATCH-4: アームの中で対象は絞り込まれた型になる（docs/check.md「classify / match」）
namespace a {
  model M { id: string; }
  classify C of M { A; B; }
  op onA(m: C.A<M>): void;
  op onB(m: C.B<M>): void;
  op wide2(m: M): void;
  op f(m: M): void {
    match m by C {
      A => onB(m);                     // ERROR: MATCH-4
      B => onB(m);
    };
  }
  op g(m: M): void {
    match m by C {
      A | B => onA(m);                 // ERROR: MATCH-4
    };
  }
  op h(m: M, n: M): void {
    match m by C {
      A => onA(n);                     // ERROR: TYPE-4
      B => wide2(m);
    };
  }
  op wide(m: C.A<M>): void;
  op ok(m: M): void {
    match m by C {
      A => onA(m);
      B => wide2(m);
    };
  }
}
