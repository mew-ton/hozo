// MATCH-4: アームの中で対象は絞り込まれた型になる（docs/check.md「classify / match」）
namespace a {
  model M { id: string; }
  classify C of M { A; B; }
  fn onA(m: M on C.A): void;
  fn onB(m: M on C.B): void;
  fn wide2(m: M): void;
  fn f(m: M): void {
    match (m by C) {
      A => onB(m);                     // ERROR: MATCH-4
      B => onB(m);
    };
  }
  fn g(m: M): void {
    match (m by C) {
      A, B => onA(m);                  // ERROR: MATCH-4
    };
  }
  fn h(m: M, n: M): void {
    match (m by C) {
      A => onA(n);                     // ERROR: TYPE-4
      B => wide2(m);
    };
  }
  fn wide(m: M on C.A): void;
  fn ok(m: M): void {
    match (m by C) {
      A => onA(m);
      B => wide2(m);
    };
  }
}
