// THROWS-3（tests/rules/THROWS-3/ng_1.hozo と同じ。docs/check.md「throws」「never を返す op」）: never を返す op は、引数を持たない例外をちょうど一つ投げる葉で、
// 引数も、reads / effects を運ぶデコレータも、catches を持つデコレータも持たない。満たさない条件ごとに一つ
namespace a {
  model Detail { reason: string; }
  exception E;
  exception F;
  exception WithValue(value: Detail);
  union Both { E; F; }
  state s: list<string>;
  effect add(x: string) on s.post;
  decorator swallow catches E recovers;
  decorator mark;
  // 1. 葉でない（位置は op の名前）
  op body(): never throws E {          // ERROR: THROWS-3
    return leaf();
  }
  op leaf(): never throws E;
  // 2. 例外がちょうど一つでない（位置は throws。なければ op の名前）
  op none1(): never;                   // ERROR: THROWS-3
  op two(): never throws E, F;        // ERROR: THROWS-3
  op viaUnion(): never throws Both;       // ERROR: THROWS-3
  op twoClauses(): never
    throws E                           // ERROR: THROWS-3
    throws F;
  // 3. 例外が引数を持つ（引数を持つ例外は、配線のアームで値を渡して投げる）
  op carries(): never throws WithValue;    // ERROR: THROWS-3
  // 4. 引数を持つ（位置は最初の引数）
  op params(x: string, y: int): never throws E;    // ERROR: THROWS-3
  // 6. catches を持つデコレータが付いている（位置はそのデコレータ）
  @mark
  @swallow                             // ERROR: THROWS-3
  op caught(): never throws E;
  // 5. デコレータが運ぶ reads / effects を持てない（位置はそのデコレータ）
  decorator reading(table: any state) for op reads table;
  decorator writing(...targets: any effect) for op effects targets;
  @mark
  @reading(s)                          // ERROR: THROWS-3
  op carriesRead(): never throws E;
  @writing(add)                        // ERROR: THROWS-3
  op carriesEffect(): never throws E;
  // 残りの引数に何も渡していなければ、運ぶものがない
  @writing
  op carriesNothing(): never throws E;
  // 節に書いたものは、葉なので STATE-5（THROWS-3 は重ねない）
  op written(): never reads s throws E;   // ERROR: STATE-5
}
