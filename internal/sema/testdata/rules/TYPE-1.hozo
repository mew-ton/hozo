// TYPE-1: 核の型（リテラルを含む）の値を scalar の位置に渡した（docs/types.md「診断」）
namespace a {
  scalar Email extends string;
  model In { email: Email; }
  fn send(email: Email): void;
  fn f(): void {
    send("a@b");                       // ERROR: TYPE-1
  }
  fn g(s: string): void {
    send(s);                           // ERROR: TYPE-1
  }
  fn h(): void {
    send({ email: "a@b" });            // ERROR: TYPE-4
  }
  fn i(e: Email): void {
    send(e);
  }
  decorator d(e: Email);
  @d("x")                              // ERROR: TYPE-1
  fn j(): void;
  fn k(s: string): void {
    take({ email: s });                // ERROR: TYPE-1
  }
  fn take(in: In): void;
}
