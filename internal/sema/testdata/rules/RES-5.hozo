// RES-5: effect ... on が別の名前空間の状態（遷移なら、別の名前空間の分類か状態）を指している（docs/resolve.md「診断」）
namespace a {
  state s: list<string>;
  classify Phase of s { Idle; Busy; }
  effect fn ok() on s.post;
  effect fn okTransition() on s: Empty -> HasItems;
  effect fn okPhase() on Phase: Idle -> Busy;
}
namespace b {
  effect fn e() on a.s.post;                // ERROR: RES-5
  effect fn t() on a.s: Empty -> HasItems;  // ERROR: RES-5
  effect fn p() on a.Phase: Idle -> Busy;   // ERROR: RES-5
}
state g: list<string>;
classify G of g { None; Some; }
effect fn okGlobal() on G: None -> Some;
namespace c {
  effect fn e() on g.post;                  // ERROR: RES-5
  effect fn t() on g: any -> Empty;         // ERROR: RES-5
  effect fn p() on G: None -> Some;         // ERROR: RES-5
}
