// RES-5: effect fn の宛先（effects の後ろ）が別の名前空間の状態（遷移なら、別の名前空間の分類か状態）を指している（docs/resolve.md「診断」）
namespace a {
  state s: list<string>;
  classify Phase of s { Idle; Busy; }
  effect fn ok(): effects s.post;
  effect fn okTransition(): effects s as Empty -> HasItems;
  effect fn okPhase(): effects Phase as Idle -> Busy;
}
namespace b {
  effect fn e(): effects a.s.post;                // ERROR: RES-5
  effect fn t(): effects a.s as Empty -> HasItems;  // ERROR: RES-5
  effect fn p(): effects a.Phase as Idle -> Busy;   // ERROR: RES-5
}
state g: list<string>;
classify G of g { None; Some; }
effect fn okGlobal(): effects G as None -> Some;
namespace c {
  effect fn e(): effects g.post;                  // ERROR: RES-5
  effect fn t(): effects g as any -> Empty;         // ERROR: RES-5
  effect fn p(): effects G as None -> Some;         // ERROR: RES-5
}
