// TYPE-12: T on C.Case の T が C の対象の型（値の分類は subject の型、op の分類はその op の returns）に渡せない（docs/types.md「診断」）
namespace a {
  model M { id: string; }
  model N { name: string; }
  classify C of M { A; }
  fn ok(m: M on C.A): void;
  fn ng(n: N on C.A): void;              // ERROR: TYPE-12
  // op の分類の対象の型は、その op の returns
  fn find(): M?;
  classify Found of find { Hit; Other; }
  fn ok2(m: M? on Found.Hit): void;
  fn ok3(m: M on Found.Hit): void;
  fn ng3(n: N on Found.Hit): void;       // ERROR: TYPE-12
  // 状態の分類のケースで絞り込んだ型は書けない（RES-4。docs/resolve.md「位置ごとに受け付ける種類」の「型」）
  state items: list<M>;
  classify Stock of items { None; Some; }
  fn ng2(m: M on Stock.Some): void;      // ERROR: RES-4
}
