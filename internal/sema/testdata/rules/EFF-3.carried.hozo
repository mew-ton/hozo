// EFF-3（docs/check.md「状態と効果」「デコレータが運ぶ reads と effects」）: 数えるのは、葉の op が自分で書いた効果だけ。
// デコレータが運ぶ効果はいくつでもよい
namespace a {
  state s: list<string>;
  state t: nullable<string>;
  effect e on s.post;
  effect f on t.post;
  effect g on t.delete;
  union Both { e; f; }
  decorator doing(...targets: any effect) for op effects targets;
  @doing(e, f, g) op carried(x: string, y: string, z: string);
  @doing(Both) op carriedUnion(x: string);
  @doing(e, f) op carriedAndOne(x: string, y: string) effects g;
  @doing(e, f) op carriedAndSame(x: string, y: string) effects e;
  @doing(e)                                     // 自分で書いた分が二つなら、運ばれた分があっても EFF-3
  op carriedAndTwo(x: string) effects f, g;    // ERROR(-1): EFF-3
}
