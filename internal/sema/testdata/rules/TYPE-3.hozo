// TYPE-3: return の値の型が op の returns に渡せない（docs/types.md「診断」）
namespace a {
  model User { id: string; hash: string; }
  model PublicUser extends User { override hash: never; }
  model Other { name: string; }
  exception Gone;
  fn user(): User;
  fn other(): Other;
  fn toPublic(u: User): PublicUser;
  fn gone(): never throws Gone;
  classify Kind of User { A; B; }
  // 継承した model は別の型で、どちらの向きにも渡せない。写す op を呼ぶ
  fn projected(): PublicUser {
    return user();                     // ERROR: TYPE-3
  }
  fn mapped(): PublicUser {
    val u = user();
    return toPublic(u);
  }
  fn wrong(): PublicUser {
    return other();                    // ERROR: TYPE-3
  }
  fn core(): int {
    return other();                    // ERROR: TYPE-3
  }
  fn fromRecord(): Other {
    return { name: "x" };
  }
  fn noneToRequired(): Other {
    return none;                       // ERROR: TYPE-3
  }
  fn noneToOptional(): Other? {
    return none;
  }
  // 「返らない」式は、どの型の return にも書ける
  fn never1(): Other throws Gone {
    return gone();
  }
  fn never2(u: User): int throws Gone {
    return match (u by Kind) { A => throw Gone; B => gone(); };
  }
}
