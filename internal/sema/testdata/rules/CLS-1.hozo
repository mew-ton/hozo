// CLS-1: ケース名の重複、残りのケース（as else）が二つ以上（docs/check.md「classify / match」「残りのケース」）
namespace a {
  model M { id: string; }
  classify D of M {
    A;
    A;                                 // ERROR: CLS-1
  }
  classify Thrice of M {
    A;
    B;
    A;                                 // ERROR: CLS-1
    A;                                 // ERROR: CLS-1
  }
  classify Ok of M { A; B; C; }
  fn find(): M?;
  classify TwoElse of find {
    Found: find as M;
    Missing: find as else;
    Gone: find as else;                // ERROR: CLS-1
  }
  classify TwoNone of find {
    Found: find as M;
    Missing: find as none;
    Gone: find as none;                // ERROR: CLS-1
  }
  classify OkElse of find { Found: find as M; Missing: find as else; }
  // 残りのケースを書かない分類は、型を書いたケースだけ（値がない側は、どのケースでもない。docs/check.md「ケースの判定」）
  classify OkNoRest of find { Found: find as M; }
}
