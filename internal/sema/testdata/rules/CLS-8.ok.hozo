// CLS-8（docs/check.md「ない側のケース」）: as none を書けるのは、値の分類か op の分類で、対象の型が T?、
// ほかのケースが一つ以上あり、どれも T? as T を持つとき。ほかのケースが一つなら型で決まる分類、二つ以上なら述語で決まる分類
namespace a {
  model M { id: string; }
  op find(): M?;
  op take(m: M);
  op f();
  classify Known of M? { Found: M? as M; Missing: M? as none; }
  classify Life of M? {
    Draft: M? as M;
    Placed: M? as M;
    /** ない */
    Absent: M? as none;
  }
  classify Hit of find { Absent: find as none; Found: find as M; }
  op use(m: M?) {
    match (m by Known) { Found => take(m); Missing => none; };
    match (m by Life) { Draft => take(m); Placed => f(); Absent => none; };
  }
}
