// WIRE-3: return の有無と位置（docs/check.md「配線」）
namespace a {
  model M { id: string; }
  fn value(): M;
  fn noValue(): void;
  fn voidReturns(): void {
    return value();                    // ERROR: WIRE-3
  }
  fn noReturn(): M {                   // ERROR: WIRE-3
    noValue();
  }
  fn empty(): M {                      // ERROR: WIRE-3
  }
  fn notLast(): M {
    return value();                    // ERROR: WIRE-3
    noValue();
  }
  fn ok(): M {
    noValue();
    return value();
  }
}
