// STATE-2（docs/check.md「状態と効果」）のうち、デコレータが運ぶ効果の分: 葉の op に運ばれた効果の名前空間（直に書いた効果なら、
// その状態の名前空間）が、op の名前空間と違う。位置はそのデコレータの適用
namespace a {
  state s: list<string>;
  state t: nullable<string>;
  effect fn e(x: string): effects s.post;
  effect fn f(x: string): effects t.post;
  union Both { e; f; }
  decorator fn doing(...targets: any effect): effects targets;
  decorator fn doingE(): effects e;
  decorator fn posting(): effects s.post;
  @doing(e, f) fn ownCarried(x: string, y: string);
  @doingE @posting export fn own();
}
namespace b {
  state u: list<string>;
  effect fn g(x: string): effects u.post;
  @a.doing(g)
  fn carriedOwn(x: string);
  @a.doing(a.e)                                  // ERROR: STATE-2
  fn carried(x: string);
  @a.doing(g, a.Both)                            // ERROR: STATE-2
  fn carriedUnion(x: string, y: string, z: string);
  @a.doingE                                      // ERROR: STATE-2
  fn carriedFixed();
  @a.posting                                     // ERROR: STATE-2
  fn carriedDirect();
  // 配線の op の節には、別の名前空間の効果を書ける（呼び出し先から伝わった効果。EFF-2 が照合する）
  fn wire(): effects a.e, a.s.post {
    a.own();
  }
}
