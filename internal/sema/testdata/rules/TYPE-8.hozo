// TYPE-8: match のアームの型がそろわない（docs/types.md「診断」）
namespace a {
  model M { id: string; }
  model N { name: string; }
  classify C of M { A; B; }
  fn m(x: M): M;
  fn n(x: M): N;
  fn v(x: M): void;
  fn use(x: M?): void;
  fn differ(x: M): void {
    val r = match (x by C) {           // ERROR: TYPE-8
      A => m(x);
      B => n(x);
    };
    use(r);
  }
  fn mixed(x: M): void {
    val r = match (x by C) {           // ERROR: TYPE-8
      A => m(x);
      B => v(x);
    };
    use(r);
  }
  fn ok(x: M): void {
    val r = match (x by C) {
      A => m(x);
      B => none;
    };
    use(r);
  }
}
