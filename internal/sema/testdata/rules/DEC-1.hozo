// DEC-1: 付けられる対象は for で決まる（docs/check.md「デコレータ」）
namespace a {
  model M { id: string; }
  state s: list<M>;
  @http.status(400)                    // ERROR: DEC-1
  op f(): void;
  @db                                  // ERROR: DEC-1
  union U { Ready: M; }
  @http.retry(3)                       // ERROR: DEC-1
  model N { @http.get("/x") id: string; }   // ERROR: DEC-1
  @db
  state okState: list<M>;
  decorator onlyOp;
  @onlyOp                              // ERROR: DEC-1
  effect e on s.post;
  @onlyOp                              // ERROR: DEC-1
  classify C of M { A; }
  @onlyOp                              // ERROR: DEC-1
  decorator other;
  @onlyOp
  op ok(): void;
}

// namespace に付けられるのは `for namespace` のデコレータだけ
namespace marks {
  decorator context(name: string) for namespace;
  decorator both for op | namespace;
  decorator modelOnly for model;
}
@marks.context("注文")
@marks.both
namespace okNs {
  @marks.both
  op f(): void;
  @marks.context("x")                  // ERROR: DEC-1
  op g(): void;
}
@a.onlyOp                              // ERROR: DEC-1
namespace ngOp { }
@marks.modelOnly                       // ERROR: DEC-1
@db                                    // ERROR: DEC-1
namespace ngModel { }
namespace outer {
  decorator inner for namespace;
  // 適用の名前は、ブロックが書かれた場所（外側の名前空間）で解決する
  @inner
  namespace sub { }
}
