// DEC-1: 付けられる対象は for で決まる（docs/check.md「デコレータ」）。対象 effect は、効果の宣言に付けるデコレータ
namespace a {
  model M { id: string; }
  state s: list<M>;
  @http.status(400)                    // ERROR: DEC-1
  op f(): void;
  @db.table(M)                         // ERROR: DEC-1
  union U { Ready: M; }
  @http.retry(3)                       // ERROR: DEC-1
  model N { @http.get("/x") id: string; }   // ERROR: DEC-1
  @db.table(M)
  state okState: list<M>;
  decorator onlyOp;
  @onlyOp                              // ERROR: DEC-1
  effect e on s.post;
  @onlyOp                              // ERROR: DEC-1
  classify C of M { A; }
  @onlyOp                              // ERROR: DEC-1
  decorator other;
  @onlyOp
  op ok(): void;
  // 対象 effect: 効果の宣言に付けられ、宣言にない対象（op、state）には付けられない
  decorator onlyEffect for effect;
  decorator opOrEffect for op | effect;
  @onlyEffect @opOrEffect @db.insert(s)
  effect okEffect on s.post;
  @db.update(s) @db.delete(s, "id")
  effect okEffect2 on s.put;
  @onlyEffect                          // ERROR: DEC-1
  op notEffect(): void;
  @db.insert(s)                        // ERROR: DEC-1
  state notEffect2: list<M>;
  @opOrEffect
  op ok2(): void;
  @db.find(s, "id")                    // ERROR: DEC-1
  effect notOp on s.delete;
  @onlyEffect                          // ERROR: DEC-1
  union V { Ready: M; }
  @onlyEffect                          // ERROR: DEC-1
  classify D of M { A; }
  @onlyEffect                          // ERROR: DEC-1
  decorator another;
}
