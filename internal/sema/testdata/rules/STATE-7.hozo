// STATE-7（docs/check.md「行の遷移」の「結びつき」）: as のケースの分類が、書き込む状態の行の分類でない。ケースが、その分類のケースでない
namespace a {
  model Order { id: string; }
  model Job { id: string; }
  state orders: list<Order>;
  state jobs: list<Job>;
  fn find(): Order?;
  classify Stage of Order { Draft; Accepted; Shipped; }
  classify Progress of Job { Queued; Done; }
  classify Hit of find { Found: find as Order; Missing: find as else; }
  classify Filled of orders { Some; None; }
  effect fn a1(order: Order): effects orders.put as Progress.Done;                      // ERROR: STATE-7
  effect fn a2(order: Order): effects orders.post as Hit.Found;                         // ERROR: STATE-7
  effect fn a3(order: Order): effects orders.post as Filled.Some;                       // ERROR: STATE-7
  effect fn a4(order: Order on Stage.Draft): effects orders.put as Stage.Packed;        // ERROR: STATE-7
}
