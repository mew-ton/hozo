// CLS-7: 残りのケース（対象 as else）を書けるのは、残りが型で決まるときだけ（docs/check.md「残りのケース」）
namespace a {
  model M { id: string; }
  model N { id: string; }
  model O { id: string; }
  scalar Email extends string;
  union Two { Ready: M; Missing: N; }
  union Three { Ready: M; Missing: N; Broken: O; }
  state token: nullable<string>;
  state profile: nullable<string>;
  fn find(): M?;
  fn other(): M?;

  // 書ける: presence（値の分類、op の分類、対象の状態が一つの状態の分類）、variant（残りのアームが一つ、二つ以上）
  classify V of M? { Has: M? as M; Lacks: M? as else; }
  classify F of find { Found: find as M; NotFound: find as else; }
  classify S of token { LoggedIn: token as string; LoggedOut: token as else; }
  classify P2 of Two { IsReady: Two as M; Rest: Two as else; }
  classify P3 of Three { Rest: Three as else; IsReady: Three as M; }
  // 書ける: 残りが、ちょうど「値がない」（値の分類か op の分類で、対象の型が T?、ほかのケースが、どれも T? as T。
  // ほかのケースが二つ以上で、述語で決まる分類でも）
  classify Life of M? { Draft: M? as M; Placed: M? as M; Absent: M? as else; }
  classify Session of find { Fresh: find as M; Stale: find as M; Missing: find as else; }

  // 述語のケースの隣には書けない
  classify NoAs of M? {
    Has;
    Lacks: M? as else;                 // ERROR: CLS-7
  }
  classify Predicate of string {
    Valid: string as Email;
    Invalid: string as else;           // ERROR: CLS-7
  }
  classify SameArm of Two {
    Fresh: Two as M;
    Stale: Two as M;
    Other: Two as else;                // ERROR: CLS-7
  }
  classify SameTypeState of token {
    Fresh: token as string;
    Stale: token as string;
    LoggedOut: token as else;          // ERROR: CLS-7
  }
  // as none のある分類には、残りがない
  classify Both of M? {
    Has: M? as M;
    Gone: M? as none;
    Rest: M? as else;                  // ERROR: CLS-7
  }
  // 対象が二つ以上の状態の分類には書けない
  classify Auth of token, profile {
    Ready: token as string, profile as string;
    NoToken: token as else;            // ERROR: CLS-7
  }
  // ほかに名前の付いたケースがない
  classify Only of M? {
    Lacks: M? as else;                 // ERROR: CLS-7
  }
  // variant で、残りのアームがない
  classify Covered of Two {
    IsReady: Two as M;
    IsMissing: Two as N;
    Other: Two as else;                // ERROR: CLS-7
  }
  // as の前は、その分類の対象（CLS-5 だけを出し、CLS-7 を重ねない）
  classify WrongSubject of find {
    Found: find as M;
    Missing: other as else;            // ERROR: CLS-5
  }
}
