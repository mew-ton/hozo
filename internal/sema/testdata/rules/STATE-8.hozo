// STATE-8（docs/check.md「行の遷移」の「操作ごとに書ける形」）: post と put の、書けない形
namespace a {
  model Order { id: string; }
  state orders: list<Order>;
  classify Stage of Order { Draft; Accepted; Shipped; }
  classify Life of Order? { Open: Order? as Order; Closed: Order? as Order; Absent: Order? as none; }
  // post: 後が、ない側のケースか else
  effect fn p1(order: Order): effects orders.post as Life.Absent;                  // ERROR: STATE-8
  effect fn p2(order: Order): effects orders.post as else;                         // ERROR: STATE-8
  // put: 後が、ない側のケース。行の引数を、ない側のケースに絞り込んだ型
  effect fn u1(order: Order on Life.Open): effects orders.put as Life.Absent;      // ERROR: STATE-8
  effect fn u2(order: Order on Life.Absent): effects orders.put as Life.Open;      // ERROR: STATE-8
  effect fn u3(order: Order on Life.Open | Life.Absent): effects orders.put as else;   // ERROR: STATE-8
  // as を書かない効果でも、行の引数を、ない側のケースに絞り込んだ型は、書けない
  effect fn u4(order: Order on Life.Absent): effects orders.put;                   // ERROR: STATE-8
}
