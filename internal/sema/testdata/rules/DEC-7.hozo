// DEC-7: any effect on の性質と、ユニオンのメンバーの照合（docs/types.md「デコレータの引数」）
namespace a {
  state s: single<string>;
  state t: list<string>;
  effect fn put() on s.put;
  effect fn post() on t.post;
  exception E;
  exception F;
  exception G;
  union Errors { E; F; }
  decorator onPut(e: any effect on s.put);
  decorator onError(error: Errors);
  @onPut(put)
  fn ok1(): void;
  @onPut(post)                         // ERROR: DEC-7
  fn ng1(): void;
  @onError(E)
  fn ok2(): void;
  @onError(E | F)
  fn ok3(): void;
  @onError(G)                          // ERROR: DEC-7
  fn ng2(): void;
  @onError(E | G)                      // ERROR: DEC-7
  fn ng3(): void;

  // any effect on s.op を満たすのは、宛先が組み込みの効果 { state: s, operation: op } の効果だけ。
  // 同じ状態に書き込む遷移の効果は満たさない
  effect fn tput() on t.put;
  effect fn drain() on t: HasItems -> Empty;
  classify Phase of t { Idle; Busy; }
  effect fn start() on Phase: Idle -> Busy;
  decorator onListPut(e: any effect on t.put);
  @onListPut(tput)
  fn ok4(): void;
  @onListPut(drain)                    // ERROR: DEC-7
  fn ng4(): void;
  @onListPut(start)                    // ERROR: DEC-7
  fn ng5(): void;
  @onListPut(post)                     // ERROR: DEC-7
  fn ng6(): void;
}
