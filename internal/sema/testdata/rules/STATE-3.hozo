// STATE-3: 状態の要素の型が optional。当たるのは list の状態だけ（docs/check.md「状態と効果」）
namespace a {
  model M { id: string; }
  state ok1: nullable<M>;
  state ok2: single<M>;
  state ok3: list<M>;
  // 要素の中の optional（配列の要素、Record の値）は要素の型そのものではない
  state ok4: single<Record<string, string?>>;
  state ok5: list<M?[]>;
  // single<T?> と nullable<T?> は T?（nullable<T>）と同じ型（docs/types.md「形の書き方」）
  state ok6: single<M?>;
  state ok7: nullable<M?>;
  state ok8: single<M??>;
  state ok9: single<string[]?>;
  state ok10: M?;
  state ng1: list<M?>;                 // ERROR: STATE-3
  state ng2: string?[];                // ERROR: STATE-3
  state ng3: list<nullable<M>>;        // ERROR: STATE-3
  state ng4: single<list<M?>>;         // ERROR: STATE-3
  // single<T?> は nullable なので、post も delete もできる
  effect fn fill(): effects ok6.post;
  effect fn clear(): effects ok6.delete;
  // STATE-3 の状態は、list<T> として残りの検査を続ける
  effect fn add(): effects ng1.post;
  fn all(): M[] {
    return ng1;
  }
}
