// WIRE-4: 束縛は一度だけ、引数と同じ名前は束縛できない（docs/check.md「配線」）
namespace a {
  model M { id: string; }
  op value(): M;
  op use(m: M): void;
  op twice(): void {
    const x = value();
    const x = value();                 // ERROR: WIRE-4
    use(x);
  }
  op param(m: M): void {
    const m = value();                 // ERROR: WIRE-4
    use(m);
  }
  op before(): void {
    use(y);                            // ERROR: RES-1
    const y = value();                 // WARN: WIRE-8
  }
}
