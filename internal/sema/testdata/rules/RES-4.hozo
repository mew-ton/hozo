// RES-4: その位置で受け付けない種類（docs/resolve.md「位置ごとに受け付ける種類」）
namespace a {
  exception E;
  state s: list<string>;
  model M { x: E; }                    // ERROR: RES-4
  fn f(): s;                           // ERROR: RES-4
  union U { E; }
  fn g(): U;                           // ERROR: RES-4
  fn h(): throws M;                     // ERROR: RES-4
  classify C of M { A; }
  fn i(): C;                           // ERROR: RES-4
  @M                                   // ERROR: RES-4
  fn j(): void;
  fn k(): M.x;                         // ERROR: RES-3
  fn l(m: M): void {
    M(m);                              // ERROR: RES-4
  }
  fn m(): a.b;                         // ERROR: RES-1
  union V { Ready: M; }
  fn n(): V;
  fn o(): V.Ready;                     // ERROR: RES-4
  fn p(): M<M>;                        // ERROR: RES-4
  // 遷移の宛先にできるのは、状態を対象にした classify か、組み込みの分類を持つ state
  effect fn q(): effects C as A -> A;               // ERROR: RES-4
  effect fn r(): effects M as A -> B;               // ERROR: RES-4
  effect fn t(): effects n as Empty -> HasItems;    // ERROR: RES-4
  // classify の対象が一つで、型でも状態でもない（値の分類の名前は C.Case<T> の形でだけ型になる）
  classify D of E { A; }               // ERROR: RES-4
  classify F of C { A; }               // ERROR: RES-4
}
