// TYPE-4: 引数の値の型が引数の型に渡せない（docs/types.md「診断」）
namespace a {
  model M { id: string; }
  model N { id: string; extra: int; }
  model O { name: string; }
  fn takeM(m: M): void;
  fn takeInt(n: int): void;
  fn takeList(l: M[]): void;
  fn n(): N;
  fn o(): O;
  fn f(): void {
    val x = o();
    takeM(x);                          // ERROR: TYPE-4
  }
  fn g(): void {
    takeInt("x");                      // ERROR: TYPE-4
  }
  fn h(): void {
    takeInt(1, 2);                     // ERROR: TYPE-4
  }
  // model の値は、別の model の位置には渡せない（フィールドを含んでいても。暗黙の射影はない）
  fn i(): void {
    val x = n();
    takeM(x);                          // ERROR: TYPE-4
    takeList(x);                       // ERROR: TYPE-4
  }
  fn j(): void {
    takeInt(none);                     // ERROR: TYPE-4
  }
  decorator fn d(n: int | float);
  @d(1.5)
  @http.retry("x")                     // ERROR: TYPE-4
  fn k(): void;
  decorator fn l(xs: string[]);
  @l(["a", 1])                         // ERROR: TYPE-4
  fn m(): void;
  @l("a")                              // ERROR: TYPE-4
  fn p(): void;
}
