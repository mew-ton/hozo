// REL-5: 一つの ThrowsClause に prevents と keeps の両方がある（docs/check.md「throws」）
namespace a {
  state s: list<string>;
  effect e() on s.post;
  exception E;
  exception F;
  decorator doing(...targets: any effect) for op effects targets;
  @doing(e) op a1() throws E prevents effects keeps effects;     // ERROR: REL-5
  @doing(e) op a2() throws E, F keeps effects prevents effects;  // ERROR: REL-5
  decorator d throws E keeps effects prevents effects;           // ERROR: REL-5
  @doing(e) op ok() throws E prevents effects throws F keeps effects;
  @doing(e) op same() throws E prevents effects prevents effects;
}
