// MATCH-7: match の形と分類が合わない（docs/check.md「classify / match」、docs/grammar.md「配線」の表）
namespace other {
  state remote: list<string>;
}
namespace a {
  model M { id: string; }
  state carts: list<M>;
  state orders: list<M>;
  state token: nullable<string>;
  state clock: single<string>;
  classify Kind of M { A; B; }
  classify Checkout of carts, orders { Shopping; Ordered; }
  op f(): void;
  op g(m: M): void;

  // 通る例: 三つの形
  op ok(m: M): void {
    match m by Kind { A => g(m); B => none; };
    match carts by list { Empty => f(); HasItems => none; };
    match token by nullable { Empty => f(); HasItems => none; };
    match by Checkout { Shopping => f(); Ordered => none; };
  }
  // 値の分類なのに対象がない
  op ng1(): void {
    match by Kind { A => f(); B => none; };                          // ERROR: MATCH-7
  }
  // 状態の分類なのに対象がある
  op ng2(m: M): void {
    match m by Checkout { Shopping => f(); Ordered => none; };       // ERROR: MATCH-7
    match carts by Checkout { Shopping => f(); Ordered => none; };   // ERROR: MATCH-7
  }
  // by list / by nullable の対象が今の名前空間のその形の状態でない: 形が違う
  op ng3(): void {
    match carts by nullable { Empty => f(); HasItems => none; };     // ERROR: MATCH-7
    match token by list { Empty => f(); HasItems => none; };         // ERROR: MATCH-7
    match clock by list { Empty => f(); HasItems => none; };         // ERROR: MATCH-7
    match clock by nullable { Empty => f(); HasItems => none; };     // ERROR: MATCH-7
  }
  // 状態でない: 値、分類、リテラル
  op ng4(m: M): void {
    match m by list { Empty => f(); HasItems => none; };             // ERROR: MATCH-7
    match Checkout by list { Empty => f(); HasItems => none; };      // ERROR: MATCH-7
    match 1 by nullable { Empty => f(); HasItems => none; };         // ERROR: MATCH-7
    match none by list { Empty => f(); HasItems => none; };          // ERROR: MATCH-7
  }
  // 別の名前空間の状態
  op ng5(): void {
    match other.remote by list { Empty => f(); HasItems => none; };  // ERROR: MATCH-7
  }
  // 対象がない
  op ng6(): void {
    match by list { Empty => f(); HasItems => none; };               // ERROR: MATCH-7
    match by nullable { Empty => f(); HasItems => none; };           // ERROR: MATCH-7
  }
  // 引数や束縛が同じ名前なら値の参照になる（docs/resolve.md「手続き」1.1）ので、状態ではない
  op ng7(carts: M): void {
    match carts by list { Empty => f(); HasItems => g(carts); };     // ERROR: MATCH-7
  }
  // 解決できない名前は RES-1（MATCH-7 は重ねない）
  op ng8(): void {
    match nothing by list { Empty => f(); HasItems => none; };       // ERROR: RES-1
  }
}
