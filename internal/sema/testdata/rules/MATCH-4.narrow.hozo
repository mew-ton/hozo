// MATCH-4（docs/types.md「アームの中の対象の型」）: as のケース、by nullable の HasItems、状態の分類の as で、アームの中の対象は
// 書いた型になる。絞り込みは、対象と同じ Atom と、それを先頭に持つより長いパス、レコードリテラルの中の値に掛かる
namespace a {
  model Profile { nick: string; }
  model M { id: string; profile: Profile; }
  model In { m: M?; }
  model Wrap { m: M; note: string?; }
  state current: M?;
  op find(): M?;
  classify Found of find { Hit: find as M; default; }
  classify Session of current { In: current as M; default; }
  op takeM(m: M): void;
  op takeString(s: string): void;
  op takeWrap(w: Wrap): void;
  op f(in: In): void {
    const m = find();
    match m by Found {
      Hit     => takeM(m);
      default => none;
    };
    // より長いパス（m.id、m.profile.nick）は、絞り込まれた型から辿る
    match m by Found {
      Hit     => takeString(m.profile.nick);
      default => none;
    };
    // レコードリテラルの中の値
    match m by Found {
      Hit     => takeWrap({ m: m, note: m.id });
      default => none;
    };
    // 対象がフィールドのパスでも同じ
    match in.m by Found {
      Hit     => takeM(in.m);
      default => none;
    };
    match in.m by nullable {
      HasItems => takeString(in.m.id);
      Empty    => none;
    };
  }
  // 状態を対象にした絞り込み: アームの中のその状態の名前は、match が読んだ値を指す
  op g(): void {
    match current by nullable {
      HasItems => takeM(current);
      Empty    => none;
    };
    match by Session {
      In      => takeString(current.id);
      default => none;
    };
  }
  // アームの本体の値にも掛かる
  op h(): M? {
    const m = find();
    return match m by Found {
      Hit     => m;
      default => none;
    };
  }
}
