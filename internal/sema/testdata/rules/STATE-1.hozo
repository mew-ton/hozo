// STATE-1: 組み込みの効果の operation が、その状態の形にない（docs/check.md「状態と効果」「状態の形」の表）
namespace a {
  state s: single<string>;
  state l: list<string>;
  state n: nullable<string>;
  effect fn put(): effects s.put;
  effect fn post(): effects s.post;               // ERROR: STATE-1
  effect fn del(): effects s.delete;              // ERROR: STATE-1
  effect fn lpost(): effects l.post;
  effect fn lput(): effects l.put;
  effect fn ldel(): effects l.delete;
  effect fn npost(): effects n.post;
  effect fn nput(): effects n.put;
  effect fn ndel(): effects n.delete;
}
