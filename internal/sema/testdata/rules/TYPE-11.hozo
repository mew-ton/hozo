// TYPE-11: model のインデックスのキーの型が string でも、元が string の scalar でもない（docs/types.md「診断」）
namespace a {
  scalar Key extends string;
  scalar Num extends int;
  model Ok1 { [name: string]: int; }
  model Ok2 { [key: Key]: int; }
  model Ng1 { [n: int]: int; }             // ERROR: TYPE-11
  model Ng2 { [n: Num]: int; }             // ERROR: TYPE-11
}
