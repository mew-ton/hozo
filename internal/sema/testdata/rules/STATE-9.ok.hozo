// STATE-9（docs/check.md「行の遷移」の「呼ぶ側の検査」、docs/types.md「ケースが分かっている値」）: 矢印の前にケースを並べた
// 効果は、そのケースにあると分かっている行で呼ぶ。分かるのは、match のアームの中の対象（名前で並べたアームも、else のアームも）と、
// 型が C.K<T> の値。前が any の形、as を書かない効果、post は、どの行でも受け取る
namespace a {
  model Order { id: string; note: string; }
  model Box { order: Order; }
  state orders: list<Order>;
  exception NotAccepted;
  classify Stage of Order { Draft; Accepted; InProduction; Shipped; Cancelled; }
  classify Urgency of Order { Rush; Normal; }
  classify Life of Order? { Open: Order? as Order; Closed: Order? as Order; Absent: Order? as none; }
  classify Review of Order { Passed: Order as Stage.Accepted<Order>; Failed; }
  read fn byId(id: string): Order? reads orders;
  effect fn accept(order: Order): effects orders.post as Stage.Accepted;
  effect fn open(order: Order): effects orders.post as Life.Absent -> Life.Open;
  effect fn start(order: Order, at: datetime): effects orders.put as Stage.Accepted -> Stage.InProduction;
  effect fn cancel(order: Order): effects orders.put as Stage.Draft, Stage.Accepted -> Stage.Cancelled;
  effect fn forceShip(order: Order): effects orders.put as any -> Stage.Shipped;
  effect fn patch(order: Order): effects orders.put as any -> else;
  effect fn rename(order: Order): effects orders.put;
  effect fn discard(order: Order): effects orders.delete as Life.Open -> Life.Absent;
  effect fn purge(order: Order): effects orders.delete as Life.Absent;
  // アームから: 名前で並べたアーム（一つのケース、前の並びに入る二つのケース）
  fn byArm(order: Order, at: datetime): throws NotAccepted {
    match (order by Stage) {
      Accepted => start(order, at);
      else     => throw NotAccepted;
    };
    match (order by Stage) {
      Draft, Accepted => cancel(order);
      InProduction, Shipped, Cancelled => none;
    };
  }
  // アームから: else のアームが受けるケースが、前の並びに入る
  fn byElseArm(order: Order) {
    match (order by Stage) {
      InProduction, Shipped, Cancelled => none;
      else => cancel(order);
    };
  }
  // アームから: 対象がパスでも、同じ Atom なら分かる。ケースが型を書いていて、対象の型が case にならないアームでも分かる
  fn byPath(box: Box, found: Order?) {
    match (box.order by Stage) {
      Draft => cancel(box.order);
      else  => none;
    };
    match (found by Life) {
      Open   => discard(found);
      Closed => none;
      Absent => none;
    };
  }
  // 型から: 引数の型、束縛の型、別の分類のケースが as に書いた型
  fn byType(order: Stage.Accepted<Order>, at: datetime) {
    start(order, at);
    cancel(order);
  }
  fn pick(order: Order): Stage.Draft<Order>;
  fn byBinding(order: Order, reviewed: Order) {
    val draft = pick(order);
    cancel(draft);
    match (reviewed by Review) {
      Passed => cancel(reviewed);
      Failed => none;
    };
  }
  // 型から分かっていれば、別の分類のアームの中でも分かる
  fn inOtherArm(order: Stage.Accepted<Order>, at: datetime) {
    match (order by Urgency) {
      Rush   => start(order, at);
      Normal => none;
    };
  }
  // どの行でも受け取る効果
  fn free(order: Order) {
    accept(order);
    open(order);
    forceShip(order);
    patch(order);
    rename(order);
    purge(order);
  }
}
