// MATCH-2: アームのケースの集合が Classify.cases と等しくない、default の有無（docs/check.md「classify / match」）
namespace a {
  model M { id: string; }
  classify C of M { A; B; }
  classify D of M { A; default; }
  op use(m: M): void;
  op missing(m: M): void {
    match m by C {                     // ERROR: MATCH-2
      A => use(m);
    };
  }
  op unknown(m: M): void {
    match m by C {                     // ERROR: MATCH-2
      A | B | Z => use(m);
    };
  }
  op dup(m: M): void {
    match m by C {                     // ERROR: MATCH-2
      A => use(m);
      B | A => use(m);
    };
  }
  op noDefault(m: M): void {
    match m by C {                     // ERROR: MATCH-2
      A | B => use(m);
      default => none;
    };
  }
  op needsDefault(m: M): void {
    match m by D {                     // ERROR: MATCH-2
      A => use(m);
    };
  }
  op ok(m: M): void {
    match m by C { A => use(m); B => none; };
    match m by D { A => use(m); default => none; };
  }
}
