// MATCH-2: アームが、分類のケースを、ちょうど一度ずつ受けていない（docs/check.md「classify / match」「アームが受けるケース」）
namespace a {
  model M { id: string; }
  classify C of M { A; B; }
  classify D of M { A; B; C; D; E; }
  fn use(m: M): void;
  fn missing(m: M): void {
    match (m by C) {                     // ERROR: MATCH-2
      A => use(m);
    };
  }
  fn unknown(m: M): void {
    match (m by C) {                     // ERROR: MATCH-2
      A, B, Z => use(m);
    };
  }
  fn dup(m: M): void {
    match (m by C) {                     // ERROR: MATCH-2
      A => use(m);
      B, A => use(m);
    };
  }
  // else のアームがあっても、名前で並べたケースは、その分類のケースで、一度だけ
  fn unknownWithElse(m: M): void {
    match (m by D) {                     // ERROR: MATCH-2
      A, Z => use(m);
      else => none;
    };
    match (m by D) {                     // ERROR: MATCH-2
      A => use(m);
      B, A => none;
      else => none;
    };
  }
  fn ok(m: M): void {
    match (m by C) { A => use(m); B => none; };
    // else のアームがあれば、足りないケースはない: 並べなかったケースのすべてを受ける
    match (m by D) { A => use(m); else => none; };
    match (m by D) { A, B => use(m); C => none; else => none; };
    match (m by C) { A => use(m); else => none; };
  }

  // 標準の分類のケースは、list が Empty / HasItems、nullable が None / Some
  state carts: list<M>;
  state token: nullable<string>;
  fn f(): void;
  fn builtinOk(): void {
    match (carts by list) { Empty => f(); HasItems => none; };
    match (token by nullable) { Some => f(); None => none; };
    match (carts by list) { Empty, HasItems => f(); };
    match (carts by list) { Empty => f(); else => none; };
  }
  fn builtinMissing(): void {
    match (carts by list) {              // ERROR: MATCH-2
      Empty => f();
    };
    match (token by nullable) {          // ERROR: MATCH-2
      Some => f();
    };
  }
  fn builtinUnknown(): void {
    match (carts by list) {              // ERROR: MATCH-2
      Empty => f();
      HasItems => none;
      Full => none;
    };
    match (token by nullable) {          // ERROR: MATCH-2
      Empty => f();
      HasItems => none;
    };
  }
  fn builtinDup(): void {
    match (carts by list) {              // ERROR: MATCH-2
      Empty => f();
      HasItems, Empty => none;
    };
  }

  // 状態の分類も、値の分類と同じ
  state orders: list<M>;
  classify Checkout of carts, orders { Shopping; Ordered; }
  classify Session of token { LoggedIn; LoggedOut; }
  fn stateOk(): void {
    match (by Checkout) { Shopping => f(); Ordered => none; };
    match (by Session) { LoggedIn => f(); else => none; };
  }
  fn stateNg(): void {
    match (by Checkout) {                // ERROR: MATCH-2
      Shopping => f();
    };
    match (by Checkout) {                // ERROR: MATCH-2
      Shopping => f();
      Ordered => none;
      Empty => none;
    };
    match (by Session) {                 // ERROR: MATCH-2
      LoggedIn => f();
    };
  }

  // 残りのケース（as else）も、ほかのケースと同じ: 名前で並べるか、else のアームが受ける
  fn find(): M?;
  classify Hit of find { Found: find as M; Missing: find as else; }
  fn restOk(): void {
    val m = find();
    match (m by Hit) { Found => use(m); Missing => none; };
    match (m by Hit) { Found => use(m); else => none; };
  }
  fn restNg(): void {
    val m = find();
    match (m by Hit) {                   // ERROR: MATCH-2
      Found => use(m);
    };
  }
}
