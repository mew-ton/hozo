// EFF-3: 葉の op の effects（ユニオンを展開した後）が二つ以上（docs/check.md「状態と効果」）
namespace a {
  state s: list<string>;
  state t: nullable<string>;
  effect e on s.post;
  effect f on t.post;
  union Both { e; f; }
  union One { e; }
  exception E;
  op two() effects e, f;                       // ERROR: EFF-3
  op viaUnion() effects Both;                   // ERROR: EFF-3
  op viaMixed() effects One, f throws E;       // ERROR: EFF-3
  op one() effects e;
  op oneViaUnion() effects One;
  op twice() effects e, One;
  op other() effects f throws E prevents effects;
  op zero();
  // 配線の op は伝播した効果をいくつ書いてもよい（EFF-2 が照合する）
  op wire() effects e, f throws E {
    one();
    other();
  }
  op wireViaUnion() effects Both throws E {
    one();
    other();
  }
}
