// DEC-11: 引数の数と名前（docs/types.md「デコレータの引数」）
namespace a {
  decorator d(code: int, name: string?);
  @d                                   // ERROR: DEC-11
  fn missing(): void;
  @d(1, "x", true)                     // ERROR: DEC-11
  fn tooMany(): void;
  @d(code: 1, nope: "x")               // ERROR: DEC-11
  fn unknown(): void;
  @d(1, code: 2)                       // ERROR: DEC-11
  fn twice(): void;
  @d(1)
  fn ok1(): void;
  @d(name: "x", code: 1)
  fn ok2(): void;
  decorator alias = d(1);
  @alias(2)                            // ERROR: DEC-11
  fn aliasArgs(): void;
  @alias
  fn ok3(): void;
  // 残りの引数（docs/types.md「デコレータの引数」）: ほかの Param の数を超えて位置で渡した値は、書いた順に残りの引数に入る。
  // 0 個でもよい。名前では渡せない
  state s: list<string>;
  effect fn e1() on s.post;
  effect fn e2() on s.put;
  decorator all(...targets: any effect) for op effects targets;
  decorator some(first: int, second: string?, ...more: string);
  @all
  fn rest0(): void;
  @all()
  fn rest0b(): void;
  @all(e1)
  fn rest1(): void;
  @all(e1, e2)
  fn rest2(): void;
  @all(targets: e1)                    // ERROR: DEC-11
  fn restNamed(): void;
  @some(1, "s", "a", "b", "c")
  fn restAfterFixed(): void;
  @some(1)
  fn restAfterFixed0(): void;
  @some                                // ERROR: DEC-11
  fn restMissingFixed(): void;
  @some(1, "s", more: "a")             // ERROR: DEC-11
  fn restNamed2(): void;
  @some(1, "s", "a", second: "t")      // ERROR: DEC-11
  fn restTwice(): void;
  @some(second: "t", first: 1)
  fn restNone(): void;
  decorator fixed = some(1, "s", "a", "b");
  @fixed
  fn restAlias(): void;
}
