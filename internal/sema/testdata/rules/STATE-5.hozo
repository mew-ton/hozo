// STATE-5（docs/check.md「状態と効果」「葉の op」）: 葉の op（本体を持たない op）は reads と effects の節を書けない。
// 節ごとに一つ。位置はその節。配線の op は書ける
namespace a {
  model M { id: string; }
  state rows: list<M>;
  effect fn add(m: M) on rows.post;
  read fn byId(id: string): M? on rows;
  fn find(id: string): M? reads rows;                  // ERROR: STATE-5
  fn named(id: string): M? reads byId;                 // ERROR: STATE-5
  fn insert(m: M) effects add;                         // ERROR: STATE-5
  fn direct(m: M) effects rows.post;                   // ERROR: STATE-5
  fn upsert(m: M)
    reads rows                                         // ERROR: STATE-5
    effects add;                                       // ERROR: STATE-5
  fn wired(id: string): M? reads rows { return byId(id); }
  fn wired2(m: M) effects add, rows.post { add(m); rows.post(m); }
  fn leaf(m: M): M;
}
