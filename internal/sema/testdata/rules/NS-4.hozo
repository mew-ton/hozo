// NS-4: classify は宣言した名前空間の中でだけ使える（docs/check.md「名前空間」）
namespace a {
  model M { x: int; }
  classify C of M { A; B; }
  op ok(m: C.A<M>): M;
}
namespace b {
  op f(m: a.C.A<a.M>): a.M;            // ERROR: NS-4
}
classify G of a.M { A; }
namespace c {
  op id(m: a.M): a.M;
  op h(m: a.M): a.M {
    return match m by G {              // ERROR: NS-4
      A => id(m);
    };
  }
}
// 状態の分類での match（match by C）の C も、現在の名前空間の classify
state shared: list<a.M>;
classify Shared of shared { None; Some; }
namespace d {
  op f(): void;
  op h(): void {
    match by Shared {                  // ERROR: NS-4
      None => f();
      Some => none;
    };
  }
}
