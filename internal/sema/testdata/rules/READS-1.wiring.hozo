// READS-1 / STATE-2（docs/check.md「デコレータが運ぶ reads と effects」）: reads か effects の節を持つデコレータは、配線の op
// （本体を持つ op）にも付けられる（DEC-17 は欠番）。運ばれたものが、付いた op の名前空間のものでなければならないことは、
// 葉と同じ。位置はそのデコレータの適用
namespace a {
  model M { id: string; }
  state s: list<M>;
  effect fn add(): effects s.post;
  decorator fn reading(table: any state): reads table;
  decorator fn writing(...targets: any effect): effects targets;
  decorator fn fixed(): reads s effects add;
  decorator fn plain();

  @reading(s) fn leafRead(): M[];
  @writing(add) export fn leafWrite(m: M);

  // 配線に付けられる。節を持つデコレータが二つでも、残りの引数に何も渡していなくても
  @reading(s)
  fn wireRead(): M[] {
    return leafRead();
  }
  @plain
  @writing(add)
  fn wireWrite(m: M) {
    leafWrite(m);
  }
  @fixed
  @reading(s)
  fn wireBoth(m: M): M[] {
    leafWrite(m);
    return leafRead();
  }
  @writing
  fn wireNothing() {
    leafWrite({ id: "x" });
  }
}
namespace b {
  state t: list<a.M>;
  effect fn put(): effects t.post;
  // 自分の名前空間のものを運ぶ
  @a.reading(t)
  @a.writing(put)
  fn own(m: a.M) {
    a.leafWrite(m);
  }
  // 別の名前空間のものを運べば、配線でも error
  @a.reading(a.s)                      // ERROR: READS-1
  fn otherRead(m: a.M) {
    a.leafWrite(m);
  }
  @a.writing(put, a.add)               // ERROR: STATE-2
  fn otherWrite(m: a.M) {
    a.leafWrite(m);
  }
  @a.fixed                             // ERROR: READS-1, STATE-2
  fn otherBoth(m: a.M) {
    a.leafWrite(m);
  }
}
