// HTTP-4: 位置は、そのフィールドを持つ model。
namespace app {
  scalar Count extends int;
  scalar When extends datetime;
  model Inner { x: int; }
  model Attrs { [name: string]: string; }

  model HeaderIn {
    // @http.header は、string と、その省略可能だけ
    @http.header("X-Count") count: int;
    @http.header("X-Scalar") scalarCount: Count?;
    @http.header flag: boolean?;
    @http.header("X-At") at: datetime;
    @http.header("X-List") list: string[];
    @http.header("X-Inner") inner: Inner?;
    @http.header("X-Ok") ok: string?;
  }
  @http.get("/header")
  export fn header(in: HeaderIn);

  model QueryIn {
    // @http.query は、string / int / float / boolean と、その省略可能だけ
    @http.query at: datetime?;
    @http.query when: When;
    @http.query("w") wait: duration?;
    @http.query list: string[];
    @http.query later: int[]?;
    @http.query attrs: Attrs?;
    @http.query inner: Inner?;
    @http.query ok: Count?;
  }
  @http.get("/query")
  export fn query(in: QueryIn);

  // 全体の形では、その model のフィールドの一つずつを、同じ場所の項目として見る
  model Meta {
    tenant: string;
    retries: int;
    trace: string?;
  }
  model Paging {
    page: Count?;
    tags: string[];
    inner: Inner;
    q: string;
  }
  model ObjIn {
    @http.headerObj meta: Meta;
    @http.queryObj paging: Paging;
  }
  @http.get("/obj")
  export fn obj(in: ObjIn);
}
