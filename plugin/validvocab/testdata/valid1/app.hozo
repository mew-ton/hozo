// VALID-1: 制約が、付けた先に合わない。位置は、付いた scalar か model。
namespace app {
  // 元の型に合わない（docs/plugin-valid.md「制約」の表の「付けられる先」）
  @valid.min(1)
  scalar Name extends string;
  @valid.max(1)
  scalar Wait extends duration;
  @valid.length(min: 1)
  scalar Count extends int;
  @valid.pattern("x")
  scalar Flag extends boolean;
  @valid.format("email")
  scalar At extends datetime;
  scalar Nick extends Name;
  @valid.max(3)
  scalar Alias extends Nick;

  model Inner { x: int; }
  model Attrs { [name: string]: string; }

  model Form {
    // 配列のフィールドに、length のほかの制約が付いている（省略可能でも同じ）。インデックスの model を型に持つフィールドに、制約が付いている
    @valid.min(1) tags: string[];
    @valid.length(max: 3) attrs: Attrs;
    @valid.min(1) later: int[]?;
    @valid.pattern("x") @valid.format("email") words: string[];
    // 配列のフィールドの length は、要素の数に掛かる: 診断にならない
    @valid.length(min: 1, max: 3) few: string[];
    // フィールドの型（scalar なら元の型）に合わない
    @valid.min(1) name: string;
    @valid.length(min: 1) inner: Inner;
    @valid.max(3) nick: string?;
    @valid.format("uri") count: Count;
    // 合っている制約は、診断にならない
    @valid.min(1) ok: int;
  }

  // 正しい宣言は、診断にならない
  @valid.min(1)
  scalar Good extends int;
}
