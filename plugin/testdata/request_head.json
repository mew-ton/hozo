{
  "comment": "Go の SDK（plugin.Run）が、要求ごとに返す、終了コードと error の code を確かめる表（docs/plugin-protocol.md「要求と応答」「起動」）。request は標準入力に渡す文字列そのまま。Handler は三つの direction をすべて実装していて、空の応答を返す。code は終了コード 2 のときの error の code（それ以外は \"\"）。",
  "cases": [
    { "name": "protocol が合い direction を実装している", "request": "{\"protocol\":\"0.24\",\"direction\":\"import\"}", "exit": 0, "code": "" },

    { "name": "protocol の小さい版が、SDK より新しい（0.x の間は、ぴったり同じ版だけが合う）", "request": "{\"protocol\":\"0.25\",\"direction\":\"import\"}", "exit": 2, "code": "protocol" },
    { "name": "protocol の大きい版が、SDK より新しい", "request": "{\"protocol\":\"2.0\",\"direction\":\"import\"}", "exit": 2, "code": "protocol" },
    { "name": "protocol の小さい版が、SDK より古い", "request": "{\"protocol\":\"0.23\",\"direction\":\"import\"}", "exit": 2, "code": "protocol" },
    { "name": "protocol が、版として読めない（小さい版がない）", "request": "{\"protocol\":\"1\",\"direction\":\"import\"}", "exit": 2, "code": "protocol" },
    { "name": "protocol が、版として読めない（数でない）", "request": "{\"protocol\":\"1.x\",\"direction\":\"import\"}", "exit": 2, "code": "protocol" },
    { "name": "protocol が違う文字列", "request": "{\"protocol\":\"9.9\",\"direction\":\"import\"}", "exit": 2, "code": "protocol" },
    { "name": "protocol がない", "request": "{\"direction\":\"import\"}", "exit": 2, "code": "protocol" },
    { "name": "protocol が null", "request": "{\"protocol\":null,\"direction\":\"import\"}", "exit": 2, "code": "protocol" },
    { "name": "protocol が数", "request": "{\"protocol\":0.24,\"direction\":\"import\"}", "exit": 2, "code": "protocol" },
    { "name": "protocol が真偽値", "request": "{\"protocol\":true,\"direction\":\"import\"}", "exit": 2, "code": "protocol" },
    { "name": "protocol が配列", "request": "{\"protocol\":[\"0.24\"],\"direction\":\"import\"}", "exit": 2, "code": "protocol" },
    { "name": "protocol がオブジェクト", "request": "{\"protocol\":{\"version\":\"0.24\"},\"direction\":\"import\"}", "exit": 2, "code": "protocol" },
    { "name": "protocol が空の文字列", "request": "{\"protocol\":\"\",\"direction\":\"import\"}", "exit": 2, "code": "protocol" },
    { "name": "protocol を direction より先に確かめる", "request": "{\"protocol\":1,\"direction\":2}", "exit": 2, "code": "protocol" },
    { "name": "protocol が違えば、ほかの項目の形が違っていても protocol", "request": "{\"protocol\":\"9.9\",\"direction\":\"emit\",\"spec\":7,\"outputs\":\"x\"}", "exit": 2, "code": "protocol" },

    { "name": "direction を知らない", "request": "{\"protocol\":\"0.24\",\"direction\":\"dance\"}", "exit": 2, "code": "unsupported" },
    { "name": "なくした direction check（版 0.22 でなくした）", "request": "{\"protocol\":\"0.24\",\"direction\":\"check\",\"view\":null}", "exit": 2, "code": "unsupported" },
    { "name": "direction がない", "request": "{\"protocol\":\"0.24\"}", "exit": 2, "code": "unsupported" },
    { "name": "direction が null", "request": "{\"protocol\":\"0.24\",\"direction\":null}", "exit": 2, "code": "unsupported" },
    { "name": "direction が数", "request": "{\"protocol\":\"0.24\",\"direction\":3}", "exit": 2, "code": "unsupported" },
    { "name": "direction が配列", "request": "{\"protocol\":\"0.24\",\"direction\":[\"import\"]}", "exit": 2, "code": "unsupported" },

    { "name": "JSON でない", "request": "{", "exit": 1, "code": "" },
    { "name": "空", "request": "", "exit": 1, "code": "" },
    { "name": "配列", "request": "[]", "exit": 1, "code": "" },
    { "name": "null", "request": "null", "exit": 1, "code": "" },
    { "name": "文字列", "request": "\"0.9\"", "exit": 1, "code": "" },
    { "name": "数", "request": "5", "exit": 1, "code": "" }
  ]
}
