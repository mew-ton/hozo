// DB-1（docs/plugin-db.md「表」）: @db.table の付いた状態の要素の型が、model でない（表の model は、状態の要素の型）。
// 位置は状態。

namespace app {
  scalar Id extends string;
  model Row { @db.key @db.text id: Id; }
  union Shape { Circle: Row; Other: string; }
  model RowsByName { [name: string]: Row; }

  // 核の型
  @db.table state names: list<string>;
  // scalar
  @db.table state ids: list<Id>;
  // array
  @db.table state groups: list<Row[]>;
  // インデックスの model（フィールドを持たない）
  @db.table state byName: list<RowsByName>;
  // union
  @db.table state shapes: list<Shape>;
  // model なら通る
  @db.table state rows: list<Row>;
  // @db.table がなければ、見ない
  state plain: list<string>;

  // 表にならなかった状態を宛先にする read と効果は、重ねて報告しない
  @db.find
  read fn nameById(id: Id): Row? reads names;
  @db.insert
  effect fn createId(row: Row): effects ids.post;
}
