// DB-9（docs/plugin-db.md「read」）: @db.find の read が、一行に決まらない: 条件の列（引数と @db.where）が、
// 表の model の @db.key のすべても、@db.unique の列も含まず、@db.latest もない。位置は read。

namespace app {
  model Row { @db.key @db.text id: string; @db.unique @db.text code: string; @db.text note: string; @db.datetime at: datetime; }
  /** キーが二つ */
  model Pair { @db.key @db.text left: string; @db.key @db.text right: string; @db.text note: string; }
  /** キーも、一意の列もない */
  model Log { @db.text line: string; @db.datetime at: datetime; }
  @db.table state rows: list<Row>;
  @db.table state pairs: list<Pair>;
  @db.table state logs: list<Log>;

  // キーでも一意でもない列
  @db.find
  read fn rowByNote(note: string): Row? reads rows;
  // 条件がない
  @db.find
  read fn anyRow(): Row? reads rows;
  // @db.where の条件だけで、キーでも一意でもない列
  @db.find
  @db.where("note", "x")
  read fn notedRow(): Row? reads rows;
  // 二つの @db.key の一つ
  @db.find
  read fn pairByLeft(left: string): Pair? reads pairs;
  // 二つの @db.key の一つと、キーでない列
  @db.find
  read fn pairByLeftAndNote(left: string, note: string): Pair? reads pairs;
  // キーのない model（どの列を並べても、決まらない）
  @db.find
  read fn logByLine(line: string, at: datetime): Log? reads logs;

  // ---- 通るもの ----

  // 1: @db.key のすべて
  @db.find
  read fn rowById(id: string): Row? reads rows;
  @db.find
  read fn pairByBoth(left: string, right: string): Pair? reads pairs;
  // 引数と @db.where を合わせて、@db.key のすべて
  @db.find
  @db.where("right", "r")
  read fn pairOnRight(left: string): Pair? reads pairs;
  // 2: @db.unique の列
  @db.find
  read fn rowByCode(code: string): Row? reads rows;
  @db.find
  @db.where("code", "c")
  read fn fixedRow(note: string): Row? reads rows;
  // 3: @db.latest（条件がなくてもよい）
  @db.find
  @db.latest("at")
  read fn lastLog(): Log? reads logs;
  @db.find
  @db.latest("at")
  read fn lastRowNoted(note: string): Row? reads rows;
  // @db.list なら、どの条件でもよい
  @db.list
  read fn rowsByNote(note: string): Row[] reads rows;
}
