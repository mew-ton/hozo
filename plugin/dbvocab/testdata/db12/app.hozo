// DB-12（docs/plugin-db.md「read」）: 一つの read が、@db.find と @db.list の両方を持つ。位置は read。
// ほかの食い違い（結果の型、条件）は、どちらを言っているのかが決まらないので、重ねて報告しない。

namespace app {
  model Row { @db.key @db.text id: string; @db.text note: string; }
  @db.table state rows: list<Row>;
  state plain: list<Row>;

  @db.find
  @db.list
  read fn rowById(id: string): Row? reads rows;
  @db.list
  @db.find
  read fn rowsByNote(note: string): Row[] reads rows;
  // @db.where と @db.latest を足しても、同じ。表の状態でなくても、同じ
  @db.find
  @db.list
  @db.where("note", "x")
  @db.latest("id")
  read fn plainRows(): Row[] reads plain;

  // 通るもの
  @db.find
  read fn byId(id: string): Row? reads rows;
  @db.list
  read fn byNote(note: string): Row[] reads rows;
}
