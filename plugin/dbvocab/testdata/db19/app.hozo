// DB-19（docs/plugin-db.md「効果」）: @db.conflict の例外が、使えない: その効果の throws にない。引数を持つ。位置は効果。

namespace app {
  model User { @db.key @db.text id: string; @db.unique @db.text email: string; }
  @db.table state users: list<User>;
  exception Taken;
  exception TakenBy(email: string);

  /** 効果の throws に、ない */
  @db.insert @db.conflict(Taken)
  effect fn add(user: User): effects users.post;
  /** 引数を持つ例外は、値を埋められない */
  @db.update @db.conflict(TakenBy)
  effect fn save(user: User): throws TakenBy effects users.put;

  // 通るもの
  @db.insert @db.conflict(Taken)
  effect fn create(user: User): throws Taken effects users.post;
}
