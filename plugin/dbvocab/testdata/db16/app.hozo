// DB-16（docs/plugin-db.md「効果」の未決）: @db.delete の効果が、引数を一つも持たない（すべての行を消す形は、
// まだ決めていない）。位置は効果。

namespace app {
  model Row { @db.key @db.text id: string; }
  @db.table state rows: list<Row>;
  @db.table state logs: list<Row>;

  @db.delete
  effect fn clearRows(): effects rows.delete;
  /** 配線が呼んでも、効果ごとに一度だけ */
  @db.delete
  effect fn clearLogs(): effects logs.delete;
  export fn reset() {
    clearLogs();
  }

  // 通るもの
  @db.delete
  effect fn deleteRow(id: string): effects rows.delete;
  /** デコレータを付けていなければ、人が書く（すべての行を消す効果は、こう書く） */
  effect fn truncate(): effects rows.delete;
  /** 条件のない @db.list は、決まっている（すべての行） */
  @db.list
  read fn allRows(): Row[] reads rows;
}
