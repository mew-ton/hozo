// DB-14（docs/plugin-db.md「read」）: 一つの read の条件が、同じ列を二度名指ししている（引数と @db.where、
// 二つの @db.where）。位置は read。

namespace app {
  model Row { @db.key @db.text id: string; @db.text note: string; @db.int rank: int; @db.datetime at: datetime; }
  @db.table state rows: list<Row>;

  // 引数と @db.where
  @db.list
  @db.where("note", "x")
  read fn rowsNoted(note: string): Row[] reads rows;
  // 二つの @db.where（値が同じでも）
  @db.list
  @db.where("rank", 1)
  @db.where("rank", 1)
  read fn topRows(): Row[] reads rows;
  // 三度
  @db.find
  @db.where("id", "a")
  @db.where("id", "b")
  read fn fixedRow(id: string): Row? reads rows;

  // 通るもの: 別の列。@db.latest の列は、条件ではない
  @db.list
  @db.where("note", "x")
  @db.where("rank", 1)
  @db.latest("at")
  read fn rowsAt(at: datetime): Row[] reads rows;
}
