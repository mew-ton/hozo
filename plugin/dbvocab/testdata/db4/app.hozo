// DB-4（docs/plugin-db.md「診断」）: 列を名指しするもの（read と @db.delete の効果の引数の名前、@db.where と
// @db.latest の column）が、表の model のフィールドにない。位置は、その read か効果。

namespace app {
  model Row { @db.key @db.text id: string; @db.text note: string; @db.datetime at: datetime; }
  @db.table state rows: list<Row>;

  // read の引数の名前（大文字と小文字は、区別する）
  @db.find
  read fn rowByID(ID: string): Row? reads rows;
  // 二つの引数の、一つだけがない（もう一つは、キー）
  @db.find
  read fn rowByIdAndNotes(id: string, notes: string): Row? reads rows;
  // @db.where の column
  @db.list
  @db.where("kind", "x")
  read fn rowsOfKind(): Row[] reads rows;
  // @db.latest の column
  @db.list
  @db.latest("addedAt")
  read fn newestRows(): Row[] reads rows;
  // SQLite の rowid は、フィールドではない
  @db.find
  @db.latest("rowid")
  read fn lastRow(): Row? reads rows;

  // @db.delete の効果の引数の名前（配線が呼んでいない効果も、同じに確かめる）
  @db.delete
  effect fn deleteRow(key: string): effects rows.delete;
  @db.delete
  effect fn deleteByRowid(id: string, rowid: string): effects rows.delete;

  // 通るもの
  @db.list
  @db.where("note", "x")
  @db.latest("at")
  read fn rowsNoted(id: string): Row[] reads rows;
  @db.delete
  effect fn deleteNoted(note: string): effects rows.delete;
  /** @db.insert と @db.update の引数の名前は、列ではない */
  @db.insert
  effect fn createRow(anything: Row): effects rows.post;
}
