// Hozo 自身の仕様（docs/decisions.md「決めたこと」468、477〜481、533）。決定の記録（ADR）の語彙 adr と、決定の分類 hozo.decisions.Decision。
// 534 からの決定は、このファイルが持ち主（docs/decisions.md「決めたこと」533）。決定ごとに、持ち主は、このファイルの、一つのケース。
// 533 までの決定の持ち主は、docs/decisions.md「決めたこと」のまま。ここにある 533 までのケース（468〜483 と、それらが置き換えた 417）は、
// 写しで、食い違えば、docs/decisions.md が正しい。番号のないケースの三つは、docs/open.md「聞かずに決めて、確かめていない決定」の写し。
// どちらの名前空間も、hozo.toml の単位の対象ではない: コードには、ならない。
//
// 書き方（同 477、479、D534）:
//   決めたこと          → ケースの説明の本文
//   理由                → @adr.context
//   決めたことで起きること → @adr.consequence
//   採らなかった案      → @adr.alternative（一つずつ）
//   決めた人の言葉      → @adr.said
//   状態                → 印を、ちょうど一つ: @adr.proposed、@adr.accepted、@adr.rejected、@adr.deprecated、@adr.superseded(…)
//   置き換えられた決定  → 古い決定の側に、印 @adr.superseded(新しい決定)
//   一部を直す決定      → 新しい決定の側に、印 @adr.amends(…)
//   形を決めた宣言      → その宣言の側に、印 @adr.decided(…)
//
// 決定の足し方と、状態の替え方は、CLAUDE.md「決定は、decisions.hozo に足す」。
// 書けなかった所の持ち主は docs/open.md「サンプルと、hozoc 自身の仕様」（下の「穴 30」「穴 36」などは、その番号）。
// @adr.said は、利用者の言葉の、一部を、書かれたまま、抜いたもの（言い換えていない。533 までの決定の全文は docs/decisions.md の行）。

/**
 * 決定の記録（ADR）の語彙（docs/decisions.md「決めたこと」479。状態の印は D534）。
 * 同梱の語彙では、ない: まず、Hozo 自身の仕様の中に、自前のものとして宣言し、使ってから、同梱の語彙に移すかを決める。
 * どれも、解釈されなくてよい印（@hint）。文章を一つ取る四つは、説明のコメントの中に、タグとして書ける（同 478、480）。
 */
namespace adr {
  /**
   * 状況と、理由: なぜ、決める必要があったか。なぜ、こう決めたか
   *
   * @param text 文章
   */
  @adr.decided(hozo.decisions.Decision.D479)
  @hint
  decorator context(text: string) for case of never;

  /**
   * 結果: 決めたことで、何が起きるか。何を、受け入れるか
   *
   * @param text 文章
   */
  @adr.decided(hozo.decisions.Decision.D479)
  @hint
  decorator consequence(text: string) for case of never;

  /**
   * 採らなかった案と、採らなかった理由。案ごとに、一つ
   *
   * @param text 文章
   */
  @adr.decided(hozo.decisions.Decision.D479, hozo.decisions.Decision.D534)
  @hint
  @repeatable
  decorator alternative(text: string) for case of never;

  /**
   * 決めた人の言葉
   *
   * @param text 言葉（書かれたまま）
   */
  @adr.decided(hozo.decisions.Decision.D479)
  @hint
  @repeatable
  decorator said(text: string) for case of never;

  /**
   * この決定が、一部を直す決定（一部だけを、置き換える。条件を足す）。直された決定は、直された部分のほかは、効いたまま。
   * どの部分かは、説明の本文に書く
   *
   * @param decisions 一部を直す決定
   */
  @adr.decided(hozo.decisions.Decision.D481)
  @hint
  decorator amends(...decisions: any case of never) for case of never;

  /**
   * この宣言の形を、決めた決定。宣言の側に付ける
   *
   * @param decisions 形を決めた決定
   */
  @adr.decided(hozo.decisions.Decision.D479)
  @hint
  decorator decided(...decisions: any case of never)
    for op, model, state, effect, read, exception, scalar, field, union, classify, decorator, case;

  // 状態（D534）。どの決定にも、ちょうど一つ付ける。

  /** 状態: 提案。出したが、まだ、利用者が認めていない。会話から生まれた決定と、聞かずに決めた決定は、これで入れる */
  @adr.decided(hozo.decisions.Decision.D479, hozo.decisions.Decision.D534)
  @hint
  decorator proposed for case of never;

  /** 状態: 採用。利用者が認め、効いている */
  @adr.decided(hozo.decisions.Decision.D534)
  @hint
  decorator accepted for case of never;

  /** 状態: 却下。提案したが、利用者が採らなかった。ケースは消さず、番号も使い回さない */
  @adr.decided(hozo.decisions.Decision.D534)
  @hint
  decorator rejected for case of never;

  /** 状態: 廃止。もう効いていない。置き換える決定は、ない */
  @adr.decided(hozo.decisions.Decision.D534)
  @hint
  decorator deprecated for case of never;

  /**
   * 状態: 置き換え済み。もう効いていない。古い決定の側に付け、置き換えた新しい決定を指す
   *
   * @param decisions 置き換えた決定
   */
  @adr.decided(hozo.decisions.Decision.D534, hozo.decisions.Decision.D537)
  @hint
  decorator superseded(...decisions: any case of never) for case of never;
}

/** Hozo の決定の記録 */
namespace hozo.decisions {
  /**
   * 決めたこと。ケースの名前は、決定の番号に、D を付けたもの（穴 30: 数字で始まる名前は、書けない）。
   * 533 までの番号は docs/decisions.md「決めたこと」の番号。534 からの番号は、ここで、入れるときに振る（状態に、関わらない）。
   * 番号のない三つ（WriteWithoutCi ほか）は、docs/open.md「聞かずに決めて、確かめていない決定」の行の写しで、中身を言う名前。
   */
  classify Decision of never {
    /**
     * コマンド hozoc check と hozoc emit を、一つにまとめる: hozoc build（検査して、ファイルを書き出す）と、
     * hozoc build --no-emit（検査だけ）。
     * この写しは、472 が置き換える先として要る分だけ（全文は docs/decisions.md「決めたこと」417）。
     */
    @adr.accepted
    D417;

    /**
     * Hozo 自身（CLI、プラグイン、IDE など）の要件と設計を、Hozo の仕様（.hozo）に移していき、書けなかった部分を、その都度、直す。
     * 進め方は、一切れずつ: 一切れを選ぶ。Hozo で書く。書けなかった所を、一つずつ、記録する。記録した穴を、一つずつ、利用者に聞く。
     * 書けた事実は、持ち主を .hozo に移し、文書は、それを引く形に直す。
     * 名前空間は、hozo の下の、入れ子（hozo.compiler、hozo.plugin、hozo.ide など）。今の名前空間 hozoc は、hozo.compiler に付け直す。
     * 最初の一切れは、hozoc の要求と、担い手。
     *
     * @adr.context hozoc 自身を、三つ目の、実物の仕様にする（shop-server、order-app の次）。
     *   名前に、ハイフンは書けない（Ident は、英字、数字、_）ので、言語は変えず、入れ子で書く。
     * @adr.alternative 名前にハイフンを書けるように、言語を変える
     * @adr.alternative 下線で書く（hozo_compiler）
     * @adr.alternative 最初の一切れを、診断か、やり取りと IR か、IDE にする
     * @adr.said hozo の cli, plugin, ide などの要件や設計を hozo に移しながら、書けなかった部分を直していきませんか
     * @adr.said ネームスペースだけ先にこちらから定めますが、hozo-* としてください。hozo-compiler、hozo-plugin、hozo-ide など
     */
    @adr.accepted
    D468;

    /**
     * 要求のケースに、値（出どころの決定の番号、診断の重さと、文言）を結ぶ印は、まず、自前の印として宣言する
     * （分類のケースに付けるデコレータ）。診断を、要求として書く一切れで使い、形が固まってから、語彙 prd に移すかを決める。
     * 言語は、変えない。
     *
     * @adr.context 語彙の名前空間は、閉じてある（456）ので、語彙に足した印は、形を変えにくい。使ってから決める方が、安全。
     *   今の言語のままで、書ける（hozoc に通して、確かめた）。
     * @adr.alternative 今、語彙 prd に足す（prd.origin、prd.message など）
     * @adr.alternative 値は、持たせず、出どころは、コメントに、文言の辞書は、Hozo の外に置く
     */
    @adr.accepted
    D469;

    /**
     * 製品の全体についての要求（どの op のものでもない要求）は、どこにも結ばないままで、よい。
     * 要求のケースとして宣言し、説明を書くだけにする。言語も、語彙も、変えない。
     *
     * @adr.context どこにも結ばれていない要求が、そのまま、「全体についての要求」を意味する。
     *   go-design を並べれば、要求ごとに、テストの入れ物が求められる（結んでいるかに、関わらない）ので、置き去りにならない。
     * @adr.consequence cli.hozo の lsp に、一部だけ結んでいた印（要求 SingleBinary への @prd.ref）は、外す。
     * @adr.alternative 名前空間に、デコレータを付けられるようにする（どの書き方に付けた印が効くかの決まりが、新しく要る）
     * @adr.alternative 全体についての要求を受ける、印だけの宣言を置く
     */
    @adr.accepted
    D470;

    /**
     * 作り方についての要求（検査の規則ごとに、通る例と、落ちる例がある。規則を実装するコードとテストは、規則の ID を書く）は、
     * 今は、Hozo の仕様に書かない。製品の仕様が持つのは、製品が何をするか、まで。作り方の決まりは、文書が持つ。
     * 決定の記録（ADR）を、Hozo で書くことは、書き写せなかったものの一覧ができてから、検討する。
     *
     * @adr.context 二つとも、道具が、すでに確かめている。Hozo に書いても、確かめる者は、増えない。
     *   「どう作るか」は、設計の事実ではなく、進め方。作り方の決まりは、要求より、決定に近いので、
     *   置き場は、ADR を Hozo で書く形が見えてから、決める方が、手戻りが少ない。
     * @adr.alternative どこにも結ばない要求として、書く
     * @adr.alternative 作り方を言う、別の名前空間（hozo.process）を作る
     * @adr.said そういえば ADR を表現って考えてなかったかもしれない
     * @adr.said 書き写せなかったものの一覧ができたら ADR を検討するとして、一旦は A
     */
    @adr.accepted
    D471;

    /**
     * hozoc 自身の仕様で、入口（コマンドの行）と、ユースケースを、分ける。
     * 入口の op は、フラグを読んで、どのユースケースに入るかを分け、ユースケースの op を呼ぶ。
     * フラグを知っているのは、入口だけ。担い手は、ユースケースに結ぶ。
     * 入口での分け方は、今は、述語で決まる分類で書く。言語は、今は、変えない。
     * 置き換えるのは、417 の細部として、聞かずに決めていた形（build 一つが、入口とユースケースを兼ね、
     * フラグを、値として、奥まで運ぶ）だけ。
     *
     * @adr.context 「CI は、検査だけ」「人と AI は、書き出す」が、別々のユースケースとして、言える。
     *   言語サーバーが、同じ「検査する」に入ることも、形に出る。サンプル shop-server と、同じ分け方。
     * @adr.consequence フラグの値から、ケースへの対応は、人が書く述語に入り、仕様からは、見えない。
     * @adr.alternative 今、言語に、真偽の値の分類を足す
     * @adr.alternative 語彙 cli の側で、フラグと op を結ぶ
     * @adr.alternative 使い方の違いを、コメントに書く
     * @adr.said CI の入口と、ユースケースの入口が違ってて、CI -> ユースケース という流れになるのが正しい気がした
     * @adr.said ユースケース側に --no-emit などの ci 側の情報がなくていいはず
     */
    @adr.amends(Decision.D417)
    @adr.accepted
    D472;
    // 今の形: 入口での分け方は、真偽の値の分類 hozo.cli.Flag（483 で、言語に入った）。人が書く述語は、なくなり、
    // フラグの値から、ユースケースへの対応は、cli.hozo の配線に出る。上の文は、決定の行の写しなので、直さない。

    /**
     * 472 の置き場: 入口（コマンドの行）の op は、名前空間 hozo.cli に、ユースケースの op は、hozo.compiler に置く。
     * 語彙 cli のコマンドとフラグのデコレータは、hozo.cli にだけ、現れる。担い手と要求は、hozo.compiler のユースケースに結ぶ。
     *
     * @adr.context 「入口だけが、フラグを知る」が、名前空間の境になる。後で、言語サーバーの入口を、別の名前空間に書くとき、
     *   同じ hozo.compiler のユースケースに入る形が、そのまま取れる。サンプル shop-server の分け方と、そろう。
     * @adr.alternative どちらも hozo.compiler に置く（境が、名前に出ない）
     * @adr.alternative ユースケースを、hozo.compiler の下の、別の名前空間に置く
     */
    @adr.accepted
    D473;

    /**
     * hozoc の担い手を、していることで分ける: 設計する人、AI、エンジニア、自動の検査（CI）。
     * エディタ、CLI、MCP サーバー、IDE は、担い手ではなく、入口（道具）。
     * 担い手の一覧と、使うユースケースの持ち主は、cli.hozo。
     * あわせて、利用者が、文書の言う業務の流れを見て、今の構成で、問題ない、とした。
     * IDE の、画面ごとの詳細は、IDE の詳細を決めるときに、考える。
     *
     * @adr.context エディタを担い手にすると、入口と、担い手が、また混ざる（472 と、同じ線）。
     *   エンジニアが、言語サーバーを使うことが、形に出なくなる。
     * @adr.consequence 担い手から、エディタを外し、言語サーバーのユースケースの担い手を、エンジニアにする。
     *   設計する人は、IDE を、Hozo に書くときに、足す。
     * @adr.alternative cli.hozo のまま（エディタも、担い手）にして、docs/tools.md を直す
     * @adr.said 今の構成では一旦問題ないと思います
     * @adr.said IDE の詳細を決めるときに考えればいいです
     */
    @adr.accepted
    D474;

    /**
     * hozoc の業務の流れを、四つとも、Hozo に書く。置き場は、名前空間 hozo.flows。
     * 流れは、ユースケースの op を、順に呼ぶ配線。hozoc の外の手順は、外の道具の名前空間 hozo.toolchain の、中身のない op として宣言して、呼ぶ。
     * 設計する人の流れは、ユースケースのない段を、コメントにしてよい。言語は、変えない。
     *
     * @adr.alternative 道具がある部分の流れだけを書く
     * @adr.alternative 今は、書かず、go-design を並べるときに、書く
     * @adr.alternative 先に、結果を使わずに順に行う書き方を、言語に足す
     * @adr.said ４つとも書いてください
     * @adr.said 存在しない fn, などはコメントアウトでよいです。最悪、中身が空でも良いです
     */
    @adr.accepted
    D475;

    /**
     * union、classify、decorator の宣言に、印（デコレータ）を付けられるようにする。namespace は、今は、足さない。
     * 書き写せなかったものの一覧ができたので、決定の記録（ADR）の検討に入る。その最初の決定。
     *
     * @adr.context 決定は、構造そのもの（なぜ、この union か、なぜ、この分類か）についてのものが多いのに、
     *   op、model、状態、効果、read、例外、scalar、フィールド、分類のケースにしか、印を付けられなかった。
     *   足す向きで、今の仕様は、壊れない。namespace は、何度でも、分けて書けるので、どの書き方に付けた印が効くかの決まりが、別に要る。
     * @adr.alternative namespace も、今、足す
     * @adr.alternative 広げずに、構造についての決定は、どこにも結ばない決定として置く
     */
    @adr.accepted
    D476;

    /**
     * 決定の記録（ADR）の書き方の方針: 文章の項目は、説明のコメントの中の、タグで書き、タグには、接頭語（名前空間）を付ける。
     * 名前を指す関係（置き換える決定、結ぶ先の宣言）は、印（デコレータ）で書く。決定の一つ一つは、対象のない分類のケース。
     *
     * @adr.context 文章を、文字列の引数に書くのは、書きにくい。コメントの中なら、そのまま書ける。
     *   名前を指すものは、印の方が、確かめられる。接頭語を付ければ、言語のタグと、語彙のタグが、混ざらない。
     * @adr.alternative 項目ごとに、印にする
     * @adr.alternative 関係も、タグで書く
     * @adr.alternative タグは、読まず、ただの文章にする
     * @adr.alternative 接頭語を付けない
     * @adr.said コメント内で `@` 指定のアノテーションで整理できませんか
     * @adr.said `@adr.context` みたいな接頭語をつける方針 + A
     */
    @adr.accepted
    D477;

    /**
     * 477 の仕組み: 説明のコメントの中の、接頭語の付いたタグは、文字列を一つ取るデコレータの、別の書き方とする。
     * タグのための、新しい宣言は、足さない。今ある検査が、そのまま効く。IR は、変えない。
     *
     * @adr.context 新しい概念を、足さずに済む。「デコレータは、宣言の前にも、説明のコメントの中にも、書ける。
     *   コメントの中に書けるのは、文章を一つ取るものだけ」と、一文で言える。
     * @adr.consequence 今の仕様のコメントで、行の頭が、たまたま、デコレータの名前になっている所は、タグとして読まれるので、書き換える。
     * @adr.alternative タグのための、新しい宣言を足す（予約語が増え、検査を、もう一通り作ることになる）
     * @adr.alternative 宣言を求めず、接頭語の付いた行は、すべて、タグとして読む（書き間違いを、見つけられない）
     */
    @adr.accepted
    D478;

    /**
     * 決定の記録（ADR）の語彙（名前空間 adr）に、持たせるもの: コメントの中のタグ context、consequence、rejected、said と、
     * 印 supersedes、decided、proposed。決めたことは、説明の本文に書く。状態は、proposed の一つだけ。
     * 名前空間 adr は、まず、Hozo 自身の仕様の中に、自前のものとして宣言する。
     *
     * @adr.context よく使われる型（Nygard の型、MADR）に、docs/decisions.md の一行が持つ項目（決めた人の言葉、持ち主）を、重ねた。
     *   proposed があれば、「聞かずに決めて、確かめていない決定」の表を、同じ並びで書け、確かめたら、印を外すだけで済む。
     *   「置き換え済み」は、置き換える印から分かり、「廃止」は、今の決定には、ない。
     * @adr.alternative 小さく始める（状況、採らなかった案、置き換える、結ぶ先の四つだけ）
     */
    @adr.accepted
    D479;

    /**
     * 説明のコメントの中に、タグとして書けるのは、@hint の付いたデコレータ（解釈されなくてよい、注記）だけ。
     * 478 に、条件を足す。
     *
     * @adr.context 478 のままだと、振る舞いを決めるデコレータも、文字列を一つ取るものなら、コメントの中に書くと、本当に、付く。
     *   コメントに書けるのは、注記だけ、という線にすれば、「コメントが、振る舞いを変えることは、ない」と言い切れる。
     * @adr.alternative 今のまま（文字列を一つ取るものなら、何でも書ける）
     * @adr.alternative 振る舞いのデコレータを、コメントに書いたら、本文として読む
     */
    @adr.amends(Decision.D478)
    @adr.accepted
    D480;

    /**
     * 決定の記録の語彙に、印 @adr.amends(…) を足す: この決定が、一部を直す決定（一部だけを、置き換える。条件を足す）。
     * 直された決定は、直された部分のほかは、効いたまま。どの部分かは、説明の本文に書く。
     *
     * @adr.context @adr.supersedes は、「置き換える。置き換えられた決定は、効いていない」の意味で、一部だけを直す決定に付けると、
     *   印だけを見る道具が、もとの決定を、効いていない、と読んでしまう。
     * @adr.alternative 一部を直す決定にも、@adr.supersedes を付け、どの部分かは、本文に書く
     */
    @adr.amends(Decision.D479)
    @adr.accepted
    D481;

    /**
     * リテラルの型（文字列、数（整数と小数）、真偽）を、型の位置に、書けるようにする。
     * 書ける位置は、項目の型、union のアームの型、ほかの、型を書ける位置。決まった値の集まりは、今の union
     * （名前の付いたアーム）で書く。行の中の、名前のない union は、足さない。
     * 型の決まりは、互換の規則 10 のまま（"error" は string に渡せ、string は "error" に渡せない）。
     * JSON の上では、リテラルの型の値は、その値そのもの。union の JSON の見分け方（399）は、変えずに、広げる:
     * 同じ名前の項目を持ち、その型が、違うリテラルの型のアームは、その項目の値で、リテラルの型そのもののアームは、
     * 値そのもので、見分ける。値を書けるのは、型の位置だけ（配線に、条件の式は、書けない）。
     *
     * @adr.context 新しい仕組みを足すのではなく、すでにある、リテラルの型（式の型）を、型として書けるようにする、
     *   と言う方が、自然で、言語の今の作りと、つながる。アームに名前があるので、match で、名前で分けられる。
     * @adr.consequence 今ある union は、今までどおりで、壊れない。書き写せなかったものの、穴 12（決まった値を持つ項目と、
     *   印で見分ける union）と、穴 13（列挙）が、足す向きで、解ける。
     * @adr.alternative 行の中の、名前のない union も、書けるようにする（アームを、名前で呼べない）
     * @adr.alternative 文字列のリテラルの型だけを入れる
     * @adr.alternative 列挙のための、宣言を足す（enum。穴 12 は、解けない）
     * @adr.alternative 今は、直さない
     * @adr.said 決まった型を書けるようにする、というよりは string literal, number literal 型の概念を追加するか？
     *   という話のほうが自然かと
     */
    @adr.accepted
    D482;

    /**
     * リテラルの型で、分類できる範囲: 型で決まる分類のケースの as に、リテラルの型を書けるのは、対象が、
     * 真偽の値（boolean）か、リテラルの型をアームに持つ union のときだけ。どちらも、取りうる値が、閉じている。
     * 文字列や、数の、開いた型（string、int）を対象に、as "abc"、as 0 と書くことは、できないままにする。
     *
     * @adr.context フラグの値から、ユースケースへの対応（書き写せなかったものの、穴 6）と、列挙のケースで分けることが、
     *   仕様に書ける。書くのは、条件の式ではなく、名前の付いた、閉じたケースの並びで、今の分類と同じ形。
     *   閉じた型に限れば、「閉じた場合分けを、名前で書く」という、今の線の内側に、とどまる。
     * @adr.alternative どの型でも、リテラルの型で、分類できるようにする（「条件は、中身」が、ゆるむ）
     * @adr.alternative 分類は、今のまま（フラグで分ける所は、人が書く述語のまま）
     */
    @adr.accepted
    D483;

    /**
     * 決定の持ち主を、移す。534 からの決定は、decisions.hozo の hozo.decisions.Decision のケースが持ち主（決定ごとに、一つ）。
     * docs/decisions.md「決めたこと」は、533 までで、足すのをやめる。会話から生まれた決定と、聞かずに決めた決定は、@adr.proposed で入れる。
     * 状態を @adr.accepted（または @adr.rejected）に替えるのは、利用者が、自分の言葉で、決定を名指しして認めた（または、却下した）ときだけ。
     * その言葉（会話でも、issue でもよい）を @adr.said に写してから、印を替える。この手順は、このプロジェクトの進め方で、語彙 adr とプラグインは、持たない。
     * 区切りの番号は、利用者が、三つの案から「533 で区切る（勧め）」を選んだ。
     * この写しは、短い（全文は docs/decisions.md「決めたこと」533）。
     *
     * @adr.alternative 区切りの番号を飛ばす（例: decisions.hozo は 600 から）
     * @adr.alternative まだ始めない（adr の語彙のプラグイン #173 が入ってから移す）
     * @adr.alternative 印を外す PR を、利用者が見て main に入れることを、認めたことにする
     * @adr.alternative issue でだけ認める
     * @adr.said このプロジェクトでは、おすすめの通り。プラグインでは明示しない
     */
    @adr.accepted
    D533;

    /**
     * 決定の状態を、5 つの印で言う: @adr.proposed（提案）、@adr.accepted（採用）、@adr.rejected（却下）、@adr.deprecated（廃止）、
     * 印 @adr.superseded(…)（置き換え済み）。状態を、一つの印の引数で持つ形には、しない。
     * どの決定にも、状態の印を、ちょうど一つ付ける。@adr.accepted も、明示して書く（印がないことを、確定とは読まない）。
     * 置き換えの関係は、古い決定の側に、@adr.superseded(新しい決定) で書く。新しい決定の側の @adr.supersedes は、なくす。
     * 一部を直す @adr.amends(…) は、今のまま、新しい決定の側。
     * 採らなかった案のタグは、@adr.rejected から @adr.alternative に、付け直す（@adr.rejected は、状態の名前になる）。
     * 479 のうち、「状態は、proposed の一つだけ」「付いていなければ、確定」「@adr.supersedes」「@adr.rejected（採らなかった案）」を、置き換える。
     *
     * @adr.context よく使われる型（Nygard の型、MADR）の状態は、提案、採用、却下、廃止、置き換えの五つ。
     *   却下と廃止を書く形がないと、却下された提案は、消すしかなく、欠番の理由も、同じ案が、また出たことも、分からない。
     *   印がないことを確定と読むと、確定と、書き忘れを、見分けられない。
     *   置き換えを、古い側の状態として書けば、一つの事実の持ち主が、一つになり、状態の印は、どれも、その決定自身の状態で、揃う。
     *   MADR も、比べた案（Considered Options）を、状態と分けている。
     * @adr.consequence 今あるケースのうち、印のなかった D417、D468〜D483 に、@adr.accepted を足した。@adr.rejected のタグは、@adr.alternative に書き換えた。
     *   印 @adr.supersedes を使っていたケースは、なかった（472 と 480 は、481 で @adr.amends に直してあった）。
     * @adr.alternative 却下を、状態として残さない（ケースを消して、欠番にする）
     * @adr.alternative 状態を、一つの印の値で持つ（@adr.status(…)）
     * @adr.alternative 新しい側に @adr.supersedes を残し、古い側の @adr.superseded は、引数のない状態だけにする
     * @adr.alternative 新しい側だけに書き、@adr.superseded は、作らない
     * @adr.alternative @adr.accepted は作らず、印がなければ確定のまま
     * @adr.alternative 採らなかった案のタグの名前を、@adr.considered か @adr.notChosen にする
     * @adr.said 残すというか5種類とも作るべきでは。ステータス引数ではなく、 adr.proposedの形式で5種
     * @adr.said alternative で
     * @adr.said 古い決定の側に superseded で
     * @adr.said 明示して書く、で
     */
    @adr.accepted
    @adr.amends(Decision.D479)
    D534;

    /**
     * decisions.hozo の決定は、入れた後、説明の本文とタグを、書き直さない。替えてよいのは、状態の印だけ
     * （@adr.proposed から @adr.accepted か @adr.rejected へ。@adr.accepted から @adr.deprecated か @adr.superseded(…) へ）と、
     * 認めた、または、却下したときに足す @adr.said。決定を変えるときは、新しいケースを足し、古いケースの状態の印を替える。
     * docs/decisions.md の「決定の行は書き直さない」を、移した先に当てはめたもの。
     *
     * @adr.context 古い決定の側に @adr.superseded を書く（D534）ので、古いケースにも、手を入れる。手を入れてよい所を、決めておく。
     * @adr.alternative 状態の印も含めて、入れた後は、何も替えない（D534 と、両立しない）
     */
    @adr.proposed
    D535;

    /**
     * 534 からの決定は、入れるときに、次の番号を振る。状態（提案でも）に、関わらない。却下した決定も、番号を残し、使い回さない。
     *
     * @adr.context 認めたときに、名前を変えると、それを指す @adr.decided(…) を、すべて書き換えることになる（穴 39）。
     *   入れるときに振れば、状態の印を替えるだけで済む。
     * @adr.alternative 認めたときに番号を振り、それまでは、中身を言う名前にする（今の WriteWithoutCi などの形）
     */
    @adr.proposed
    D536;

    /**
     * 印 @adr.superseded(…) は、置き換えた決定を、いくつも取れる（...decisions）。@adr.amends(…)、@adr.decided(…) と、同じ形。
     *
     * @adr.context 一つの決定を、二つの決定が、分けて置き換えることが、ありうる。
     * @adr.alternative 一つだけ取る
     */
    @adr.proposed
    D537;

    /**
     * 複数行の文字列を、言語の全体に足す。文字列を書ける所なら、どこでも書ける（デコレータの引数、配線の値、リテラルの型）。
     * 説明のコメントの中のタグ（477、478）も、残す: 文章を一つ取るデコレータは、タグでも、複数行の文字列の引数でも、書ける。
     *
     * @adr.context 決定の理由や補足は、項目に割るには複雑で、自然な文章で書ける方が、都合がよい。
     *   477 が、引数の形をやめた理由は、文章を、文字列の引数に書くのは、書きにくいこと（複数行が書けない）で、それがなくなる。
     *   478 で、タグは、もともと、引数の別の書き方なので、意味は増えず、字句が一つ増えるだけ。ADR のほか（要求の説明、診断の文言など）にも、効く。
     * @adr.consequence 同じことの書き方が、二つ（タグと、引数）になる。今ある decisions.hozo のタグは、書き換えない。
     *   @hint のないデコレータ（480 で、タグにできない）にも、長い文章を渡せる。
     * @adr.alternative 足して、タグはなくす（477、478、480 を置き換え、今あるタグを、すべて引数に書き換える）
     * @adr.alternative ADR の語彙のデコレータの引数にだけ、許す（場所によって、字句が変わる）
     * @adr.said 複数行文字列を記載可能にする。意思決定における理由や補足などは構造化するには複雑であり、自然言語での記載を可能に、拡張できたほうが都合がよい
     * @adr.said そのうえで、引数に理由などを自由にかけるようにするとかはどうか
     * @adr.said 言語の全体に足し、タグも残す、で
     */
    @adr.accepted
    D538;

    /**
     * 538 の、複数行の文字列の形: 三つの二重引用符で囲む（"""…"""）。開きの後ろは、行の終わり。閉じは、自分の行に置き、
     * その前の空白を、字下げとして、中身の各行から取り除く。閉じの前の改行は、値に入らない。エスケープは、ふつうの文字列と同じ。
     * 字下げで始まらない行、開きの後ろの文字、行の途中の、エスケープしない三つの引用符は、構文エラー。
     * 持ち主は docs/grammar.md「リテラル」。
     *
     * @adr.context 閉じの位置で字下げを決めると、周りのコードの字下げに合わせて書け、値には、意図した字下げだけが残る（Swift、Java のテキストブロックと同じ考え）。
     *   値の始まりと終わりが、行の境で決まるので、前後の改行を、どう扱うかに、迷わない。
     * @adr.alternative 中身の行の、いちばん短い字下げを、取り除く（Kotlin の trimIndent。閉じの位置に、意味がなくなる）
     * @adr.alternative 字下げを取り除かない（周りに合わせて字下げすると、値に入る）
     * @adr.alternative バッククォートで囲む（` は、文書の中で、コードの印として使っている）
     */
    @adr.consequence("""
      値の字下げは、閉じの位置で決まる。この引数の値は、三行で、頭に空白が残るのは、三行目の二つだけ:
      周りに合わせて字下げしても、
        閉じより深い分は、値に残る。
      """)
    @adr.proposed
    D539;

    /**
     * docs/README.md「書き方」から、docs/decisions.md の書き方（「決定と持ち主の一覧で、理由は持たない」）を、消す。
     * 決めた理由は、決定に置く（534 からは decisions.hozo）、とだけ言う。
     *
     * @adr.context docs/decisions.md の行の多くは、理由を持っていて、文書と食い違っていた。docs/decisions.md は 533 で閉じ（533）、
     *   もう書かないので、docs の側から、その書き方を指示するのは、変。533 までの行は、書き直さない。
     * @adr.alternative 一文を、実際に合わせて「決定と、決めた時点の理由を持つ」に直す（こちらの勧め）
     * @adr.alternative そのままにし、#174 で考える
     * @adr.said なおす
     * @adr.said というか,docs から消えるものの書き方をdocs で指示するのも変だ
     */
    @adr.accepted
    D540;

    /**
     * ユースケース write（書き出す）の担い手に、Ci を入れない。
     * 出どころは、docs/open.md「聞かずに決めて、確かめていない決定」の、hozoc の担い手の行。
     *
     * @adr.context 472 の理由に、例として書いた言い方（「CI は、検査する」「人と AI は、書き出す」）を、写した。文書に、根拠は、ない。
     * @adr.alternative Ci を、write にも入れる（CI が、ビルドの中でコードを書き出す使い方は、ありえる）
     */
    @adr.proposed
    WriteWithoutCi;

    /**
     * 業務の流れは、新しいファイル flows.hozo に書き、流れに、担い手は、結ばない。
     * hozo.flows と hozo.toolchain は、単位に入れない。
     * 出どころは、docs/open.md「聞かずに決めて、確かめていない決定」の、hozoc の業務の流れの行。
     *
     * @adr.alternative 流れを cli.hozo に書く
     * @adr.alternative 流れにも、担い手を結ぶ印を足す
     * @adr.alternative go-design を並べて、流れのテストの口を出す
     */
    @adr.proposed
    FlowsInOwnFile;

    /**
     * 生成物の置き場は internal/gen/hozo/compiler、Go のパッケージ名は compiler。仕様のファイルは cli.hozo のまま。
     * 出どころは、docs/open.md「聞かずに決めて、確かめていない決定」の、名前空間を付け直したときの行。
     *
     * @adr.context 後で、hozo.plugin、hozo.ide が、横に並ぶ形にする。
     * @adr.alternative 置き場を internal/gen/hozoc のままにする
     * @adr.alternative 仕様のファイルを hozo/compiler.hozo に移す
     */
    @adr.proposed
    GeneratedUnderHozo;
  }
}
