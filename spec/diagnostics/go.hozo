// Hozo 自身の仕様: 診断の分類 hozo.diagnostics.Go（決定 D812。持ち主は、このファイル）。印の意味は spec/diagnostics.hozo。
// ケースの名前は、ID の - を _ に替えたもの。もとの綴りは、説明の頭に書く。どの単位の対象でもない: コードには、ならない。

namespace hozo.diagnostics {
  /** Go の基底のトランスパイラ go が返す診断（plugins/go/spec/go.hozo） */
  classify Go of never {
    // docs/plugin-go.md「診断」が説明する規則

    /**
     * GO-2: 生成する名前が当たる（plugins/go/spec/go.hozo の Requirement.Names）。当たった二つの宣言をメッセージに示す。位置は後ろの宣言
     */
    @severity(Severity.Error)
    GO_2;

    /**
     * GO-3: 型のパッケージどうしの import が循環する（plugins/go/spec/go.hozo の Requirement.Layout の「パッケージと import パス」。型と、値の分類・op の分類が、互いの名前空間の型を使う）。輪に入る出力を、単位（何番目の `[[emit]]` か）と名前空間でメッセージに示す。位置なし。輪に入る出力ごとに出る
     */
    @severity(Severity.Error)
    GO_3;

    /**
     * GO-4: 基底が作るディレクトリが、同じ単位が出力する子の名前空間の出力先と重なる: 内側のフォルダ `inner` と `N.inner`（plugins/go/spec/go.hozo の Requirement.Layout の「内側のフォルダと入口」。位置は、名前空間の最初の内部の op）、テストのパッケージ `<パッケージ名>test` と `N.<パッケージ名>test`（plugins/go/spec/go.hozo の Requirement.UnitTestPort。位置は、口を持つ最初の宣言）、型のパッケージ `types` と `N.types`（plugins/go/spec/go.hozo の Requirement.Layout の「型のパッケージ」。位置なし）
     */
    @severity(Severity.Error)
    GO_4;

    /**
     * GO-5: トランスパイラ `go` へのオプションに、知らないキーがある（plugins/go/hozo-plugin.toml）。位置なし
     */
    @severity(Severity.Error)
    GO_5;

    /**
     * GO-6: `variant` の絞り込みの `as` の型と等しい型のアームが、union に二つ以上ある（plugins/go/spec/go.hozo の Requirement.Wiring の「match」）。位置は分類
     */
    @severity(Severity.Error)
    GO_6;

    /**
     * GO-7: 単位のトランスパイラが、本体のあるデコレータに、継ぎ目を宣言している（plugins/go/spec/go.hozo の Requirement.Wraps）。位置は、デコレータの宣言。メッセージに、宣言したトランスパイラの名前
     */
    @severity(Severity.Error)
    GO_7;

    /**
     * GO-8: オプション `module` が、書かれていない、文字列でない、空（plugins/go/spec/go.hozo の Requirement.Layout の「パッケージと import パス」、plugins/go/hozo-plugin.toml）。位置なし。メッセージは、`hozo.toml` の `[options.go]` に、`go.mod` の `module` と同じ名前を書くことを、示す
     */
    @severity(Severity.Error)
    @adr.decided(hozo.decisions.Decision400.D425)
    GO_8;

    /**
     * GO-9: 名前空間 N の宣言が、基底が、まだ Go の形を持たない、リテラルの型の使い方をしている（`docs/open.md`「語彙とプラグイン」）。断るもの: リテラルの型（`docs/types.md`「リテラルの型」）を、op・`read`・効果・デコレータの引数と戻り値、例外の引数、状態の型、`optional` と `array` の中、インデックスの model のキーと値、分類の対象に使う宣言。`literal` の絞り込み（同「型で決まる絞り込み」）を持つ、状態の分類。**断らないもの**（Go の形がある）: model のフィールドの型そのもの（plugins/go/spec/go.hozo の Requirement.Types の「model」）、union のアームの型そのもの（plugins/go/spec/go.hozo の Requirement.Types の「union」）、分類のケースの `as` に書いたリテラルの型（`variant` と、対象の型が `boolean` か `boolean?` の `literal`: plugins/go/spec/go.hozo の Requirement.Wiring の「match」）。配線の本体の中の型は、見ない。形を当て推量せずに、断る。位置は、その宣言。宣言ごとに一つ
     */
    @severity(Severity.Error)
    GO_9;

    /**
     * GO-INTERNAL: 生成器の不具合（利用者の仕様の誤りではない）: 生成したコードを `go/format` で整形できない、検査を通った IR には来ないはずの形、`View` が欠けている、型の置き場がない（CFG-22 が通したはずのもの）
     */
    @severity(Severity.Error)
    GO_INTERNAL;

    // 欠番: なくした ID。別の意味に、使い回さない（決定 D52）

    /**
     * GO-1: 欠番。「Dir(U, N) の上に `go.mod` がない」という診断で、プラグインが `go.mod` を読まなくなったとき（決定 D425）に、なくなった。番号は、使い回さない
     */
    @retired
    @adr.decided(hozo.decisions.Decision400.D425)
    GO_1;
  }
}
