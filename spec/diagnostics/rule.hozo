// Hozo 自身の仕様: 診断の分類 hozo.diagnostics.Rule（決定 D812。持ち主は、このファイル）。印の意味は spec/diagnostics.hozo。
// ケースの名前は、ID の - を _ に替えたもの。もとの綴りは、説明の頭に書く。どの単位の対象でもない: コードには、ならない。

namespace hozo.diagnostics {
  /** 言語と設定の規則（docs/check.md、docs/resolve.md、docs/types.md、docs/config.md が説明する）。どのケースも、tests/rules/<ID>/ に、通る例と落ちる例を持つ（持たないものと、その理由は tests/rules_test.go） */
  classify Rule of never {
    // docs/check.md「名前空間」が説明する規則

    /**
     * NS-1: 別の名前空間の宣言は常に修飾して参照。外側を自動で探さない
     *
     * 解決の手続きそのもの（`docs/resolve.md`「手続き」）。診断は RES-1 として出る
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    NS_1;

    /**
     * NS-2: 同じ名前の `namespace` は一つに併合
     *
     * 正規化で行う。診断なし
     */
    @severity(Severity.Silent)
    @checkedBy(hozo.compiler.verify)
    NS_2;

    /**
     * NS-3: 複数の語彙（標準の語彙、プラグインの語彙）が同じ名前をグローバルに宣言したらエラー
     *
     * RES-6 のうち、両方の出どころが語彙（`Span.file` が `hozo:` で始まる。`docs/ir.md`「Program」）のもの。メッセージに語彙の出どころ（標準か、どのプラグインか）を出す
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    NS_3;

    /**
     * NS-5: 別の名前空間の、`export` のない op を呼んだ（`docs/check.md`「op の宣言と本体」の「export」の表の二つ: 配線の呼び出し、デコレータの引数に渡した op）。位置は呼び出しの op の名前（デコレータの引数ならその引数の値）。`Related` にその op の宣言
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    NS_5;

    /**
     * NS-6: 配線が、別の名前空間の `read` か効果（`effect` の宣言）を呼んだ（`docs/check.md`「状態に触れるもの」の「配線からの呼び出し」）。位置は呼び出しの名前。`Related` にその宣言。メッセージに、その名前空間の op を通すことを示す。`Signature` を要しないので `internal/sema` が出す
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    NS_6;

    /**
     * NAME-1: 型の位置は UpperCamelCase、実行・適用されるものは lowerCamelCase
     *
     * `model` / `scalar` / `exception` / `union` / `classify` とそのケースの名前の先頭が大文字でない。`state` / `op` / `effect` / `read` / `decorator` の名前の先頭が小文字でない。`_` で始まる名前も警告。語彙は対象外。強さは、ここで warning と決めた
     */
    @severity(Severity.Warning)
    @checkedBy(hozo.compiler.verify)
    NAME_1;

    /**
     * DOC-1: `@param` / `@throws` / `@see` が存在しない名前を指したらエラー。説明の有無は警告しない
     *
     * `@param` が引数名にない（op、デコレータ、`exception`、`effect`、`read` の引数。引数を持たない種類の宣言に書いた `@param` も）、`@see` が解決できない（`internal/sema`）。`@throws` の例外が `Signature.exceptions` にも、O に付いたデコレータの `outer throws` にもない（`internal/check`。外から見たときだけ起きる例外も書けるようにするため）。効果の `@throws` の例外が、その効果の `throws`（`Effect.throws`）にない（`internal/sema`）。デコレータの宣言の `@param` は `Param` の名前
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    DOC_1;

    /**
     * DOC-2: 同じ `@param` 名、同じ `@throws` 例外が二度ある
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    DOC_2;

    /**
     * UNION-1: `union` の要素にアーム（`A: T`）と参照（`X;`）が混ざる。または参照の要素に例外と効果が混ざる。または `arms` でアーム名が重複
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    UNION_1;

    /**
     * UNION-2: `union`（`arms`）の二つのアームが、等しいリテラルの型を持つ（`docs/types.md`「リテラルの型」）。位置は、後ろのアームの型
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    UNION_2;

    // docs/check.md「状態と効果」が説明する規則

    /**
     * STATE-1: 状態への操作は形で決まる（形と操作の表は `docs/check.md`「状態の形」）
     *
     * 組み込みの効果の `operation` が、その状態の形にない（`docs/check.md`「状態の形」の表。`single` に `post` / `delete`）。`effect` の宣言の宛先にも、`effects` に直に書いた `状態.操作`（`docs/check.md`「状態に触れるもの」の「節に書く要素」）にも、配線で直に呼んだ `状態.操作(…)`（同「直に呼ぶ組み込みの効果」）にも掛かる。位置は操作の語
     *
     * 決めた所と、説明のある所: S1: `docs/check.md`「状態の形」。`effects` に直に書いた `状態.操作` と、配線で直に呼んだ `状態.操作(…)` にも掛かる: 同「状態に触れるもの」
     */
    @severity(Severity.Error)
    @adr.decided(hozo.decisions.DecisionS.S1)
    @checkedBy(hozo.compiler.verify)
    STATE_1;

    /**
     * STATE-3: 状態の要素の型（`State.element`）が `optional`。形が型から決まるようになった（`docs/check.md`「状態の形」）ので、当たるのは `list` の状態だけ（`list<T?>`、`T?[]`）: 列は値を持つ。`single<T?>` と `nullable<T?>` は `T?`（`nullable<T>`）と同じ型なので当たらない（`docs/types.md`「形の書き方」）。当たった状態は、`list<T>` として残りの検査を続ける
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    STATE_3;

    /**
     * STATE-4: 遷移の前か後のケースが、宛先の分類のケースでない（宛先が基底の状態なら、その形の、組み込みの分類のケース: `docs/check.md`「状態の形」の表）。宛先が `single` の状態（組み込みの分類がない）。前と後のどちらかのケースの並びに重複がある
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    STATE_4;

    /**
     * STATE-2: 持ち主でない名前空間の op（葉でも配線でも）に、その状態への効果をデコレータが運んだらエラー（葉の op は、自分では `effects` を書けない: STATE-5）
     *
     * op O（葉でも配線でも）にデコレータが運ぶ効果 e（`Op.carried.effects`）について、e の名前空間（直に書いた効果なら、その状態の名前空間）が ns(O) と違う。デコレータの `halts` の効果（宣言に書いたもの、`any effect` の引数で渡したもの）についても、デコレータを付けた op の名前空間と違えば同じ（§6.2「持ち主ではない名前空間の葉の op がその効果を `effects` に宣言すればエラー」を、葉が節を書けなくなり、デコレータが配線にも運ぶ形に当てたもの）。位置はそのデコレータの適用
     *
     * 決めた所と、説明のある所: `docs/check.md`「状態と効果」「葉の op」「デコレータが運ぶ reads と effects」
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    STATE_2;

    /**
     * EFF-1: 効果は呼び出し元に自動で伝播する
     *
     * 計算（Sig の F）で行う。診断なし
     */
    @severity(Severity.Silent)
    @checkedBy(hozo.compiler.verify)
    EFF_1;

    /**
     * READS-1: op O（葉でも配線でも）にデコレータが運ぶ `reads`（`Op.carried.reads` の要素の状態。`read` の宣言なら、その宛先）の名前空間が ns(O) と違う（計算`docs/check.md`「デコレータが運ぶ reads と effects」。`Signature` を要しないので `internal/sema` が出す）。位置はそのデコレータの適用
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    READS_1;

    /**
     * EFF-4: 配線の op が、`effects` の節に、計算した分にない効果を書けば warning
     *
     * 配線の op O が、`effects` の節に書いた効果 e（`Op.effects` の要素。ユニオンは、展開した効果ごと）が、計算した分にない（`docs/check.md`「状態に触れるもの」の「節に書く要素」と、`docs/check.md`「状態と効果」）。効果ごとに一つ。位置は op。メッセージに、本体が、それを行わないことと、呼び出しを書くか、節から外すことを示す
     *
     * 決めた所と、説明のある所: 決定 D451: `docs/check.md`「状態に触れるもの」の「節に書く要素」
     */
    @severity(Severity.Warning)
    @adr.decided(hozo.decisions.Decision400.D451)
    @checkedBy(hozo.compiler.verify)
    EFF_4;

    /**
     * READS-3: 配線の op が、`reads` の節に、計算した分にない状態を書けば warning
     *
     * 配線の op O が、`reads` の節に書いた要素の状態（`read` の宣言なら、その宛先）が、計算した分にない（`docs/check.md`「状態に触れるもの」の「節に書く要素」と、`docs/check.md`「状態と効果」）。状態ごとに一つ。位置は op。メッセージは EFF-4 と同じ形
     *
     * 決めた所と、説明のある所: 決定 D451: `docs/check.md`「状態に触れるもの」の「節に書く要素」
     */
    @severity(Severity.Warning)
    @adr.decided(hozo.decisions.Decision400.D451)
    @checkedBy(hozo.compiler.verify)
    READS_3;

    /**
     * STATE-5: 葉の op（本体を持たない op）が `reads` か `effects` の節を書いた（`docs/check.md`「状態に触れるもの」の「葉の op」。`Signature` を要しないので `internal/sema` が出す）。節ごとに一つ。位置はその節。メッセージに、`read` か効果を宣言して配線で呼ぶことを示す
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    STATE_5;

    /**
     * STATE-6: 配線が、`list` の状態の `put` か `delete` を直に呼んだ（`docs/check.md`「状態に触れるもの」の「直に呼ぶ組み込みの効果」: どの列かを引数から決める規則がない）。位置は操作の語。メッセージに、名前を付けた `effect` を宣言して呼ぶことを示す。`internal/sema` が出す
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    STATE_6;

    /**
     * STATE-7: 行の遷移（`as` の節）が、書き込む状態と効果の引数に結びつかない（`docs/check.md`「行の遷移」の「結びつき」）: ケース `C.K` の C が、値の分類でない（op の分類、状態の分類）か、対象の型が、状態の要素の型 T でも `T?` でもない。K が C のケースでない。効果の引数に、型が T か、T を絞り込んだ型のものが、ちょうど一つでない（メッセージに、行の引数を持たない効果は `as` を書けないことを示す）。位置は、当たったケースの名前（引数の数なら `as`）。`internal/sema` が出す
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    STATE_7;

    /**
     * STATE-8: 行の遷移の形が、操作に合わない（`docs/check.md`「行の遷移」の「操作ごとに書ける形」の表の「書けない形」）。`put` と `delete` の行の引数を、ない側のケースに絞り込んだ型も、これ。位置は、合わないところ（ケースなら、そのケースの名前、`else` なら `else`、引数の型なら、その型）。メッセージに、その操作で書ける形を示す。`internal/sema` が出す
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    STATE_8;

    // docs/check.md「throws」が説明する規則

    /**
     * THROWS-3: `never` を返す op が、`docs/check.md`「op の宣言と本体」の「never を返す op」の条件 1〜6 のどれかを満たさない（`Signature` を要しないので `internal/sema` が出す）。満たさない条件ごとに一つ。位置は、1 は op の名前、2 と 3 は `throws`（なければ op の名前）、4 は最初の引数、5 と 6 はそのデコレータ
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    THROWS_3;

    /**
     * THROWS-4: 配線の op が `throws` の節に書いた例外は、計算した例外に、足す。節に書いていない例外も、多めに書いた例外も、エラーにしない。診断は、ない
     *
     * 計算（Sig の E）で行う。診断なし。配線の op が `throws` の節に書いた例外は、計算した例外に、足す。節に書いていない例外も、多めに書いた例外も、エラーにしない（`docs/check.md`「状態に触れるもの」の「節に書く要素」）
     *
     * 決めた所と、説明のある所: 決定 D381: `docs/check.md`「状態に触れるもの」の「節に書く要素」
     */
    @severity(Severity.Silent)
    @adr.decided(hozo.decisions.Decision300.D381, hozo.decisions.Decision400.D466)
    @checkedBy(hozo.compiler.verify)
    THROWS_4;

    /**
     * REL-1: `throws` の中で各例外は一度だけ現れる
     *
     * `Op.throws`（またはデコレータの `throws`、効果の `throws`）の全節を通して同じ例外が二度ある（`Signature` を要しないので `internal/sema` が出す。REL-5 も同じ）
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    REL_1;

    /**
     * REL-2: 効果を持たない op の `throws` に `prevents` / `keeps` があれば警告
     *
     * Sig(O, ns(O)).effects が空の op の `Op.throws` に `relations` がある。デコレータの `throws` の `relations` は対象外（§7.3）
     */
    @severity(Severity.Warning)
    @checkedBy(hozo.compiler.verify)
    REL_2;

    /**
     * REL-4: 配線の op の例外ごとの効果の状態は検査器が計算する。書かれた `prevents` / `keeps`（目的語は `effects` だけ）が計算と食い違えばエラー
     *
     * 計算の手順 0 の「配線の `Op.throws` に `relations` が書かれていれば」の比較。`prevents` なのに `prevented` でない、`keeps` なのに `kept` でない組を示す。目的語の `effects` は、その op の効果のすべて（F）なので、呼ぶ先が言った関係を、呼び元が、向きを変えて書いたとき（呼ぶ先の効果は、呼ぶ先の言ったとおりに計算される）にも、呼び元が、同じ向きで書いて、例外の前に起きる効果を持つときにも、当たる（`docs/check.md`「状態に触れるもの」の「節に書く要素」の、上書き）
     *
     * 決めた所と、説明のある所: S9: `docs/check.md`「計算」「throws」
     */
    @severity(Severity.Error)
    @adr.decided(hozo.decisions.DecisionS.S9)
    @checkedBy(hozo.compiler.verify)
    REL_4;

    /**
     * REL-5: 一つの `ThrowsClause` に `prevents` と `keeps` の両方がある
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    REL_5;

    // docs/check.md「デコレータ」が説明する規則

    /**
     * DEC-1: 付けられる対象は、関数に付けるデコレータ（`decorator fn`）なら `op`、そのほかは `for` で決まる。宣言にない対象に付けたらエラー
     *
     * `Application` が付いた先の種類が、D の `targets` にない。分類のケースに付けたときは、D の `targets` に、そのケースを含む、分類のケース（`docs/grammar.md`「decorator の宣言」の `CaseKind`: 分類の名前か、対象の型で、絞る）がなければ DEC-1。`union` / `classify`（分類そのもの）/ `decorator` の宣言に付けたときも、同じ: D の `targets` に、その種類がなければ DEC-1（付けられるようにしたのは 決定 D476。関数に付けるデコレータ `decorator fn` の `targets` は `op` だけなので、この三つには、付かない）。`namespace` と `bind` は文法で閉じる（`docs/grammar.md`「ファイルと宣言」）
     *
     * 決めた所と、説明のある所: 対象 `effect` と `read`: `docs/grammar.md`「decorator の宣言」（理由は同「決めたこと」）
     */
    @severity(Severity.Error)
    @adr.decided(hozo.decisions.Decision400.D476)
    @checkedBy(hozo.compiler.verify)
    DEC_1;

    /**
     * DEC-2: `throws` / `catches`（と、`reads` / `effects`）の節を宣言できるのは、関数に付けるデコレータ（`decorator fn`）だけ（文法で閉じる）
     *
     * 文法で閉じる（節を持てるのは、`decorator fn` だけ。`docs/grammar.md`「decorator の宣言」）
     *
     * 決めた所と、説明のある所: `reads` / `effects` の節は 決定 D98。`decorator fn`: 同 394、`docs/grammar.md`「decorator の宣言」
     */
    @severity(Severity.Silent)
    @adr.decided(hozo.decisions.Decision000.D98, hozo.decisions.Decision300.D394)
    @checkedBy(hozo.compiler.verify)
    DEC_2;

    /**
     * DEC-3: `catches X` の後に `recovers` / `halts e` / `ignores` を必ず書く
     *
     * 文法で閉じる
     */
    @severity(Severity.Silent)
    @checkedBy(hozo.compiler.verify)
    DEC_3;

    /**
     * DEC-4: `ignores` は値を返さない op にだけ付けられる
     *
     * `catches ... ignores` を持つデコレータが、`returns` が `null` でない op に付いている
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    DEC_4;

    /**
     * DEC-5: 効果が不明な例外を `recovers` で吸収するデコレータを、効果を持つ op に付けたら警告
     *
     * 計算の手順 i で `recovers` が succ(e) を `unknown` にした（F が空なら起きない）
     */
    @severity(Severity.Warning)
    @checkedBy(hozo.compiler.verify)
    DEC_5;

    /**
     * DEC-6: `throws` と `catches` の差し引きがゼロになる宣言は警告
     *
     * 一つのデコレータの宣言で、`catches` の例外と `throws` の例外に同じものがある
     */
    @severity(Severity.Warning)
    @checkedBy(hozo.compiler.verify)
    DEC_6;

    /**
     * DEC-7: 引数の中身を確認する（`any effect on s.put` の性質、ユニオンのメンバー、持ち主でない状態への効果など）
     *
     * `docs/types.md`「デコレータの引数」の、`any effect on` と、ユニオンのメンバーと、分類のケース（`any case of never`、`any case of Order`、`any case of Actor` の、絞りに合わないケース）の照合
     */
    @severity(Severity.Error)
    @checkedBy(hozo.compiler.verify)
    DEC_7;

    /**
     * DEC-8: 名前付きのデコレータは、汎用のデコレータに引数を固定した別名としてだけ定義できる
     *
     * 文法で閉じる
     */
    @severity(Severity.Silent)
    @checkedBy(hozo.compiler.verify)
    DEC_8;

    /**
     * DEC-9: 適用順は op に近いものから。IR では入れ子にせず、順序付きの列に正規化する
     *
     * 正規化（`docs/ir.md`「デコレータの適用」）
     *
     * 決めた所と、説明のある所: `docs/ir.md`「デコレータの適用」（決定 D16）
     */
    @severity(Severity.Silent)
    @adr.decided(hozo.decisions.Decision000.D16)
    @checkedBy(hozo.compiler.verify)
    DEC_9;

    /**
     * DEC-10: `outer throws` の例外は境界の外から見たときだけ加わる（前は `@external` の `throws`。決定 D407）
