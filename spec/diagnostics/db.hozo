// Hozo 自身の仕様: 診断の分類 hozo.diagnostics.Db（決定 D812。持ち主は、このファイル）。印の意味は spec/diagnostics.hozo。
// ケースの名前は、ID の - を _ に替えたもの。もとの綴りは、説明の頭に書く。どの単位の対象でもない: コードには、ならない。

namespace hozo.diagnostics {
  /** 語彙のプラグイン db が返す診断（docs/plugin-db.md） */
  classify Db of never {
    // docs/plugin-db.md「診断」が説明する規則

    /**
     * DB-1: `@db.table` の付いた状態の要素の型が、model でないか、インデックスの model（`docs/plugin-db.md`「表」）。位置は状態
     */
    @severity(Severity.Error)
    @adr.decided(hozo.decisions.Decision400.D410)
    DB_1;

    /**
     * DB-2: `@db.table` の付いた状態の形が `list` でない（`nullable`、`single`）。位置は状態
     */
    @severity(Severity.Error)
    DB_2;

    /**
     * DB-3: `db` のデコレータを付けた `read` の `reads` の状態か、効果の宛先の状態が、N の表の状態でない（`@db.table` が付いていない）。位置は、その `read` か効果
     */
    @severity(Severity.Error)
    DB_3;

    /**
     * DB-4: 列を名指しするもの（`read` と `@db.delete` の効果の引数の名前、`@db.where` と `@db.latest` の `column`）が、表の model のフィールドにない。位置は、その `read` か効果
     */
    @severity(Severity.Error)
    DB_4;

    /**
     * DB-5: 引数が、デコレータの言うものと合わない: 条件の引数（`read` と、`@db.delete` の効果）の型が、列に合わない（`docs/plugin-db.md`「列と引数の型」）。`@db.insert` / `@db.update` の効果の引数が、表の model の行一つでない。位置は、その `read` か効果
     */
    @severity(Severity.Error)
    DB_5;

    /**
     * DB-6: `read` の結果の型が、デコレータの言うものと合わない: `@db.find` は `M?`、`@db.list` は `M[]`（M は表の model）。位置は `read`
     */
    @severity(Severity.Error)
    DB_6;

    /**
     * DB-7: 効果のデコレータが、効果の宛先と合わない（`docs/plugin-db.md`「効果」）: 宛先が組み込みの効果でない（分類の遷移）か、操作が合わない（`@db.insert` は `post`、`@db.update` は `put`、`@db.delete` は `delete`）。位置は効果
     */
    @severity(Severity.Error)
    DB_7;

    /**
     * DB-8: 一つの効果が、`@db.insert` / `@db.update` / `@db.delete` のうち二つ以上を持つ。位置は効果
     */
    @severity(Severity.Error)
    DB_8;

    /**
     * DB-9: `@db.find` の `read` が、一行に決まらない: 条件の列が、表の model の `@db.key` のすべても、`@db.unique` の列も含まず、`@db.latest` もない（`docs/plugin-db.md`「read」）。位置は `read`
     */
    @severity(Severity.Error)
    DB_9;

    /**
     * DB-10: `@db.update` の表の model が、`@db.key` を一つも持たないか、キーでない列を一つも持たない。位置は効果
     */
    @severity(Severity.Error)
    DB_10;

    /**
     * DB-11: 表の model のフィールドの `@db.ref(M2)` の指す先が、一つに決まらない: 要素の型が M2 の表の状態が、N にないか、二つ以上ある。または、M2 の `@db.key` が一つでない（`docs/plugin-db.md`「キーと参照」）。位置は model
     */
    @severity(Severity.Error)
    DB_11;

    /**
     * DB-12: 一つの `read` が、`@db.find` と `@db.list` の両方を持つ。位置は `read`
     */
    @severity(Severity.Error)
    DB_12;

    /**
     * DB-13: `@db.where` か `@db.latest` の付いた `read` が、`@db.find` も `@db.list` も持たない。位置は `read`
     */
    @severity(Severity.Error)
    DB_13;

    /**
     * DB-14: 一つの `read` の条件が、同じ列を二度名指ししている（引数と `@db.where`、二つの `@db.where`）。位置は `read`
     */
    @severity(Severity.Error)
    DB_14;

    /**
     * DB-15: `@db.where` のリテラルが、列の型に渡せない（`docs/plugin-db.md`「read」）。メッセージに、列、リテラル、型を示す。位置は `read`
     */
    @severity(Severity.Error)
    DB_15;

    /**
     * DB-16: `@db.delete` の効果が、引数を一つも持たない。まだ決めていない形（`docs/plugin-db.md`「効果」の未決）。位置は効果
     */
    @severity(Severity.Error)
    DB_16;

    /**
     * DB-17: `@db.update` を付けた効果の行の遷移（`Effect.row`）の、行の引数の型が、同じ分類で絞り込んだ型（`case`）で、後のケース（`to`）が、その `cases` にない（`docs/plugin-db.md`「効果」）。位置は効果
     */
    @severity(Severity.Error)
    DB_17;

    /**
     * DB-18: `@db.conflict` を付けた効果が、`@db.insert` も `@db.update` も持たない（`docs/plugin-db.md`「効果」）。位置は効果
     */
    @severity(Severity.Error)
    DB_18;

    /**
     * DB-19: `@db.conflict` の例外が、使えない: その効果の `throws` にない。引数を持つ。メッセージに、どちらかを示す。位置は効果
     */
    @severity(Severity.Error)
    DB_19;
  }
}
