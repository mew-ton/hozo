    @adr.decided(hozo.decisions.Decision100.D134, hozo.decisions.Decision100.D137)
    GOSQL_19;

    /**
     * GOSQL-21: 欠番（GOSQL-14、GOSQL-18、GOSQL-19、GOSQL-21、GOSQL-23 を、まとめて、なくした）。`db` の語彙の、op の中身を言うデコレータ（`@db.reads`、`@db.effects`）、`@db.nullable`、デコレータの引数の表についての規則。`db` の語彙を、`read` と効果の宣言から中身を作る形にした（決定 D134〜D137）ときになくなった
     *
     * 経緯のある所: `docs/plugin-go-sqlite.md`「診断」
     */
    @retired
    @adr.decided(hozo.decisions.Decision100.D134, hozo.decisions.Decision100.D137)
    GOSQL_21;

    /**
     * GOSQL-23: 欠番（GOSQL-14、GOSQL-18、GOSQL-19、GOSQL-21、GOSQL-23 を、まとめて、なくした）。`db` の語彙の、op の中身を言うデコレータ（`@db.reads`、`@db.effects`）、`@db.nullable`、デコレータの引数の表についての規則。`db` の語彙を、`read` と効果の宣言から中身を作る形にした（決定 D134〜D137）ときになくなった
     *
     * 経緯のある所: `docs/plugin-go-sqlite.md`「診断」
     */
    @retired
    @adr.decided(hozo.decisions.Decision100.D134, hozo.decisions.Decision100.D137)
    GOSQL_23;
  }
}
