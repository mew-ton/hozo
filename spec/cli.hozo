/**
 * hozo の仕様を検査し、各言語のコードに展開するコンパイラの、ユースケース。
 * コマンドの行（入口）は、名前空間 hozo.cli で、フラグを知っているのは、そちらだけ: ユースケースの入力は、フラグに当たる項目を
 * 持たない（決定 D472、D473）。
 * 例外は、投げるユースケースの側（この名前空間）に宣言し、終了コード（@cli.exitCode）も、その宣言に付ける。go-cli は、コマンドの op が
 * 投げうる例外を、どの名前空間のものでも見分ける（plugins/go-cli/spec/go-cli.hozo の Requirement.CommandFunctions）。例外の名前の表示（--format json の
 * "error"）は、hozo.compiler.CheckFailed のように、名前空間から書く（決定 D742）。
 */
namespace hozo.compiler {
  /**
   * 担い手: hozoc を使うもの。どの担い手が、どのユースケースを使うかは、ユースケースの op の @prd.usecase.of が言う
   * （docs/tools.md「担い手」、docs/requirements.md「書く人と、読む人」、confirmTests の説明、docs/testing.md「CI」）。
   * 担い手は、していることで分ける。道具（エディタ、CLI、MCP サーバー、IDE）は、入口で、担い手ではない。
   * 設計する人が使う操作と、画面は、spec/ide.hozo
   */
  @adr.decided(hozo.decisions.Decision400.D474)
  classify Actor of never {
    /** 仕様（.hozo）の文面を書く AI。文面を書くのは、主に AI */
    @prd.actor.ai Agent;
    /** 仕様の文面と、中身のコードを、自分のエディタで、直に書くエンジニア。エディタと言語サーバー、CLI は、道具（入口）で、担い手ではない */
    @prd.actor.human Engineer;
    /** CI。検査を走らせる。プロジェクトのやり方でテストを走らせ、カバレッジのファイルを渡す */
    @prd.actor.bot Ci;
    /** 設計する人。作りたいものを、仕様として決める。AI に書かせ、読み、直し、中身が仕様どおりかを見る。エンジニアでない人を含む。道具は、IDE（spec/ide.hozo） */
    @prd.actor.human Designer;
  }

  /**
   * 要求: hozoc が満たすこと。どの宣言が、どの要求のためのものかは、@prd.ref が言う
   * （docs/requirements.md「ただ一つの正」「もとの考えと、Hozo が守るもの」「言語サーバー」「品質の要件」）
   */
  classify Requirement of never {
    /** ただ一つの正: 設計を言うものは、仕様（.hozo）だけ。生成するコードの枠と、テストは、仕様から作る */
    SingleSource;
    /** 共有: 検査だけの実行と、言語サーバーの診断は、同じ検査器の、同じ呼び出しで作る。同じ入力に対する診断が、二つの入口で食い違わない */
    SharedDiagnostics;
    /** 決定性: 同じ入力から、同じバイトの出力を作る。出力の並びは、宣言の並びに従い、ハッシュの順序に依存しない */
    Deterministic;
    /** 診断: 漏れを指摘するときは、何が漏れているかを、名指しする */
    NamedOmission;
    /** 配布: OS ごとの、単一のバイナリ。実行環境を要求しない。言語サーバーも、別のバイナリにしない */
    @adr.decided(hozo.decisions.Decision400.D470)
    SingleBinary;
    /** ハーネス: 必要なテストケースが、用意されていて、それが、通っていること */
    RequiredTestsRan;
  }

  /** ファイルのパス。相対パスの基準は使う場所が決める（docs/config.md「置き場と探し方」など） */
  scalar Path extends string;

  /** 読み込むファイル */
  model SourceFile { path: Path; content: string; }

  /** 書き出すファイル */
  model OutputFile { path: Path; content: string; }

  /** 位置（1 始まりの行と列） */
  model Position { line: int; col: int; }

  /** 指摘の、機械が読む補足（spec/diagnostics.hozo の、Data の model）。項目の名前から、値の並びを引く */
  @adr.decided(hozo.decisions.Decision600.D603)
  model DiagnosticData { [key: string]: string[]; }

  /** 検査やプラグインが報告する一件の指摘（docs/diagnostics.md） */
  model Diagnostic {
    /** error か warning */
    severity: string;
    /** 規則の ID */
    code: string;
    message: string;
    file: Path?;
    start: Position?;
    end: Position?;
    related: RelatedInfo[];
    /** 機械が読む補足（spec/diagnostics.hozo の、Data の model）。json にだけ出す */
    data: DiagnosticData?;
  }

  /** 指摘に関連する位置 */
  model RelatedInfo { file: Path; start: Position; end: Position; message: string; }

  /** 仕様のファイル */
  @fs.files("**/*.hozo")
  state sources: list<SourceFile>;

  /** プロジェクトの設定（docs/config.md） */
  @fs.files("hozo.toml")
  state config: nullable<SourceFile>;

  /**
   * 生成したファイル。置き場は hozo.toml の各単位の out（docs/config.md「単位の対象」）。置き場は設定で決まり、仕様の宣言の時点では
   * 決まらないので、@fs.files を付けない
   */
  state outputs: list<OutputFile>;

  /**
   * 仕様に構文か型の誤りがある
   *
   * @param diagnostics error と warning のすべて
   */
  @cli.exitCode(1)
  exception CheckFailed(diagnostics: Diagnostic[]);

  /**
   * hozo.toml がない、または設定が誤っている（docs/config.md の CFG-*）
   *
   * @param diagnostics error と warning のすべて
   */
  @cli.exitCode(2)
  exception ConfigInvalid(diagnostics: Diagnostic[]);

  /**
   * 一つの単位のトランスパイラの language がそろっていない
   *
   * @param diagnostics error と warning のすべて
   */
  @cli.exitCode(2)
  exception LanguageMismatch(diagnostics: Diagnostic[]);

  /**
   * 複数の出どころが同じファイルに書こうとした
   *
   * @param diagnostics error と warning のすべて
   */
  @cli.exitCode(3)
  exception OutputConflict(diagnostics: Diagnostic[]);

  /**
   * 求めるテストのうち、走ったと確かめられないものがある（docs/cli.md「診断」の TESTS-1）
   *
   * @param diagnostics error と warning のすべて
   */
  @cli.exitCode(4)
  exception TestsNotRun(diagnostics: Diagnostic[]);

  /**
   * カバレッジを、求めるテストと突き合わせられない（docs/cli.md「診断」の TESTS-2、TESTS-3）
   *
   * @param diagnostics error と warning のすべて
   */
  @cli.exitCode(5)
  exception CoverageUnusable(diagnostics: Diagnostic[]);

  /** 書き出す名前空間として指定されたものも、その子孫も、どの単位の対象でもない。build の引数の書き間違いを、何も書かずに成功したことにしない */
  @cli.exitCode(64)
  exception UnknownNamespace;

  /**
   * プラグインが異常終了した（WASM の実行環境で、0 と 2 のほかの終了コードで終わった、途中で止まった、起動できなかった。docs/plugin-protocol.md「起動」）。
   * 外部プロセスを起動する語彙 proc は、なくしたので、この名前空間の例外として宣言する（MalformedOutput も同じ）
   */
  @adr.decided(hozo.decisions.Decision400.D434)
  exception Crashed;

  /** プラグインの出力が、約束した形（JSON）でなかった（docs/plugin-protocol.md「応答の形」） */
  @adr.decided(hozo.decisions.Decision400.D434)
  exception MalformedOutput;

  /** 検査の結果（誤りではない指摘） */
  model CheckResult { warnings: Diagnostic[]; }

  /**
   * 検査と書き出しのユースケース（verify、preview、write）の結果。検査だけ（verify）なら、written も removed も空。
   * 三つのユースケースの結果を同じ型にするのは、build の match のアームの型が、そろっていなければならないため（TYPE-8）
   */
  model BuildResult {
    warnings: Diagnostic[];
    /** 書いたファイル（新規と更新） */
    written: Path[];
    /** 消したファイル */
    removed: Path[];
  }

  /** 突き合わせの結果 */
  model TestsResult {
    warnings: Diagnostic[];
    /** 走ったと確かめた、求めるテスト（`<トランスパイラの名前>: <テストの名前>`。対応表の順） */
    ran: string[];
  }

  /**
   * 検査（check）の入力。ユースケースの入力（EmitInput、CoverageInput）から、配線が作る。
   * 環境変数（HOZO_PLUGIN_PATH、HOZO_CACHE_DIR）も、コマンドの入力のフィールドとして受け取り、ここまで配線で渡す。葉の op の実装は、
   * プロセスの環境を自分で読まない（docs/testing.md「環境からの独立」）
   */
  @adr.decided(hozo.decisions.Decision600.D694)
  model CheckInput {
    /** 設定ファイルの場所 */
    config: Path?;
    /** プラグインを探すディレクトリ（OS のパス区切りで複数） */
    pluginPath: string?;
    /** プラグインの WASM を、機械の言葉に直したものを、覚える置き場 */
    cacheDir: Path?;
  }

  /** 検査と書き出しのユースケース（verify、preview、write）の入力 */
  model EmitInput {
    /** 設定ファイルの場所 */
    config: Path?;
    /** 生成する名前空間（一つもなければすべて）。その名前空間と子孫を出力する単位の分を書き出す */
    namespaces: string[];
    /** プラグインを探すディレクトリ（OS のパス区切りで複数） */
    pluginPath: string?;
    /** プラグインの WASM を、機械の言葉に直したものを、覚える置き場 */
    cacheDir: Path?;
  }

  /** 求めるテストが走ったかを確かめるユースケース（confirmTests）の入力 */
  model CoverageInput {
    /** 設定ファイルの場所 */
    config: Path?;
    /** テストを走らせたときに取った、カバレッジのファイル */
    coverage: Path;
    /** プラグインを探すディレクトリ（OS のパス区切りで複数） */
    pluginPath: string?;
    /** プラグインの WASM を、機械の言葉に直したものを、覚える置き場 */
    cacheDir: Path?;
  }

  /** 言語サーバーとして動くユースケース（serve）の入力 */
  model ServeInput {
    /** 設定ファイルの場所 */
    config: Path?;
    /** ログの書き出し先 */
    log: Path?;
    /** プラグインを探すディレクトリ（OS のパス区切りで複数） */
    pluginPath: string?;
    /** プラグインの WASM を、機械の言葉に直したものを、覚える置き場 */
    cacheDir: Path?;
  }

  /**
   * 生成したファイルが、今の仕様と設定から生成し直したものと一致しているか。書き出しの三つの変化（追加、書き換え、削除）は、
   * この分類の遷移 syncOutputs 一つにする（一つの効果が変えるのは、一つの状態の一つの変化: docs/check.md「効果の宛先」）
   */
  classify OutputsSync of outputs {
    /** 一致している: 生成し直して、差分がない。docs/testing.md「生成物の一致」の検査と同じ中身 */
    UpToDate;
    /** 足りない、古い、または余分なファイルがある。UpToDate の否定 */
    OutOfDate;
  }

  /** 書き出す予定: 単位ごとにトランスパイラを呼んで集めたファイルと、そこまでの warning */
  model EmitPlan {
    warnings: Diagnostic[];
    files: OutputFile[];
  }

  /**
   * 書き出す予定を、今の生成したファイルと比べて、書くファイルと消すファイルを決める。
   *
   * @param plan 書き出す予定
   */
  read fn outputChanges(plan: EmitPlan): BuildResult reads outputs;

  /**
   * 生成したファイルを今の仕様と設定に合わせる（足りないものを書き、古いものを書き換え、余分なものを消す）。
   *
   * @param plan 書き出す予定
   */
  effect fn syncOutputs(plan: EmitPlan): effects OutputsSync as any -> UpToDate;

  /**
   * 仕様を検査する。使うプラグインに、展開を頼み、その診断も集める。ファイルは書き出さない。
   * コマンドでも、ユースケースでもない、内部の葉の op で、ユースケースの配線が、はじめに呼ぶ。プラグインを一つずつ起動する繰り返しは、
   * この op の中に置く（配線は、繰り返しを持たない）。
   *
   * 手順:
   *
   * 1. hozo.toml を読み、入っているプラグインのマニフェストを探して読み、各単位の transpilers の名前をトランスパイラに解決する
   *    （docs/config.md「置き場と探し方」「単位」、docs/plugin-protocol.md「探索」）。探索が見るプロジェクトの外の場所は、入力の
   *    pluginPath（HOZO_PLUGIN_PATH）と、ホームディレクトリ（入力にはない。実装が、プロセスから受け取って渡す）。hozo.toml がなければ、設定なしで進む（作業ディレクトリを
   *    ルートにし、sources は既定。プラグインは探さない）。設定とマニフェストの error は、CFG-16 なら LanguageMismatch、それ以外は
   *    ConfigInvalid（docs/config.md「診断」、docs/plugin-protocol.md「診断」）。
   * 2. 標準の語彙、使うプラグイン（docs/plugin-protocol.md「探索」）の語彙、sources のファイルの順に読み、解析する（docs/grammar.md）。
   *    in は、読むファイルを変えない（docs/config.md「in」）。
   * 3. 解決（docs/resolve.md）、正規化（docs/ir.md）、計算と検査（docs/check.md）を行う。
   * 4. 1〜3 に error が一つもなければ、プラグインに頼む。はじめに、語彙のプラグインごとに一回、direction "read" を送る（相手は
   *    docs/plugin-protocol.md「語彙のプラグイン」: 仕様が使っている語彙のもの。単位がなくても、頼む）。その応答に error がなければ、
   *    使うプラグインごとに一回、direction "emit" を送る（相手と、受け持つ出力は、同「起動」）。どちらの応答も、返った errors を error の
   *    診断として、warnings を warning の診断（PLUGIN）として、足す（同じ診断は、一度だけ。同「emit」）。語彙の使い方の誤り（HTTP-5 など）と、
   *    トランスパイラが返す誤り（GOHTTP-16 など）は、ここで出る（決定 D404、D410、D416）。返ったファイルは、書かない: 同じ実行の、
   *    後の段（collectOutputs、matchTests）が使う。プラグインの異常終了は Crashed、形の違う応答は MalformedOutput。
   * 5. error が一つでもあれば、例外（値は error と warning のすべて）。設定かマニフェストの error（CFG-*、MAN-*）が一つでもあれば
   *    ConfigInvalid、ただし、それがすべて CFG-16 なら LanguageMismatch。それ以外は CheckFailed。error がなければ CheckResult（warning）。
   *
   * 構文エラーのあるファイルも、読めた宣言は、解決と検査に進める。診断の順序は docs/diagnostics.md。
   *
   * @param in 検査の入力
   * @throws LanguageMismatch 一つの単位のトランスパイラの language がそろっていない（docs/config.md の CFG-16）
   * @throws CheckFailed 仕様に誤りがある、または、トランスパイラが errors を返した
   * @throws Crashed プラグインが異常終了した
   * @see verify
   */
  @prd.ref(Requirement.SharedDiagnostics, Requirement.NamedOmission)
  @adr.decided(hozo.decisions.Decision400.D417, hozo.decisions.Decision600.D694, hozo.decisions.Decision800.D809)
  fn check(in: CheckInput): CheckResult
    throws CheckFailed, ConfigInvalid, LanguageMismatch
    throws Crashed, MalformedOutput;

  /**
   * 検査がプラグインから受け取った答えから、出力ごとのファイルを集める。プラグインは、起動しない。ファイルには触れない。
   *
   * @param in ユースケースの入力
   * @param checked 検査の結果
   * @throws OutputConflict 同じファイルに二つの出どころが書こうとした
   * @throws UnknownNamespace 書き出す名前空間として指定されたものも、その子孫も、どの単位の対象でもない
   * @throws MalformedOutput トランスパイラの返したファイルのパスか、テストの対応表が、約束の形でない
   */
  fn collectOutputs(in: EmitInput, checked: CheckResult): EmitPlan
    throws OutputConflict, UnknownNamespace
    throws MalformedOutput;

  /**
   * 検査がプラグインから受け取った答えから、出力ごとのファイルを集めて、確かめる（パスと、ファイルの衝突）。集めたファイルは、返さない:
   * 返すのは、warning だけの結果（written も removed も空）。プラグインは、起動しない。ファイルには触れない。
   * hozo.toml がなければ、集めるものがなく、検査の warning だけを返す。
   * 配線でなく葉なのは、配線が、並びのリテラルも、並びの写しも書けないため（docs/open.md「サンプルと、hozoc 自身の仕様」）。
   *
   * @param in ユースケースの入力
   * @param checked 検査の結果
   * @throws OutputConflict 同じファイルに二つの出どころが書こうとした
   * @throws UnknownNamespace 書き出す名前空間として指定されたものも、その子孫も、どの単位の対象でもない
   * @throws MalformedOutput トランスパイラの返したファイルのパスか、テストの対応表が、約束の形でない
   */
  fn verifyOutputs(in: EmitInput, checked: CheckResult): BuildResult
    throws OutputConflict, UnknownNamespace
    throws MalformedOutput;

  /**
   * 仕様を検査する。プラグインに展開を頼み、返ってきたファイルを集めて確かめるところまで行う。ファイルには、触れない（読みも、書きも、消しもしない）。
   *
   * @param in ユースケースの入力
   * @see write
   */
  @prd.usecase.of(Actor.Agent, Actor.Engineer, Actor.Ci)
  @prd.ref(Requirement.SharedDiagnostics)
  @adr.decided(hozo.decisions.Decision400.D472, hozo.decisions.Decision400.D473, hozo.decisions.Decision700.D751)
  export fn verify(in: EmitInput): BuildResult {
    val checked = check({ config: in.config, pluginPath: in.pluginPath, cacheDir: in.cacheDir });
    return verifyOutputs(in, checked);
  }

  /**
   * 書き出す予定を、結果の形にする: written は、書く予定のファイルのパス（内容が同じで、書き直さないものも入る）。removed は、空
   * （消すファイルは、今の生成したファイルを読まないと決まらないので、決めない）。ファイルには触れない。
   * 配線でなく葉なのは、配線が、並びのリテラルも、並びの写しも書けないため（docs/open.md「サンプルと、hozoc 自身の仕様」）。
   *
   * @param plan 書き出す予定
   */
  fn plannedChanges(plan: EmitPlan): BuildResult;

  /**
   * 仕様を検査し、書き出す予定のファイルを返す。書き出さない。今の生成したファイルも、読まない（消すファイルは、決めない）。
   *
   * @param in ユースケースの入力
   * @see write
   */
  @prd.usecase.of(Actor.Agent, Actor.Engineer)
  @adr.decided(hozo.decisions.Decision400.D472, hozo.decisions.Decision400.D473, hozo.decisions.Decision700.D751)
  export fn preview(in: EmitInput): BuildResult {
    val checked = check({ config: in.config, pluginPath: in.pluginPath, cacheDir: in.cacheDir });
    val plan = collectOutputs(in, checked);
    return plannedChanges(plan);
  }

  /**
   * 仕様を検査し、プラグインから受け取ったファイルを書き出す。例外は、どれも書き出しを始める前に起きる（集めるのが先）。
   * 配線にしたのは、検査を通った結果だけを書き出しに渡すことと、check の例外が、ユースケースとコマンド build に伝わることを、検査器に
   * 確かめさせるため。MalformedOutput も prevents effects なのは、ファイルをすべて集めて、パスと衝突を確かめてから書き始めるため
   * （下の手順の 3 が、5 より先）。それは、例外を投げる collectOutputs が、効果 syncOutputs より上の行にあることから、検査器が確かめる（REL-4）。
   *
   * 書き出しの手順（check の後）。1〜3 が collectOutputs（ファイルを集める）、5〜7 の、書くファイルと消すファイルを決めるところが
   * outputChanges、書き出すところが syncOutputs。verify（検査だけ）は、1〜3 を、確かめるためだけに行い（verifyOutputs）、preview（書き出す
   * 予定を見る）は、1〜3 の後、4 で終わる（plannedChanges）。出力（単位 U と、U が出力する名前空間 N の組）と、その置き場 Dir(U, N) は
   * docs/config.md「単位の対象」「in」。一度の build が書き出す出力の集まりを、**書き出しの対象**と呼ぶ。書き出すファイルは、どれも
   * トランスパイラが返したもので、hozoc が自分で作るファイルは、出力先ごとの記録だけ。プラグインは、check の 4 で、一度、起動してあり、
   * collectOutputs は、起動しない（docs/plugin-protocol.md「起動」: 一度の実行で、同じプラグインに、同じことを、二度、頼まない）。
   *
   * 0. hozo.toml がなければ（設定なし）、verify は、集めるものがないので、検査の warning だけを返す（verifyOutputs）。preview と write は、
   *    CFG-7 で ConfigInvalid（collectOutputs）。
   * 1. namespaces が空なら、すべての出力が、書き出しの対象。空でなければ、引数 n ごとに、名前空間が n と同じか n の子孫である出力が、
   *    書き出しの対象（その名前空間を出力する、すべての単位の分。引数は、単位ではなく、名前空間を選ぶ）。n は、単位の namespace に書いた
   *    名前である必要はない: n 自身がどの単位の対象でなくても、n の子孫を対象にする単位があれば、その出力が選ばれ、単位が名指しする
   *    名前空間の子孫を n に書けば、その子孫の出力だけが選ばれる。引数 n について、仕様にある名前空間のうち、n と n の子孫のどれも、
   *    どの単位の対象（docs/config.md「単位の対象」）でもなければ、UnknownNamespace（仕様にない名前を書いたときも、これに当たる）。
   *    単位の対象ではあるが、in のせいで出力でない名前空間だけを選ぶ引数は、UnknownNamespace ではなく、何も書かずに、5 の後始末だけを行う。
   * 2. 書き出しの対象の各出力 (U, N) について、U の transpilers の各トランスパイラの答え（check の 4 で受け取ったもの）から、files を集める
   *    （順序は、単位の設定の順、名前空間の IR の順、transpilers に書いた順）。files の path の誤り（PLG-1 / PLG-2）と、テストの対応表の
   *    誤り（PLG-4）は、MalformedOutput（docs/plugin-protocol.md「応答の形」「診断」）。errors は、ここには、ない（一つでもあれば、check が
   *    CheckFailed で終わっている）。
   * 3. すべての出力のファイルを集めてから、パスの重複を確かめる（CFG-5 → OutputConflict）。
   * 4. verify は、ここで終わり: written も removed も空で返す（置き場は、読まない）。preview も、ここで終わり: 書く予定のパスを written に
   *    入れて返す（書かない。置き場は、読まないので、removed は、空）。
   * 5. 書き出しの対象の各出力の <Dir(U, N)>/.hozoc-outputs.json（前回書いたパスの一覧。ルートからの相対パスの JSON の配列、辞書順）を読み、
   *    今回書かないパスのファイルを消す。ファイルがなければ、何もしない。U の対象の名前空間が、in のせいで出力でなくなったとき
   *    （docs/config.md「in」）も、その Dir(U, N) は、同じに扱う（前回のファイルを消す）。hozo.toml から単位を消した、または、namespace か
   *    out を変えた場合、前の出力先は、もう分からないので、消さない（手で消す）。
   *    - 記録のパスに従って消すのは、その記録の持ち主の Dir(U, N) の下のファイルだけ。記録に、Dir(U, N) の下でないパス（.. で外へ出るもの、
   *      絶対パス、ルートの中の別のディレクトリ、別の出力の Dir）が書かれていても、そのファイルは消さず、removed にも warning にも出さない。
   *      hozoc がこの記録に書くのは、Dir(U, N) の下のパスだけ（PLG-1 を通ったトランスパイラのファイル）なので、それ以外は、hozoc の
   *      書いたものではなく、記録が壊れているか、手で直されている。壊れた記録で、出力先の外や、プロジェクトの外のファイルを消さないための
   *      規則。黙って無視するのは、単位を消したときの、前の出力先と同じ扱い（hozoc が持ち主だと言えないファイルには触れず、何も言わない）。
   *    - 消したファイルのディレクトリが空になれば、Dir(U, N) の下の範囲で、そのディレクトリも消す（Go の基底の内側のフォルダ inner が
   *      要らなくなったとき。docs/plugin-go.md「内側のフォルダと入口」）。
   * 6. ファイルを書く。内容が同じなら、書き直さない（written には入れる）。ディレクトリは作る。
   * 7. .hozoc-outputs.json を書く。書くものが一つもない出力（どのトランスパイラも、ファイルを返さなかった）には作らず、前回のものが
   *    あれば消す。
   *
   * - 書き出しの対象を絞っても、書き出す出力の内容は、すべてを対象にしたときと同じになる。どのトランスパイラも、一つの出力の答えを、
   *   その出力の View だけから作り（docs/plugin-protocol.md「起動」）、ほかの出力の答えを要らないため。
   * - 書き出しの対象を絞っても、プラグインには、すべての出力を頼む（check の 4 が、すべての出力の診断を要る）。絞るのは、集めて、書き出す
   *   ファイルだけ。対象でない出力の、path の誤り（PLG-1 / PLG-2 / PLG-4）と、衝突（CFG-5）は、見ない。
   * - BuildResult.warnings は、check の warning（トランスパイラの warning を含む）。
   * - 書く順序は、パスの辞書順。途中で失敗したら、そこまでに書いたものは残る（原子性は持たない。Crashed は check で起きるので、書き出しには
   *   入っていない）。
   *
   * @param in ユースケースの入力
   * @see verify
   * @see preview
   */
  @prd.usecase.of(Actor.Agent, Actor.Engineer)
  @prd.ref(Requirement.SingleSource, Requirement.Deterministic)
  @adr.decided(hozo.decisions.Decision400.D472, hozo.decisions.Decision400.D473, hozo.decisions.Decision700.D743, hozo.decisions.Decision700.D751, hozo.decisions.Decision700.D752, hozo.decisions.Decision800.D809)
  export fn write(in: EmitInput): BuildResult
    effects syncOutputs
    throws CheckFailed, ConfigInvalid, LanguageMismatch, OutputConflict, UnknownNamespace prevents effects
    throws Crashed, MalformedOutput prevents effects
  {
    val checked = check({ config: in.config, pluginPath: in.pluginPath, cacheDir: in.cacheDir });
    val plan = collectOutputs(in, checked);
    val result = outputChanges(plan);
    syncOutputs(plan);
    return result;
  }

  /**
   * 検査がプラグインから受け取った答えから、テストの対応表を集め、カバレッジの「実行された行」と突き合わせる。ファイルは書き出さない。
   * 対応表を集めるところは、collectOutputs を呼ばずに、この op の中に置く: 配線は、並びのリテラルを書けず、EmitInput（namespaces を持つ）を、
   * 配線の中で作れない。
   *
   * @param in ユースケースの入力
   * @param checked 検査の結果
   * @throws ConfigInvalid hozo.toml がない（docs/config.md の CFG-7）
   * @throws OutputConflict 同じファイルに二つの出どころが書こうとした
   * @throws TestsNotRun 求めるテストのうち、走ったと確かめられないものがある
   * @throws CoverageUnusable 置き場の出力が今の仕様からのものと違う、または、カバレッジを読めない
   * @throws Crashed カバレッジを読むプラグインが異常終了した
   */
  @adr.decided(hozo.decisions.Decision600.D649)
  fn matchTests(in: CoverageInput, checked: CheckResult): TestsResult
    throws ConfigInvalid, OutputConflict, TestsNotRun, CoverageUnusable
    throws Crashed, MalformedOutput;

  /**
   * 仕様を検査し、求めるテストが走ったかを、カバレッジと突き合わせて確かめる。テストは走らせない。
   *
   * 求めるテストは、テストを受け取る口が、ケースを受け取って走らせるテスト（docs/plugin-protocol.md「テストの対応表」）。hozoc は、
   * テストを走らせない: 利用者（か CI）が、プロジェクトのやり方で、カバレッジを取りながらテストを走らせ、そのファイルの場所を渡す。
   * 分かるのは「走ったか」までで、「通ったか」は、テストの実行の終了コードが言う（docs/ide-chain.md「テストの規約」の「担保すること」）。
   *
   * 手順（check の後の、matchTests）:
   *
   * 1. すべての出力について、トランスパイラの答えから、ファイルを集める（write の手順の 2 と 3 と同じ。OutputConflict、MalformedOutput も
   *    同じ）。ファイルは、書き出さない。hozo.toml がなければ、CFG-7 で ConfigInvalid。
   * 2. 集めたファイルから、テストの対応表を取り出す。その並び（出力の順、トランスパイラの順、対応表の中の順）が、**求めるテスト**。
   *    一つもなければ、ここで終わり（ran は空）。
   * 3. 対応表と、対応表が指すファイルが、置き場にあり、集めたものと同じ内容であることを確かめる。ないか、違えば、ファイルごとに TESTS-2
   *    （置き場の出力が、今の仕様からのものでない。行が、合わない）。一つでもあれば、CoverageUnusable。
   * 4. coverage のファイルを読み（相対パスの基準は、作業ディレクトリ）、対応表を持つ単位の基底のプラグインごとに、direction "coverage" を
   *    送る（相手と、渡すものは、docs/plugin-protocol.md「coverage」）。次のどれかなら、TESTS-3 で、一つでもあれば、CoverageUnusable:
   *    ファイルを読めない（一つ）。単位の基底のプラグインが [coverage] enabled でない（プラグインごとに一つ）。プラグインの応答が
   *    recognized: false（プラグインごとに一つ）。
   * 5. 求めるテストごとに、応答の、そのファイルの lines のどれかが、テストの lines の範囲と、一行でも重なれば、**走った**。重ならなければ、
   *    走っていない。応答に、そのファイルがなければ、カバレッジが、そのファイルを測っていない。どちらも、テストごとに TESTS-1 で、一つでも
   *    あれば、TestsNotRun。
   * 6. すべて走っていれば、TestsResult（warnings は、check の warning（トランスパイラの warning を含む）。ran は、求めるテストの
   *    <トランスパイラの名前>: <テストの名前>）。
   *
   * - 確かめられないこと: カバレッジを取った後に、hozoc build をやり直して、同じ内容でない出力を書いた場合、3 は、今の置き場を見るので、
   *   通る。カバレッジは、前の出力の行を言っているので、突き合わせは、当てにならない。カバレッジと出力の、新しさは、比べない（ファイルの
   *   時刻は、チェックアウトで変わる）。CI では、書き出しの後の一致（docs/testing.md「生成物の一致」）、テスト、hozoc tests を、この順に、
   *   同じ作業ツリーで走らせる。
   * - 一度に渡せるカバレッジのファイルは、一つ（言語の違う単位を持つプロジェクトの扱いは、決めていない: docs/open.md「語彙とプラグイン」）。
   *
   * @param in ユースケースの入力
   * @see write
   */
  @prd.usecase.of(Actor.Agent, Actor.Engineer, Actor.Ci)
  @prd.ref(Requirement.RequiredTestsRan)
  @adr.decided(hozo.decisions.Decision300.D380, hozo.decisions.Decision400.D472, hozo.decisions.Decision400.D473, hozo.decisions.Decision600.D649, hozo.decisions.Decision700.D751, hozo.decisions.Decision800.D809)
  export fn confirmTests(in: CoverageInput): TestsResult {
    val checked = check({ config: in.config, pluginPath: in.pluginPath, cacheDir: in.cacheDir });
    return matchTests(in, checked);
  }

  /**
   * 言語サーバーとして標準入出力で動く（docs/lsp.md）。クライアントが exit を送るまで戻らない。
   * config が与えられなければ、クライアントの rootUri から、hozo.toml を探す。
   *
   * @param in ユースケースの入力
   */
  @prd.usecase.of(Actor.Engineer)
  @prd.ref(Requirement.SharedDiagnostics, Requirement.SingleBinary)
  @adr.decided(hozo.decisions.Decision400.D472, hozo.decisions.Decision400.D473, hozo.decisions.Decision400.D474, hozo.decisions.Decision700.D751, hozo.decisions.Decision800.D809)
  export fn serve(in: ServeInput);

  /**
   * プラグインの起動のしかた（docs/plugin-protocol.md「起動」）。wasm は、プラグインの本体（WASM）のファイル。
   * プラグインは、hozoc の中のサンドボックスで動き、作業ディレクトリも、引数も、渡さないので、名前と WASM の場所だけを持つ
   */
  @adr.decided(hozo.decisions.Decision700.D703)
  model Plugin { name: string; wasm: Path; }

  /** 仕様: IR の、出力に依らない部分（docs/ir.md「まとめた形」の Spec）。中身はこの仕様では書かない */
  model Spec {}

  /** IR の、出力ごとの部分（同 OutputView）。中身はこの仕様では書かない */
  model OutputView {}

  /** プラグインが受け持つ出力一つ（docs/plugin-protocol.md「emit」の要求の outputs の要素）。transpilers は、その出力で頼むトランスパイラの名前。単位のオプションは view の中にある */
  model EmitOutput { transpilers: string[]; view: OutputView; }

  /** 展開のときのプラグインへの入力（同「emit」の要求）。仕様を一度と、プラグインが受け持つ出力の並び */
  @adr.decided(hozo.decisions.Decision400.D411)
  model EmitRequest { protocol: string; direction: string; spec: Spec; outputs: EmitOutput[]; }

  /** トランスパイラの warning（同「emit」の応答の warnings の要素） */
  model PluginWarning { at: string; message: string; }

  /** トランスパイラの error（同「emit」の応答の errors の要素） */
  model PluginError { code: string; at: string; message: string; }

  /** トランスパイラ一つの、出力一つへの答え（同「emit」の応答の results の要素） */
  model TranspilerResult { files: OutputFile[]; warnings: PluginWarning[]; errors: PluginError[]; }

  /** 出力一つへの答え（同「emit」の応答の outputs の要素）。results は、要求の、その出力の transpilers と同じ順 */
  model OutputResult { results: TranspilerResult[]; }

  /** 展開のときのプラグインからの出力（同「emit」の応答）。outputs は、要求の outputs と同じ順 */
  model EmitResponse { outputs: OutputResult[]; }

  /**
   * プラグインを一つ、hozoc の中の WASM の実行環境で動かして、受け持つ出力のすべてを、まとめて展開させる
   * （docs/plugin-protocol.md「起動」）。入力は、標準入力に JSON で渡し、標準出力の JSON を、出力として受け取る。
   * どの配線からも呼ばれないが、プラグインとの境界の記述として残す。動かすプラグインは、引数 plugin で
   * 渡す: デコレータの引数に、実行時の値は書けない。
   *
   * @param plugin 動かすプラグイン
   * @param req プラグインへの入力
   * @throws Crashed プラグインが異常終了した
   * @throws MalformedOutput プラグインの出力が、約束した形でない
   */
  fn runEmit(plugin: Plugin, req: EmitRequest): EmitResponse
    throws Crashed, MalformedOutput;
}

/**
 * hozoc のコマンドの行（入口）。引数とフラグを読んで、名前空間 hozo.compiler のユースケースに入る。
 * フラグ（--no-emit、--dry-run、--format）を知っているのは、ここだけ: コマンドの op が、入力から、レコードリテラルで、ユースケースの
 * 入力を組んで渡す（決定 D472、D473）。
 * コマンドの op は export: go-cli の Main が、名前空間の外から、入口の Ops を通して呼ぶ（docs/plugin-go-cli.md「対象」の CLI-6）。
 */
namespace hozo.cli {
  /** 表示の形式。text か json。json は、診断を機械が読むためのもの（docs/diagnostics.md「json」） */
  @valid.pattern("^(text|json)$")
  scalar OutputFormat extends string;

  /**
   * build の入力。フラグ（noEmit、dryRun）は、省略可能でない boolean で、付いていなければ偽（plugins/go-cli/cli.hozo）
   */
  model BuildInput {
    /** 設定ファイルの場所 */
    @cli.flag("config") @cli.env("HOZO_CONFIG") config: hozo.compiler.Path?;
    /** 表示の形式 */
    @cli.flag("format") format: OutputFormat?;
    /** 生成する名前空間（一つもなければすべて）。その名前空間と子孫を出力する単位の分を書き出す */
    @cli.arg(1) namespaces: string[];
    /** 検査だけを行い、ファイルを書き出さない */
    @cli.flag("no-emit") noEmit: boolean;
    /** 書き出さずに、書き出す予定のファイルだけを表示する */
    @cli.flag("dry-run") dryRun: boolean;
    /** プラグインを探すディレクトリ（OS のパス区切りで複数） */
    @cli.env("HOZO_PLUGIN_PATH") pluginPath: string?;
    /** プラグインの WASM を、機械の言葉に直したものを、覚える置き場 */
    @cli.env("HOZO_CACHE_DIR") cacheDir: hozo.compiler.Path?;
  }

  /**
   * フラグが、付いているか。真偽の値の、型で決まる分類（docs/check.md「分類」。リテラルの型: 決定 D483）。
   * build は、これで、--no-emit と --dry-run を見て、入るユースケースを分ける: フラグの値から、ユースケースへの対応は、
   * 人が書く述語ではなく、下の二つの op の配線が、言う。
   */
  @adr.decided(hozo.decisions.Decision400.D472, hozo.decisions.Decision400.D483, hozo.decisions.Decision700.D770)
  classify Flag of boolean {
    /** 付いている */
    On: boolean as true;
    /** 付いていない */
    Off: boolean as false;
  }

  /**
   * 仕様を検査し、プラグインから受け取ったファイルを書き出す。--no-emit なら、検査だけを行い、ファイルを書き出さない。
   *
   * - --no-emit の表示は、検査の結果だけ: text は、warning と、数の行（0 errors, 0 warnings。docs/diagnostics.md「text」）。warning だけなら、
   *   終了コードは 0。json は {"warnings": [...]}。written と removed は、出さない（いつも空）。--no-emit のない build は、warning と、
   *   written: <パス> / removed: <パス> の行（json は、warnings、written、removed）。
   * - --no-emit と --dry-run を、両方書けば、--no-emit（書き出す予定も、表示しない）: build が、先に noEmit を見て、verify に入るので、
   *   dryRun は、見ない。
   * - 名前空間の引数は、--no-emit でも、集めて確かめるファイルの範囲を選ぶ（write の手順の 1。UnknownNamespace も、同じ）。
   * - hozo.toml がないとき: build --no-emit は、設定なしで検査する（check の手順の 1）。build は、書き出す単位がないので、CFG-7 で
   *   ConfigInvalid（write の手順の 0）。
   * - 古い名前: hozoc check と hozoc emit は、なくした。その名前で呼ばれたら、何もせずに、新しい書き方を標準エラーに示して、使い方の誤りの
   *   終了コード（64。docs/diagnostics.md「終了コード」）で終わる。示すのは、残りの引数を付けたもの: hozoc check --format json には
   *   hozoc build --no-emit --format json、hozoc emit --dry-run server には hozoc build --dry-run server。仕様にないコマンドの名前は、
   *   go-cli の Main には、知らないコマンドとしか見えないので、この案内は、Main の前で、手で書く。
   *
   * @param in コマンドの入力
   * @see tests
   */
  @cli.command("build")
  @adr.decided(hozo.decisions.Decision400.D417, hozo.decisions.Decision400.D472, hozo.decisions.Decision400.D473, hozo.decisions.Decision700.D751, hozo.decisions.Decision700.D770, hozo.decisions.Decision800.D809)
  export fn build(in: BuildInput): hozo.compiler.BuildResult {
    return match (in.noEmit by Flag) {
      On => hozo.compiler.verify({ config: in.config, namespaces: in.namespaces, pluginPath: in.pluginPath, cacheDir: in.cacheDir });
      Off => writeOrPreview(in);
    };
  }

  /**
   * --no-emit の付いていない build: --dry-run なら、書き出す予定を見る。そうでなければ、書き出す。
   * build の、二つ目の分かれ道。アームの本体に、match は書けないので、op を、一つ、分けてある。
   *
   * @param in コマンドの入力
   */
  @adr.decided(hozo.decisions.Decision400.D472, hozo.decisions.Decision400.D473)
  fn writeOrPreview(in: BuildInput): hozo.compiler.BuildResult {
    return match (in.dryRun by Flag) {
      On => hozo.compiler.preview({ config: in.config, namespaces: in.namespaces, pluginPath: in.pluginPath, cacheDir: in.cacheDir });
      Off => hozo.compiler.write({ config: in.config, namespaces: in.namespaces, pluginPath: in.pluginPath, cacheDir: in.cacheDir });
    };
  }

  /** tests の入力 */
  model TestsInput {
    /** 設定ファイルの場所 */
    @cli.flag("config") @cli.env("HOZO_CONFIG") config: hozo.compiler.Path?;
    /** 表示の形式 */
    @cli.flag("format") format: OutputFormat?;
    /** テストを走らせたときに取った、カバレッジのファイル */
    @cli.required @cli.flag("coverage") coverage: hozo.compiler.Path;
    /** プラグインを探すディレクトリ（OS のパス区切りで複数） */
    @cli.env("HOZO_PLUGIN_PATH") pluginPath: string?;
    /** プラグインの WASM を、機械の言葉に直したものを、覚える置き場 */
    @cli.env("HOZO_CACHE_DIR") cacheDir: hozo.compiler.Path?;
  }

  /**
   * 仕様を検査し、求めるテストが走ったかを、カバレッジと突き合わせて確かめる。テストは走らせない。
   *
   * @param in コマンドの入力
   * @see build
   */
  @cli.command("tests")
  export fn tests(in: TestsInput): hozo.compiler.TestsResult {
    return hozo.compiler.confirmTests({ config: in.config, coverage: in.coverage, pluginPath: in.pluginPath, cacheDir: in.cacheDir });
  }

  /** lsp の入力 */
  model LspInput {
    /** 設定ファイルの場所 */
    @cli.flag("config") @cli.env("HOZO_CONFIG") config: hozo.compiler.Path?;
    /** ログの書き出し先 */
    @cli.flag("log") @cli.env("HOZO_LSP_LOG") log: hozo.compiler.Path?;
    /** プラグインを探すディレクトリ（OS のパス区切りで複数） */
    @cli.env("HOZO_PLUGIN_PATH") pluginPath: string?;
    /** プラグインの WASM を、機械の言葉に直したものを、覚える置き場 */
    @cli.env("HOZO_CACHE_DIR") cacheDir: hozo.compiler.Path?;
  }

  /**
   * 言語サーバーとして標準入出力で動く（docs/lsp.md）。クライアントが exit を送るまで戻らない。
   *
   * @param in コマンドの入力
   */
  @cli.command("lsp")
  export fn lsp(in: LspInput) {
    hozo.compiler.serve({ config: in.config, log: in.log, pluginPath: in.pluginPath, cacheDir: in.cacheDir });
  }
}
