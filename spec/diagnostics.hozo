// Hozo 自身の仕様（決定 D442、D468、D469、D812）。診断を、要求として持つ名前空間 hozo.diagnostics の、印と、Data の形。
// **検査の規則と診断の持ち主は、この名前空間の分類のケース**（spec/diagnostics/ の下の、分類ごとのファイル）: ID、条件（ケースの説明）、
// 重さ、欠番。形を決めた決定は、ケースの @adr.decided が指す。文書（docs/）は、規則の背景と、手続きの全体を説明し、条件と重さの表を
// 持たない。どの単位の対象でもない: コードには、ならない。
//
// 診断の文言（メッセージ）は、ここにない: 今の文言は、Go のコードが組み立てる日本語（英語にするのは、後: 決定 D442）。
// Go のコードが出す診断のコードと重さが、ここのケースと合うことは tests/codes_test.go が、言語と設定の規則（分類 Rule）のケースが
// 例を持つことは tests/rules_test.go が確かめる。
//
// 書けなかった所の持ち主は docs/open.md「サンプルと、hozoc 自身の仕様」（「穴 30」などは、その番号）:
//   穴 30: 診断の ID を、そのままの綴りで書けない（RES-1 の - は、名前に書けない）。RES_1 と書き、もとの綴りは、説明の頭に書いた
//   穴 31: 印の付け方の決まり（どのケースにも、重さか欠番の、どちらかが、ちょうど一つ）を、言えない（tests/codes_test.go が確かめる）
//   穴 32: 要求を、それを確かめる内部の op（spec/cli.hozo の check、collectOutputs、matchTests）に、結べない。自前の印 @checkedBy で、
//          外から呼べるユースケース（verify、confirmTests、serve）に結んだ
//   穴 33: プラグインの診断を、そのプラグインに結べない（プラグインは、別の製品で、Hozo の宣言を持たない）。やり取りの op
//          （spec/plugin.hozo の readVocabulary、emit）に、@prd.ref で結んだ: どのプラグインかは、分類の名前が言うだけ
//   穴 34: 規則の例（通る例と、落ちる例）を、要求に結ぶ書き方が、ない
//   穴 35: 文言の型（どの値を埋めるか）は、Data を持つ診断にしか、書けていない
//   穴 10（兄弟の名前空間を、短く引けない）は、ここでも当たった。重さ（Severity）は、リテラルの型（決定 D482）が
//   入った後も、対象のない分類のケースのまま: 名前の付いた、リテラルの型の union を、印の引数の型にすると、リテラルを渡せない（TYPE-4）。
//   Silent は、JSON の上の値でもない（診断の JSON の severity は "error" か "warning"）

/** 診断を、要求として持つ。番号（ID）が、ケースの名前。番号を鍵に、条件（説明）、重さ、決めた決定、文言に埋める値を引く */
namespace hozo.diagnostics {
  /** 診断の重さ（docs/diagnostics.md「構造」）。Silent は、診断を出さない規則 */
  classify Severity of never {
    /** 終了コードを、失敗にする */
    Error;
    /** 知らせるだけ。終了コードは、変えない */
    Warning;
    /** 診断を出さない。決まりを言うだけの行（計算や、正規化で行う）か、診断にならず、例外になる誤り */
    Silent;
  }

  /**
   * 重さ。欠番でないケースに、ちょうど一つ付ける（その決まりは、仕様では、言えない: 穴 31）。
   *
   * @param level 重さ
   */
  @adr.decided(hozo.decisions.Decision400.D469)
  @hint
  decorator severity(level: any case of Severity) for case of never;

  /**
   * 欠番。なくした ID で、別の意味に、使い回さない（CLAUDE.md「番号は使い回さない」）。ID をなくすときは、ケースを消さずに、重さの印を、
   * この印に替え、説明に、なくした経緯を書く。
   *
   * @param replacedBy 置き換えた先の ID（なければ、書かない）
   */
  @adr.decided(hozo.decisions.Decision400.D469)
  @hint
  decorator retired(...replacedBy: any case of never) for case of never;

  /**
   * 文言に埋める値のうち、機械が読む形で持つもの（Diagnostic.data）。
   *
   * @param data 値の形
   */
  @adr.decided(hozo.decisions.Decision400.D469)
  @hint
  decorator carries(data: any model) for case of never;

  /**
   * その診断を出すユースケース（spec/cli.hozo の hozo.compiler の、外から呼べる op）。確かめる op そのもの（内部の check など）は、
   * 別の名前空間からは、指せない（NS-5: 穴 32）。
   *
   * @param ops ユースケースの op
   */
  @adr.decided(hozo.decisions.Decision400.D469)
  @hint
  decorator checkedBy(...ops: any op) for case of never;

  /** RES-1 の Data: 候補の名前 */
  model Candidates {
    /** 候補の FQN */
    candidates: string[];
  }

  /** MATCH-2 の Data: アームが受けるケースの、足りないものと、余分なもの */
  model CaseMismatch {
    /** 足りないケースの名前 */
    missing: string[];
    /** 余分なケースの名前 */
    extra: string[];
  }

  /** MATCH-10 の Data: どのケースにも当たらない例外 */
  model Unclassified {
    /** 例外の FQN */
    unclassified: string[];
  }

  /** BIND-4 の Data: 埋まっていない、必須の入力 */
  model MissingPaths {
    /** 入力のパス */
    missing: string[];
  }
}
