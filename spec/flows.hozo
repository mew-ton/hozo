// Hozo 自身の仕様（決定 D468、D475）。業務の流れの名前空間 hozo.flows と、hozoc の外の道具 hozo.toolchain。
// 流れは、ユースケースの op（spec/cli.hozo の hozo.compiler の、@prd.usecase.of を付けた op）を、順に呼ぶ配線。
// 出どころは、docs/tools.md「仕事の流れ」「ユースケース」と、docs/cli.md「tests」。文書が言っている流れだけを、写してある。
// どちらの名前空間も、hozo.toml の単位の対象ではない: コードには、ならない。

/** hozoc の外にある、利用者の道具。hozoc は、これを呼ばない: 流れの中で、人か CI が行う手順を、op として言う */
namespace hozo.toolchain {
  /**
   * 生成されたテストを、プロジェクトのやり方で、カバレッジを取りながら走らせる（go test -coverprofile など）。
   * hozoc は、テストを走らせない（docs/cli.md「tests」）。
   *
   * @returns カバレッジのファイルの場所
   */
  @adr.decided(hozo.decisions.Decision400.D475)
  export fn runTests(): hozo.compiler.Path;
}

/** 業務の流れ。ユースケースを、順に行う */
namespace hozo.flows {
  /** 生成したテストが、走ったことを確かめる流れの結果 */
  model Harnessed {
    /** 書き出した結果 */
    written: hozo.compiler.BuildResult;
    /** 求めるテストが、走ったかの結果 */
    ran: hozo.compiler.TestsResult;
  }

  /**
   * 生成したテストが、走ったことを確かめる（docs/cli.md「tests」、docs/requirements.md「もとの考えと、Hozo が守るもの」）。
   * 担い手は、枠を出して、テストと中身を書くのが、AI か、エンジニア。テストを走らせて、確かめるのが、利用者か、CI。
   *
   * @param in 書き出す対象
   * @returns 書き出した結果と、求めるテストが、走ったかの結果
   */
  @prd.business.flow
  @adr.decided(hozo.decisions.Decision400.D475, hozo.decisions.Decision700.D744)
  export fn confirmHarness(in: hozo.compiler.EmitInput): Harnessed {
    // 1. 枠を出す。テストの口と、求めるテストの一覧も、一緒に出る
    val written = hozo.compiler.write(in);
    // 2. 口を満たすテストと、中身を書く（AI か、エンジニア。hozoc の外で、op は、ない）
    // 3. カバレッジを取りながら、テストを走らせる（hozoc の外）
    val coverage = hozo.toolchain.runTests();
    // 4. 求めるテストが、走ったかを、確かめる
    val ran = hozo.compiler.confirmTests({ config: in.config, coverage: coverage, pluginPath: in.pluginPath, cacheDir: in.cacheDir });
    return { written: written, ran: ran };
  }

  /**
   * 入った変更を、自動で検査する（docs/tools.md「自動の検査（CLI）」）。担い手は、CI。
   *
   * @param in 検査する対象
   * @returns 検査の結果
   */
  @prd.business.flow
  @adr.decided(hozo.decisions.Decision400.D475, hozo.decisions.Decision700.D744)
  export fn checkChange(in: hozo.compiler.EmitInput): hozo.compiler.BuildResult {
    // 1. 検査する
    return hozo.compiler.verify(in);
    // 2. 生成物が、仕様から遅れていないことを確かめる（専用のユースケースは、まだ、ない）
    // 3. プルリクエストに、設計として何が変わったかを出す（ユースケースは、まだ、ない）
  }

  /** エンジニアが、文面を書く流れの結果 */
  model Written {
    /** 打っている間に得た、診断 */
    found: hozo.compiler.Diagnostic[];
    /** 名前から移った先の、宣言の位置 */
    place: hozo.operation.Place?;
    /** 名前の説明 */
    description: hozo.operation.Description?;
    /** 手元の検査の結果 */
    checked: hozo.compiler.BuildResult;
    /** 枠を出し直した結果 */
    written: hozo.compiler.BuildResult;
  }

  /**
   * エンジニアが、文面を書く（docs/tools.md「エンジニア（言語サーバー、VS Code 拡張、CLI）」）。
   * 1 と 2 は、言語サーバーという入口（spec/lsp.hozo の hozo.lsp）から入る操作。3 と 4 は、CLI から入るユースケース。
   *
   * @param workspace エディタで開いているプロジェクト
   * @param at 文面の中の、カーソルの位置
   * @param in 検査して、書き出す対象
   * @returns 得た診断、移った先、説明、手元の検査と、枠を出し直した結果
   */
  @prd.business.flow
  @adr.decided(hozo.decisions.Decision400.D475, hozo.decisions.Decision700.D744)
  export fn writeSpec(workspace: hozo.operation.Workspace, at: hozo.operation.Cursor, in: hozo.compiler.EmitInput): Written {
    // 1. 文面を書く。打っている間に、誤りを得る（名前の候補と、機械的な直しは、まだ、ない: docs/lsp.md「段階 4 の後」）
    val found = hozo.operation.diagnose(workspace);
    // 2. 文面の中を移る。名前から、宣言、説明へ（参照へ移るのは、まだ、ない）
    val place = hozo.operation.locate(workspace, at);
    val description = hozo.operation.describe(workspace, at);
    // 3. 手元で、検査する
    val checked = hozo.compiler.verify(in);
    // 4. 枠を出し直す
    val written = hozo.compiler.write(in);
    return { found: found, place: place, description: description, checked: checked, written: written };
  }

  /** 設計する人の、仕事の流れの、前半（開く、書かせる、読む、直す）の結果 */
  model Shaped {
    /** 開いたときに出る、全体 */
    overview: hozo.operation.Overview;
    /** 読んだ、入口の手順 */
    traced: hozo.operation.Trace;
    /** 読んだ、変わったところ */
    changes: hozo.operation.Change[];
    /** 画面で直した、文面の書き換え */
    amended: hozo.operation.TextEdit[];
  }

  /** 設計する人の、仕事の流れの、後半（整える、中身を作らせる、確かめる）の結果 */
  model Realized {
    /** 検査の欠け */
    gaps: hozo.compiler.Diagnostic[];
    /** 枠を出した結果 */
    written: hozo.compiler.BuildResult;
    /** ハーネスの状況 */
    harness: hozo.operation.HarnessStatus;
  }

  /** 設計する人の、仕事の流れの結果 */
  model Designed {
    shaped: Shaped;
    realized: Realized;
  }

  /**
   * 設計する人の、仕事の流れの、段 1〜4（docs/tools.md「仕事の流れ」）。
   *
   * @param project 開くプロジェクト
   * @param prompt AI に言うこと
   * @param about AI に言うときに、添える要素
   * @param entry 読む入口
   * @param edit 画面の上での直し
   */
  fn shape(project: hozo.operation.Workspace, prompt: string, about: hozo.operation.Element[], entry: hozo.operation.Element, edit: hozo.operation.ElementEdit): Shaped {
    // 1. 開く: プロジェクトのルートを、IDE で開く。仕様のファイルと、設計の全体が出る
    val overview = hozo.operation.overview(project);
    // 2. 書かせる: チャットで、作りたいものを AI に言う。AI が、仕様の文面を書く
    hozo.assistant.ask(prompt, about);
    // 3. 読む: 書かれた仕様を、設計の手法ごとの画面で読む（ここでは、入口の手順）。二度目からは、変わったところを読む
    val traced = hozo.operation.trace(project, entry);
    val changes = hozo.operation.compare(project);
    // 4. 直す: 画面の上で直す。大きな直しは、画面の要素を指して、AI に言う（2 と同じ op）
    val amended = hozo.operation.amend(project, edit);
    return { overview: overview, traced: traced, changes: changes, amended: amended };
  }

  /**
   * 設計する人の、仕事の流れの、段 5〜7。
   *
   * @param project 開いているプロジェクト
   * @param in 枠を出す対象
   */
  fn realize(project: hozo.operation.Workspace, in: hozo.compiler.EmitInput): Realized {
    // 5. 整える: 検査の欠け（足りない宣言）を、AI か、ボタンで埋める（埋めるのは、欠けごとの hozo.operation.fill）
    val gaps = hozo.operation.diagnose(project);
    // 6. 中身を作らせる: 仕様からコードの枠を出し、AI に中身を書かせる（書かせるのは、段 2 と同じ op）
    val written = hozo.compiler.write(in);
    // 7. 確かめる: ハーネスの状況（検査、枠の遅れ、中身の欠け、テスト）を見る
    val harness = hozo.operation.harness(project);
    return { gaps: gaps, written: written, harness: harness };
  }

  /**
   * 設計する人の、仕事の流れ（docs/tools.md「仕事の流れ」）。どの段も、IDE の中で起きる。IDE は、まだ、ない: 呼んでいるのは、
   * spec/ide.hozo に、設計として書いた操作（hozo.operation）と、チャットの AI（hozo.assistant。hozoc の外）。
   * 二つに分けてあるのは、一つの op の val の数の上限（WIRE-6）のため。
   *
   * @param project 開くプロジェクト
   * @param prompt AI に言うこと
   * @param about AI に言うときに、添える要素
   * @param entry 読む入口
   * @param edit 画面の上での直し
   * @param in 枠を出す対象
   * @returns 段ごとの結果
   */
  @prd.business.flow
  @adr.decided(hozo.decisions.Decision400.D475, hozo.decisions.Decision700.D744)
  export fn design(project: hozo.operation.Workspace, prompt: string, about: hozo.operation.Element[], entry: hozo.operation.Element, edit: hozo.operation.ElementEdit, in: hozo.compiler.EmitInput): Designed {
    val shaped = shape(project, prompt, about, entry, edit);
    val realized = realize(project, in);
    // 8. 段 2 に戻る（決まった回数でない、繰り返しは、書けない: 配線の繰り返しは、並びの要素ごと）
    return { shaped: shaped, realized: realized };
  }
}
