/** 外部プロセスの語彙（プラグインの呼び出し） */
namespace proc {
  /** プロセスが異常終了した */
  exception Crashed;

  /** 出力が約束した形（JSON）でなかった */
  exception MalformedOutput;

  /**
   * 外部プロセスを起動し、標準入力に入力を JSON で渡し、標準出力の JSON を出力として受け取る。
   * 起動するコマンドは、このデコレータを付けた op の入力で渡す。
   */
  decorator stdio throws Crashed | MalformedOutput;
}
