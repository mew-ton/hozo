/** ブラウザの語彙: ブラウザが持つ状態の置き場と、ページ（名前空間 browser.page） */
namespace browser {
  /** この状態をブラウザの localStorage が持つ */
  decorator localStorage for state;

  /** ページの語彙: URL から決まる状態、ルート、ダイアログ、操作 */
  namespace page {
    /** ダイアログが閉じられた */
    exception Aborted;

    /** ルートの位置（path と params） */
    scalar Route extends string;

    /** URL のクエリ。名前から、値の並びを引く */
    model Query { [name: string]: string[]; }

    decorator path for state;
    decorator query for state;
    @entry
    decorator fn route(path: string, from: any state?, onInvalid: any effect?);
    /**
     * ダイアログで入力を待つ。component はコンポーネントの実装の名前（例: "YamadaWarrantyModal"）。
     * どの実装を指すかは展開器が解決する（表層は責務外）。
     */
    decorator fn dialog(component: string): throws Aborted;
    /** error を受けて、ページの VM の代わりに view のアームを描画する（URL は変わらない。view の型の規則は §11.2） */
    decorator fn fallback(error: any exception, view: any model): catches error recovers;
    decorator fn interaction(page: any op, when: any variant);
  }
}
