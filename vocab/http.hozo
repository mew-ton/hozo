namespace http {
  /** サーバー側の失敗（5xx 全般） */
  exception ServerError;
  /** 運搬の失敗（ステータスなし） */
  exception NetworkError;

  /** 制約の違反一つ。path は通信の上の場所、constraint は valid の語彙のデコレータの名前 */
  model Violation { path: string; constraint: string; }
  /** 要求を op の入力に読めなかった、または入力が制約に合わなかった（op は呼ばれていない） */
  exception BadRequest: { message: string; violations: Violation[]; };

  @external
  decorator get(path: string) throws ServerError | NetworkError;
  @external
  decorator post(path: string) throws ServerError | NetworkError;

  decorator status(code: int) for exception;
  decorator header(name: string) for field;
  decorator body for field;
  decorator query for field;
  decorator retry(times: int);
}
