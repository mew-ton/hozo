// docs/plugin-go.md「match」の switch の形（絞り込みが variant の型で決まる分類、述語で決まる値の分類・op の分類・状態の分類）と、
// 「絞り込んだ値」「分類」を、一か所ずつ使う。各 op の上のコメントが、その op が確かめる行。
// op はどれも export（出力は一つのパッケージ）。

/** switch で分ける match */
namespace app {
  scalar Email extends string;
  model Item { name: string; price: int; }
  model Problem { reason: string; }
  model Receipt { total: int; }
  model Title { title: string; }
  /** 画面。アームの型: 宣言した model、その場の model、核の型（包む型）、省略可能（包む型） */
  union Page {
    Ready: Title;
    Blank: { hint: string; };
    Failed: Problem;
    Code: int;
    Note: string?;
  }
  /** 結果 */
  union Result {
    Done: Receipt;
    Fail: Problem;
  }
  exception Bad;
  /** 印。付いた op は純粋でなくなる */
  decorator fn mark();

  /** 今の画面 */
  state stage: single<Page>;
  /** カート */
  state carts: list<Item>;
  /** 注文 */
  state orders: list<Item>;

  /** 型で決まる値の分類（variant。残りのケースが、残りのアーム Blank と Note を受ける） */
  classify PageKind of Page {
    IsReady: Page as Title;
    IsFailed: Page as Problem;
    IsCode: Page as int;
    Rest: Page as else;
  }
  /** 型で決まる値の分類（variant。すべてのアームを覆う） */
  classify Outcome of Result {
    Ok: Result as Receipt;
    Err: Result as Problem;
  }
  /** 型で決まる値の分類（variant。残りのケースがなく、アーム Blank、Failed、Note の値は、どのケースでもない） */
  classify Shown of Page {
    ShowsTitle: Page as Title;
    ShowsCode: Page as int;
  }
  /** 型で決まる状態の分類（variant） */
  classify Stage of stage {
    Showing: stage as Title;
    Broken: stage as Problem;
    Hidden: stage as else;
  }
  /** 述語で決まる値の分類 */
  classify Size of Item {
    /** 大きい */
    Big;
    Small;
    Tiny;
  }
  /** 述語で決まる値の分類。二つに分かれ、どちらのケースも述語を持つ。絞り込みは predicate（string を Email に） */
  classify Address of string {
    Valid: string as Email;
    /** メールアドレスでない */
    Invalid;
  }
  /** 述語で決まる値の分類。型で決まる絞り込み（presence）の as を持つケースと、predicate の as を持つケースと、as のないケース */
  classify Contact of string? {
    Mail: string? as Email;
    Text: string? as string;
    Silent;
  }
  /** 述語で決まる op の分類（同じ型に絞り込むケースが二つ） */
  classify Stock of findItem {
    InStock: findItem as Item;
    SoldOut: findItem as Item;
    Unknown;
  }
  /** 述語で決まる状態の分類 */
  classify Checkout of carts, orders {
    Shopping;
    Ordered;
  }

  @mark export fn findItem(name: string): Item?;
  @mark export fn load(name: string): string;
  export fn titleOf(ready: Title): string;
  export fn codeText(code: int): string;
  export fn receiptText(receipt: Receipt): string;
  export fn send(addr: Email): string;
  export fn priceOf(item: Item): int;
  export fn bigOnly(item: Item on Size.Big): string;
  export fn show(text: string);
  export fn fail(): never throws Bad;

  // variant の return match: switch <対象>.(type)。絞り込んだ値（アームの型、包む型の .Value）、フィールドを読む、残りのケースの節。
  // 最後の節は、いつも default:（分類の誤りの枝）
  export fn describe(page: Page): string
  {
    return match (page by PageKind) {
      IsCode   => codeText(page);
      IsReady  => titleOf(page);
      IsFailed => page.reason;
      Rest     => "other";
    };
  }

  // else のアームは、受けるケースを名前で並べたアームと、同じコードになる: describe と、本体が同じ（else は Rest を受ける）
  export fn describeElse(page: Page): string
  {
    return match (page by PageKind) {
      IsCode   => codeText(page);
      IsReady  => titleOf(page);
      IsFailed => page.reason;
      else     => "other";
    };
  }

  // variant の return match で、書いた型が union のすべてのアームを覆う（純粋な配線）。union の値がない（nil）ために、default: の節は置く
  export fn outcome(result: Result): string
  {
    return match (result by Outcome) {
      Ok  => receiptText(result);
      Err => result.reason;
    };
  }

  // 残りのケースのない variant の return match: 書かなかった型のアームの値は、default: の節で、分類の誤り
  export fn shown(page: Page): string
  {
    return match (page by Shown) {
      ShowsTitle => titleOf(page);
      ShowsCode  => codeText(page);
    };
  }

  // 同じ分類の const と文の match: どの節にも入らない値は、通り抜けずに、default: の節で、分類の誤り
  export fn shownNote(page: Page): string
  {
    val text = match (page by Shown) {
      ShowsTitle => titleOf(page);
      ShowsCode  => none;
    };
    match (page by Shown) {
      ShowsTitle => show("title");
      ShowsCode  => none;
    };
    return "noted";
  }

  // variant の const と文。複数のケースを受けるアーム（対象の型は変わらない）。else のアームは、型を書いたケースと残りのケースを
  // 受ける（case は、それぞれの Go の型を並べる）
  @mark export fn variants(page: Page): string
  {
    val text = match (page by PageKind) {
      IsReady, IsFailed => load("page");
      IsCode            => codeText(page);
      else              => none;
    };
    match (page by PageKind) {
      IsReady => show("ready");
      else    => none;
    };
    match (page by PageKind) {
      IsCode => none;
      else   => show("not code");
    };
    return "done";
  }

  // 型で決まる状態の分類（variant）: 対象の状態を読んでから分ける
  export fn stageText(): string
  {
    return match (by Stage) {
      Showing => titleOf(stage);
      Broken  => stage.reason;
      else    => "none";
    };
  }

  // 述語で決まる値の分類の return match: 判定関数と失敗の扱い、switch k<n>。default: の節がないので、後ろに return を置く。
  // ケースで絞り込んだ型（Item on Size.Big）は、Go では同じ型
  @mark export fn sizeLabel(item: Item): string
  {
    return match (item by Size) {
      Small => "small";
      Big   => bigOnly(item);
      Tiny  => load(item.name);
    };
  }

  // 述語で決まる分類を、純粋で throws のない配線が使う（判定の誤りは、error として返す。panic にしない）。
  // else のアームは、受けるケースの定数を並べた case（Go の default: ではない）
  export fn pureLabel(item: Item): string
  {
    return match (item by Size) {
      Tiny => "tiny";
      else => "normal";
    };
  }

  // 絞り込みが predicate: Go の型が違えば <絞り込んだ型>(<対象>)、省略可能を外すなら *<対象>
  export fn mail(addr: string, contact: string?): string
    throws Bad
  {
    val first = match (addr by Address) {
      Valid   => send(addr);
      Invalid => "invalid";
    };
    show(first);
    return match (contact by Contact) {
      Mail   => send(contact);
      Text   => contact;
      Silent => fail();
    };
  }

  // 述語で決まる op の分類: const と、「返らない」呼び出し・throw のアーム
  @mark export fn price(name: string): int
    throws Bad
  {
    val item = findItem(name);
    val value = match (item by Stock) {
      InStock => priceOf(item);
      SoldOut => throw Bad;
      Unknown => fail();
    };
    return value;
  }

  // 対象が名前でない Atom（リテラル、レコードリテラル）: v<n> に束縛してから分ける
  export fn literalSubjects(): string
    throws Bad
  {
    val a = match ("x@example.com" by Address) {
      Valid => "ok";
      else  => "ng";
    };
    show(a);
    return match ({ name: "box", price: 3 } by Size) {
      Big   => "big";
      Small => "small";
      Tiny  => throw Bad;
    };
  }

  // 述語で決まる状態の分類: 文の match（error を返す呼び出しと、none のアーム）
  export fn checkoutNote()
  {
    match (by Checkout) {
      Shopping => show("shopping");
      Ordered  => none;
    };
  }
}
