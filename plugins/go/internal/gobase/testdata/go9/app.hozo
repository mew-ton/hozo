// GO-9（docs/plugin-go.md「診断」）: リテラルの型を、型の位置（フィールド、union のアーム、引数）に使う宣言と、対象の型が boolean? の、
// literal の分類ごとに、一つ。リテラルの型を使わない宣言（Plain、plain）と、対象の型が boolean の literal の分類（Done）には、出ない。
// 位置は、その宣言。

namespace a {
  model Plain { id: string; }
  model Report { severity: "error"; }
  union Severity {
    Error: "error";
    Warning: "warning";
  }
  /** 型で決まる分類（literal）。対象の型が boolean なら、出せる */
  classify Done of boolean {
    Yes: boolean as true;
    No: boolean as false;
  }
  /** 対象の型が boolean? の literal の分類は、まだ、出せない */
  classify Flag of boolean? {
    On: boolean? as true;
    Off: boolean? as false;
    Unset: boolean? as else;
  }
  export fn plain(p: Plain): int;
  export fn retry(times: 3): int;
}
