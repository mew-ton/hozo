// docs/plugin-go.md「match」の、二つに分ける形（if）での、閉じた分類（docs/check.md「閉じた分類」）を、一か所ずつ使う:
// 残りのケースを書かない presence の分類の「分類の誤りの枝」（return / const / 文）と、else のアーム（受けるケースを名前で
// 並べたアームと、同じコードになる）。各 op の上のコメントが、その op が確かめる行。
// op はどれも export（出力は一つのパッケージ）。

/** 閉じた分類で、二つに分ける match */
namespace app {
  scalar Token extends string;
  model User { name: string; }
  model Line { item: string; }
  exception Denied;
  /** 印。付いた op は純粋でなくなる */
  decorator mark;

  /** 手元のトークン */
  state token: nullable<Token>;

  @mark export op findUser(name: string): User?;
  export op nameOf(user: User): string;
  export op useToken(token: Token): string;
  export op show(text: string);
  export op deny(): never throws Denied;

  /** 型で決まる op の分類（presence）。残りのケースを書かない: 値がないのは、どのケースでもない */
  classify Arrival of findUser {
    /** 届いた */
    Arrived: findUser as User;
  }
  /** 型で決まる状態の分類（presence）。残りのケースを書かない */
  classify Held of token {
    Holding: token as Token;
  }
  /** 型で決まる値の分類（presence）。残りのケースを持つ */
  classify Present of nullable<User> {
    Some: nullable<User> as User;
    Nothing: nullable<User> as else;
  }

  // return match: 値のある場合が if の枝。もう一方は、分類の誤りの枝（else を書かずに後ろに続ける。頭のコメントは書かない）
  @mark export op arrivedName(name: string): string
  {
    val user = findUser(name);
    return match (user by Arrival) {
      Arrived => nameOf(user);
    };
  }

  // val x = match と、文の match: 分類の誤りの枝は、else の枝。if の枝の中身がなければ（none のアーム）、条件を逆にして、
  // 分類の誤りの枝だけを書く。どの形でも、値がなければ、通り抜けずに、分類の誤りを返す
  @mark export op arrivedForms(name: string): string
  {
    val user = findUser(name);
    val text = match (user by Arrival) {
      Arrived => nameOf(user);
    };
    match (user by Arrival) {
      Arrived => show(text);
    };
    match (user by Arrival) {
      Arrived => none;
    };
    return text;
  }

  // 型で決まる状態の分類（presence）で、残りのケースを書かない: 対象の状態を読んでから分ける
  export op heldText(): string
  {
    return match (by Held) {
      Holding => useToken(token);
    };
  }

  // else のアームが、値のない側のケース（Nothing）を受ける: Nothing を名前で書いたアームと同じコード
  export op nameOrDeny(user: User?): string
    throws Denied
  {
    return match (user by Present) {
      Some => nameOf(user);
      else => deny();
    };
  }

  // else のアームが、値のある側のケース（Some）を受ける: 受けるケースが一つなので、対象は絞り込まれる（*<対象>）
  export op nameOrNobody(user: User?): string
  {
    return match (user by Present) {
      Nothing => "nobody";
      else    => nameOf(user);
    };
  }

  // 標準の分類の else のアーム（nullable の HasItems を受けて絞り込まれる。list の Empty を受ける）
  @mark export op standard(user: User?, lines: Line[]): string
  {
    match (lines by list) {
      HasItems => show("some");
      else     => show("none");
    };
    return match (user by nullable) {
      Empty => "nobody";
      else  => nameOf(user);
    };
  }
}
