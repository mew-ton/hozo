// docs/plugin-go.md「型」の各節と「コメント」を、サンプルが使わない形も含めて、一か所ずつ使う。op はない（型だけの出力）。

/** Types of the app. 説明が ASCII の文字で始まる（「は」の後ろに空白を置く） */
namespace app {
  // 「scalar」元の型ごと。scalar を継承する scalar
  /** 識別子 */
  scalar Id extends string;
  scalar AdminId extends Id;
  scalar Count extends int;
  scalar Ratio extends float;
  scalar Flag extends boolean;
  scalar Stamp extends Time;
  scalar Wait extends Duration;

  // 「model」核の型、省略可能（omitempty）、array、record、別の名前空間の型、説明が複数の行
  /**
   * 利用者。
   *
   * 二つ目の段。
   */
  model User {
    /** 識別子 */
    id: Id;
    name: string;
    nick: string?;
    tags: string[];
    attrs: Record<string, int>;
    born: Time;
    wait: Duration?;
    score: float;
    active: boolean;
    twice: string??;
    home: type.Address;
    homes: type.Address[]?;
  }

  // 「model」model から出すのは、構造体だけ（値を作る関数 New<Model> は出さない）。使う側は、零値から始める
  model Options {
    limit: int;
    label: string;
    ratio: float;
    wait: Duration;
    on: boolean;
    id: Id;
    note: string?;
  }

  // 「model」継承した model: なくしたフィールド、変えたフィールド、足したフィールド
  model Public extends User {
    override nick: never;
    override id: AdminId;
    extra: int;
  }
  model Renamed extends User {
    override twice: never;
    override tags: never;
  }

  model Problem { reason: string; }

  // 「union」アームの型: その場の model、N の model、別の名前空間の model・核の型・省略可能・array・union（包む型）
  /** 画面 */
  union Page {
    /** 表示できる */
    Ready: { title: string; };
    Failed: Problem;
    Away: type.Address;
    Code: int;
    Maybe: User?;
    Many: User[];
    Sub: Shape;
  }
  union Shape {
    Broken: Problem;
    Counted: Count;
  }

  // 「exception」値のない例外、その場の model の値、宣言した model の値
  exception Plain;
  /** 入力が不正 */
  exception Invalid(reason: string, at: int?);
  exception Wrapped(value: Problem);
  // variant が set の union は、Go の型にしない
  union Errors { Plain; Invalid; }

  // 「effect」組み込みの効果と遷移の定数
  /** 利用者 */
  state users: list<User>;
  /** 利用者を足す */
  effect addUser() on users.post;
  effect clearUsers() on users: HasItems -> Empty;

  // 型で決まる分類と decorator の宣言は、何も出さない
  classify Known of User? {
    Yes: User? as User;
    default;
  }
  decorator mark for model | op;
}

// 説明のない名前空間
namespace type {
  model Address { city: string; }
}
