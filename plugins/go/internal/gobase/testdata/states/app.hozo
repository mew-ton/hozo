// docs/plugin-go.md「op の置き場」「状態の単位」（問い合わせ、命令、SharedState）と「状態の参照」を、一か所ずつ使う。
// 各 op の上のコメントが、その op が確かめる行。op はどれも export（出力は一つのパッケージ）。

/** 状態を読む配線 */
namespace app {
  scalar Token extends string;
  model Line { item: string; count: int; }
  model Owner { name: string; }
  model Settings { title: string; owner: Owner?; }

  /** 手元のトークン */
  state token: nullable<Token>;
  /** カートの行 */
  state lines: list<Line>;
  /** 店の設定 */
  state settings: single<Settings>;

  /** 述語で決まる状態の分類（単位 SyncState を持つ） */
  classify Sync of token, lines {
    Fresh;
    Stale;
  }
  /** 型で決まる状態の分類（単位を持たない。遷移の宛先の単位は、ただ一つの対象の状態） */
  classify SignedIn of token {
    Yes: token as Token;
    default;
  }

  effect addLine on lines.post;
  effect dropToken on token.delete;
  /** カートを空にする */
  effect clearLines on lines: HasItems -> Empty;
  effect refresh on Sync: Stale -> Fresh;
  effect signIn on SignedIn: any -> Yes;

  // 読む状態と効果を運ぶデコレータ（docs/check.md「デコレータが運ぶ reads と effects」）。基底は、デコレータの名前を見ずに、
  // hozoc が IR に置いた Op.carried で、op の置き場を決める
  decorator looks(table: any state) for op reads table;
  decorator joins(a: any state, b: any state) for op reads a, b;
  decorator does(...targets: any effect) for op effects targets;
  /** 運ぶ節のないデコレータ。付いた op は純粋でなくなるだけ */
  decorator mark for op;

  // 「状態の単位」命令（効果を持つ葉）、op の問い合わせ（reads が一つの葉）、SharedState（reads が二つ以上の葉）
  export op add(line: Line) effects addLine;
  export op logout() effects dropToken;
  export op countLines(): int reads lines;
  export op summary(): string reads lines, settings;

  // 「op の置き場」の 3: 効果の宛先の単位。基底の状態の遷移はその状態、述語で決まる状態の分類の遷移はその分類の単位、
  // 型で決まる状態の分類の遷移は、ただ一つの対象の状態。効果と読む状態の両方を持つ葉は、効果だけで決める
  export op clear() effects clearLines;
  export op sync() effects refresh;
  export op enter(token: Token) effects signIn;
  export op addCounted(line: Line): int effects addLine reads settings;

  // 「op の置き場」の 3: デコレータが運ぶ効果。一つならその単位。二つ以上でも、宛先の単位がすべて同じなら、その単位の命令
  // （コメントは、効果を「、」でつなぐ）。分かれるなら SharedState の命令
  @does(addLine)
  export op push(line: Line);
  @does(clearLines, addLine)
  export op replace(line: Line);
  @does(addLine, dropToken)
  export op checkout(line: Line);
  // op が書いた効果と、運ばれた効果を合わせて数える（書いたものが先）
  @does(dropToken)
  export op syncOut() effects refresh;

  // 「op の置き場」の 4 と 5: デコレータが運ぶ reads。一つならその単位の問い合わせ、op が書いたものと合わせて二つ以上なら SharedState
  @looks(token)
  export op peek(): Token?;
  @joins(token, lines)
  export op status(): string;
  @looks(token)
  export op lineFor(item: string): Line? reads lines;

  // 「op の置き場」の 6: 運ぶ節のないデコレータだけを持つ葉は Leaves
  @mark
  export op audit(note: string);

  // 値を受け取る葉（純粋で失敗しない）
  export op show(title: string);
  export op showOwner(name: string?);
  export op showToken(token: Token?);
  export op showBoth(a: Token?, b: Token?);
  export op showLines(lines: Line[]);

  // 「状態の参照」Atom の state とパス（省略可能を通るパスも）。別の文なら、もう一度読む（同じ変数に = で代入する）
  export op header()
  {
    show(settings.title);
    showOwner(settings.owner.name);
  }

  // 「状態の参照」一つの文の中の同じ状態は、一度だけ読む。二つの状態を使う文は、書かれた順に読む
  export op once()
  {
    showBoth(token, token);
    add({ item: settings.title, count: 1 });
    showToken(token);
  }

  // 「状態の参照」const と return。戻り値の型の零値で失敗を返す
  export op current(): Token?
  {
    const t = token;
    showToken(t);
    return token;
  }
  export op title(): string
  {
    return settings.title;
  }

  // 「状態の参照」読んだ値の変数の名前が、引数と当たる（末尾に _）。同じ名前の引数があれば、名前はそちらを指す
  export op shadowed(token: Token?, lines: Line[])
  {
    showLines(lines);
    showBoth(token, app.token);
  }

  // 「状態の参照」match の対象が状態なら、match の前に一度読み、アームの中の同じ状態はその値を使う。
  // アームの本体だけが使う状態は、そのアームの枝の中で読む
  export op branches()
  {
    match lines by list {
      HasItems => showLines(lines);
      Empty    => show(settings.title);
    };
    match token by nullable {
      HasItems => logout();
      Empty    => showToken(token);
    };
  }

  // 状態を読む葉と、効果を持つ葉を呼ぶ配線（Reads と Effects のコメント）
  export op report(line: Line): string
  {
    add(line);
    const n = countLines();
    return summary();
  }

  // 複数の状態にまたがる葉（SharedState の命令と問い合わせ）と、分類の単位の命令を呼ぶ配線。運ばれた reads と effects も、
  // 呼び出し元へ伝わる（Reads と Effects のコメント）
  export op finish(line: Line): string
  {
    replace(line);
    checkout(line);
    sync();
    audit("finished");
    return status();
  }
}
