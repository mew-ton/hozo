// docs/plugin-go.md「op の置き場」「状態の単位」「状態の参照」と、「呼び出し」「文」の read・効果・直に呼ぶ組み込みの効果の行を、
// 一か所ずつ使う。各宣言の上のコメントが、それが確かめる行。op はどれも export（出力は一つのパッケージ）。

// 葉の op は reads / effects の節を書けない（docs/check.md「葉の op」）ので、葉が状態に触れることは、運ぶ節を持つデコレータで言う
// （docs/check.md「デコレータが運ぶ reads と effects」）
decorator reading(...tables: any state) for op reads tables;
decorator doing(...targets: any effect) for op effects targets;

/** 状態に触れる read と効果と、それを呼ぶ配線 */
namespace app {
  scalar Token extends string;
  model Line { item: string; count: int; }
  model Owner { name: string; }
  model Settings { title: string; owner: Owner?; }

  /** 手元のトークン */
  state token: nullable<Token>;
  /** カートの行 */
  state lines: list<Line>;
  /** 店の設定 */
  state settings: single<Settings>;
  // 「状態の単位」read も効果もなく、どの配線も直に呼ばない状態: 形で決まる問い合わせだけを持つ
  state journal: list<string>;

  /** 述語で決まる状態の分類（単位 SyncState を持つ） */
  classify Sync of token, lines {
    Fresh;
    Stale;
  }
  /** 型で決まる状態の分類（単位を持たない。遷移の宛先の単位は、ただ一つの対象の状態） */
  classify SignedIn of token {
    Yes: token as Token;
    No: token as else;
  }

  // 「状態の単位」read: 読む状態の単位の問い合わせ（宣言順）。説明は、メソッドのコメントに写す
  /** 品目が同じ行 */
  read fn lineFor(item: string): Line? reads lines;
  // 説明がなく、引数もない read。結果の型は、宣言に書かれたまま（宛先の状態の型と照らさない）
  read fn countLines(): int reads lines;
  /**
   * 店の名前。
   * 設定の title を、そのまま返す。
   */
  read fn shopTitle(): string reads settings;
  // どの配線も呼ばない read も出す。省略可能な引数と、Time の引数
  read fn linesSince(since: Time, limit: int?): Line[] reads lines;
  /** 手元のトークンの写し */
  read fn tokenCopy(): Token? reads token;

  // 「状態の単位」効果: 宛先の単位の命令（宣言順）。宛先の単位は、組み込みの効果と基底の状態の遷移なら、その基底の状態。
  // 述語で決まる状態の分類の遷移は、その分類の単位。型で決まる状態の分類の遷移は、ただ一つの対象の状態
  /** 行を足す */
  effect fn addLine(line: Line): effects lines.post;
  effect fn dropToken(): effects token.delete;
  /** カートを空にする */
  effect fn clearLines(): effects lines as HasItems -> Empty;
  effect fn refresh(): effects Sync as Stale -> Fresh;
  /**
   * ログインする。
   * 二行目の説明。
   */
  effect fn signIn(token: Token): effects SignedIn as any -> Yes;
  // 引数が二つの効果（省略可能な引数を持つ）
  effect fn rename(title: string, owner: Owner?): effects settings.put;
  // どの配線も呼ばない効果も出す
  effect fn removeLine(item: string): effects lines.delete;

  // 読む状態と効果を運ぶデコレータ（docs/check.md「デコレータが運ぶ reads と effects」）
  decorator looks(table: any state) for op reads table;
  decorator does(...targets: any effect) for op effects targets;
  /** 運ぶ節のないデコレータ。付いた op は純粋でなくなるだけ */
  decorator mark for op;

  // 「op の置き場」の 3: 葉は、いつも Leaves。デコレータが reads / effects を運んでいても（一つの状態でも、二つの状態でも）、
  // 置き場は変わらない
  @doing(addLine) export fn push(line: Line);
  @reading(lines, settings) export fn summary(): string;
  @does(addLine, dropToken)
  export fn checkout(line: Line);
  @looks(token)
  export fn peek(): Token?;
  @mark
  export fn audit(note: string);

  // 値を受け取る葉（純粋で throws がない）
  export fn show(title: string);
  export fn showCount(n: int);
  export fn showOwner(name: string?);
  export fn showToken(token: Token?);
  export fn showBoth(a: Token?, b: Token?);
  export fn showLines(lines: Line[]);

  // 「呼び出し」read: return 呼び出し（戻り値の並びが同じ）、const、型をそろえる return（int → int?）
  export fn find(item: string): Line?
  {
    return lineFor(item);
  }
  export fn total(): int
  {
    val n = countLines();
    showCount(n);
    return n;
  }
  export fn maybeTotal(): int?
  {
    return countLines();
  }
  export fn title(): string
  {
    return shopTitle();
  }

  // 「呼び出し」効果: 文（失敗の扱いを置く）。宛先の単位の引数名で呼ぶ: 基底の状態、述語で決まる状態の分類、
  // 型で決まる状態の分類の、ただ一つの対象の状態
  export fn add(line: Line)
  {
    addLine(line);
  }
  export fn reset(t: Token)
  {
    clearLines();
    refresh();
    signIn(t);
    dropToken();
  }

  // 「呼び出し」引数の型をそろえる（scalar → 元の型、T → T?）、渡されていない省略可能な引数は nil、レコードリテラルの引数
  export fn retitle(t: Token, owner: Owner)
  {
    rename(t, owner);
    rename(t);
    addLine({ item: "gift", count: 1 });
  }

  // 「呼び出し」直に呼ぶ組み込みの効果: 状態の単位の、形で決まる命令。値を取る操作は value 一つ（状態の要素の型）、
  // nullable の delete は、なし。呼んでいる操作だけが、単位のメソッドになる（lines は Post、token は Post と Put と Delete、
  // settings は Put。journal は、どれも持たない）
  export fn direct(line: Line, t: Token)
  {
    lines.post(line);
    token.put(t);
    token.delete();
    token.post(t);
    settings.put({ title: "direct" });
  }

  // 「match」アームの本体の read（return match、const）と、効果と直に呼ぶ組み込みの効果（文の match）
  export fn findOrNone(item: string?): Line?
  {
    return match (item by nullable) {
      HasItems => lineFor(item);
      Empty    => none;
    };
  }
  export fn countOrZero(item: string?): int
  {
    val n = match (item by nullable) {
      HasItems => countLines();
      Empty    => 0;
    };
    return n;
  }
  export fn toggle(t: Token)
  {
    match (token by nullable) {
      HasItems => dropToken();
      Empty    => token.post(t);
    };
  }

  // 「状態の参照」Atom の state とパス（省略可能を通るパスも）。別の文なら、もう一度読む（同じ変数に = で代入する）
  export fn header()
  {
    show(settings.title);
    showOwner(settings.owner.name);
  }

  // 「状態の参照」一つの文の中の同じ状態は、一度だけ読む。二つの状態を使う文は、書かれた順に読む。
  // read と効果の引数に書いた状態も、その文の前に読む
  export fn once()
  {
    showBoth(token, token);
    addLine({ item: settings.title, count: 1 });
    showToken(token);
  }

  // 「状態の参照」const と return。戻り値の型の零値で失敗を返す
  export fn current(): Token?
  {
    val t = token;
    showToken(t);
    return token;
  }

  // 「状態の参照」読んだ値の変数の名前が、引数と当たる（末尾に _）。同じ名前の引数があれば、名前はそちらを指す
  export fn shadowed(token: Token?, lines: Line[])
  {
    showLines(lines);
    showBoth(token, app.token);
  }

  // 「状態の参照」match の対象が状態なら、match の前に一度読み、アームの中の同じ状態はその値を使う。
  // アームの本体だけが使う状態は、そのアームの枝の中で読む
  export fn branches()
  {
    match (lines by list) {
      HasItems => showLines(lines);
      Empty    => show(settings.title);
    };
    match (token by nullable) {
      HasItems => dropToken();
      Empty    => showToken(token);
    };
  }

  // 葉（デコレータが reads と effects を運ぶもの）と、read と、効果を呼ぶ配線。運ばれた reads と effects も、呼び出し元へ伝わる
  // （Reads と Effects のコメント: Reads は読む状態、Effects は効果。直に呼んだ組み込みの効果は <状態>.<操作>）
  export fn finish(line: Line): string
  {
    push(line);
    checkout(line);
    lines.post(line);
    refresh();
    audit("finished");
    val n = countLines();
    showCount(n);
    return summary();
  }

  // 配線に付いたデコレータが運ぶ reads と effects（docs/check.md「デコレータが運ぶ reads と effects」）: その配線の Reads と Effects の
  // コメントに、本体が行き着くものの後ろに並ぶ（コメントは Op.signature から書く）。出すコードは変わらない: 配線の本体は、
  // 書かれた呼び出しだけで、運ばれたものを起こすのは、デコレータを読むトランスパイラ
  @looks(settings)
  @does(dropToken)
  export fn keep(line: Line)
  {
    addLine(line);
  }
  // それを呼ぶ配線にも伝わる
  export fn keepTwice(line: Line)
  {
    keep(line);
    keep(line);
  }
}
