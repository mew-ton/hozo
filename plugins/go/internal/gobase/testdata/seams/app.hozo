// plugins/go/spec/go.hozo の Requirement.Seams の各行を、一か所ずつ使う。各 op の上のコメントが、その op が確かめる行。

// 葉の op は reads / effects の節を書けない（docs/check.md「葉の op」）ので、葉が状態に触れることは、運ぶ節を持つデコレータで言う
// （docs/check.md「デコレータが運ぶ reads と effects」）
decorator fn reading(...tables: any state): reads tables;
decorator fn doing(...targets: any effect): effects targets;

/** テストの語彙 */
namespace t {
  /** 継ぎ目を要る（go-rate） */
  decorator fn limited();
  /** 継ぎ目を要る（go-trace） */
  decorator fn traced();
  /** 単位の継ぎ目にあるが、どの op にも付いていない（go-trace） */
  decorator fn unused();
  /** どのトランスパイラも読まない印 */
  decorator fn plain();
}

/** 継ぎ目を持つ op の名前空間 */
namespace shop {
  model Item { id: string; }
  /** 閉店している */
  exception Closed;
  /** 品物 */
  state items: list<Item>;
  /** 店の名前 */
  state title: single<string>;
  /** 品物を足す */
  effect fn addItem(item: Item): effects items.post;
  /** 識別子が同じ品物の数 */
  read fn countById(id: string): int reads items;

  // 「中身」置き場 1（配線）: wiring.go の buyBody。継ぎ目を持つ op を同じ名前空間の配線から呼ぶと、外側を通る
  /**
   * 品物を買う
   *
   * @param id 品物の識別子
   */
  @t.limited
  export fn buy(id: string): Item
  {
    val item = find(id);
    add(item);
    return item;
  }

  // 「中身」継ぎ目が掛かるのは op だけ: 継ぎ目を持つ配線の中身が呼ぶ read と効果と、直に呼ぶ組み込みの効果は、
  // 状態の単位のメソッドを、そのまま呼ぶ
  @t.limited
  export fn restock(item: Item): int
  {
    addItem(item);
    title.put("restocked");
    return countById(item.id);
  }

  // 「中身」置き場 2（never を返す op）: ops.go の、外側のすぐ後ろの closedBody
  @t.limited
  export fn closed(): never throws Closed;

  // 「中身」置き場 3（葉）: Leaves のメソッドの値（名前は op 名のまま）。デコレータが reads / effects を運ぶ葉も、Leaves
  @t.limited
  @doing(addItem) export fn add(item: Item);
  @t.limited
  @reading(items) export fn count(): int;
  @t.limited
  @reading(items, title) export fn summary(): string;
  @t.limited
  export fn notify(item: Item);

  // 「外側」二つの継ぎ目の入れ子（先に書かれたものほど外側）と、間の継ぎ目を持たないデコレータ
  @t.traced
  @t.plain
  @t.limited
  export fn find(id: string): Item
  {
    return lookup(id);
  }
  export fn lookup(id: string): Item;

  // 「内側のフォルダと、別の名前空間」内部の op も継ぎ目を持つ（二層と Seams は内側のパッケージ）
  @t.traced
  fn audit(item: Item);

  // 「Seams」body という名前が op の引数の局所の名前と当たる
  @t.limited
  export fn post(body: string, body_: string): string;

  // 継ぎ目にないデコレータだけの op は、継ぎ目を持たない
  @t.plain
  export fn plain(id: string): Item;
}

/** shop の op を呼ぶ側 */
namespace front {
  // 「内側のフォルダと、別の名前空間」別の名前空間の op の継ぎ目について、呼ぶ側は何も出さない
  @t.plain
  export fn order(id: string): shop.Item
  {
    return shop.buy(id);
  }
}
