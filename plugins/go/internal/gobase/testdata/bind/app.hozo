// plugins/go/spec/go.hozo の Requirement.Wiring の「bind で埋まる位置」の 1〜4 を、一か所ずつ使う。各 op の上のコメントが、その op が確かめる行。
// op はどれも export（出力は、名前空間ごとに一つのパッケージ）。

/** 呼ばれる側。bind の位置を持つ op */
namespace api {
  scalar Token extends string;
  model GetInput { token: Token?; id: string; }
  model Auth { token: Token?; locale: string?; }
  model NestedInput { auth: Auth; id: string; }
  model Guest { token: Token?; id: string; }
  /** 印。付いた op は純粋でなくなる */
  decorator fn remote();

  @remote export fn logout(token: Token?);
  @remote export fn get(in: GetInput): string;
  @remote export fn nested(in: NestedInput): string;
  @remote export fn ping(auth: Auth?): string;
  @remote export fn enter(guest: Guest): string;
  @remote export fn plain(id: string): string;
}

/** 呼ぶ側。状態を bind で埋める */
namespace web {
  scalar Locale extends string;
  /** 手元のトークン */
  state token: nullable<api.Token>;
  /** 表示の言語 */
  state locale: single<Locale>;

  bind token to api.*;
  bind locale to web.*;

  export fn greet(name: string, locale: Locale): string;

  // 2: 位置が引数そのもの
  export fn signOut()
  {
    api.logout();
  }

  // 3: 位置が、レコードリテラルで渡した引数の中のフィールド（入れ子のレコードリテラルも）
  export fn fetch(id: string): string
  {
    val a = api.get({ id });
    val b = api.nested({ auth: { locale: "en" }, id });
    return api.nested({ auth: {}, id: a });
  }

  // 4: 位置が、渡されていない引数の中のフィールド（その引数の型の構造体リテラルを作る）
  export fn check(): string
  {
    return api.ping();
  }

  // 3: 形が nullable の状態が埋まるのは、省略可能な位置だけ（省略可能でない位置に埋めることは、ない。BIND-2）。
  // 読んだ値を、そのまま、構造体リテラルのフィールドに書く
  export fn enter(id: string): string
  {
    return api.enter({ id });
  }

  // 名前で渡した引数の中の位置は、明示した位置（埋めない）。位置のない op はそのまま
  export fn explicit(in: api.GetInput, id: string): string
  {
    val a = api.get(in);
    return api.plain(id);
  }

  // 同じ名前空間の op への呼び出しも、配線が埋める（形が single の状態）
  export fn hello(name: string): string
  {
    return greet(name);
  }
}
