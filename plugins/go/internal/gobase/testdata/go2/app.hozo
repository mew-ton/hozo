// GO-2（docs/plugin-go.md「名前」の「名前が当たれば GO-2」）の条件を、名前空間ごとに一つずつ。どれも hozoc の検査は通る
// （NAME-1 は warning）。直すのは仕様の名前。

// 葉の op は reads / effects の節を書けない（docs/check.md「葉の op」）ので、葉が状態に触れることは、運ぶ節を持つデコレータで言う
// （docs/check.md「デコレータが運ぶ reads と effects」）
decorator reading(...tables: any state) for op reads tables;
decorator doing(...targets: any effect) for op effects targets;

/** 継ぎ目の語彙 */
namespace x {
  decorator limited;
}
namespace rate.x {
  decorator limited;
}

namespace c {
}

// 公開の名前どうし: 大文字化で同じになる宣言の名前
namespace c.caps {
  scalar id extends string;
  scalar Id extends string;
}

// 公開の名前どうし: 合成した名前と宣言の名前
namespace c.synth {
  union Page { Ready: { title: string; }; }
  model PageReady { title: string; }
}

// model から出す名前は、構造体の型だけ（New<Model> は出さない）ので、New… という名前の型は、何とも当たらない
namespace c.models {
  model Options { limit: int; }
  model NewOptions { x: int; }
}

// 公開の名前どうし: Effect… と型、<状態>State と型
namespace c.states {
  model Row { id: string; }
  state rows: list<Row>;
  effect fn addRow(): effects rows.post;
  model EffectAddRow { x: int; }
  model RowsState { x: int; }
}

// 公開の名前どうし: Ops、Leaves と型。<Ns>Ops と型
namespace c.ops {
  model Ops { x: int; }
  model Leaves { x: int; }
  model CDepOps { x: int; }
  export fn run(): int;
  export fn call(): int
  {
    return c.dep.work();
  }
}
namespace c.dep {
  export fn work(): int;
}

// 公開の名前どうし: 分類の名前（列挙の定数、述語のインターフェース、判定関数）と型
namespace c.kinds {
  model Item { x: int; }
  classify Size of Item {
    Big;
    Small;
  }
  model SizeBig { x: int; }
  model SizeCases { x: int; }
  model ClassifySize { x: int; }
}

// 一つの構造体のフィールドどうし（例外の引数を含む）
namespace c.fields {
  model Row { id: string; Id: string; }
  exception Bad(code: int, Code: string);
}

// 一つのインターフェースのメソッドどうし: Ops の中の foo と Foo
namespace c.methods {
  export fn foo(): int;
  export fn Foo(): int;
}

// 一つのインターフェースのメソッドどうし: 状態の単位の、形で決まるメソッド（Get と、配線が直に呼ぶ Post）と、ケースの述語と、
// その単位の read と効果の名前を先頭大文字にしたもの
namespace c.units {
  model Row { id: string; }
  state rows: list<Row>;
  // 形で決まる問い合わせ Get と read get
  read fn get(): int reads rows;
  // 同じ状態の read findRow と効果 FindRow
  read fn findRow(id: string): Row? reads rows;
  effect fn FindRow(id: string): effects rows.delete;
  // 形で決まる命令 Post（配線が直に呼ぶ）と効果 post
  effect fn post(row: Row): effects rows.post;
  export fn add(row: Row)
  {
    rows.post(row);
  }
  // 直に呼ばれていない操作（rows は put を直に呼べない）は、単位のメソッドにならないので、効果 put は当たらない
  effect fn put(row: Row): effects rows.put;
  // 状態の分類の単位: ケースの述語 Full と効果 full
  classify Load of rows {
    Full;
    Spare;
  }
  effect fn full(): effects Load as Spare -> Full;
}

// Seams の中のメソッドどうし（op loginRate の @x.limited と、op login の @rate.x.limited。どちらも LoginRateXLimited）と、
// 構造体 ops のフィールドと中身のメソッド（状態 loginBody と、継ぎ目を持つ配線 login）
namespace c.seams {
  state loginBody: single<string>;
  @x.limited
  export fn loginRate(): int;
  @rate.x.limited
  export fn login(): int
  {
    return loginRate();
  }
}
