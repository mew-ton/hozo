// plugins/go/spec/go.hozo の Requirement.Wraps の各行を、一か所ずつ使う。各 op の上のコメントが、その op が確かめる行。

/** テストの語彙 */
namespace trace {
  /** 混んでいる */
  exception Busy;
  /** 遅れた */
  exception Late;
  /** 変だ */
  exception Odd;
  // 継ぎ目を要る（go-trace）。本体のあるデコレータと、重ねる。デコレータのテストの口（plugins/go/spec/go.hozo の Requirement.UnitTestPort の「デコレータのテストの口」）の、
  // 結果ごとの確かめ: prevents effects（中身を呼ばない）、keeps effects（中身を呼んでいる）、関係なし（例外だけ）
  /** 中身の前後に、印を残す */
  decorator fn traced(): throws Busy prevents effects throws Late keeps effects throws Odd;

  /** 落ちた */
  exception Down;
  /** 切れた */
  exception Cut;
  /** 落ちたか、切れた */
  union Outage { Down; Cut; }
  // 例外を受ける、継ぎ目のデコレータ（go-trace）。デコレータのテストの口の「受けるケース」（plugins/go/spec/go.hozo）の、扱いごとの確かめ
  /** 落ちても、何もなかったことにする */
  decorator fn quiet(): catches Down ignores;
  /** 落ちても、切れても、続ける */
  decorator fn steady(): catches Outage recovers;
  /** 渡した例外を受けて、別の例外にして、返す */
  decorator fn renamed(error: any exception, into: any exception): catches error recovers throws into;
  /** 渡した例外を受けて、効果で、止める */
  decorator fn stopped(error: any exception, then: any effect): catches error halts then;
  /** 渡した例外を受けて、別の例外にして、返す。何度でも、付けられる */
  @repeatable decorator fn swapped(error: any exception, into: any exception): catches error recovers throws into;
  /** 落ちたのを受けるが、自分でも、落ちたと言う（DEC-6 の warning） */
  decorator fn echoed(): catches Down recovers throws Down;
  /** 渡した例外を、いくつでも受けて、何もなかったことにする */
  decorator fn muted(...errors: any exception): catches errors ignores;
}

/** 本体のあるデコレータを宣言する名前空間 */
namespace gate {
  /** 閉まっている */
  exception Closed;
  model Ticket { ok: boolean; }
  /** 通してよいか（述語で決まる分類） */
  classify Gate of Ticket { Open; Shut; }
  /** 今の切符（人が書く） */
  export fn ticket(): Ticket;
  /** 記録する（人が書く） */
  export fn note(label: string, times: int, memo: string?);
  /** 内部の op（別の名前空間に付けるデコレータの本体からは、呼べない） */
  fn local();

  // 前で確かめる。next() は、最後の文の match のアーム: return <内側の呼び出し>。別の名前空間の op にも付けられる
  // （本体が呼ぶのは、export の op だけ）。分類 Gate の述語は、付けた先の New が受け取る
  /** 閉まっていれば、op の中身を呼ばずに Closed */
  decorator fn guarded(next: fn) {
    val now = ticket();
    match (now by Gate) {
      Open => next();
      Shut => throw Closed;
    }
  }

  // 後で記録する。next() の後ろに文が続く: 値を返す op では、結果を result に受けて、最後に返す。値の引数は、
  // 適用に書いたリテラルを、その場に書く。渡されていない省略可能な引数は nil
  /** op の中身が、正常に終わった後に、記録する */
  decorator fn noted(next: fn, label: string, times: int, memo: string?) {
    next();
    note(label, times, memo);
  }

  // 前で確かめ、後で記録する。next() のアームを持つ match の後ろに、文が続く: 値を返す op では、var result を置き、
  // next() のアームが、result に入れる。throw のアームは、その場で、失敗を返す
  /** 閉まっていれば、op の中身を呼ばずに Closed。op の中身が、正常に終わった後に、記録する */
  decorator fn checked(next: fn, label: string) {
    val now = ticket();
    match (now by Gate) {
      Open => next();
      Shut => throw Closed;
    }
    note(label, 1);
  }

  // 宣言した名前空間の op に付けるなら、内部の op も呼べる
  /** 前に、内部の op を呼ぶ */
  decorator fn prepared(next: fn) {
    local();
    next();
  }

  // 宣言した名前空間の、葉の op に付ける: 中身は Leaves のメソッド（名前は op 名のまま）
  /** 中を見る（人が書く） */
  @prepared
  export fn peek(): Ticket;
}

/** gate のデコレータを、別の名前空間から付ける */
namespace shop {
  model Item { id: string; }

  // 配線の op、値を返す、next() が最後: 中身は findBody
  /** 品物を探す */
  @gate.guarded
  export fn find(id: string): Item {
    return lookup(id);
  }
  /** 品物を引く（人が書く） */
  fn lookup(id: string): Item;

  // 葉の op、値を返す、next() の後ろに文: 中身は o.leaves.Save。値の引数のリテラル（省略可能な memo は、渡さない）
  /** 品物をしまう（人が書く） */
  @gate.noted("save", 2)
  export fn save(item: Item): Item;

  // 値を返さない op に、継ぎ目と、本体のあるデコレータ二つを重ねる。書かれた順に、外から内へ:
  // 継ぎ目 trace.traced → gate.guarded → gate.noted → 中身
  /** 店を開ける（人が書く） */
  @trace.traced @gate.guarded @gate.noted("open", 1, "朝")
  export fn open();

  // 本体のあるデコレータの内側に、継ぎ目: next() が、継ぎ目を呼ぶ
  /** 店を閉める */
  @gate.guarded @trace.traced
  export fn close() {
    sweep();
  }
  /** 掃除する（人が書く） */
  fn sweep();

  // next() のアームを持つ match の後ろに、文: 値を返す op（配線）
  /** 値段を引く */
  @gate.checked("price")
  export fn price(id: string): Item {
    return lookup(id);
  }

  // next() のアームを持つ match の後ろに、文: 値を返さない op（葉）
  /** 呼び鈴を鳴らす（人が書く） */
  @gate.checked("ring")
  export fn ring();

  /** 断られた */
  exception Denied;

  // never を返す op に、前で確かめるだけのデコレータ: next() は、「返らない」呼び出しと同じ。中身は refuseBody
  /** いつも、断る */
  @gate.guarded
  export fn refuse(): never throws Denied;
}

/** 例外を受けるデコレータを付ける名前空間（plugins/go/spec/go.hozo の Requirement.UnitTestPort の「デコレータのテストの口」の「受けるケース」） */
namespace desk {
  /** 灯り */
  state lamp: single<string>;
  /** 灯りを点ける */
  effect fn light(color: string): effects lamp.put;

  // ignores: 値を返さない op。受ける例外は、宣言に書いたもの
  /** 呼びかける（人が書く） */
  @trace.quiet
  export fn ping(): throws trace.Down;

  // recovers（throws を持たないデコレータ）: ユニオンは、メンバーごと。値を返す op
  /** 取ってくる（人が書く） */
  @trace.steady
  export fn fetch(id: string): string throws trace.Down, trace.Cut;

  // recovers と throws: 引数で渡した例外を受ける。失敗が返るなら、引数で渡した例外
  /** 読み込む（人が書く） */
  @trace.renamed(trace.Down, trace.Late)
  export fn load(id: string): string throws trace.Down;

  // halts: 引数で渡した例外と、効果
  /** 電話する（人が書く） */
  @trace.stopped(trace.Cut, light)
  export fn dial(): throws trace.Cut;

  // 受ける例外が、op の計算した例外にない（DEC-16 の warning）: それでも、テストは、作る
  /** 待つ（人が書く） */
  @trace.quiet
  export fn idle();

  /** 机の側で、落ちた */
  exception Down;

  // 同じデコレータを、二度（@repeatable）: 継ぎ目は一つで、受ける例外を、合わせる。名前が当たる例外（trace.Down と desk.Down）は、
  // 名前空間のセグメントを前に付ける。失敗が返るなら、どちらかの適用が渡した例外（want0、want1）
  /** 取り次ぐ（人が書く） */
  @trace.swapped(trace.Down, trace.Late) @trace.swapped(Down, trace.Odd)
  export fn relay(): string throws trace.Down, Down;

  // 受けた例外が、デコレータの throws にもある（DEC-6 の warning）: 「受けた例外が、返らない」は、確かめない
  /** 繰り返す（人が書く） */
  @trace.echoed
  export fn echo(): throws trace.Down;

  // 残りの引数で、例外を、いくつも渡す: 渡した例外ごと
  /** 黙る（人が書く） */
  @trace.muted(trace.Down, trace.Cut)
  export fn hush(): throws trace.Down, trace.Cut;
}
