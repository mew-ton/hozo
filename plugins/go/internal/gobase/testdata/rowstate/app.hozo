// plugins/go の単体テストの入力: 行の遷移（docs/check.md「行の遷移」）と、ない側のケース（同「ない側のケース」）。
// 効果は、行の遷移を持っても、宛先の状態の単位のメソッドで、形は変わらない。変わるのは、コメントだけ。
// 行の引数を絞り込んだ効果（start、cancel、revise、discard）は、入口で、行のケースを確かめる（plugins/go/spec/go.hozo の Requirement.Ports の「効果の入口の確かめ」）。
// ない側のケースは、述語を持たない: 型で決まる分類（Known）は何も出さず、述語で決まる分類（Life）は、判定関数が、値がないことで決める。
namespace app {
  model Order { id: string; note: string; }

  state orders: list<Order>;

  exception NoOrder;
  exception NotAccepted;
  exception NotOpen;

  /** 注文の段階 */
  classify Stage of Order { Draft; Accepted; InProduction; Shipped; Cancelled; }

  /** 注文が、あるか。あれば、開いているか */
  classify Life of Order? {
    Open: Order? as Order;
    Closed: Order? as Order;
    /** ない */
    Absent: Order? as none;
  }

  /** 引いた注文があるか */
  classify Known of Order? {
    Found: Order? as Order;
    Missing: Order? as none;
  }

  read fn orderById(id: string): Order? reads orders;

  /** 注文を受け付ける */
  effect fn accept(order: Order): effects orders.post as Stage.Accepted;
  effect fn open(order: Order): effects orders.post as Life.Open;
  effect fn bring(order: Order): effects orders.post;
  /** 作り始める */
  effect fn start(order: Order on Stage.Accepted, at: datetime): effects orders.put as Stage.InProduction;
  /**
   * 取り消す。
   * 取り消せるのは、作り始める前だけ
   */
  effect fn cancel(order: Order on Stage.Draft | Stage.Accepted): effects orders.put as Stage.Cancelled;
  effect fn forceShip(order: Order): effects orders.put as Stage.Shipped;
  effect fn revise(order: Order on Stage.Accepted, note: string): effects orders.put as else;
  effect fn patch(order: Order): effects orders.put as else;
  effect fn rename(order: Order): effects orders.put;
  effect fn discard(order: Order on Life.Open): effects orders.delete as Life.Absent;
  effect fn purge(order: Order): effects orders.delete as Life.Absent;

  /** 作り始める。受け付けた注文だけ */
  export fn begin(id: string, at: datetime):
    throws NoOrder, NotAccepted
  {
    val found = orderById(id);
    match (found by Known) {
      Found   => beginFound(found, at);
      Missing => throw NoOrder;
    };
  }

  export fn beginFound(order: Order, at: datetime):
    throws NotAccepted
  {
    match (order by Stage) {
      Accepted => start(order, at);
      else     => throw NotAccepted;
    };
  }

  /** 型から Accepted と分かっている注文を、書き換える */
  export fn amend(order: Order on Stage.Accepted, note: string) {
    revise(order, note);
  }

  /** 捨てる。開いている注文だけ */
  export fn drop(id: string):
    throws NoOrder, NotOpen
  {
    val found = orderById(id);
    match (found by Life) {
      Open   => discard(found);
      Closed => throw NotOpen;
      Absent => throw NoOrder;
    };
  }

  /** いまの状態の呼び名 */
  export fn lifeName(found: Order?): string {
    return match (found by Life) {
      Open, Closed => found.note;
      Absent       => "absent";
    };
  }
}
