// docs/plugin-go.md「呼び出し」「文」の表の各行を、一か所ずつ使う。各 op の上のコメントが、その op が確かめる行。
// op はどれも export（内部の op がなければ、出力は一つのパッケージ。「内側のフォルダと入口」は、入力 layout が確かめる）。

/** 文と呼び出しの形 */
namespace app {
  scalar Id extends string;
  scalar Count extends int;
  model Item { id: Id; count: int; }
  union Shape { Thing: Item; Key: Id; }
  exception Broken;
  exception Gone;
  /** 印。読むトランスパイラはない。付いた op は純粋でなくなる（メソッドの形は変わらない） */
  decorator mark;

  // 葉: デコレータを持つ（仕様の上で、純粋でない）
  @mark export fn load(id: Id): Item;
  @mark export fn save(item: Item);
  @mark export fn touch();
  @mark export fn find(id: Id, limit: int?, tag: string?): Item?;
  // 葉: 純粋で throws がない（それでも、メソッドは ctx を取り、error を返す。docs/plugin-go.md「op の形」）
  export fn make(id: Id): Item;
  export fn note(item: Item);
  export fn pick(a: Item?, b: Item?): Item?;
  export fn keep(items: Item?[], ids: Id[]);
  // 葉: 純粋で throws がある（同じ形）
  export fn parse(text: string): Id throws Broken;
  // never を返す op
  export fn fail(): never throws Gone;

  // 「文」val x = 呼び出し（純粋でない op と、純粋な op。どちらも失敗の扱いを置く）、使っていない束縛（WIRE-8）、val x = 値、呼び出しの文
  @mark export fn consts(id: Id): Item
  {
    val a = load(id);
    val b = make(id);
    val unused = load(id);
    val c = b;
    val n = 3;
    note(a);
    save(c);
    return c;
  }

  // 「文」return 呼び出し: 型をそろえる必要がない（純粋でない配線が、純粋でない op を返す）
  @mark export fn sameShape(id: Id): Item
  {
    return load(id);
  }

  // 「文」return 呼び出し: 純粋でない配線が、純粋な op を返す（同じ形: return <呼び出し>）
  @mark export fn calleeOnlyPure(id: Id): Item
  {
    return make(id);
  }

  // 「文」return 呼び出し: 純粋な配線が、純粋な op を返す（同じ形。配線も ctx を取り、error を返す）
  export fn bothPure(id: Id): Item
  {
    return make(id);
  }

  // 「文」return 呼び出し: 型をそろえる必要がある（Item → Item?）
  @mark export fn widen(id: Id): Item?
  {
    return load(id);
  }

  // 「文」return 値: 純粋でない配線と、純粋な配線（どちらも return <値>, nil）
  @mark export fn valueWithError(item: Item): Item
  {
    return item;
  }
  export fn valueOnly(item: Item): Item
  {
    return item;
  }

  // 「文」「返らない」呼び出しの return と、文（戻り値のない配線。最後に return nil を足さない）
  export fn stop(id: Id): Item
    throws Gone
  {
    val a = make(id);
    note(a);
    return fail();
  }
  export fn stopStatement()
    throws Gone
  {
    fail();
  }

  // 「文」本体の終わり: 純粋でない配線も、純粋な配線も、最後に return nil
  @mark export fn endWithError(item: Item)
  {
    save(item);
  }
  export fn endQuiet(item: Item)
  {
    note(item);
  }

  // 「文」val x;（名前を並べた宣言は、名前ごとに一行）、x = 呼び出し（その位置で err が見えていないので、直前に var err error）、
  // 型をそろえる x = 呼び出し（Item → Item?）、x = 値、読まれていない空の val（WIRE-8: 宣言の直後に _ = x）
  @mark export fn fill(id: Id): Item?
  {
    val a, b: Item?, unused: Item;
    a = load(id);
    b = make(id);
    unused = a;
    return b;
  }

  // 「文」x = 呼び出し: 上の行に、err を作る文がある（var err error を置かない）
  @mark export fn fillAfterCall(id: Id): Item
  {
    val a = load(id);
    val b;
    b = make(a.id);
    return b;
  }

  // 「文」型を書いた val: 値の Go の型が同じ（x := 値）、違う（var x T = 値）、呼び出しの型をそろえる（v<n> に受ける）
  @mark export fn typed(id: Id): Item?
  {
    val a = make(id);
    val same: Item = a;
    val wide: Item? = a;
    val called: Item? = load(id);
    note(same);
    return pick(wide, called);
  }

  // 「文」for（変数を読む: for _, v := range。読まない: for range）、xs collect 呼び出し、型をそろえる xs collect 呼び出し、
  // xs collect 値
  @mark export fn each(ids: Id[]): Item[]
  {
    val items: Item[];
    val wide: Item?[];
    val seen: Id[];
    for (val id of ids) {
      items collect load(id);
      wide collect make(id);
      seen collect id;
    }
    for (val id of seen) {
      touch();
    }
    keep(wide, seen);
    return items;
  }

  // 「文」disjoint: 文の一つのアーム（そのまま）と、ブロックのアーム（Go のブロック。文が一つのブロックも）。disjoint for。
  // 「match」x = match、xs collect match
  @mark export fn apart(id: Id, other: Id, ids: Id[]): Item[]
  {
    val a, b, c;
    disjoint {
      a = load(id);
      {
        c = make(id);
      }
      {
        val found = find(other);
        b = match (found by nullable) {
          Empty    => make(other);
          HasItems => found;
        };
      }
    }
    note(a);
    note(b);
    note(c);
    val items: Item[];
    disjoint for (val each of ids) {
      val found = find(each);
      items collect match (found by nullable) {
        Empty    => make(each);
        HasItems => found;
      };
    }
    return items;
  }

  // 「呼び出し」純粋で throws がある op（ctx を渡し、失敗の扱いを置く）、渡されていない省略可能な引数は nil、別の名前空間の op
  @mark export fn calls(text: string): Item?
    throws Broken
  {
    val id = parse(text);
    val found = find(id);
    val fetched = dep.fetch(id);
    note(fetched);
    return found;
  }

  // 「呼び出し」零値: 失敗の扱いの return の、戻り値の型ごとの零値
  export fn asTime(): Time;
  export fn asDuration(): Duration;
  export fn asId(): Id;
  export fn asCount(): Count;
  export fn asFloat(): float;
  export fn asBool(): boolean;
  export fn asItems(): Item[];
  export fn asTable(): Record<string, int>;
  export fn asOptional(): Item?;
  export fn asShape(): Shape;
  @mark export fn zeroTime(): Time { touch(); return asTime(); }
  @mark export fn zeroDuration(): Duration { touch(); return asDuration(); }
  @mark export fn zeroId(): Id { touch(); return asId(); }
  @mark export fn zeroCount(): Count { touch(); return asCount(); }
  @mark export fn zeroFloat(): float { touch(); return asFloat(); }
  @mark export fn zeroBool(): boolean { touch(); return asBool(); }
  @mark export fn zeroItems(): Item[] { touch(); return asItems(); }
  @mark export fn zeroTable(): Record<string, int> { touch(); return asTable(); }
  @mark export fn zeroOptional(): Item? { touch(); return asOptional(); }
  @mark export fn zeroShape(): Shape { touch(); return asShape(); }
  @mark export fn zeroItem(id: Id): Item { touch(); return make(id); }
}

/** 別の名前空間。単位を持たない（app が、その op の口 DepOps を持つ） */
namespace dep {
  @app.mark export fn fetch(id: app.Id): app.Item;
}
