// docs/plugin-go.md「match」の、二つに分ける形（標準の分類 nullable / list と、絞り込みが presence の型で決まる分類）と、
// 使われ方（return / const / 文）ごとのアームの本体の組を、一か所ずつ使う。各 op の上のコメントが、その op が確かめる行。
// op はどれも export（出力は一つのパッケージ）。

/** 二つに分ける match */
namespace app {
  scalar Token extends string;
  model User { name: string; nick: string?; }
  model Line { item: string; }
  model Input { user: User?; id: string; }
  exception Missing;
  exception Denied;
  /** 印。付いた op は純粋でなくなる */
  decorator mark;

  /** 手元のトークン */
  state token: nullable<Token>;

  @mark export fn findUser(id: string): User?;
  export fn lookup(id: string): User?;
  export fn nameOf(user: User): string;
  @mark export fn loadName(user: User): string;
  export fn deny(): never throws Denied;
  export fn show(text: string);
  @mark export fn record(text: string);
  export fn countOf(lines: Line[]): int;
  export fn countTags(tags: string[]): int;
  export fn useToken(token: Token): string;
  export fn takeOptionalUser(user: User?);

  /** 型で決まる op の分類（絞り込みは presence） */
  classify Lookup of findUser {
    Found: findUser as User;
    NotFound: findUser as else;
  }
  /** 型で決まる値の分類（絞り込みは presence） */
  classify Present of nullable<User> {
    Some: nullable<User> as User;
    Nothing: nullable<User> as else;
  }
  /** 型で決まる状態の分類（絞り込みは presence） */
  classify SignedIn of token {
    Yes: token as Token;
    No: token as else;
  }

  // return match: 呼び出し（純粋でない op）と throw。アームを書いた順によらず、値のある場合が if の枝。else を書かない
  @mark export fn nameById(id: string): string
    throws Missing
  {
    val user = findUser(id);
    return match (user by Lookup) {
      NotFound => throw Missing;
      Found    => loadName(user);
    };
  }

  // return match: 値（絞り込んだ対象のフィールドを読むだけなら、元の式のまま）と none
  export fn nickOf(user: User?): string?
  {
    return match (user by nullable) {
      Some => user.nick;
      None => none;
    };
  }

  // return match: 呼び出し（純粋な配線が、純粋な op を呼ぶ。絞り込んだ値は *<対象>）と「返らない」呼び出し。
  // else のアーム（Nothing を受ける）は、そのケースを名前で書いたアームと同じコード（枝の頭のコメントも、ケースの名前）
  export fn pureName(user: User?): string
    throws Denied
  {
    return match (user by Present) {
      Some => nameOf(user);
      else => deny();
    };
  }

  // return match: 呼び出しの結果の型をそろえる（string → string?）。対象がパス
  @mark export fn widened(in: Input): string?
  {
    return match (in.user by nullable) {
      Some => loadName(in.user);
      None => none;
    };
  }

  // return match: 絞り込みで Go の型が変わらない対象（array）
  export fn tagCount(tags: string[]?): int
  {
    return match (tags by nullable) {
      Some => countTags(tags);
      None => 0;
    };
  }

  // return match: 対象が状態（先に読む）。型で決まる状態の分類は、対象の状態を読んでから分ける
  export fn tokenText(): string
  {
    return match (token by nullable) {
      Some => useToken(token);
      None => "none";
    };
  }
  export fn signedInText(): string
  {
    return match (by SignedIn) {
      Yes => useToken(token);
      No  => "anonymous";
    };
  }

  // val x = match: var x <match の型> を先に置く。呼び出し（純粋でない op / 純粋な op。どちらも失敗の扱いを置く）、値、none（何も書かない）、
  // throw、使っていない束縛（match の後ろに _ = x）
  @mark export fn constForms(id: string, lines: Line[]): string
    throws Missing
  {
    val user = lookup(id);
    val name = match (user by nullable) {
      Some => loadName(user);
      None => "nobody";
    };
    val count = match (lines by list) {
      HasItems => countOf(lines);
      Empty    => 0;
    };
    val maybe = match (user by nullable) {
      Some => nameOf(user);
      None => none;
    };
    val strict = match (user by nullable) {
      Some => user.name;
      None => throw Missing;
    };
    show(name);
    takeOptionalUser(user);
    return strict;
  }

  // 文の match: 呼び出し（純粋でない op / 純粋な op）、none のアーム（枝を書かない。if の枝がなければ条件を逆にする）、
  // 「返らない」呼び出し、throw、一つのアームが両方のケース（分けない）、絞り込んだ値を省略可能な位置へ
  @mark export fn statementForms(user: User?, lines: Line[]):
    throws Denied
  {
    match (user by nullable) {
      Some => record(user.name);
      None => show("none");
    };
    match (lines by list) {
      HasItems => show("some");
      Empty    => none;
    };
    match (user by nullable) {
      Some => none;
      None => deny();
    };
    match (lines by list) {
      Empty, HasItems => show("any");
    };
    match (user by nullable) {
      Some => takeOptionalUser(user);
      None => throw Denied;
    };
  }
}
