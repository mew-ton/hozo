// GOSQL-7（docs/plugin-go-sqlite.md「診断」）: db の語彙のデコレータ（@db.find、@db.list、@db.insert、@db.update、@db.delete）の
// 引数の状態が、N の表の状態でない（@db.table が付いていない、別の名前空間の状態）。位置はデコレータを付けた宣言。

/** 別の名前空間の表 */
namespace far {
  model Row { @db.key @db.text id: string; }
  @db.table(Row) state rows: list<Row>;
}

namespace app {
  model Row { @db.key @db.text id: string; @db.text note: string; }
  @db.table(Row) state rows: list<Row>;
  /** @db.table が付いていない状態 */
  state plain: list<Row>;

  // @db.find、@db.list
  @db.find(plain, "id")
  export op findPlain(id: string): Row?;
  @db.list(plain)
  export op listPlain(): Row[];

  // @db.insert、@db.update、@db.delete（op に並べられていない効果のデコレータも、同じに確かめる）
  @db.insert(plain)
  effect createPlain on plain.post;
  @db.update(plain)
  effect updatePlain on plain.put;
  @db.delete(plain, "id")
  effect deletePlain on plain.delete;
  @db.effects(createPlain)
  export op addPlain(row: Row);

  // 別の名前空間の状態
  @db.insert(far.rows)
  effect createFar on rows.post;

  // 通るもの
  @db.find(rows, "id")
  export op findRow(id: string): Row?;
  @db.insert(rows)
  effect createRow on rows.post;
  @db.effects(createRow)
  export op addRow(row: Row);
}
