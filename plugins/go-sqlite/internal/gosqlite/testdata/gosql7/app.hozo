// GOSQL-7（docs/plugin-go-sqlite.md「診断」）: db のデコレータを付けた read の on の状態か、効果の宛先の状態が、N の表の状態でない
// （@db.table が付いていない）。位置は、その read か効果。

namespace app {
  model Row { @db.key @db.text id: string; @db.text note: string; }
  @db.table state rows: list<Row>;
  /** @db.table が付いていない状態 */
  state plain: list<Row>;

  // read: @db.find、@db.list
  @db.find
  read plainById(id: string): Row? on plain;
  @db.list
  @db.where("note", "x")
  @db.latest("note")
  read plainRows(): Row[] on plain;

  // 効果: @db.insert、@db.update、@db.delete（配線が呼んでいない効果も、同じに確かめる）
  @db.insert
  effect createPlain(row: Row) on plain.post;
  @db.update
  effect updatePlain(row: Row) on plain.put;
  @db.delete
  effect deletePlain(id: string) on plain.delete;
  export op addPlain(row: Row) {
    createPlain(row);
  }

  // 通るもの
  @db.find
  read rowById(id: string): Row? on rows;
  @db.insert
  effect createRow(row: Row) on rows.post;
  /** デコレータを付けていない read と効果は、見ない */
  read plainCount(): int on plain;
  effect clearPlain() on plain.delete;
}
