// docs/plugin-go-sqlite.md「表」「しまい方」: 六つのしまい方（表の各行。核の型と scalar）、@db.nullable の列（しまい方ごと）、制約。
// どの表にも、行を足す op を置く（dbArgs<Model> が出る）。読むのは、形で決まる問い合わせ Get。

namespace kinds {
  scalar Name extends string;
  scalar Count extends int;
  scalar Ratio extends float;
  scalar Flag extends boolean;
  scalar Span extends Duration;
  scalar Stamp extends Time;
  /** scalar の元が scalar（元の核の型は string） */
  scalar Label extends Name;

  /** 表の model でない model: フィールドの db の語彙のデコレータは、読まない（合わないしまい方も、@db.nullable のない省略可能も） */
  model Tag { @db.int key: string; value: string; note: string?; }
}

/** 列のしまい方 */
namespace app {
  /** 核の型の列: しまい方の表の各行 */
  model Core {
    @db.key @db.text s: string;
    @db.int i: int;
    @db.int d: Duration;
    @db.float f: float;
    @db.bool b: boolean;
    @db.time t: Time;
  }

  /** scalar の列（しまい方に合うかは、元の核の型で見る） */
  model Named {
    @db.key @db.text name: kinds.Name;
    @db.int count: kinds.Count;
    @db.int span: kinds.Span;
    @db.float ratio: kinds.Ratio;
    @db.bool flag: kinds.Flag;
    @db.time stamp: kinds.Stamp;
    @db.text label: kinds.Label;
  }

  /** @db.json の列（array、record、model）。自分を指す model も JSON */
  model Doc {
    @db.json tags: string[];
    @db.json attrs: Record<string, int>;
    @db.json tag: kinds.Tag;
    @db.json nested: kinds.Tag[];
    @db.json tree: Tree;
  }
  model Tree { label: string; children: Tree[]; }

  /** @db.nullable の列: しまい方ごと（核の型と scalar）。NOT NULL が付かない */
  model Sparse {
    @db.text s: string?;
    @db.int i: int?;
    @db.int d: Duration?;
    @db.float f: float?;
    @db.bool b: boolean?;
    @db.time t: Time?;
    @db.text name: kinds.Name?;
    @db.int count: kinds.Count?;
    @db.int span: kinds.Span?;
    @db.float ratio: kinds.Ratio?;
    @db.bool flag: kinds.Flag?;
    @db.time stamp: kinds.Stamp?;
    @db.json tags: string[]?;
    @db.json attrs: Record<string, int>?;
    @db.json tag: kinds.Tag?;
  }

  /** 複数の @db.key（表の末尾の PRIMARY KEY）と @db.unique */
  model Pair {
    @db.key @db.text left: kinds.Name;
    @db.key @db.int right: kinds.Count;
    @db.unique @db.text note: string;
  }

  /** 二つの表の model（補助は一度だけ出る） */
  model Shared { @db.key @db.text id: string; }

  /** @db.ref: 先の表と、そのただ一つのキーへの REFERENCES。自分の表も指せる。@db.nullable と @db.unique と一緒にも書ける */
  model Link {
    @db.key @db.text id: string;
    @db.ref(Core) @db.text core: string;
    @db.unique @db.ref(Link) @db.text parent: string?;
  }

  @db.table state cores: list<Core>;
  @db.table state nameds: list<Named>;
  @db.table state docs: list<Doc>;
  @db.table state sparses: list<Sparse>;
  @db.table state pairs: list<Pair>;
  @db.table state sharedA: list<Shared>;
  @db.table state sharedB: list<Shared>;
  @db.table state links: list<Link>;
  /** @db.table のない状態は、表にならない */
  state plain: list<Core>;

  @db.insert effect createCore(row: Core) on cores.post;
  @db.insert effect createNamed(row: Named) on nameds.post;
  @db.insert effect createDoc(row: Doc) on docs.post;
  @db.insert effect createSparse(row: Sparse) on sparses.post;
  @db.insert effect createPair(row: Pair) on pairs.post;
  @db.insert effect createSharedA(row: Shared) on sharedA.post;
  @db.insert effect createLink(row: Link) on links.post;

  export op addCore(core: Core) {
    createCore(core);
  }
  export op addNamed(named: Named) {
    createNamed(named);
  }
  export op addDoc(doc: Doc) {
    createDoc(doc);
  }
  export op addSparse(sparse: Sparse) {
    createSparse(sparse);
  }
  export op addPair(pair: Pair) {
    createPair(pair);
  }
  export op addSharedA(shared: Shared) {
    createSharedA(shared);
  }
  export op addLink(link: Link) {
    createLink(link);
  }
}
