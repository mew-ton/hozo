// docs/requirements.md「出力を推論しない」: フィールドごと、op ごとに出すコードは、型によらず同じ形。
// 三つの名前空間は、フィールドと引数の型だけが違う（plain は核の型、named は scalar、sparse は省略可能で @db.nullable を持つ）。
// plugins/go-sqlite の TestUniform が、三つの db.go が、名前と型（と、@db.nullable の足すもの）のほかは同じテキストであることを確かめる。

/** 核の型 */
namespace plain {
  model Tag { name: string; }

  model Row {
    @db.key @db.text s: string;
    @db.int i: int;
    @db.int d: Duration;
    @db.float f: float;
    @db.bool b: boolean;
    @db.time at: Time;
    @db.json j: string[];
  }

  @db.table state rows: list<Row>;

  @db.find
  read findRow(s: string): Row? on rows;
  export op find(s: string): Row? {
    return findRow(s);
  }
  @db.list
  read byIRows(i: int): Row[] on rows;
  export op byI(i: int): Row[] {
    return byIRows(i);
  }
  @db.list
  read byDRows(d: Duration): Row[] on rows;
  export op byD(d: Duration): Row[] {
    return byDRows(d);
  }
  @db.list
  read byFRows(f: float): Row[] on rows;
  export op byF(f: float): Row[] {
    return byFRows(f);
  }
  @db.list
  read byBRows(b: boolean): Row[] on rows;
  export op byB(b: boolean): Row[] {
    return byBRows(b);
  }
  @db.list
  read byAtRows(at: Time): Row[] on rows;
  export op byAt(at: Time): Row[] {
    return byAtRows(at);
  }
  @db.list
  read byJRows(j: string[]): Row[] on rows;
  export op byJ(j: string[]): Row[] {
    return byJRows(j);
  }

  @db.insert
  effect create(row: Row) on rows.post;
  @db.update
  effect change(row: Row) on rows.put;
  @db.delete
  effect drop(at: Time) on rows.delete;

  export op add(row: Row) {
    create(row);
  }
  export op save(row: Row) {
    change(row);
  }
  export op remove(at: Time) {
    drop(at);
  }
  @db.transaction
  export op swap(at: Time, row: Row) {
    drop(at);
    create(row);
  }
}

/** scalar */
namespace named {
  scalar S extends string;
  scalar I extends int;
  scalar D extends Duration;
  scalar F extends float;
  scalar B extends boolean;
  scalar At extends Time;
  model Tag { name: string; }

  model Row {
    @db.key @db.text s: S;
    @db.int i: I;
    @db.int d: D;
    @db.float f: F;
    @db.bool b: B;
    @db.time at: At;
    @db.json j: Record<string, Tag>;
  }

  @db.table state rows: list<Row>;

  @db.find
  read findRow(s: S): Row? on rows;
  export op find(s: S): Row? {
    return findRow(s);
  }
  @db.list
  read byIRows(i: I): Row[] on rows;
  export op byI(i: I): Row[] {
    return byIRows(i);
  }
  @db.list
  read byDRows(d: D): Row[] on rows;
  export op byD(d: D): Row[] {
    return byDRows(d);
  }
  @db.list
  read byFRows(f: F): Row[] on rows;
  export op byF(f: F): Row[] {
    return byFRows(f);
  }
  @db.list
  read byBRows(b: B): Row[] on rows;
  export op byB(b: B): Row[] {
    return byBRows(b);
  }
  @db.list
  read byAtRows(at: At): Row[] on rows;
  export op byAt(at: At): Row[] {
    return byAtRows(at);
  }
  @db.list
  read byJRows(j: Record<string, Tag>): Row[] on rows;
  export op byJ(j: Record<string, Tag>): Row[] {
    return byJRows(j);
  }

  @db.insert
  effect create(row: Row) on rows.post;
  @db.update
  effect change(row: Row) on rows.put;
  @db.delete
  effect drop(at: At) on rows.delete;

  export op add(row: Row) {
    create(row);
  }
  export op save(row: Row) {
    change(row);
  }
  export op remove(at: At) {
    drop(at);
  }
  @db.transaction
  export op swap(at: At, row: Row) {
    drop(at);
    create(row);
  }
}

/** 省略可能（@db.nullable） */
namespace sparse {
  model Tag { name: string; }

  model Row {
    @db.key @db.text s: string?;
    @db.int i: int?;
    @db.int d: Duration?;
    @db.float f: float?;
    @db.bool b: boolean?;
    @db.time at: Time?;
    @db.json j: Tag?;
  }

  @db.table state rows: list<Row>;

  @db.find
  read findRow(s: string?): Row? on rows;
  export op find(s: string?): Row? {
    return findRow(s);
  }
  @db.list
  read byIRows(i: int?): Row[] on rows;
  export op byI(i: int?): Row[] {
    return byIRows(i);
  }
  @db.list
  read byDRows(d: Duration?): Row[] on rows;
  export op byD(d: Duration?): Row[] {
    return byDRows(d);
  }
  @db.list
  read byFRows(f: float?): Row[] on rows;
  export op byF(f: float?): Row[] {
    return byFRows(f);
  }
  @db.list
  read byBRows(b: boolean?): Row[] on rows;
  export op byB(b: boolean?): Row[] {
    return byBRows(b);
  }
  @db.list
  read byAtRows(at: Time?): Row[] on rows;
  export op byAt(at: Time?): Row[] {
    return byAtRows(at);
  }
  @db.list
  read byJRows(j: Tag?): Row[] on rows;
  export op byJ(j: Tag?): Row[] {
    return byJRows(j);
  }

  @db.insert
  effect create(row: Row) on rows.post;
  @db.update
  effect change(row: Row) on rows.put;
  @db.delete
  effect drop(at: Time?) on rows.delete;

  export op add(row: Row) {
    create(row);
  }
  export op save(row: Row) {
    change(row);
  }
  export op remove(at: Time?) {
    drop(at);
  }
  @db.transaction
  export op swap(at: Time?, row: Row) {
    drop(at);
    create(row);
  }
}
