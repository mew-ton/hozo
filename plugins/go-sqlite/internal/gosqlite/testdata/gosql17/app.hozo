// GOSQL-17（docs/plugin-go-sqlite.md「しまい方」の表）: しまい方が、フィールドの型に合わない。位置は model。フィールドごとに一つ。

namespace app {
  scalar Name extends string;
  scalar Count extends int;
  scalar Stamp extends datetime;
  model Tag { name: string; }
  model CountsByName { [name: string]: Count; }

  model Row {
    @db.key @db.text id: string;
    // @db.text は string
    @db.text textOnInt: int;
    @db.text textOnTime: datetime;
    @db.text textOnArray: string[];
    // @db.int は int と duration
    @db.int intOnString: string;
    @db.int intOnFloat: float;
    @db.int intOnBool: boolean;
    @db.int intOnTime: datetime;
    // @db.float は float
    @db.float floatOnInt: int;
    // @db.bool は boolean
    @db.bool boolOnInt: int;
    // @db.datetime は datetime
    @db.datetime timeOnString: string;
    @db.datetime timeOnDuration: duration;
    // @db.json は array、record、model
    @db.json jsonOnString: string;
    @db.json jsonOnInt: int;
    @db.json jsonOnScalar: Name;
    // scalar は、元の核の型で見る
    @db.int intOnName: Name;
    @db.text textOnCount: Count;
    @db.int intOnStamp: Stamp;
    // 省略可能でも同じ
    @db.int intOnMaybeString: string?;
    @db.text textOnMaybeTag: Tag?;

    // 通るもの
    @db.text name: Name;
    @db.int count: Count;
    @db.int span: duration;
    @db.datetime stamp: Stamp;
    @db.json tag: Tag;
    @db.json tags: Name[];
    @db.json byName: CountsByName;
    @db.float ratio: float?;
  }

  @db.table state rows: list<Row>;
}
