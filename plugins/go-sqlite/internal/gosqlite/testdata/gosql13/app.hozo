// GOSQL-13（docs/plugin-go-sqlite.md「read の中身」）: @db.find の read が、一行に決まらない: 条件の列（引数と @db.where）が、
// 表の model の @db.key のすべても、@db.unique の列も含まず、@db.latest もない。位置は read。

namespace app {
  model Row { @db.key @db.text id: string; @db.unique @db.text code: string; @db.text note: string; @db.time at: Time; }
  /** キーが二つ */
  model Pair { @db.key @db.text left: string; @db.key @db.text right: string; @db.text note: string; }
  /** キーも、一意の列もない */
  model Log { @db.text line: string; @db.time at: Time; }
  @db.table state rows: list<Row>;
  @db.table state pairs: list<Pair>;
  @db.table state logs: list<Log>;

  // キーでも一意でもない列
  @db.find
  read rowByNote(note: string): Row? on rows;
  // 条件がない
  @db.find
  read anyRow(): Row? on rows;
  // @db.where の条件だけで、キーでも一意でもない列
  @db.find
  @db.where("note", "x")
  read notedRow(): Row? on rows;
  // 二つの @db.key の一つ
  @db.find
  read pairByLeft(left: string): Pair? on pairs;
  // 二つの @db.key の一つと、キーでない列
  @db.find
  read pairByLeftAndNote(left: string, note: string): Pair? on pairs;
  // キーのない model（どの列を並べても、決まらない）
  @db.find
  read logByLine(line: string, at: Time): Log? on logs;

  // ---- 通るもの ----

  // 1: @db.key のすべて
  @db.find
  read rowById(id: string): Row? on rows;
  @db.find
  read pairByBoth(left: string, right: string): Pair? on pairs;
  // 引数と @db.where を合わせて、@db.key のすべて
  @db.find
  @db.where("right", "r")
  read pairOnRight(left: string): Pair? on pairs;
  // 2: @db.unique の列
  @db.find
  read rowByCode(code: string): Row? on rows;
  @db.find
  @db.where("code", "c")
  read fixedRow(note: string): Row? on rows;
  // 3: @db.latest（条件がなくてもよい）
  @db.find
  @db.latest("at")
  read lastLog(): Log? on logs;
  @db.find
  @db.latest("at")
  read lastRowNoted(note: string): Row? on rows;
  // @db.list なら、どの条件でもよい
  @db.list
  read rowsByNote(note: string): Row[] on rows;
}
