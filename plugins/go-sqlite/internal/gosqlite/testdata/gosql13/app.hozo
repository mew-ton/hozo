// GOSQL-13（docs/plugin-go-sqlite.md「op の中身」）: @db.find の列が、一行に決まる列でない（表の model のただ一つの @db.key でも、
// @db.unique でもない）。位置は op。

namespace app {
  model Row { @db.key @db.text id: string; @db.unique @db.text code: string; @db.text note: string; }
  /** キーが二つ */
  model Pair { @db.key @db.text left: string; @db.key @db.text right: string; @db.unique @db.key @db.text both: string; }
  /** キーがない */
  model Log { @db.text line: string; }
  @db.table state rows: list<Row>;
  @db.table state pairs: list<Pair>;
  @db.table state logs: list<Log>;

  // キーでも一意でもない列
  @db.find
  read findByNoteRow(note: string): Row? on rows;
  export op findByNote(note: string): Row? {
    return findByNoteRow(note);
  }
  // 複数の @db.key の一つ
  @db.find
  read findByLeftRow(left: string): Pair? on pairs;
  export op findByLeft(left: string): Pair? {
    return findByLeftRow(left);
  }
  // キーのない model
  @db.find
  read findLineRow(line: string): Log? on logs;
  export op findLine(line: string): Log? {
    return findLineRow(line);
  }

  // 通るもの: ただ一つの @db.key、@db.unique、複数の @db.key の一つでも @db.unique を持つ列
  @db.find
  read findRowRow(id: string): Row? on rows;
  export op findRow(id: string): Row? {
    return findRowRow(id);
  }
  @db.find
  read findByCodeRow(code: string): Row? on rows;
  export op findByCode(code: string): Row? {
    return findByCodeRow(code);
  }
  @db.find
  read findByBothRow(both: string): Pair? on pairs;
  export op findByBoth(both: string): Pair? {
    return findByBothRow(both);
  }
  // @db.list なら、どの列でもよい
  @db.list
  read listByNoteRows(note: string): Row[] on rows;
  export op listByNote(note: string): Row[] {
    return listByNoteRows(note);
  }
}
