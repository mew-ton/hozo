// GOSQL-20（docs/plugin-go-sqlite.md「表」）: 表の model のフィールドの @db.ref(M2) の指す先が、一つに決まらない:
// @db.table(M2) の付いた表の状態が、N にないか、二つ以上ある。または、M2 の @db.key が一つでない。位置は model。フィールドごとに一つ。

/** 別の名前空間の表 */
namespace far {
  model Row { @db.key @db.text id: string; }
  @db.table state rows: list<Row>;
}

namespace app {
  /** 表のない model */
  model Loose { @db.key @db.text id: string; }
  /** 表が二つある model */
  model Twin { @db.key @db.text id: string; }
  /** キーが二つの model */
  model Pair { @db.key @db.text left: string; @db.key @db.text right: string; }
  /** キーのない model */
  model Log { @db.text line: string; }
  model User { @db.key @db.text id: string; }

  model Link {
    @db.key @db.text id: string;
    @db.ref(Loose) @db.text loose: string;
    @db.ref(Twin) @db.text twin: string;
    @db.ref(Pair) @db.text pair: string;
    @db.ref(Log) @db.text log: string;
    // 表が、別の名前空間にしかない
    @db.ref(far.Row) @db.text far: string;
    // 通るもの（自分の表も指せる）
    @db.ref(User) @db.text user: string;
    @db.ref(Link) @db.text parent: string?;
  }

  @db.table state twinsA: list<Twin>;
  @db.table state twinsB: list<Twin>;
  @db.table state pairs: list<Pair>;
  @db.table state logs: list<Log>;
  @db.table state users: list<User>;
  @db.table state links: list<Link>;
}
