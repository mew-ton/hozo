// GOSQL-11（docs/plugin-go-sqlite.md「op の中身」）: 効果のデコレータが、効果の宛先と合わない。位置は効果。
// 宛先が組み込みの効果なら、状態がデコレータの表で、操作が合う（@db.insert は post、@db.update は put、@db.delete は delete）。
// 宛先が遷移なら、デコレータの表が、その効果の書き込む状態（Effect.writes）にある。

namespace app {
  model Row { @db.key @db.text id: string; @db.text note: string; }
  @db.table(Row) state rows: list<Row>;
  @db.table(Row) state copies: list<Row>;
  @db.table(Row) state logs: list<Row>;

  // ---- 組み込みの効果: 操作が合わない ----

  @db.insert(rows)
  effect insertOnPut on rows.put;
  @db.insert(rows)
  effect insertOnDelete on rows.delete;
  @db.update(rows)
  effect updateOnPost on rows.post;
  @db.update(rows)
  effect updateOnDelete on rows.delete;
  @db.delete(rows, "id")
  effect deleteOnPost on rows.post;
  @db.delete(rows, "id")
  effect deleteOnPut on rows.put;

  // ---- 組み込みの効果: 状態が、デコレータの表でない ----

  @db.insert(copies)
  effect insertElsewhere on rows.post;
  @db.delete(copies, "id")
  effect deleteElsewhere on rows.delete;

  // ---- 遷移: デコレータの表が、効果の書き込む状態にない ----

  classify Sync of rows, copies {
    Same;
    Differ;
  }
  @db.insert(logs)
  effect logSync on Sync: Differ -> Same;
  @db.update(copies)
  effect fillRows on rows: Empty -> HasItems;

  // op に並べても、効果ごとに一度だけ
  @db.effects(insertOnPut)
  export op addWrong(row: Row);

  // ---- 通るもの ----

  @db.insert(rows)
  effect createRow on rows.post;
  @db.update(rows)
  effect updateRow on rows.put;
  @db.delete(rows, "id")
  effect deleteRow on rows.delete;
  // 遷移なら、操作の名前との照合はない
  @db.delete(copies, "id")
  effect copyOver on Sync: Differ -> Same;
  @db.update(rows)
  effect touchRows on rows: HasItems -> HasItems;
}
