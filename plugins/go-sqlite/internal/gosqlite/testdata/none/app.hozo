// docs/plugin-go-sqlite.md「出力」: @db.table の付いた状態が一つもなければ、ファイルを出さず warning を一つ。
// db の語彙のデコレータを付けていない read と効果には、何も出さない（warning も、この一つだけ）。

namespace app {
  model Row { @db.key @db.text id: string; }
  /** `@db.table` のない状態は、表の状態ではない */
  state rows: list<Row>;
  read fn rowById(id: string): Row? reads rows;
  effect fn createRow(row: Row): effects rows.post;
  export fn findRow(id: string): Row? {
    return rowById(id);
  }
}
