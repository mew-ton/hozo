// GOSQL-14（docs/plugin-go-sqlite.md「op の中身」）: op が、db の op のデコレータ（@db.find、@db.list、@db.effects）の言う以外の
// ものを読み書きする: そのデコレータを二つ以上持つ。op が直に読む状態か直に持つ効果に、そのデコレータが運ぶもの以外がある。
// @db.effects に効果が一つもない。位置は op。

namespace app {
  model Row { @db.key @db.text id: string; @db.text note: string; }
  @db.table(Row) state rows: list<Row>;
  @db.table(Row) state copies: list<Row>;

  @db.insert(rows)
  effect createRow() on rows.post;
  @db.insert(copies)
  effect createCopy() on copies.post;
  @db.delete(rows, "id")
  effect deleteRow() on rows.delete;

  // ---- db の op のデコレータを二つ以上持つ（同じデコレータを二度付けるのは、hozoc の DEC-13） ----

  @db.find(rows, "id")
  @db.list(rows, "id")
  export op findOrList(id: string): Row?;
  @db.find(rows, "id")
  @db.effects(createCopy)
  export op findAndAdd(row: Row);
  @db.list(rows)
  @db.effects(createRow)
  export op listAndAdd(row: Row);

  // ---- 直に読む状態か、直に持つ効果に、デコレータが運ぶもの以外がある ----

  // @db.find の op が、自分で effects を書いている
  @db.find(rows, "id")
  export op takeRow(id: string): Row? effects deleteRow;
  // @db.list の op が、自分で、別の状態の reads を書いている
  @db.list(rows)
  export op listBoth(): Row[] reads copies;
  // @db.effects の op が、自分で reads を書いている
  @db.effects(createRow)
  export op addIfNew(row: Row) reads rows;
  // @db.effects の op が、自分で、並べていない効果を書いている
  @db.effects(createRow)
  export op addAndCopy(row: Row) effects createCopy;

  // ---- @db.effects に効果が一つもない ----

  @db.effects()
  export op nothing();

  // ---- 通るもの ----

  // デコレータが運ぶものを、自分でも書くのは、食い違いではない
  @db.find(rows, "id")
  export op findRow(id: string): Row? reads rows;
  @db.effects(createRow)
  export op addRow(row: Row) effects createRow;
}
