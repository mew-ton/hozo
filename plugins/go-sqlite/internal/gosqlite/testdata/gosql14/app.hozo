// GOSQL-14 の入力だったもの。db の op のデコレータ（@db.find、@db.list、@db.effects を op に付ける形）は、言語と語彙からなくなった:
// 表から引くのは @db.find / @db.list を付けた read、表に書くのは @db.insert / @db.update / @db.delete を付けた効果で、op は
// それを配線で呼ぶ（docs/check.md「状態に触れるもの」、docs/vocab.md「`db` の read と効果」）。「op が、デコレータの言う以外の
// ものを読み書きする」という食い違いは、書けない。ここには、同じ op を、今の書き方で書いたものだけを残す。

namespace app {
  model Row { @db.key @db.text id: string; @db.text note: string; }
  @db.table state rows: list<Row>;
  @db.table state copies: list<Row>;

  @db.insert
  effect createRow(row: Row) on rows.post;
  @db.insert
  effect createCopy(row: Row) on copies.post;
  @db.delete
  effect deleteRow(id: string) on rows.delete;

  @db.find
  read rowById(id: string): Row? on rows;
  @db.list
  read allRows(): Row[] on rows;
  @db.list
  read allCopies(): Row[] on copies;

  // 引いてから消す
  export op takeRow(id: string): Row? effects deleteRow {
    const row = rowById(id);
    deleteRow(id);
    return row;
  }
  // 二つの表を引く
  op join(a: Row[], b: Row[]): Row[];
  export op listBoth(): Row[] reads rows, copies {
    const a = allRows();
    const b = allCopies();
    return join(a, b);
  }
  // 二つの表に足す
  @db.transaction
  export op addAndCopy(row: Row) effects createRow, createCopy {
    createRow(row);
    createCopy(row);
  }
  export op findRow(id: string): Row? reads rows {
    return rowById(id);
  }
  export op addRow(row: Row) effects createRow {
    createRow(row);
  }
}
