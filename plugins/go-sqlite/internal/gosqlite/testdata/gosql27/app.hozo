// GOSQL-27（docs/plugin-go-sqlite.md「read の中身」）: @db.latest の列のしまい方が、@db.datetime / @db.int / @db.float のどれでもない。
// 位置は read。

namespace app {
  model Row {
    @db.key @db.text id: string;
    @db.bool flag: boolean;
    @db.json tags: string[];
    @db.text note: string?;
    @db.datetime at: datetime;
    @db.int rank: int;
    @db.int span: duration;
    @db.float score: float?;
  }
  @db.table state rows: list<Row>;

  // @db.text
  @db.list
  @db.latest("id")
  read fn byId(): Row[] reads rows;
  @db.find
  @db.latest("note")
  read fn lastNoted(): Row? reads rows;
  // @db.bool
  @db.list
  @db.latest("flag")
  read fn byFlag(): Row[] reads rows;
  // @db.json
  @db.list
  @db.latest("tags")
  read fn byTags(): Row[] reads rows;

  // 通るもの: @db.datetime、@db.int（duration も）、@db.float（省略可能でも）
  @db.list
  @db.latest("at")
  read fn newest(): Row[] reads rows;
  @db.list
  @db.latest("rank")
  read fn ranked(): Row[] reads rows;
  @db.list
  @db.latest("span")
  read fn longest(): Row[] reads rows;
  @db.find
  @db.latest("score")
  read fn best(): Row? reads rows;
}
