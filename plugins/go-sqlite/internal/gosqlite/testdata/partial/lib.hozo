// docs/plugin-go-sqlite.md「状態ごとの型」: 規則に当たらない op があるとき、その型は、その op のメソッドを持たず、
// var _ を出さない。当たらなかった op ごとに warning。各 op の上のコメントが、当たらない理由。

/** 図書館 */
namespace lib {
  scalar BookId extends string;

  model Book {
    @db.key id: BookId;
    title: string;
    author: string;
    pages: int;
    lentAt: Time?;
  }

  /** キーのない model */
  model Note { text: string; stars: int; }

  /** キーだけの model */
  model Mark { @db.key book: BookId; @db.key page: int; }

  @db state books: list<Book>;
  @db state notes: list<Note>;
  @db state marks: list<Mark>;
  /** op がどれも規則に当たる状態（var _ を出す） */
  @db state archive: list<Book>;

  // ---- books ----

  // 当たる（一行を引く）
  export op findBook(id: BookId): Book? reads books;
  // 当たらない: 引数の型 string と等しい型のフィールドが二つ（title、author）
  export op findByTitle(title: string): Book? reads books;
  // 当たらない: 対応した列（pages）が @db.key でも @db.unique でもない（戻り値が Book[] なら当たる）
  export op findByPages(pages: int): Book? reads books;
  // 当たらない: 戻り値が Book? でも Book[] でもない
  export op countBooks(): int reads books;
  // 当たらない: 引数の型 Time と等しい型のフィールドがない（lentAt は Time?）
  export op lentAt(at: Time): Book[] reads books;
  // 当たらない: 引数の一つ（newest）が列に対応しない
  export op recent(id: BookId, newest: boolean): Book[] reads books;

  effect createBook on books.post;
  effect deleteBook on books.delete;
  effect refill on books: Empty -> HasItems;

  // 当たる（足す）
  export op addBook(book: Book) effects createBook;
  // 当たらない: 引数が M の一つだけでない
  export op addBookAt(book: Book, at: Time) effects createBook;
  // 当たらない: 戻り値がある
  export op addAndCount(book: Book): int effects createBook;
  // 当たらない: 引数が M でない
  export op addById(id: BookId) effects createBook;
  // 当たらない: 引数がない（消す op は、引数が一つ以上）
  export op clearBooks() effects deleteBook;
  // 当たらない: reads と効果の両方を持つ
  export op takeBook(id: BookId): Book? reads books effects deleteBook;
  // 当たらない: 遷移を宛先にする効果
  export op restock(book: Book) effects refill;

  // ---- notes ----

  effect updateNote on notes.put;
  // 当たらない: M が @db.key を持たない
  export op saveNote(note: Note) effects updateNote;

  // ---- marks ----

  effect updateMark on marks.put;
  // 当たらない: M に、キーでない列がない（書き換えるものがない）
  export op saveMark(mark: Mark) effects updateMark;

  // ---- archive ----

  effect archiveBook on archive.post;
  // 当たる
  export op archiveOne(book: Book) effects archiveBook;
}
