// docs/plugin-go-sqlite.md「状態ごとの型」: db の語彙のデコレータを付けていない read と効果があるとき、その型は、そのメソッドを
// 持たず、var _ を出さない（人が、型を埋め込んで書き足す。足りなければ、基底の New に渡す行がコンパイルできない）。warning も出さない。
// 表の状態でない状態の単位と、述語で決まる状態の分類の単位の型は、出さない。

/** 図書館 */
namespace lib {
  scalar BookId extends string;

  model Book {
    @db.key @db.text id: BookId;
    @db.text title: string;
    @db.int pages: int;
  }

  model Note {
    @db.text text: string;
    @db.int stars: int;
  }

  model Stamp {
    @db.datetime at: datetime;
  }

  @db.table state books: list<Book>;
  @db.table state notes: list<Note>;
  /** 行を受け取るメソッド（@db.insert、@db.update、Post）を持たない表: dbScan<Model> だけが出て、dbArgs<Model> は出ない */
  @db.table state stamps: list<Stamp>;
  /** `@db.table` のない状態は、表にならない（単位は、人が書く） */
  state drafts: list<Note>;

  // ---- books: デコレータを付けた read と効果と、付けていない read と効果 ----

  @db.find
  read fn bookById(id: BookId): Book? reads books;

  /** 付けていない: 件数と位置は、この語彙で言えない */
  read fn newestBooks(limit: int): Book[] reads books;

  /** 付けていない: 行でないものを引く */
  read fn countBooks(): int reads books;

  @db.insert
  effect fn createBook(book: Book): effects books.post;

  /** 付けていない: 条件に合う行の、一つの列だけの書き換え */
  effect fn retitle(id: BookId, title: string): effects books.put;

  /** 付けていない: すべての行を消す */
  effect fn clearBooks(): effects books.delete;

  // ---- notes: read は付け、効果は付けていない ----

  @db.list
  read fn notesWith(stars: int): Note[] reads notes;

  /** 基底の状態の遷移を宛先にする効果には、db のデコレータを付けられない（付ければ GOSQL-11）。人が書く */
  effect fn firstNote(note: Note): effects notes as Empty -> HasItems;

  // ---- stamps: すべてに付けた（消すだけ） ----

  @db.delete
  effect fn dropStamp(at: datetime): effects stamps.delete;

  // ---- drafts: 表でない状態の read と効果は、どの型にも出ない ----

  read fn draftsWith(stars: int): Note[] reads drafts;
  effect fn createDraft(note: Note): effects drafts.post;

  // ---- 述語で決まる状態の分類の単位（LendingState）: 型は出さない ----

  /** 貸し出しの進み具合 */
  classify Lending of books, notes {
    /** 貸し出していない */
    Free;
    /** 貸し出している */
    Lent;
  }

  /** 状態の分類の遷移を宛先にする効果。人が書く */
  effect fn lend(book: Book): effects Lending as Free -> Lent;

  // ---- op: read と効果を呼ぶ配線 ----

  /** 本を引く */
  export fn findBook(id: BookId): Book? {
    return bookById(id);
  }

  /** 新しい本 */
  export fn newest(limit: int): Book[] {
    return newestBooks(limit);
  }

  /** 本を足す */
  export fn addBook(book: Book) {
    createBook(book);
  }

  /** 本の題を変える */
  export fn rename(id: BookId, title: string) {
    retitle(id, title);
  }

  /** 本を足して、題を変える。人が書いた効果（retitle）も、Conn を通せば、同じトランザクションに入る */
  @db.transaction
  export fn addRenamed(book: Book, title: string) {
    createBook(book);
    retitle(book.id, title);
  }

  /** 題を変えてから、本を足す。後の効果が失敗すれば、人が書いた効果のしたことも残らない */
  @db.transaction
  export fn renameThenAdd(id: BookId, title: string, book: Book) {
    retitle(id, title);
    createBook(book);
  }

  /** 下書きを足す */
  export fn draft(note: Note) {
    createDraft(note);
  }

  /** 本を貸す */
  export fn lendBook(book: Book) {
    lend(book);
  }
}
