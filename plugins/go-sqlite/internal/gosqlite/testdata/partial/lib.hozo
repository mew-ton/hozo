// docs/plugin-go-sqlite.md「状態ごとの型」「状態をまたぐ単位の型」: db の語彙のデコレータを付けていない op があるとき、その型は、
// その op のメソッドを持たず、var _ を出さない。warning も出さない。述語で決まる状態の分類の単位の命令は <C>Table、
// 宛先の単位が分かれる op は SharedTable。

/** 図書館 */
namespace lib {
  scalar BookId extends string;

  model Book {
    @db.key @db.text id: BookId;
    @db.text title: string;
    @db.int pages: int;
  }

  model Note { @db.text text: string; @db.int stars: int; }

  model Archived { @db.key @db.text id: BookId; }

  model Loan {
    @db.key @db.ref(Book) @db.text book: BookId;
    @db.text member: string;
  }

  @db.table(Book) state books: list<Book>;
  @db.table(Note) state notes: list<Note>;
  @db.table(Loan) state loans: list<Loan>;
  /** op を一つも持たない表の状態（句は「この単位では、すべて」。var _ を出す）。命令は、分類 Shelving の単位に置かれる */
  @db.table(Archived) state archive: list<Archived>;
  /** @db.table のない状態は、表にならない（単位は、人が書く） */
  state drafts: list<Note>;

  // ---- books: デコレータを付けた op と、付けていない op ----

  @db.find(books, "id")
  export op findBook(id: BookId): Book?;
  // 付けていない: 順序と件数は、デコレータで言えない
  export op newestBooks(limit: int): Book[] reads books;
  // 付けていない
  export op countBooks(): int reads books;

  @db.insert(books)
  effect createBook on books.post;
  /** デコレータを付けていない効果 */
  effect deleteBook on books.delete;

  @db.effects(createBook)
  export op addBook(book: Book);
  // 付けていない
  export op clearBooks() effects deleteBook;

  // ---- notes: 基底の状態の遷移を宛先にする効果。操作の名前との照合はなく、表が、効果の書き込む状態にあればよい ----

  @db.insert(notes)
  effect firstNote on notes: Empty -> HasItems;
  @db.delete(notes, "text")
  effect lastNote on notes: HasItems -> Empty;

  @db.effects(firstNote)
  export op startNotes(note: Note);
  @db.effects(lastNote, firstNote)
  export op swapNote(text: string, note: Note);

  // ---- drafts: 表でない状態の op は、どの型にも出ない ----

  export op listDrafts(): Note[] reads drafts;

  // ---- 述語で決まる状態の分類の単位: <C>Table ----

  /** 貸し出しの進み具合（books と loans にまたがる） */
  classify Lending of books, loans {
    /** 貸し出していない */
    Free;
    /** 貸し出している */
    Lent;
  }

  /** 状態の分類の遷移を宛先にする効果: 表（loans）は、効果の書き込む状態（books、loans）の一つ */
  @db.insert(loans)
  effect lend on Lending: Free -> Lent;
  @db.update(books)
  effect retitle on Lending: any -> any;
  effect giveBack on Lending: Lent -> Free;

  @db.effects(lend)
  export op lendBook(loan: Loan);
  // 二つの効果の宛先の単位が、どちらも Lending: <C>Table のメソッドで、一つのトランザクション
  @db.effects(retitle, lend)
  export op lendRenamed(book: Book, loan: Loan);
  // 付けていない
  export op returnBook(book: BookId) effects giveBack;

  /** 命令のすべてにデコレータの付いた、述語で決まる状態の分類（句は「この単位では、すべて」。それでも var _ は出さない） */
  classify Shelving of archive {
    Open;
    Closed;
  }
  @db.insert(archive)
  effect shelve on Shelving: Open -> Closed;
  @db.effects(shelve)
  export op shelveBook(book: Archived);

  // ---- SharedState: 宛先の単位が分かれる op と、複数の状態を読む op ----

  // 宛先の単位が books と notes: SharedTable のメソッド
  @db.effects(createBook, firstNote)
  export op addWithNote(book: Book, note: Note);
  // 宛先の単位が books と Lending（Lending は books にもまたがるが、単位は別）
  @db.effects(createBook, lend)
  export op addAndLend(book: Book, loan: Loan);
  // 付けていない: 複数の状態を読む葉は、SharedState の op（読む op のデコレータは、表一つしか読めない）
  export op overdue(): Book[] reads books, loans;
}
