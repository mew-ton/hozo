// GOSQL-8（docs/plugin-go-sqlite.md「診断」）: デコレータの引数の列の名前が、その表の model のフィールドにない。
// 位置はデコレータを付けた宣言。

namespace app {
  model Row { @db.key @db.text id: string; @db.text note: string; }
  @db.table state rows: list<Row>;

  // @db.find、@db.list
  @db.find
  read findRowRow(ID: string): Row? on rows;
  export op findRow(id: string): Row? {
    return findRowRow(id);
  }
  @db.list
  read listRowsRows(notes: string): Row[] on rows;
  export op listRows(note: string): Row[] {
    return listRowsRows(note);
  }
  // 空の名前
  @db.list
  read listAllRows(): Row[] on rows;
  export op listAll(note: string): Row[] {
    return listAllRows();
  }

  // @db.delete（op に並べられていない効果のデコレータも、同じに確かめる）
  @db.delete
  effect deleteRow(key: string) on rows.delete;
  @db.delete
  effect deleteByRowid(rowid: string) on rows.delete;
  export op removeRow(id: string) {
    deleteRow(id);
  }

  // 通るもの
  @db.list
  read listByNoteRows(note: string): Row[] on rows;
  export op listByNote(note: string): Row[] {
    return listByNoteRows(note);
  }
}
