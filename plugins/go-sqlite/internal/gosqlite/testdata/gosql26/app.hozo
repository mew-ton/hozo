// GOSQL-26（docs/plugin-go-sqlite.md「read の中身」）: @db.where のリテラルが、列の型（scalar は元の核の型。省略可能は外して見る）に
// 渡せない。しまい方が @db.time と @db.json の列には、渡せるリテラルがない。位置は read。

namespace app {
  scalar Name extends string;
  scalar Count extends int;
  model Tag { name: string; }
  model Row {
    @db.key @db.text id: string;
    @db.text name: Name;
    @db.int count: Count;
    @db.int span: Duration;
    @db.float ratio: float;
    @db.bool flag: boolean;
    @db.time at: Time;
    @db.json tags: string[];
    @db.json tag: Tag;
    @db.text note: string?;
    @db.int rank: int?;
  }
  @db.table state rows: list<Row>;

  // 文字列の列に、整数、真偽値
  @db.list
  @db.where("id", 1)
  read fn intToText(): Row[] on rows;
  @db.list
  @db.where("name", true)
  read fn boolToName(): Row[] on rows;
  // 整数の列に、文字列、小数
  @db.list
  @db.where("count", "1")
  read fn textToInt(): Row[] on rows;
  @db.list
  @db.where("count", 1.5)
  read fn floatToInt(): Row[] on rows;
  // 小数の列に、文字列
  @db.list
  @db.where("ratio", "0.5")
  read fn textToFloat(): Row[] on rows;
  // 真偽値の列に、整数、文字列
  @db.list
  @db.where("flag", 1)
  read fn intToBool(): Row[] on rows;
  @db.list
  @db.where("flag", "true")
  read fn textToBool(): Row[] on rows;
  // Duration の列（@db.int）に、整数
  @db.list
  @db.where("span", 60)
  read fn intToDuration(): Row[] on rows;
  // @db.time の列には、渡せるリテラルがない
  @db.list
  @db.where("at", "2026-01-02T03:04:05Z")
  read fn textToTime(): Row[] on rows;
  // @db.json の列には、渡せるリテラルがない
  @db.list
  @db.where("tags", "[]")
  read fn textToJSON(): Row[] on rows;
  @db.list
  @db.where("tag", "{}")
  read fn textToModel(): Row[] on rows;
  // 省略可能は、外して見る
  @db.list
  @db.where("note", 0)
  read fn intToMaybeText(): Row[] on rows;
  // 二つの @db.where の、一つだけが渡せない
  @db.list
  @db.where("name", "n")
  @db.where("rank", "high")
  read fn mixed(): Row[] on rows;

  // ---- 通るもの ----

  @db.list
  @db.where("id", "a")
  @db.where("name", "n")
  @db.where("count", 1)
  @db.where("ratio", 1)
  @db.where("flag", false)
  @db.where("note", "x")
  @db.where("rank", -2)
  read fn fits(): Row[] on rows;
  @db.list
  @db.where("ratio", 0.5)
  read fn floatToFloat(): Row[] on rows;
}
