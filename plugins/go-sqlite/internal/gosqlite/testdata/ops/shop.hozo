// docs/plugin-go-sqlite.md「op の中身」「列と引数の型」「トランザクション」「メソッドの形とコメント」の各行。
// 各 op の上のコメントが、その op が確かめる行。どの op も db の語彙のデコレータを持つ（どの型も、基底の単位を満たす）。

/** 店の在庫 */
namespace shop {
  scalar ItemId extends string;
  scalar Sku extends string;
  scalar Shelf extends int;

  model Item {
    @db.key @db.text id: ItemId;
    @db.unique @db.text sku: Sku;
    @db.int shelf: Shelf;
    @db.text name: string;
    @db.bool active: boolean;
    @db.time addedAt: Time;
    @db.json tags: string[];
    /** 値がなくてよい列 */
    @db.text note: string?;
  }

  /** キーが二つ */
  model Stock {
    @db.key @db.text item: ItemId;
    @db.key @db.int shelf: Shelf;
    @db.int count: int;
  }

  /** 棚卸しの記録（キーがない） */
  model Audit {
    @db.text item: ItemId;
    @db.time at: Time;
  }

  @db.table state items: list<Item>;
  @db.table state stock: list<Stock>;
  @db.table state audits: list<Audit>;

  // ---- 読む op ----

  // @db.find: 列が、ただ一つの @db.key
  @db.find
  read findItemRow(id: ItemId): Item? on items;
  export op findItem(id: ItemId): Item? {
    return findItemRow(id);
  }
  // @db.find: 列が @db.unique
  @db.find
  read findBySkuRow(sku: Sku): Item? on items;
  export op findBySku(sku: Sku): Item? {
    return findBySkuRow(sku);
  }
  // @db.list: 列を渡さない（引数はない）
  @db.list
  read listItemsRows(): Item[] on items;
  export op listItems(): Item[] {
    return listItemsRows();
  }
  // @db.list: @db.int の列
  @db.list
  read listOnShelfRows(shelf: Shelf): Item[] on items;
  export op listOnShelf(shelf: Shelf): Item[] {
    return listOnShelfRows(shelf);
  }
  // @db.list: @db.bool の列
  @db.list
  read listActiveRows(active: boolean): Item[] on items;
  export op listActive(active: boolean): Item[] {
    return listActiveRows(active);
  }
  // @db.list: @db.time の列。引数の名前は、列の名前と違ってよい
  @db.list
  read listAddedAtRows(addedAt: Time): Item[] on items;
  export op listAddedAt(at: Time): Item[] {
    return listAddedAtRows(at);
  }
  // @db.list: @db.json の列
  @db.list
  read listTaggedRows(tags: string[]): Item[] on items;
  export op listTagged(tags: string[]): Item[] {
    return listTaggedRows(tags);
  }
  // @db.list: 複数の @db.key の一つ（@db.find にはできない列でも、@db.list ならよい）
  @db.list
  read listStockRows(item: ItemId): Stock[] on stock;
  export op listStock(item: ItemId): Stock[] {
    return listStockRows(item);
  }
  // 列と引数の型: T? の列に、T の引数（値のない行は、どの値にも合わない）
  @db.list
  read listNotedRows(note: string): Item[] on items;
  export op listNoted(note: string): Item[] {
    return listNotedRows(note);
  }
  // 列と引数の型: T? の列に、T? の引数（値がなければ、値のない行）
  @db.list
  read listByNoteRows(note: string?): Item[] on items;
  export op listByNote(note: string?): Item[] {
    return listByNoteRows(note);
  }

  // ---- 効果: 表に何をするか ----

  @db.insert
  effect createItem(row: Item) on items.post;
  @db.update
  effect updateItem(row: Item) on items.put;
  @db.delete
  effect deleteItem(id: ItemId) on items.delete;
  @db.delete
  effect deleteNoted(note: string?) on items.delete;
  @db.insert
  effect createStock(row: Stock) on stock.post;
  @db.update
  effect updateStock(row: Stock) on stock.put;
  @db.delete
  effect deleteStock(item: ItemId) on stock.delete;
  @db.insert
  effect createAudit(row: Audit) on audits.post;
  /** op に並べられていない効果のデコレータも、同じに確かめる（何も出さない） */
  @db.delete
  effect deleteAudit(item: ItemId) on audits.delete;

  // ---- 書く op: 効果が一つ ----

  // @db.insert
  export op addItem(item: Item) {
    createItem(item);
  }
  export op addStock(stock: Stock) {
    createStock(stock);
  }
  // @db.update: キーが一つ
  export op saveItem(item: Item) {
    updateItem(item);
  }
  // @db.update: キーが二つ
  export op saveStock(stock: Stock) {
    updateStock(stock);
  }
  // @db.delete
  export op removeItem(id: ItemId) {
    deleteItem(id);
  }
  // @db.delete: @db.nullable の列と、T? の引数（値がなければ、値のない行を消す）
  export op removeNoted(note: string?) {
    deleteNoted(note);
  }

  // ---- 書く op: 効果が二つ以上（一つのトランザクション） ----

  // 宛先の単位が同じ: <状態>Table のメソッド。同じ効果を二度並べてもよい
  @db.transaction
  export op addTwo(first: Item, second: Item) {
    createItem(first);
    createItem(second);
  }
  // 三つの効果のデコレータを、一つの状態に（@db.delete は、行の値を作らない）
  @db.transaction
  export op replaceItem(old: ItemId, item: Item, other: Item) {
    deleteItem(old);
    createItem(item);
    updateItem(other);
  }
  // @db.delete だけ
  @db.transaction
  export op purge(id: ItemId, note: string?) {
    deleteItem(id);
    deleteNoted(note);
  }
  // 宛先の単位が分かれる: SharedTable のメソッド
  @db.transaction
  export op receive(item: Item, stock: Stock, audit: Audit) {
    createItem(item);
    createStock(stock);
    createAudit(audit);
  }
  @db.transaction
  export op discontinue(id: ItemId, item: ItemId) {
    deleteItem(id);
    deleteStock(item);
  }
  @db.transaction
  export op recount(stock: Stock, audit: Audit) {
    updateStock(stock);
    createAudit(audit);
  }
}
