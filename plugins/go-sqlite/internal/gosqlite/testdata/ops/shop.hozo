// docs/plugin-go-sqlite.md「op の中身」「列と引数の型」「トランザクション」「メソッドの形とコメント」の各行。
// 各 op の上のコメントが、その op が確かめる行。どの op も db の語彙のデコレータを持つ（どの型も、基底の単位を満たす）。

/** 店の在庫 */
namespace shop {
  scalar ItemId extends string;
  scalar Sku extends string;
  scalar Shelf extends int;

  model Item {
    @db.key @db.text id: ItemId;
    @db.unique @db.text sku: Sku;
    @db.int shelf: Shelf;
    @db.text name: string;
    @db.bool active: boolean;
    @db.time addedAt: Time;
    @db.json tags: string[];
    /** 値がなくてよい列 */
    @db.nullable @db.text note: string?;
  }

  /** キーが二つ */
  model Stock {
    @db.key @db.text item: ItemId;
    @db.key @db.int shelf: Shelf;
    @db.int count: int;
  }

  /** 棚卸しの記録（キーがない） */
  model Audit {
    @db.text item: ItemId;
    @db.time at: Time;
  }

  @db.table(Item) state items: list<Item>;
  @db.table(Stock) state stock: list<Stock>;
  @db.table(Audit) state audits: list<Audit>;

  // ---- 読む op ----

  // @db.find: 列が、ただ一つの @db.key
  @db.find(items, "id")
  export op findItem(id: ItemId): Item?;
  // @db.find: 列が @db.unique
  @db.find(items, "sku")
  export op findBySku(sku: Sku): Item?;
  // @db.list: 列を渡さない（引数はない）
  @db.list(items)
  export op listItems(): Item[];
  // @db.list: @db.int の列
  @db.list(items, "shelf")
  export op listOnShelf(shelf: Shelf): Item[];
  // @db.list: @db.bool の列
  @db.list(items, "active")
  export op listActive(active: boolean): Item[];
  // @db.list: @db.time の列。引数の名前は、列の名前と違ってよい
  @db.list(items, "addedAt")
  export op listAddedAt(at: Time): Item[];
  // @db.list: @db.json の列
  @db.list(items, "tags")
  export op listTagged(tags: string[]): Item[];
  // @db.list: 複数の @db.key の一つ（@db.find にはできない列でも、@db.list ならよい）
  @db.list(stock, "item")
  export op listStock(item: ItemId): Stock[];
  // 列と引数の型: T? の列に、T の引数（値のない行は、どの値にも合わない）
  @db.list(items, "note")
  export op listNoted(note: string): Item[];
  // 列と引数の型: T? の列に、T? の引数（値がなければ、値のない行）
  @db.list(items, "note")
  export op listByNote(note: string?): Item[];

  // ---- 効果: 表に何をするか ----

  @db.insert(items)
  effect createItem() on items.post;
  @db.update(items)
  effect updateItem() on items.put;
  @db.delete(items, "id")
  effect deleteItem() on items.delete;
  @db.delete(items, "note")
  effect deleteNoted() on items.delete;
  @db.insert(stock)
  effect createStock() on stock.post;
  @db.update(stock)
  effect updateStock() on stock.put;
  @db.delete(stock, "item")
  effect deleteStock() on stock.delete;
  @db.insert(audits)
  effect createAudit() on audits.post;
  /** op に並べられていない効果のデコレータも、同じに確かめる（何も出さない） */
  @db.delete(audits, "item")
  effect deleteAudit() on audits.delete;

  // ---- 書く op: 効果が一つ ----

  // @db.insert
  @db.effects(createItem)
  export op addItem(item: Item);
  @db.effects(createStock)
  export op addStock(stock: Stock);
  // @db.update: キーが一つ
  @db.effects(updateItem)
  export op saveItem(item: Item);
  // @db.update: キーが二つ
  @db.effects(updateStock)
  export op saveStock(stock: Stock);
  // @db.delete
  @db.effects(deleteItem)
  export op removeItem(id: ItemId);
  // @db.delete: @db.nullable の列と、T? の引数（値がなければ、値のない行を消す）
  @db.effects(deleteNoted)
  export op removeNoted(note: string?);

  // ---- 書く op: 効果が二つ以上（一つのトランザクション） ----

  // 宛先の単位が同じ: <状態>Table のメソッド。同じ効果を二度並べてもよい
  @db.effects(createItem, createItem)
  export op addTwo(first: Item, second: Item);
  // 三つの効果のデコレータを、一つの状態に（@db.delete は、行の値を作らない）
  @db.effects(deleteItem, createItem, updateItem)
  export op replaceItem(old: ItemId, item: Item, other: Item);
  // @db.delete だけ
  @db.effects(deleteItem, deleteNoted)
  export op purge(id: ItemId, note: string?);
  // 宛先の単位が分かれる: SharedTable のメソッド
  @db.effects(createItem, createStock, createAudit)
  export op receive(item: Item, stock: Stock, audit: Audit);
  @db.effects(deleteItem, deleteStock)
  export op discontinue(id: ItemId, item: ItemId);
  @db.effects(updateStock, createAudit)
  export op recount(stock: Stock, audit: Audit);
}
