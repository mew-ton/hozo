// docs/plugin-go-sqlite.md「補助」: メソッドの引数の名前が、このファイルが使う名前（レシーバの t、ctx、args、args<数>、tx、err、
// import するパッケージの名前、このファイルの非公開の名前）と当たれば、末尾に _。
// vault は内部の op（touch）を持つので、出力は内側のフォルダと入口に分かれる。db.go は入口のパッケージで、型は入口の別名で書く。

// パッケージの名前が、dbArgs<Model> / dbScan<Model> の中の局所の名前（row、r）と同じ名前空間
namespace row {
  model Entry { @db.key @db.text id: string; @db.time at: Time; }
}

namespace r {
  model Entry { @db.key @db.int code: int; @db.json tags: string[]; }
}

/** 当たる名前を持つ名前空間 */
namespace vault {
  scalar Key extends string;
  scalar Num extends int;
  scalar Ratio extends float;
  scalar Flag extends boolean;

  model Tag { name: string; }

  /** フィールドの名前が、Go の予約語、事前宣言の識別子、import するパッケージの名前、このファイルの局所の名前と同じ */
  model Secret {
    @db.key @db.text row: Key;
    @db.int r: Num;
    @db.float err: Ratio;
    @db.bool data: Flag;
    @db.time type: Time;
    @db.json string: Tag[];
    @db.json json: Record<string, string>;
    @db.json any: Tag?;
    @db.time time: Time?;
    @db.int sql: Duration;
  }

  @db.table state secrets: list<Secret>;
  /** 同じ名前の model（row.Entry と r.Entry）: 補助の名前は、後の方に 2 を付ける */
  @db.table state entriesA: list<row.Entry>;
  @db.table state entriesB: list<r.Entry>;

  // 引数の名前がレシーバの t と当たる
  @db.find
  read findRow(row: Key): Secret? on secrets;
  export op find(t: Key): Secret? {
    return findRow(t);
  }
  // 引数の名前が ctx と当たる
  @db.list
  read scanRows(r: Num): Secret[] on secrets;
  export op scan(ctx: Num): Secret[] {
    return scanRows(ctx);
  }
  // 引数の名前が err と当たる
  @db.list
  read nearRows(err: Ratio): Secret[] on secrets;
  export op near(err: Ratio): Secret[] {
    return nearRows(err);
  }
  // 引数の名前が import するパッケージの名前と当たる
  @db.list
  read listAtRows(type: Time): Secret[] on secrets;
  export op listAt(time: Time): Secret[] {
    return listAtRows(time);
  }
  @db.list
  read listJsonRows(json: Record<string, string>): Secret[] on secrets;
  export op listJson(json: Record<string, string>): Secret[] {
    return listJsonRows(json);
  }
  @db.list
  read listSqlRows(sql: Duration): Secret[] on secrets;
  export op listSql(sql: Duration): Secret[] {
    return listSqlRows(sql);
  }
  @db.list
  read listDataRows(data: Flag): Secret[] on secrets;
  export op listData(reflect: Flag): Secret[] {
    return listDataRows(reflect);
  }
  // 引数の名前が、このファイルの非公開の名前と当たる
  @db.find
  read openRow(row: Key): Secret? on secrets;
  export op open(dbGet: Key): Secret? {
    return openRow(dbGet);
  }
  @db.list
  read countRows(r: Num): Secret[] on secrets;
  export op count(dbScanSecret: Num): Secret[] {
    return countRows(dbScanSecret);
  }
  // 内部の op（export がない）: 状態の単位のメソッドは、export の有無によらず公開
  @db.find
  read touchRow(row: Key): Secret? on secrets;
  op touch(row: Key): Secret? {
    return touchRow(row);
  }

  @db.insert
  effect createSecret(row: Secret) on secrets.post;
  @db.update
  effect updateSecret(row: Secret) on secrets.put;
  @db.delete
  effect deleteSecret(row: Key) on secrets.delete;
  @db.delete
  effect deleteByNum(r: Num) on secrets.delete;

  // 引数の名前が、行の値の変数 args、err と当たる
  export op add(args: Secret) {
    createSecret(args);
  }
  export op save(err: Secret) {
    updateSecret(err);
  }
  // 引数の名前が、このファイルの非公開の名前、import するパッケージの名前と当たる
  export op drop(dbExec: Key) {
    deleteSecret(dbExec);
  }
  export op dropNum(context: Num) {
    deleteByNum(context);
  }
  // トランザクションの中の名前（args<数>、tx、err、t、ctx）と当たる
  @db.transaction
  export op mix(args1: Secret, tx: Secret, args2: Key, args: Num) {
    createSecret(args1);
    updateSecret(tx);
    deleteSecret(args2);
    deleteByNum(args);
  }
  @db.transaction
  export op mix2(t: Key, ctx: Num, err: Secret) {
    deleteSecret(t);
    deleteByNum(ctx);
    createSecret(err);
  }

  @db.insert
  effect createA(row: row.Entry) on entriesA.post;
  @db.insert
  effect createB(row: r.Entry) on entriesB.post;
  export op addA(entry: row.Entry) {
    createA(entry);
  }
  export op addB(entry: r.Entry) {
    createB(entry);
  }
  // 宛先の単位が分かれる: SharedTable
  @db.transaction
  export op addBoth(row: row.Entry, r: r.Entry) {
    createA(row);
    createB(r);
  }
}
