// docs/plugin-go-sqlite.md「補助」の末尾: メソッドの引数の名前が、このファイルが使う名前（表のメソッドのレシーバ t、継ぎ目の
// メソッドのレシーバ s、ctx、args、err、import するパッケージの名前、このファイルの非公開の名前）と当たれば、末尾に _。
// 補助と継ぎ目のメソッドの中の局所の名前は、import するパッケージの名前と当たれば、当たらなくなるまで末尾に _。
// vault は内部の op（touch）を持つので、出力は内側のフォルダと入口に分かれる。db.go は入口のパッケージで、型は入口の別名で書く。

// パッケージの名前が、dbArgs<Model> / dbScan<Model> の中の局所の名前（row、r）と同じ名前空間。同じ名前の model を持つ
namespace row {
  model Entry { @db.key @db.text id: string; @db.datetime at: datetime; }
}

namespace r {
  model Entry { @db.key @db.int code: int; @db.json tags: string[]; }
}

// パッケージの名前が、継ぎ目のメソッドの中の局所の名前（s、ctx、err、body）と同じ名前空間
namespace s {
  model Mark { n: int; }
}

namespace ctx {
  model Info { n: int; }
}

namespace err {
  model Fault { n: int; }
}

namespace body {
  model Part { n: int; }
}

/** 当たる名前を持つ名前空間 */
namespace vault {
  scalar Key extends string;
  scalar Num extends int;
  scalar Ratio extends float;
  scalar Flag extends boolean;

  model Tag { name: string; }
  model Labels { [name: string]: string; }

  /** フィールドの名前が、Go の予約語、事前宣言の識別子、import するパッケージの名前、このファイルが使う名前と同じ */
  model Secret {
    @db.key @db.text t: Key;
    @db.int ctx: Num;
    @db.float err: Ratio;
    @db.bool args: Flag;
    @db.datetime type: datetime;
    @db.json string: Tag[];
    @db.json json: Labels;
    @db.json any: Tag?;
    @db.datetime time: datetime?;
    @db.int sql: duration;
    @db.text runtime: string;
    @db.text dbGet: string;
    @db.text dbScanSecret: string;
    @db.text s: string;
    @db.text value: string;
  }

  @db.table state secrets: list<Secret>;
  /** 同じ名前の model（row.Entry と r.Entry）: 補助の名前は、後の方に 2 を付ける */
  @db.table state entriesA: list<row.Entry>;
  @db.table state entriesB: list<r.Entry>;

  // ---- read: 引数の名前（= 列の名前）が、このファイルが使う名前と当たる ----

  /** レシーバの t */
  @db.find
  read fn byT(t: Key): Secret? reads secrets;

  /** ctx、err、args */
  @db.list
  read fn byLocals(ctx: Num, err: Ratio, args: Flag): Secret[] reads secrets;

  /** Go の予約語と、事前宣言の識別子（仕様の予約語 string、any、time の列は、引数の名前に書けない） */
  @db.list
  read fn byWords(type: datetime): Secret[] reads secrets;

  /** import するパッケージの名前 */
  @db.list
  read fn byImports(json: Labels, sql: duration, runtime: string): Secret[] reads secrets;

  /** このファイルの非公開の名前と、継ぎ目のメソッドのレシーバ s */
  @db.list
  read fn byPrivates(dbGet: string, dbScanSecret: string, s: string): Secret[] reads secrets;

  // ---- 効果 ----

  /** 行の引数の名前が、行の値の変数 args と当たる */
  @db.insert
  effect fn createSecret(args: Secret): effects secrets.post;

  /** err と当たる */
  @db.update
  effect fn updateSecret(err: Secret): effects secrets.put;

  /** `@db.delete` の引数（= 列の名前） */
  @db.delete
  effect fn deleteSecret(t: Key, ctx: Num, dbGet: string): effects secrets.delete;

  @db.insert
  effect fn createA(row: row.Entry): effects entriesA.post;
  @db.insert
  effect fn createB(r: r.Entry): effects entriesB.post;

  // ---- op ----

  /** 内部の op（export がない）: 出力は、内側のフォルダと入口に分かれる */
  fn touch(t: Key): Secret? {
    return byT(t);
  }

  /** 引く */
  export fn find(t: Key): Secret? {
    return touch(t);
  }

  /** 足す。形で決まる命令 Post（引数の名前は、いつも value） */
  export fn add(secret: Secret) {
    secrets.post(secret);
  }

  /** 継ぎ目のメソッドの引数の名前が、このファイルが使う名前と当たる */
  @db.transaction
  export fn mix(s: Secret, t: Secret, ctx: Key, err: Num, body: string, args: row.Entry, dbTransaction: r.Entry) {
    createSecret(s);
    updateSecret(t);
    deleteSecret(ctx, err, body);
    createA(args);
    createB(dbTransaction);
  }

  // 継ぎ目のメソッドの本体が書く戻り値の型のパッケージの名前が、その中の局所の名前（s、ctx、err、body）と当たる。葉の op
  @db.transaction
  export fn mark(t: Key): s.Mark;
  @db.transaction
  export fn info(t: Key): ctx.Info?;
  @db.transaction
  export fn faults(t: Key): err.Fault[];
  @db.transaction
  export fn part(s: Key, body: Key): body.Part;
  /** 戻り値がない形の局所の変数 err も、パッケージ err と当たる */
  @db.transaction
  export fn report(fault: err.Fault);
}
