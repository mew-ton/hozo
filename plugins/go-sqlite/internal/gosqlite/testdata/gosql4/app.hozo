// GOSQL-4（docs/plugin-go-sqlite.md「診断」）: このトランスパイラの公開の名前（Schema、CreateTables、<状態>Table、
// New<状態>Table）が、N の定義のパッケージの名前と当たる。位置は当たった宣言。

// Schema と CreateTables が、型の名前と当たる
namespace fixed {
  model Schema { @db.key id: string; }
  exception CreateTables;
  @db state rows: list<Schema>;
}

// <状態>Table が scalar と、New<状態>Table が model と、既定値を持つ model の New<Model> と当たる
namespace table {
  model Row { @db.key id: string; }
  scalar UsersTable extends string;
  model NewUsersTable { n: int; }
  model OrdersTable { n: int = 1; }
  @db state users: list<Row>;
  @db state orders: list<Row>;
}

// <状態>Table が、effect の定数、述語で決まる分類のケースの定数、判定関数、union のアームを包む型と当たる
namespace consts {
  model Row { @db.key id: string; }
  @db state effectLog: list<Row>;
  effect logTable on effectLog.post;
  @db state kind: list<Row>;
  classify Kind of string {
    Table;
    Other;
  }
  @db state classifyKinds: list<Row>;
  classify KindsTable of int {
    Small;
    Large;
  }
  @db state shape: list<Row>;
  union Shape { Table: string; Circle: int; }
}

// このトランスパイラの公開の名前どうし: 状態 users の New<状態>Table と、状態 newUsers の <状態>Table
namespace own {
  model Row { @db.key id: string; }
  @db state users: list<Row>;
  @db state newUsers: list<Row>;
}

// 当たらない名前空間には、出ない
namespace clean {
  model Row { @db.key id: string; }
  @db state users: list<Row>;
}
