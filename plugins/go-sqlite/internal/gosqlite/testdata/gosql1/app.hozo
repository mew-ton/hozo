// GOSQL-1（docs/plugin-go-sqlite.md「表」）: @db.table(M) の付いた状態の要素の型が、M と等しくない（要素が model でないときを含む）。
// 位置は状態。

namespace app {
  scalar Id extends string;
  model Row { @db.key @db.text id: Id; }
  /** 形は同じでも、別の model */
  model Other { @db.key @db.text id: Id; }
  /** Row を継承した model も、別の model */
  model Wide extends Row { @db.text note: string; }

  // 核の型
  @db.table(Row) state names: list<string>;
  // scalar
  @db.table(Row) state ids: list<Id>;
  // array
  @db.table(Row) state groups: list<Row[]>;
  // 別の model
  @db.table(Row) state others: list<Other>;
  // 継承した model
  @db.table(Row) state wides: list<Wide>;
  // 等しければ通る
  @db.table(Row) state rows: list<Row>;
  @db.table(Wide) state all: list<Wide>;

  // 表にならなかった状態を名指しするデコレータは、重ねて報告しない
  @db.find(names, "id")
  export op findName(id: Id): Row?;
  @db.insert(others)
  effect createOther on others.post;
  @db.effects(createOther)
  export op addOther(other: Other);
}
