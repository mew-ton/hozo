// GOSQL-1（docs/plugin-go-sqlite.md「表」）: @db.table(M) の付いた状態の要素の型が、M と等しくない（要素が model でないときを含む）。
// 位置は状態。

namespace app {
  scalar Id extends string;
  model Row { @db.key @db.text id: Id; }
  /** 形は同じでも、別の model */
  model Other { @db.key @db.text id: Id; }
  /** Row を継承した model も、別の model */
  model Wide extends Row { @db.text note: string; }

  // 核の型
  @db.table state names: list<string>;
  // scalar
  @db.table state ids: list<Id>;
  // array
  @db.table state groups: list<Row[]>;
  // 別の model
  @db.table state others: list<Other>;
  // 継承した model
  @db.table state wides: list<Wide>;
  // 等しければ通る
  @db.table state rows: list<Row>;
  @db.table state all: list<Wide>;

  // 表にならなかった状態を名指しするデコレータは、重ねて報告しない
  @db.find
  read findNameRow(id: Id): Row? on names;
  export op findName(id: Id): Row? {
    return findNameRow(id);
  }
  @db.insert
  effect createOther(row: Other) on others.post;
  export op addOther(other: Other) {
    createOther(other);
  }
}
