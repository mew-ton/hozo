// docs/plugin-go-sqlite.md「効果の中身」の表の各行と、「状態ごとの型」の、形で決まる命令 Post、「メソッドの形とコメント」の効果の句。
// 表は、効果の宛先の状態。@db.insert と @db.update の引数は、表の model の行一つ。@db.delete の引数は、条件（名前が列）。
// @db.conflict: 一意の制約（キーと、@db.unique）に当たったら、名指しした例外を返す（@db.insert と、@db.update）。

/** 倉庫 */
namespace depot {
  scalar Code extends string;

  model Crate {
    @db.key @db.text code: Code;
    @db.text label: string;
    @db.int weight: int;
    /** 値がなくてよい列 */
    @db.text zone: string?;
    @db.json contents: string[];
  }

  /** キーが二つ */
  model Slot {
    @db.key @db.text aisle: string;
    @db.key @db.int level: int;
    @db.text crate: Code?;
    @db.bool locked: boolean;
  }

  /** キーがない */
  model Event {
    @db.text crate: Code;
    @db.text what: string;
    @db.datetime at: datetime;
  }

  /** キーと、一意の列 */
  model Tag {
    @db.key @db.text id: string;
    @db.unique @db.text name: string;
  }

  /** その名前（か、その識別子）の札が、もうある */
  exception TagTaken;

  @db.table state crates: list<Crate>;
  @db.table state slots: list<Slot>;
  @db.table state events: list<Event>;
  @db.table state tags: list<Tag>;

  // ---- crates ----

  /** @db.insert */
  @db.insert
  effect fn createCrate(crate: Crate): effects crates.post;

  /** @db.update: キーが一つ */
  @db.update
  effect fn updateCrate(crate: Crate): effects crates.put;

  /** @db.delete: 列が一つ */
  @db.delete
  effect fn deleteCrate(code: Code): effects crates.delete;

  /** @db.delete: 列が二つ（どの条件も満たす行をすべて消す） */
  @db.delete
  effect fn deleteLabelled(label: string, weight: int): effects crates.delete;

  /** @db.delete: 省略可能な列に、T? の引数（値がなければ、値のない行を消す） */
  @db.delete
  effect fn deleteInZone(zone: string?): effects crates.delete;

  @db.find
  read fn crateByCode(code: Code): Crate? reads crates;

  // ---- slots ----

  @db.insert
  effect fn createSlot(slot: Slot): effects slots.post;

  /** @db.update: キーが二つ */
  @db.update
  effect fn updateSlot(slot: Slot): effects slots.put;

  /** @db.delete: 二つのキー */
  @db.delete
  effect fn deleteSlot(aisle: string, level: int): effects slots.delete;

  // ---- events ----

  /** 配線が呼んでいない効果も、状態の単位のメソッドになる */
  @db.delete
  effect fn deleteEventsOf(crate: Code): effects events.delete;

  // ---- tags: @db.conflict ----

  /** @db.insert と @db.conflict: キーか、一意の列が、同じ行があれば、例外 */
  @db.insert @db.conflict(TagTaken)
  effect fn createTag(tag: Tag): throws TagTaken effects tags.post;

  /** @db.update と @db.conflict: 書き換えた行の、一意の列が、別の行と同じになれば、例外 */
  @db.update @db.conflict(TagTaken)
  effect fn renameTag(tag: Tag): throws TagTaken effects tags.put;

  // ---- op: 効果を呼ぶ配線 ----

  /** 木箱を足す */
  export fn addCrate(crate: Crate) {
    createCrate(crate);
  }

  /** 木箱を書き換える */
  export fn saveCrate(crate: Crate) {
    updateCrate(crate);
  }

  /** 木箱を消す */
  export fn removeCrate(code: Code) {
    deleteCrate(code);
  }

  /** 棚の段を書き換える */
  export fn saveSlot(slot: Slot) {
    updateSlot(slot);
  }

  /** 札を足す */
  export fn addTag(tag: Tag): throws TagTaken {
    createTag(tag);
  }

  /** 札を書き換える */
  export fn saveTag(tag: Tag): throws TagTaken {
    renameTag(tag);
  }

  /** 出来事を記録する。形で決まる命令 Post: 配線が、組み込みの効果を直に呼ぶ */
  export fn logEvent(event: Event) {
    events.post(event);
  }
}
