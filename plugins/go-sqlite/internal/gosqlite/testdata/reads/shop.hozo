// docs/plugin-go-sqlite.md「read の中身」「列と引数の型」「メソッドの形とコメント」の各行。
// 各 read の上のコメントが、その read が確かめる行。表は、宣言の on の状態で、列は、引数の名前。
// どの read も db の語彙のデコレータを持つ（どの型も、基底の単位を満たす）。

/** 店の在庫 */
namespace shop {
  scalar ItemId extends string;
  scalar Sku extends string;
  scalar Shelf extends int;
  scalar Price extends float;

  model Item {
    @db.key @db.text id: ItemId;
    @db.unique @db.text sku: Sku;
    @db.int shelf: Shelf;
    @db.text kind: string;
    @db.float price: Price;
    @db.int stock: int;
    @db.bool active: boolean;
    @db.time addedAt: Time;
    @db.json tags: string[];
    /** 値がなくてよい列 */
    @db.text note: string?;
    @db.time soldAt: Time?;
  }

  /** キーが二つ */
  model Stock {
    @db.key @db.text item: ItemId;
    @db.key @db.int shelf: Shelf;
    @db.int count: int;
  }

  /** キーも、一意の列もない */
  model Audit {
    @db.text item: ItemId;
    @db.time at: Time;
    @db.float weight: float?;
  }

  @db.table state items: list<Item>;
  @db.table state stock: list<Stock>;
  @db.table state audits: list<Audit>;

  // ---- @db.find: 一行に決まる条件 ----

  /** 条件の列が、ただ一つの @db.key */
  @db.find
  read itemById(id: ItemId): Item? on items;

  /** 条件の列が @db.unique */
  @db.find
  read itemBySku(sku: Sku): Item? on items;

  /** 引数が二つ: 条件の列が、二つの @db.key のすべて */
  @db.find
  read stockAt(item: ItemId, shelf: Shelf): Stock? on stock;

  /** キーと、ほかの列（どれも満たす行。合う行は、一つのまま） */
  @db.find
  read activeItem(id: ItemId, active: boolean): Item? on items;

  /** キーの一つを引数で、もう一つを @db.where で */
  @db.find
  @db.where("shelf", 1)
  read frontStock(item: ItemId): Stock? on stock;

  // ---- @db.find と @db.latest: いちばん新しい一行 ----

  /** 条件がない */
  @db.find
  @db.latest("at")
  read lastAudit(): Audit? on audits;

  /** 条件がある */
  @db.find
  @db.latest("at")
  read lastAuditOf(item: ItemId): Audit? on audits;

  /** @db.where の条件だけ */
  @db.find
  @db.where("active", true)
  @db.latest("addedAt")
  read newestActive(): Item? on items;

  // ---- @db.list ----

  /** 条件がない: すべての行 */
  @db.list
  read allItems(): Item[] on items;

  /** @db.int の列 */
  @db.list
  read itemsOnShelf(shelf: Shelf): Item[] on items;

  /** @db.float の列 */
  @db.list
  read itemsPriced(price: Price): Item[] on items;

  /** @db.bool の列 */
  @db.list
  read itemsActive(active: boolean): Item[] on items;

  /** @db.time の列 */
  @db.list
  read itemsAddedAt(addedAt: Time): Item[] on items;

  /** @db.json の列 */
  @db.list
  read itemsTagged(tags: string[]): Item[] on items;

  /** 引数が三つ */
  @db.list
  read itemsOf(kind: string, shelf: Shelf, active: boolean): Item[] on items;

  /** 二つの @db.key の一つ（@db.find にはできない条件でも、@db.list ならよい） */
  @db.list
  read stockOf(item: ItemId): Stock[] on stock;

  // ---- 列と引数の型 ----

  /** T? の列に、T の引数（値のない行は、どの値にも合わない） */
  @db.list
  read itemsNoted(note: string): Item[] on items;

  /** T? の列に、T? の引数（値がなければ、値のない行） */
  @db.list
  read itemsByNote(note: string?): Item[] on items;

  // ---- @db.where: 決まった値の条件。しまい方ごとのリテラル ----

  /** @db.text の列に、文字列 */
  @db.list
  @db.where("kind", "book")
  read books(): Item[] on items;

  /** @db.int の列に、整数 */
  @db.list
  @db.where("stock", 0)
  read soldOut(): Item[] on items;

  /** @db.float の列に、小数 */
  @db.list
  @db.where("price", 9.5)
  read atNineFifty(): Item[] on items;

  /** @db.float の列に、整数（Go では、小数のリテラルで書く） */
  @db.list
  @db.where("price", 10)
  read atTen(): Item[] on items;

  /** @db.bool の列に、真偽値 */
  @db.list
  @db.where("active", false)
  read retired(): Item[] on items;

  /** scalar の列（元の核の型に渡せるリテラル）と、負の数 */
  @db.list
  @db.where("shelf", -1)
  read unshelved(): Item[] on items;

  /** 省略可能な列 */
  @db.list
  @db.where("note", "fragile")
  read fragile(): Item[] on items;

  /** エスケープの要る文字列 */
  @db.list
  @db.where("kind", "\"odd\" \\ kind")
  read odd(): Item[] on items;

  /** 二つの @db.where と、引数（条件は、引数の後ろに、書いた順） */
  @db.list
  @db.where("kind", "book")
  @db.where("active", true)
  read activeBooksOn(shelf: Shelf): Item[] on items;

  // ---- @db.list と @db.latest: 新しい順 ----

  /** @db.time の列 */
  @db.list
  @db.latest("addedAt")
  read newestFirst(): Item[] on items;

  /** @db.int の列 */
  @db.list
  @db.latest("stock")
  read mostStocked(): Item[] on items;

  /** @db.float の、省略可能な列: 値のない行は最後 */
  @db.list
  @db.latest("weight")
  read heaviest(): Audit[] on audits;

  /** @db.time の、省略可能な列と、引数の条件 */
  @db.list
  @db.latest("soldAt")
  read lastSoldOn(shelf: Shelf): Item[] on items;

  /** 引数と @db.where と @db.latest */
  @db.list
  @db.where("active", true)
  @db.latest("addedAt")
  read newestActiveOf(kind: string): Item[] on items;

  // ---- 行を足す効果（テストが、表を満たすのに使う） ----

  @db.insert
  effect createItem(item: Item) on items.post;
  @db.insert
  effect createStock(row: Stock) on stock.post;
  @db.insert
  effect createAudit(audit: Audit) on audits.post;

  // ---- op: read を呼ぶ配線 ----

  /** 識別子から商品を引く */
  export op findItem(id: ItemId): Item? {
    return itemById(id);
  }

  /** 棚の、売り出し中の本を、新しい順でなく、足した順に */
  export op activeBooks(shelf: Shelf): Item[] {
    return activeBooksOn(shelf);
  }

  /** いちばん新しい棚卸し */
  export op latestAudit(): Audit? {
    return lastAudit();
  }

  /** 商品を足す */
  export op addItem(item: Item) {
    createItem(item);
  }
}
