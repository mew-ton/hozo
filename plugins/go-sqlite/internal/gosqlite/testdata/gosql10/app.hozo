// GOSQL-10（docs/plugin-go-sqlite.md「read の中身」）: read の結果の型が、デコレータの言うものと合わない: @db.find は M?、
// @db.list は M[]（M は表の model）。位置は read。

namespace app {
  model Row { @db.key @db.text id: string; @db.text note: string; @db.time at: Time; }
  /** 形は同じでも、別の model */
  model Other { @db.key @db.text id: string; @db.text note: string; @db.time at: Time; }
  @db.table state rows: list<Row>;

  // ---- @db.find は M? ----

  @db.find
  read sureRow(id: string): Row on rows;
  @db.find
  read manyRows(id: string): Row[] on rows;
  @db.find
  read otherRow(id: string): Other? on rows;
  @db.find
  read noteOf(id: string): string? on rows;
  @db.find
  @db.latest("at")
  read lastNote(): string on rows;

  // ---- @db.list は M[] ----

  @db.list
  read oneRow(): Row? on rows;
  @db.list
  read maybeRows(note: string): Row[]? on rows;
  @db.list
  read otherRows(): Other[] on rows;
  @db.list
  read rowCount(): int on rows;
  @db.list
  read rowsByNote(): Record<string, Row> on rows;

  // ---- 通るもの ----

  @db.find
  read rowById(id: string): Row? on rows;
  @db.list
  read allRows(): Row[] on rows;
}
