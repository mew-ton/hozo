// CLI-1: 位置は op。
namespace app {
  model In { @cli.flag("x") x: string?; }
  scalar Name extends string;

  // 引数が二つ
  @cli.command("two")
  export fn two(a: In, b: In);

  // 核の型
  @cli.command("core")
  export fn core(a: string);

  // scalar
  @cli.command("named")
  export fn named(a: Name);

  // 省略可能な model
  @cli.command("optional")
  export fn optional(a: In?);

  // model の配列
  @cli.command("many")
  export fn many(a: In[]);

  // 0 個と、model 一つは受け付ける
  @cli.command("none")
  export fn none_();
  @cli.command("one")
  export fn one(a: In);
}
