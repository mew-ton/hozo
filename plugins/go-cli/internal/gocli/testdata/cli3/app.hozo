// CLI-3: 位置は model。
namespace app {
  model Point { x: int; }
  model Labels { [name: string]: string; }
  scalar Path extends string;
  scalar Count extends int;
  scalar Count2 extends Count;
  scalar When extends datetime;

  model In {
    @cli.flag("model") model_: Point;
    @cli.flag("index") index: Labels;
    @cli.flag("time") time: datetime;
    @cli.arg(1) duration: duration;
    @cli.flag("when") when: When?;
    @cli.flag("flags") flags: string[];
    @cli.env("ENVS") envs: string[];
    @cli.arg(2) flag: boolean;
    @cli.arg(3) maybe: boolean?;
    @cli.arg(4) points: Point[];
    @cli.arg(5) counts: int[];
    @cli.arg(6) rest: string[]?;
  }
  @cli.command("run")
  export fn run(in: In);

  // 受け付ける型: string / boolean / int / float、その scalar、その省略可能、@cli.arg(7) の string（と string の scalar）の array
  model Fine {
    @cli.flag("s") s: string;
    @cli.flag("b") b: boolean;
    @cli.flag("i") i: int;
    @cli.flag("f") f: float;
    @cli.flag("os") os: string?;
    @cli.flag("ob") ob: boolean?;
    @cli.flag("oi") oi: int?;
    @cli.flag("of") of: float?;
    @cli.flag("sc") sc: Count2;
    @cli.flag("osc") osc: Path?;
    @cli.arg(1) a: int;
    @cli.arg(2) rest: Path[];
  }
  @cli.command("fine")
  export fn fine(in: Fine);
}
