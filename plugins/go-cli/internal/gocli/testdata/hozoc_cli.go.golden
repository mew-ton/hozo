// Code generated by hozoc plugin go-cli; DO NOT EDIT.

// Package cli は名前空間 hozoc のコマンドラインの骨組み（docs/plugin-go-cli.md）。
//
// 人が書く main は、Ops の実装を組み立てて
//
//	os.Exit(cli.Main(ops, cli.JSONPresenter{}, os.Args[1:], os.Getenv, os.Stdout, os.Stderr))
//
// を呼ぶだけ。
package cli

import (
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"os"
	"path/filepath"
	"strconv"
	"strings"

	"github.com/mew-ton/hozo/internal/gen/hozoc"
	"github.com/mew-ton/hozo/runtime"
)

// Presenter は結果と例外の表示。既定は JSON（JSONPresenter）。
type Presenter interface {
	// Present は成功の結果を w に出す。void の op なら result は nil。
	Present(w io.Writer, command string, input any, result any) error
	// PresentError は例外を w に出す。
	PresentError(w io.Writer, command string, input any, f Failure) error
}

// Failure は例外の内容。Name は例外の FQN、Value は運ぶ値（なければ nil）で、
// 生成したコードが例外の型を型スイッチで見分けて入れる。Err は op が返した error そのもの（表示のメッセージに使える）。
// 宣言にない例外なら Name は空で Err だけ。
type Failure struct {
	Name  string
	Value any
	Err   error
}

// JSONPresenter は結果と例外を JSON で出す既定の Presenter。
type JSONPresenter struct{}

// Present は result を json.MarshalIndent で w に出す。nil なら何も出さない。
func (JSONPresenter) Present(w io.Writer, command string, input any, result any) error {
	if result == nil {
		return nil
	}
	b, err := json.MarshalIndent(result, "", "  ")
	if err != nil {
		return err
	}
	_, err = fmt.Fprintln(w, string(b))
	return err
}

// PresentError は Name があれば {"error": <Name>, "value": <Value>}（Value が nil なら value を省く）を、
// なければ {"error": <Err.Error()>} を w に出す。
func (JSONPresenter) PresentError(w io.Writer, command string, input any, f Failure) error {
	var body any
	switch {
	case f.Name != "" && f.Value != nil:
		body = struct {
			Error string `json:"error"`
			Value any    `json:"value"`
		}{f.Name, f.Value}
	case f.Name != "":
		body = struct {
			Error string `json:"error"`
		}{f.Name}
	default:
		msg := "unknown error"
		if f.Err != nil {
			msg = f.Err.Error()
		}
		body = struct {
			Error string `json:"error"`
		}{msg}
	}
	b, err := json.MarshalIndent(body, "", "  ")
	if err != nil {
		return err
	}
	_, err = fmt.Fprintln(w, string(b))
	return err
}

// Main は引数を解釈して ops の op を呼び、結果を p で表示し、終了コードを返す。
// args は os.Args[1:]（プログラム名を含まない）。env は環境変数の値を返す関数（os.Getenv。nil なら環境変数を見ない）。
// 終了コード: 成功 0、使い方の誤り 64、@cli.exitCode の付いた例外はその値、それ以外の例外と表示の失敗 70。
func Main(ops hozoc.Ops, p Presenter, args []string, env func(string) string, stdout, stderr io.Writer) int {
	prog := programName()
	if len(args) == 0 {
		fmt.Fprint(stderr, usage(prog))
		return 64
	}
	switch args[0] {
	case "help", "--help", "-h":
		fmt.Fprint(stdout, usage(prog))
		return 0
	case "check":
		return runCheck(ops, p, prog, args[1:], env, stdout, stderr)
	case "emit":
		return runEmit(ops, p, prog, args[1:], env, stdout, stderr)
	case "lsp":
		return runLsp(ops, p, prog, args[1:], env, stdout, stderr)
	}
	return usageError(stderr, prog, usage(prog), fmt.Sprintf("unknown command %q", args[0]))
}

// usage は全体の使い方（docs/plugin-go-cli.md「使い方の表示」）。
func usage(prog string) string {
	return "usage: " + prog + " <command> [flags]\n\ncommands:\n  check   仕様を検査する。ファイルは書き出さない\n  emit    仕様を検査し、名前空間ごとに設定されたプラグインを呼んで、生成したファイルを書き出す\n  lsp     言語サーバーとして標準入出力で動く（docs/lsp.md）。クライアントが exit を送るまで戻らない\n"
}

// runCheck はサブコマンド check（hozoc.check）。
func runCheck(ops hozoc.Ops, p Presenter, prog string, args []string, env func(string) string, stdout, stderr io.Writer) int {
	specs := map[string]bool{
		"config": false,
		"format": false,
	}
	flags, pos, help, err := parseArgs(args, specs)
	if err != nil {
		return usageError(stderr, prog, usageCheck(prog), err.Error())
	}
	if help {
		fmt.Fprint(stdout, usageCheck(prog))
		return 0
	}
	if len(pos) > 0 {
		return usageError(stderr, prog, usageCheck(prog), fmt.Sprintf("too many arguments: %d given, at most 0 expected", len(pos)))
	}
	var in hozoc.CheckInput
	if v, ok := lookup(flags, "config", env, "HOZO_CONFIG"); ok {
		in.Config = ptr(hozoc.Path(v))
	}
	if v, ok := lookup(flags, "format", env, ""); ok {
		in.Format = ptr(hozoc.OutputFormat(v))
	}
	if err := in.Validate(); err != nil {
		return usageError(stderr, prog, "", "invalid input: "+validationMessage(err))
	}
	result, err := ops.Check(in)
	if err != nil {
		return failCheck(p, prog, in, err, stderr)
	}
	if err := p.Present(stdout, "check", in, result); err != nil {
		fmt.Fprintf(stderr, "%s: %v\n", prog, err)
		return 70
	}
	return 0
}

// failCheck は check の例外を Signature の順に見分けて Failure を作り、終了コードを決めて p で表示する。
func failCheck(p Presenter, prog string, input any, err error, stderr io.Writer) int {
	f, code := Failure{Err: err}, 70
	if e, ok := asException[hozoc.CheckFailed](err); ok {
		f, code = Failure{Name: "hozoc.CheckFailed", Value: e.Value, Err: err}, 1
	} else if e, ok := asException[hozoc.ConfigInvalid](err); ok {
		f, code = Failure{Name: "hozoc.ConfigInvalid", Value: e.Value, Err: err}, 2
	} else if e, ok := asException[hozoc.LanguageMismatch](err); ok {
		f, code = Failure{Name: "hozoc.LanguageMismatch", Value: e.Value, Err: err}, 2
	} else if _, ok := asException[hozoc.Crashed](err); ok {
		f, code = Failure{Name: "proc.Crashed", Err: err}, 70
	} else if _, ok := asException[hozoc.MalformedOutput](err); ok {
		f, code = Failure{Name: "proc.MalformedOutput", Err: err}, 70
	}
	if err := p.PresentError(stderr, "check", input, f); err != nil {
		fmt.Fprintf(stderr, "%s: %v\n", prog, err)
		return 70
	}
	return code
}

// usageCheck は check の使い方。
func usageCheck(prog string) string {
	return "usage: " + prog + " check [flags]\n\n仕様を検査する。ファイルは書き出さない\n\nflags:\n  --config <Path>           設定ファイルの場所 (env: HOZO_CONFIG)\n  --format <OutputFormat>   表示の形式\n"
}

// runEmit はサブコマンド emit（hozoc.emit）。
func runEmit(ops hozoc.Ops, p Presenter, prog string, args []string, env func(string) string, stdout, stderr io.Writer) int {
	specs := map[string]bool{
		"config":  false,
		"format":  false,
		"dry-run": true,
	}
	flags, pos, help, err := parseArgs(args, specs)
	if err != nil {
		return usageError(stderr, prog, usageEmit(prog), err.Error())
	}
	if help {
		fmt.Fprint(stdout, usageEmit(prog))
		return 0
	}
	var in hozoc.EmitInput
	if v, ok := lookup(flags, "config", env, "HOZO_CONFIG"); ok {
		in.Config = ptr(hozoc.Path(v))
	}
	if v, ok := lookup(flags, "format", env, ""); ok {
		in.Format = ptr(hozoc.OutputFormat(v))
	}
	if len(pos) > 0 {
		in.Namespaces = pos
	}
	if v, ok := lookup(flags, "dry-run", env, ""); ok {
		b, err := strconv.ParseBool(v)
		if err != nil {
			return usageError(stderr, prog, usageEmit(prog), fmt.Sprintf("invalid value %q for --dry-run: want boolean", v))
		}
		in.DryRun = ptr(b)
	}
	if err := in.Validate(); err != nil {
		return usageError(stderr, prog, "", "invalid input: "+validationMessage(err))
	}
	result, err := ops.Emit(in)
	if err != nil {
		return failEmit(p, prog, in, err, stderr)
	}
	if err := p.Present(stdout, "emit", in, result); err != nil {
		fmt.Fprintf(stderr, "%s: %v\n", prog, err)
		return 70
	}
	return 0
}

// failEmit は emit の例外を Signature の順に見分けて Failure を作り、終了コードを決めて p で表示する。
func failEmit(p Presenter, prog string, input any, err error, stderr io.Writer) int {
	f, code := Failure{Err: err}, 70
	if e, ok := asException[hozoc.CheckFailed](err); ok {
		f, code = Failure{Name: "hozoc.CheckFailed", Value: e.Value, Err: err}, 1
	} else if e, ok := asException[hozoc.ConfigInvalid](err); ok {
		f, code = Failure{Name: "hozoc.ConfigInvalid", Value: e.Value, Err: err}, 2
	} else if e, ok := asException[hozoc.LanguageMismatch](err); ok {
		f, code = Failure{Name: "hozoc.LanguageMismatch", Value: e.Value, Err: err}, 2
	} else if e, ok := asException[hozoc.OutputConflict](err); ok {
		f, code = Failure{Name: "hozoc.OutputConflict", Value: e.Value, Err: err}, 3
	} else if _, ok := asException[hozoc.UnknownNamespace](err); ok {
		f, code = Failure{Name: "hozoc.UnknownNamespace", Err: err}, 64
	} else if _, ok := asException[hozoc.Crashed](err); ok {
		f, code = Failure{Name: "proc.Crashed", Err: err}, 70
	} else if _, ok := asException[hozoc.MalformedOutput](err); ok {
		f, code = Failure{Name: "proc.MalformedOutput", Err: err}, 70
	}
	if err := p.PresentError(stderr, "emit", input, f); err != nil {
		fmt.Fprintf(stderr, "%s: %v\n", prog, err)
		return 70
	}
	return code
}

// usageEmit は emit の使い方。
func usageEmit(prog string) string {
	return "usage: " + prog + " emit [flags] [NAMESPACES...]\n\n仕様を検査し、名前空間ごとに設定されたプラグインを呼んで、生成したファイルを書き出す\n\narguments:\n  NAMESPACES...   生成する名前空間（一つもなければすべて）\n\nflags:\n  --config <Path>           設定ファイルの場所 (env: HOZO_CONFIG)\n  --format <OutputFormat>   表示の形式\n  --dry-run                 書き出さずに、書き出す予定のファイルだけを表示する\n"
}

// runLsp はサブコマンド lsp（hozoc.lsp）。
func runLsp(ops hozoc.Ops, p Presenter, prog string, args []string, env func(string) string, stdout, stderr io.Writer) int {
	specs := map[string]bool{
		"config": false,
		"log":    false,
	}
	flags, pos, help, err := parseArgs(args, specs)
	if err != nil {
		return usageError(stderr, prog, usageLsp(prog), err.Error())
	}
	if help {
		fmt.Fprint(stdout, usageLsp(prog))
		return 0
	}
	if len(pos) > 0 {
		return usageError(stderr, prog, usageLsp(prog), fmt.Sprintf("too many arguments: %d given, at most 0 expected", len(pos)))
	}
	var in hozoc.LspInput
	if v, ok := lookup(flags, "config", env, "HOZO_CONFIG"); ok {
		in.Config = ptr(hozoc.Path(v))
	}
	if v, ok := lookup(flags, "log", env, "HOZO_LSP_LOG"); ok {
		in.Log = ptr(hozoc.Path(v))
	}
	if err := in.Validate(); err != nil {
		return usageError(stderr, prog, "", "invalid input: "+validationMessage(err))
	}
	err = ops.Lsp(in)
	if err != nil {
		return failLsp(p, prog, in, err, stderr)
	}
	if err := p.Present(stdout, "lsp", in, nil); err != nil {
		fmt.Fprintf(stderr, "%s: %v\n", prog, err)
		return 70
	}
	return 0
}

// failLsp は lsp の例外を Signature の順に見分けて Failure を作り、終了コードを決めて p で表示する。
func failLsp(p Presenter, prog string, input any, err error, stderr io.Writer) int {
	f, code := Failure{Err: err}, 70
	if err := p.PresentError(stderr, "lsp", input, f); err != nil {
		fmt.Fprintf(stderr, "%s: %v\n", prog, err)
		return 70
	}
	return code
}

// usageLsp は lsp の使い方。
func usageLsp(prog string) string {
	return "usage: " + prog + " lsp [flags]\n\n言語サーバーとして標準入出力で動く（docs/lsp.md）。クライアントが exit を送るまで戻らない\n\nflags:\n  --config <Path>   設定ファイルの場所 (env: HOZO_CONFIG)\n  --log <Path>      ログの書き出し先 (env: HOZO_LSP_LOG)\n"
}

// programName は使い方に出すプログラム名（filepath.Base(os.Args[0])）。
func programName() string {
	if len(os.Args) > 0 && os.Args[0] != "" {
		return filepath.Base(os.Args[0])
	}
	return "hozoc"
}

// parseArgs は args をフラグと位置引数に分ける（docs/plugin-go-cli.md「引数の解釈」）。
// specs はフラグ名 → boolean か。フラグは --name value か --name=value で、boolean は --name だけで true
// （--name=false は取れる）。-- 以降はすべて位置引数。--help か -h があれば help が true。
// 知らないフラグ、値のないフラグは誤り。
func parseArgs(args []string, specs map[string]bool) (flags map[string]string, pos []string, help bool, err error) {
	flags = map[string]string{}
	for i := 0; i < len(args); i++ {
		a := args[i]
		if a == "--" {
			pos = append(pos, args[i+1:]...)
			break
		}
		if a == "--help" || a == "-h" {
			return nil, nil, true, nil
		}
		if !strings.HasPrefix(a, "--") {
			pos = append(pos, a)
			continue
		}
		name, value, hasValue := strings.Cut(a[2:], "=")
		boolean, known := specs[name]
		if !known {
			return nil, nil, false, fmt.Errorf("unknown flag --%s", name)
		}
		if !hasValue {
			if boolean {
				value = "true"
			} else {
				if i+1 >= len(args) {
					return nil, nil, false, fmt.Errorf("flag --%s needs a value", name)
				}
				i++
				value = args[i]
			}
		}
		flags[name] = value
	}
	return flags, pos, false, nil
}

// lookup はフラグの値、なければ環境変数 name の値（空でなければ）を返す。フラグが優先。
func lookup(flags map[string]string, flag string, env func(string) string, name string) (string, bool) {
	if flag != "" {
		if v, ok := flags[flag]; ok {
			return v, true
		}
	}
	if name != "" && env != nil {
		if v := env(name); v != "" {
			return v, true
		}
	}
	return "", false
}

// lookupArg は i 番目の位置引数、なければ環境変数 name の値（空でなければ）を返す。
func lookupArg(pos []string, i int, env func(string) string, name string) (string, bool) {
	if i < len(pos) {
		return pos[i], true
	}
	return lookup(nil, "", env, name)
}

// usageError は使い方の誤りを標準エラーに出して 64 を返す。usage が空なら使い方は出さない。
func usageError(stderr io.Writer, prog, usage, msg string) int {
	fmt.Fprintf(stderr, "%s: %s\n", prog, msg)
	if usage != "" {
		fmt.Fprint(stderr, "\n"+usage)
	}
	return 64
}

// validationMessage は Validate の誤りを「path: constraint; ...」にする（docs/plugin-go-cli.md「引数の解釈」）。
func validationMessage(err error) string {
	var ve *runtime.ValidationError
	if !errors.As(err, &ve) {
		return err.Error()
	}
	parts := make([]string, len(ve.Violations))
	for i, v := range ve.Violations {
		parts[i] = v.String()
	}
	return strings.Join(parts, "; ")
}

// asException は err の連鎖の中の例外 T を取り出す。値でも *T でも見つける（P は *T。型推論で埋まる）。
func asException[T error, P interface {
	*T
	error
}](err error) (T, bool) {
	var v T
	if errors.As(err, &v) {
		return v, true
	}
	var p P
	if errors.As(err, &p) && p != nil {
		return *p, true
	}
	return v, false
}

// ptr は v を指すポインタ（optional のフィールドのため）。
func ptr[T any](v T) *T { return &v }
