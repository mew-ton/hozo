// CLI-12: 位置は model。
namespace app {
  model In {
    // 一つのフィールドに、@cli.required と @cli.default の両方
    @cli.flag("a") @cli.required @cli.default("x") a: string;
    @cli.arg(1) @cli.default(1) @cli.required b: int;
    // どちらか一つなら、付けられる
    @cli.flag("c") @cli.required c: string;
    @cli.flag("d") @cli.default("x") d: string;
  }
  @cli.command("run")
  export fn run(in: In);

  // 同じ model を使う、もう一つのコマンド（入力の model の診断は、一度だけ返す）
  @cli.command("again")
  export fn again(in: In): string;
}
