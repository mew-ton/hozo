// CLI-4: 位置は model。
namespace app {
  // array の @cli.arg(1) の後ろに、@cli.arg(2) がある
  model Early {
    @cli.arg(1) rest: string[];
    @cli.arg(2) last: string;
  }
  @cli.command("early")
  export op early(in: Early);

  // array の @cli.arg(3) が二つ
  model Twice {
    @cli.arg(1) a: string[];
    @cli.arg(2) b: string[];
  }
  @cli.command("twice")
  export op twice(in: Twice);

  // array の @cli.arg(3) が @cli.arg(4) の中で最後なら、後ろにフラグがあってもよい
  model Fine {
    @cli.arg(1) first: string;
    @cli.arg(2) rest: string[];
    @cli.flag("after") after: string?;
  }
  @cli.command("fine")
  export op fine(in: Fine);
}
