// GODESIGN-2: 位置は、その op。
namespace design {
  classify Actor of never { @prd.actor.human User; }
}

namespace act {
  @prd.usecase.of(design.Actor.User)
  export fn touch();
}

namespace flows {
  exception Stop;

  // 本体を持たない（葉）
  @prd.business.flow
  export fn leaf(): int;

  // never を返す
  @prd.business.flow
  export fn fail(): never
    throws Stop;

  // 配線で、値を返さないフローは、当たらない
  @prd.business.flow
  export fn fine() {
    act.touch();
  }
}
