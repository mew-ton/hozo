// GODESIGN-5: 位置なし。
namespace design {
  classify Actor of never { @prd.actor.human User; }
  classify Req of never { R1; }
  model Note { text: string; }
  // 対象を持つ分類
  classify Size of int { Small; Large; }
}

namespace act {
  @prd.usecase.of(design.Actor.User)
  @prd.ref(design.Req.R1)
  export fn touch();
}

namespace unknown {
  @prd.business.flow
  export fn run() { act.touch(); }
}

namespace onestr {
  @prd.business.flow
  export fn run() { act.touch(); }
}

namespace numbers {
  @prd.business.flow
  export fn run() { act.touch(); }
}

namespace entries {
  @prd.business.flow
  export fn run() { act.touch(); }
}
