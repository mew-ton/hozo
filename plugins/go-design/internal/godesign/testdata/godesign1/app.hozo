// GODESIGN-1: 位置は、その op。
namespace design {
  classify Actor of never { @prd.actor.human User; }
}

namespace act {
  @prd.usecase.of(design.Actor.User)
  export fn touch();
}

namespace flows {
  @prd.business.flow
  fn hidden() {
    act.touch();
  }

  @prd.business.flow
  fn also() {
    act.touch();
  }

  // export があれば、当たらない
  @prd.business.flow
  export fn shown() {
    act.touch();
  }
}
