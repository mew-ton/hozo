// GOVALID-5: 位置は、付いた scalar か model。
namespace valid {
  /** 末尾の 1 桁が、チェックディジットと一致する */
  decorator checkDigit for scalar, field;
  decorator even(strict: boolean) for scalar, field;
}

namespace app {
  @valid.checkDigit
  scalar Jan extends string;

  decorator strictlyEven = valid.even(true);

  model Order {
    @valid.even(false) qty: int;
    @valid.length(min: 1) @valid.checkDigit code: string;
    @strictlyEven boxes: int;
  }

  // 標準の制約だけなら、当たらない
  @valid.min(1)
  scalar Count extends int;
}
