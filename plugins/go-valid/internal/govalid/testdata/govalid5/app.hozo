// GOVALID-5: 位置は、付いた scalar か model。標準でない valid の制約（checkDigit、even）は、プラグイン morevalid の語彙のファイル
// （plugins/morevalid/valid.hozo）が、valid に足している（仕様からは、足せない: RES-8）。

namespace app {
  @valid.checkDigit
  scalar Jan extends string;

  decorator strictlyEven = valid.even(true);

  model Order {
    @valid.even(false) qty: int;
    @valid.length(min: 1) @valid.checkDigit code: string;
    @strictlyEven boxes: int;
  }

  // 標準の制約だけなら、当たらない
  @valid.min(1)
  scalar Count extends int;
}
