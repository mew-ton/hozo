// GOVALID-3: 位置は model（scalar の元の型なら、その scalar）。
namespace type {
  @valid.format("email")
  scalar Email extends string;
  model Address { @valid.length(min: 1) city: string; }
  scalar Id extends string;
}

namespace app {
  model AddressesById { [id: string]: type.Address?; }
  // type の置き場の単位（1 番目）が go-valid を並べていない
  model User {
    email: type.Email;
    homes: type.Address[];
    byId: AddressesById?;
    // Validate を持たない型は、当たらない
    id: type.Id;
  }
  scalar WorkEmail extends type.Email;
  // 自分の名前空間の型と、Validate を持たない別の名前空間の型だけなら、当たらない
  model Local { work: WorkEmail?; id: type.Id; }
  // 例外の引数の型は、当たらない（例外は Validate を持たないので、呼ぶコードがない）
  exception Bounced(email: type.Email, homes: type.Address[]);
}

// 型の置き場の単位（5 番目）が go-valid を並べていれば、当たらない
namespace front {
  model Form { email: front.type.Email; }
}
namespace front.type {
  @valid.format("email")
  scalar Email extends string;
}
