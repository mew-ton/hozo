// GOVALID-4: 位置は model。アームの型が、Validate を持つ型そのもの（ref）でなく、その中に Validate を持つ型がある union。
namespace app {
  @valid.format("email")
  scalar Email extends string;
  model Card { @valid.min(1) n: int; }

  union Contact { Mail: Email; Other: string; }
  union Nested { Inner: Contact; None: string; }
  model CardsByName { [name: string]: Card?; }
  model NestedByName { [name: string]: Nested; }
  union Cards { Many: Card[]; One: CardsByName; }
  union Free { A: string; B: int; }

  // アームの型が、Validate を持つ型への ref（Contact の Mail）なら、当たらない: 値が当たっているアームの検証を呼ぶ
  model Holder { contact: Contact; }
  model Lists {
    contacts: Contact[];
    byName: NestedByName?;
    cards: Cards?;
  }
  // アームに Validate を持つ型のない union は、当たらない
  model Fine { free: Free; frees: Free[]; }
  // 例外の引数の型は、当たらない（例外は Validate を持たない）
  exception Refused(contact: Contact, cards: Cards?);
}
