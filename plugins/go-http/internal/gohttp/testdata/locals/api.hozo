// 名前空間のパッケージの名前が、NewHandler とハンドラの中の局所の名前（ops、mux、w、r、in、req、out、err）や、
// http.go が import する標準ライブラリのパッケージの名前（strconv、reflect）と当たる入力。
namespace w {
  @http.status(404)
  exception NotFound;
}
namespace err {
  model Note { text: string; }
  @http.status(409)
  exception Conflict: Note;
}
namespace in {
  model Note { @http.required @http.body text: string; }
}
namespace out {
  model Find { @valid.length(min: 1) @http.query @http.default("x") q: string; }
}
namespace r {
  model Head { @http.header("X-Trace") trace: string?; }
}
namespace req {
  model Page { @http.query page: int?; }
}
namespace mux {
  model Paging { page: int?; }
  model Query { @http.queryObj paging: Paging; }
}
namespace ops {
  model Meta { trace: string?; }
  model Head { @http.headerObj meta: Meta; }
}
namespace strconv {
  model Flag { @http.query on: boolean?; }
}
namespace reflect {
  model Body { text: string; }
  model Put { @http.bodyObj body: Body; }
}

namespace api {
  @http.post("/in")
  export op viaIn(in: in.Note): string
    throws w.NotFound | err.Conflict;
  @http.get("/out")
  export op viaOut(in: out.Find): string[];
  @http.get("/r")
  export op viaR(in: r.Head): string?;
  @http.get("/req")
  export op viaReq(in: req.Page);
  @http.get("/mux")
  export op viaMux(in: mux.Query): int;
  @http.get("/ops")
  export op viaOps(in: ops.Head): int;
  @http.get("/strconv")
  export op viaStrconv(in: strconv.Flag): boolean;
  @http.post("/reflect")
  export op viaReflect(in: reflect.Put): Record<string, string>;
}
