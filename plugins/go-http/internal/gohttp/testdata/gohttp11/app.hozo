// GOHTTP-11: 位置は op。
namespace plain {
  // Validate を持つ model（制約の付いたフィールド）。置き場の単位は go-valid を並べていない
  model In {
    @valid.length(min: 1) @http.query name: string;
  }
  // Validate を持たない model
  model Free {
    @http.query name: string?;
  }
}

namespace checked {
  model In {
    @valid.length(min: 1) @http.query name: string;
  }
}

namespace app {
  // 入力の model が plain のもの: Validate のメソッドがないので、確かめられないまま op に渡る
  @http.get("/a")
  export fn a(in: plain.In): string;

  // 同じ model を使う、もう一つの経路
  @http.post("/b")
  export fn b(in: plain.In);

  // Validate を持たない入力は、確かめるものがないので、当たらない
  @http.get("/c")
  export fn c(in: plain.Free): string;

  // 置き場の単位が go-valid を並べていれば、当たらない
  @http.get("/d")
  export fn d(in: checked.In): string;

  // 自分の名前空間の model（自分の単位は go-valid を並べている。CFG-19）
  model Own {
    @valid.length(min: 1) @http.query name: string;
  }
  @http.get("/e")
  export fn e(in: Own): string;
}
