// GOHTTP-10: 位置は、当たった宣言。当たるのは、入口のパッケージに足す三つの公開の名前（HandlerOption、WithInternalError、NewHandler）。
namespace app {
  // model の名前そのもの
  model NewHandler { retries: int; }
  @http.get("/a")
  export fn a(): string;
}

namespace typed {
  // scalar の名前そのもの
  scalar NewHandler extends string;
  @http.get("/b")
  export fn b(): string;
}

namespace wrapped {
  // union New のアーム Handler を包む型 NewHandler
  union New { Handler: string; Other: int; }
  @http.get("/c")
  export fn c(): string;
}

namespace options {
  // 設定の型 HandlerOption と、関数 WithInternalError
  model HandlerOption { name: string; }
  scalar WithInternalError extends string;
  @http.get("/e")
  export fn e(): string;
}

namespace quiet {
  // 経路の op がなければ、NewHandler を出さないので、当たらない
  model NewHandler { retries: int; }
  export fn d(): string;
}
