// docs/plugin-go-http.md「出力」「入力の読み方」「補助」「通信の形」の各行を、一か所ずつ使う。

/** 共有の型と例外 */
namespace type {
  scalar Token extends string;
  @valid.min(1)
  scalar Page extends int;
  scalar Ratio extends float;
  scalar Flag extends boolean;
  @valid.length(min: 1)
  scalar Name extends string;
  scalar Wait extends duration;

  /** 品物 */
  model Item {
    @valid.length(min: 1) name: string;
    @valid.min(1) quantity: int;
    tags: string[];
    at: datetime?;
  }

  /** 見つからない（引数のない例外） */
  @http.status(404)
  exception NotFound;
  /** 既にある（引数が二つ） */
  @http.status(409)
  exception Conflict(existing: string, count: int);
  /** 受け付けられない（引数が一つ。型は model） */
  @http.status(422)
  exception Rejected(value: Item);
  /** 多すぎる（省略可能な引数を持つ。scalar の引数は、元の型の JSON） */
  @http.status(429)
  exception Limited(retryAfter: Wait, hint: string?, until: datetime?);
  /** もうない（引数が、どれも省略可能） */
  @http.status(410)
  exception Gone(since: datetime?);
  /** ステータスを持たない例外 */
  exception Broken;
  /** ステータスを持たない例外は、引数を持っていても、通信に現れない */
  exception Leaky(secret: string);

  /** 別の名前空間の入力の model */
  model Lookup {
    @http.query @http.required id: string;
    @http.header("X-Trace") trace: string?;
  }

  /** ヘッダの全体で受け取る model: 項目の名前は、フィールドの名前 */
  model Meta {
    tenant: string;
    trace: Token?;
  }

  /** クエリの全体で受け取る model */
  model Paging {
    page: int?;
    size: Page;
    q: string;
    exact: Flag?;
    ratio: float;
  }
}

/** 入力の読み方のすべて（validate は既定の false） */
namespace api {
  /** 品物のラベル。名前から、値を引く */
  model Labels { [name: string]: type.Name; }
  /** 名前ごとの数 */
  model Counts { [name: string]: int; }

  // 引数がなく、戻り値がある
  @http.get("/health")
  export fn health(): string;

  // ヘッダと本文の項目: 名前を書いたものと省いたもの、@http.required、@http.default、どちらもない（省略可能と、そうでないもの）。
  // 本文の項目は、いくつあっても、JSON のオブジェクトのキー。@http.default のリテラルは、文字列、整数、小数、真偽値、期間
  model CreateInput {
    @http.header("X-Tenant") @http.required tenant: string;
    @http.header("Authorization") token: type.Token;
    @http.header("X-Request-Id") requestId: string?;
    @http.header("Accept-Language") @http.default("en") lang: string;
    @http.header trace: string?;
    @http.body item: type.Item;
    @http.query @http.required dryRun: boolean;
    @http.body("memo") note: string?;
    @http.body @http.default(1) copies: int;
    @http.required @http.body labels: Labels;
    @http.body @http.default(2) weight: float;
    @http.body @http.default(1.5) scale: type.Ratio;
    @http.body @http.default(true) active: boolean;
    @http.body @http.default(30s) timeout: duration;
    @http.body @http.default(5m) wait: type.Wait;
    @http.body @http.default("anon") owner: type.Token;
  }

  /** 品物を作る */
  @http.post("/items")
  export fn create(in: CreateInput): type.Item
    throws type.Conflict, type.Rejected;

  // クエリの項目: string / int / float / boolean と、その scalar。@http.required、@http.default、どちらもない
  model SearchInput {
    @http.query @http.required q: string;
    @http.query("n") name: type.Name?;
    @http.query tag: string?;
    @http.query @http.default("nobody") owner: type.Token;
    @http.query @http.default(1) page: type.Page;
    @http.query limit: int?;
    @http.query size: type.Page?;
    @http.query offset: int;
    @http.query @http.required min: float;
    @http.query @http.default(0.5) ratio: type.Ratio;
    @http.query max: float?;
    @http.query scale: type.Ratio?;
    @http.query @http.default(true) exact: boolean;
    @http.query deep: boolean?;
    @http.query flag: type.Flag?;
    @http.query @http.default(3) factor: float;
  }

  /** 品物を探す。結果は配列（空でも [] を返す） */
  @http.get("/items")
  export fn search(in: SearchInput): type.Item[]
    throws type.Broken, type.Leaky;

  /** 最初の品物。省略可能な戻り値（なければ 204）。入力は、別の名前空間の model */
  @http.get("/items/first")
  export fn first(in: type.Lookup): type.Item?
    throws type.NotFound, type.Limited, type.Gone;

  // 本文の項目が一つでも、本文は、キーを持つオブジェクト。戻り値がない（204）
  model ReplaceInput {
    @http.body items: type.Item[];
  }
  @http.post("/items/replace")
  export fn replace(in: ReplaceInput):
    throws type.NotFound;

  // 全体の形: ヘッダとクエリを、一つずつの model で。結果は、インデックスの model（値がなくても {} を返す）
  model ListInput {
    @http.headerObj meta: type.Meta;
    @http.queryObj paging: type.Paging;
  }
  @http.get("/list")
  export fn listAll(in: ListInput): Counts;

  // 全体の形: 本文が、その model の JSON。ほかの場所の項目の形とは、一緒に書ける。結果は、省略可能な scalar
  model PutInput {
    @http.bodyObj item: type.Item;
    @http.header("X-Tenant") tenant: string?;
  }
  @http.post("/put")
  export fn put(in: PutInput): type.Token?;

  // 引数も戻り値もない。/ で終わるパスは、そのパスだけに合う
  @http.post("/reset/")
  export fn reset();

  // 一つの op に、二つの経路
  @http.get("/ping")
  @http.post("/ping")
  export fn ping(): boolean;

  // 零値の結果も、値（200）
  @http.get("/count")
  export fn count(): int;

  // @http.* のない export の op は、経路にならない。@http.retry は読まない（印）
  export fn version(): string;
  @http.retry(3)
  export fn flaky(): string;

  // 内部の op
  fn helper(n: int): int;
}

/** 制約の検査（validate = true） */
namespace strict {
  // 項目の形: 違反の path は、場所と名前と、その中のパス（body.lines[1].name）
  model OrderInput {
    @http.header("Authorization") token: type.Token?;
    @http.required @http.body lines: type.Item[];
  }
  @http.post("/orders")
  export fn order(in: OrderInput): int;

  // 名前を書いた項目は、その名前で（body.more）。クエリとヘッダの値の制約も確かめる
  model EditInput {
    @http.query @http.default(1) page: type.Page;
    @http.header("X-Name") name: type.Name?;
    @http.body item: type.Item;
    @http.body("more") extra: type.Item?;
  }
  @http.post("/edit")
  export fn edit(in: EditInput);

  // 全体の形: 場所は body、query（フィールドの名前 payload、paging は、通信に現れない）
  model BulkInput {
    @http.bodyObj payload: type.Item;
    @http.queryObj paging: type.Paging;
  }
  @http.post("/bulk")
  export fn bulk(in: BulkInput);

  // Validate を持たない入力にも、同じ httpValidate を出す（補助が、実行時に見る）
  model PlainInput {
    @http.query id: string?;
  }
  @http.get("/plain")
  export fn plain(in: PlainInput): string;

  // 入力のない経路は、確かめるものがない
  @http.get("/now")
  export fn now(): string;
}

/** 入力も、@http.status を持つ例外もない */
namespace bare {
  exception Unknown;

  @http.get("/")
  export fn root(): string;

  @http.post("/touch")
  export fn touch():
    throws Unknown;

  // 名前付きデコレータを通して付けた @http.get も、展開した適用として経路になる
  decorator pong = http.get("/pong");
  @pong
  export fn viaAlias(): string;
}

namespace flow {
  // Hozo が作る、例外のケース（docs/plugin-go-http.md「インテグレーションテストの口」の「必要なケース」）が、走って、通ることを見る入口:
  // 述語で決まる分類の match の、throw のアーム（判定のにせものが、そのケースだと言う）と、effect fn が投げる例外（端のにせものが、投げる）
  model Item { id: string; }

  @http.status(409)
  exception Taken;
  @http.status(422)
  exception TooBig;

  state items: Item[];

  /** 品物を足す。同じ識別子の品物が、もうあれば、投げる */
  effect fn addItem(item: Item): throws Taken effects items.post;

  /** 大きさ（人が、述語を書く） */
  classify Size of Item { Big; Small; }

  model AddInput { @http.bodyObj item: Item; }

  @http.post("/flow/items")
  export fn add(in: AddInput) {
    val item = in.item;
    match (item by Size) {
      Small => addItem(item);
      Big   => throw TooBig;
    }
  }

  // 本体のあるデコレータ（docs/plugin-go.md「本体のあるデコレータ」）を付けた入口: 本体は、本物を通すので、本体の中の、例外の出どころ
  // （throw のアームと、本体が呼ぶ葉）も、Hozo が、ケースを作る。proceed() のアームの先（op の中身）の出どころも、同じ
  @http.status(503)
  exception Shut;
  @http.status(502)
  exception Jammed;

  /** 受け付ける時間か（人が、述語を書く） */
  classify Hours of Item { Open; Late; }

  /** 今の番（人が書く） */
  fn duty(): Item;
  /** 戸を確かめる。壊れていれば Jammed（人が書く） */
  fn checkDoor(): throws Jammed;

  /** 戸を確かめ、受け付ける時間でなければ、op の中身を呼ばずに Shut */
  decorator fn opened() {
    checkDoor();
    val now = duty();
    match (now by Hours) {
      Open => proceed();
      Late => throw Shut;
    }
  }

  @http.post("/flow/shelf")
  @opened
  export fn shelve(in: AddInput) {
    addItem(in.item);
  }
}
