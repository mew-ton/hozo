// GOHTTP-7: 位置は op。
namespace app {
  // / で始まらない
  @http.get("items")
  export fn relative(): string;
  @http.post("")
  export fn empty();
  @http.get("http://example.com/items")
  export fn absolute(): string;
  // { か } を含む（パスの中の値）
  @http.get("/items/{id}")
  export fn byId(): string;
  @http.post("/items/}")
  export fn brace();

  // / で始まる、決まった文字列なら、当たらない
  @http.get("/items")
  export fn all(): string;
  @http.get("/")
  export fn root(): string;
}
