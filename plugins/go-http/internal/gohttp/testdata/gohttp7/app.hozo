// GOHTTP-7: 位置は op。
namespace app {
  // / で始まらない
  @http.get("items")
  export op relative(): string;
  @http.post("")
  export op empty();
  @http.get("http://example.com/items")
  export op absolute(): string;
  // { か } を含む（パスの中の値）
  @http.get("/items/{id}")
  export op byId(): string;
  @http.post("/items/}")
  export op brace();

  // / で始まる、決まった文字列なら、当たらない
  @http.get("/items")
  export op all(): string;
  @http.get("/")
  export op root(): string;
}
