// GOHTTP-17: 位置は model。
namespace app {
  model In {
    @http.query @http.required @http.default(1) page: int;
    @http.default("x") @http.header("X-Trace") @http.required trace: string;
    // 片方だけなら、当たらない
    @http.query @http.required q: string;
    @http.query @http.default(10) size: int;
  }
  @http.get("/in")
  export fn take(in: In);
}
