// 決定の記録（1〜99）。名前空間 hozo.decisions。書き方は decisions/adr.hozo の頭のコメント。
// コードには、ならない（hozo.toml の単位の対象ではない）。
// docs/decisions.md「決めたこと」の行を、そのまま移したもの（本文は、行の「決めたこと」の列。持ち主は、行の「持ち主」の列）。

namespace hozo.decisions {
  /** 決めたこと。1〜99 */
  classify Decision000 of never {
    /**
     * 本体は Go。IDE の対応は、その IDE の拡張が要求する言語で書く。初期は VS Code 拡張だけ
     *
     * 持ち主: `docs/requirements.md`「実装言語」
     */
    @adr.accepted
    D1;

    /**
     * 当面の展開先は Go と TS。プラグインは展開先の言語で書き、SDK も Go と TS
     *
     * 持ち主: `docs/requirements.md`「プラグインの書き方」
     */
    @adr.accepted
    D2;

    /**
     * IR の構造と JSON の形の持ち主は `docs/ir.md`。`ir` パッケージはそれを写し、スキーマと TS の型は生成
     *
     * 持ち主: `docs/requirements.md`「プラグインの書き方」
     */
    @adr.accepted
    D3;

    /**
     * hozoc 自身を `cli.hozo` で書き、骨組みを生成する
     *
     * 持ち主: `docs/requirements.md`「自己展開」
     */
    @adr.accepted
    D4;

    /**
     * 言語サーバーは `hozoc lsp`。別のバイナリにしない
     *
     * 持ち主: `docs/requirements.md`「言語サーバー」
     */
    @adr.accepted
    D5;

    /**
     * （68 が置き換えた。言語ごとの出力の担い手は、hozoc 本体ではなく基底のトランスパイラ。最初の言語が Go で、TS が段階 5 であることは変わらない）
     *
     * 持ち主: 68
     */
    @adr.superseded(Decision000.D68)
    D6;

    /**
     * 予約語と文脈キーワードの分け方
     *
     * 持ち主: `docs/grammar.md`「予約語」「決めたこと」
     */
    @adr.accepted
    D7;

    /**
     * 省略可能は型の `?` だけで表し、名前に付ける `x?: T` は書けない
     *
     * 持ち主: `docs/grammar.md`「決めたこと」
     */
    @adr.accepted
    D8;

    /**
     * 識別子は ASCII。`Duration` の単位は `ms` `s` `m` `h` `d`。`Time` のリテラルはない
     *
     * 持ち主: `docs/grammar.md`「決めたこと」
     */
    @adr.accepted
    D9;

    /**
     * 付く先のないドキュメンテーションコメント、名前付き引数の後の位置引数はエラー（「`omit` のない `is`」は、`is … omit` をなくした S22 で要らなくなった）
     *
     * 持ち主: `docs/grammar.md`「決めたこと」
     */
    @adr.accepted
    D10;

    /**
     * `@external` は宣言ではなく核の印
     *
     * 持ち主: `docs/grammar.md`「決めたこと」
     */
    @adr.accepted
    D11;

    /**
     * その場で書く model はユニオンのアームと例外の値にだけ置ける
     *
     * 持ち主: `docs/grammar.md`「決めたこと」
     */
    @adr.accepted
    D12;

    /**
     * `return` は本体の最後の文にだけ書ける
     *
     * 持ち主: `docs/check.md`「配線」WIRE-3
     */
    @adr.accepted
    D13;

    /**
     * IR の参照はすべて FQN。その場の model は `<親>.<名前>` の model に合成
     *
     * 持ち主: `docs/ir.md`「原則」「正規化」
     */
    @adr.accepted
    D14;

    /**
     * 例外・効果・`bind` の計算結果を IR に置く
     *
     * 持ち主: `docs/ir.md`「原則」
     */
    @adr.accepted
    D15;

    /**
     * デコレータの適用は入れ子にせず順序付きの列
     *
     * 持ち主: `docs/ir.md`「デコレータの適用」
     */
    @adr.accepted
    D16;

    /**
     * 「その名前空間から見た IR」は `Program` 全体に見る側の `Signature` を足したもの
     *
     * 持ち主: `docs/ir.md`「その名前空間から見た IR」
     */
    @adr.accepted
    D17;

    /**
     * 名前の先頭のセグメントの探し方の順序
     *
     * 持ち主: `docs/resolve.md`「手続き」
     */
    @adr.accepted
    D18;

    /**
     * 標準の語彙（`valid` `http` `db` `localStorage` `page` `fs` `proc`）は hozoc に同梱し、常に読む。`cli` の語彙は hozoc には同梱せず、go-cli が `vocabulary` で提供する
     *
     * 持ち主: `docs/vocab.md`「読み込み」「同梱する語彙」「同梱しない語彙」
     */
    @adr.accepted
    D19;

    /**
     * `proc.stdio` は引数を持たず `@external` でもない
     *
     * 持ち主: `docs/vocab.md`「同梱する語彙」
     */
    @adr.accepted
    D20;

    /**
     * 入っているプラグインは `[hozo].plugin_dirs` → `HOZO_PLUGIN_PATH` → `~/.hozo/plugins` の順で探す。単位の `transpilers` の名前は、入っているすべてのプラグインのトランスパイラから探す
     *
     * 持ち主: `docs/plugin-protocol.md`「探索」
     */
    @adr.accepted
    D21;

    /**
     * マニフェストに `protocol` `vocabulary` `[check]` を足す。`command` は配列も可。要求は `ir` でなく `view` を持ち `protocol` を足す。応答に `errors` を持つ。`[emit]` と `language` の代わりに `[[transpiler]]`（`name` / `language` / `unsupported`）を持ち、`emit` の要求は `transpiler` を持つ
     *
     * 持ち主: `docs/plugin-protocol.md`「マニフェスト」「要求と応答」
     */
    @adr.accepted
    D22;

    /**
     * 語彙に固有の検査（PAGE-1 / PAGE-2）はプラグインの `check` が行う
     *
     * 持ち主: `docs/plugin-protocol.md`「check」
     */
    @adr.accepted
    D23;

    /**
     * トランスパイラは、単位と、その単位が出力する名前空間の組ごとに常に一回呼ぶ。`check` はプラグインと名前空間の組ごとに一回。並列にしない
     *
     * 持ち主: `docs/plugin-protocol.md`「起動」
     */
    @adr.accepted
    D24;

    /**
     * `[hozo]` に `sources` `plugin_dirs` `max_bindings`
     *
     * 持ち主: `docs/config.md`「形」
     */
    @adr.accepted
    D25;

    /**
     * TOML は `github.com/BurntSushi/toml`。ほかに外部のモジュールは使わない
     *
     * 持ち主: `docs/packages.md`「依存の向き」
     */
    @adr.accepted
    D26;

    /**
     * （72 と 73 が置き換えた。「宣言一つにつき型一つ、束ねるのは構造体、未設定は `*runtime.MissingError`、`context` を取らない」という、本体に組み込んでいた Go の出力の形）
     *
     * 持ち主: 72、73
