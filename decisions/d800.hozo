// 決定の記録（800〜899）。名前空間 hozo.decisions。書き方は decisions/adr.hozo の頭のコメント。
// コードには、ならない（hozo.toml の単位の対象ではない）。

namespace hozo.decisions {
  /** 決めたこと。800〜899 */
  classify Decision800 of never {
    /**
     * db.transaction の約束は、呼ばれ方によらない: その op が失敗すれば、その op が DB にしたことは、入れ子でも、どれも残らない。
     * 入れ子の内側が失敗すれば、内側がしたことだけが消え、外側がその失敗を受けて成功すれば、外側の残りは確定する。確定するのは、
     * いちばん外側。意味は語彙の文書（docs/vocab.md）が持ち、go-sqlite は、入れ子の内側を SAVEPOINT（名前は、いつも "hozo"）で出す。
     * go-sqlite 自身の要求 hozo.gosqlite.Requirement.NestedRollback に書き、そこから作るテストで確かめる。これまでの
     * docs/plugin-go-sqlite.md「トランザクション」の、入れ子の内側は外側に加わるだけで、内側だけを取り消すこと（セーブポイント）は
     * しない、という決まりを、置き換える。
     *
     * @adr.context 入れ子の内側の失敗を、途中のデコレータが受けて（catches … recovers）外側が成功すると、内側が失敗までに書いたものが
     * 確定していた（#164 の 6）。入れ子のトランザクションの意味は、ほかの仕組みでも分かれる（Django の atomic と SQLAlchemy の
     * begin_nested は SAVEPOINT、Rails の transaction は外側に加わるだけ、Spring の REQUIRED は外側ごと取り消す）ので、読む人の期待に
     * 任せず、語彙の文書に意味を書く。一つの op は、直にも、入れ子でも呼ばれうるので、意味が呼ばれ方で変わらないものにする。
     * @adr.consequence 入れ子の内側の失敗を受けて成功する外側は、内側の書き込みを、確定しなくなる。
     * @adr.alternative 入れ子の内側は、外側に加わるだけ（これまでの形。Rails の既定と同じ）: 内側の失敗を受けると、途中の書き込みが、
     * 黙って確定する
     * @adr.alternative 入れ子の内側が失敗すれば、外側が受けても、いちばん外側を取り消す（Spring の REQUIRED に近い）: 途中の書き込みは
     * 残らないが、失敗を受けて続ける外側の op も、失敗になる
     * @adr.alternative db.transaction(nested: …) で書き分ける: op を書く人が、呼ばれ方を知って選ぶことになる
     * @adr.alternative SAVEPOINT 用のデコレータ（db.savepoint）を足す: 一つの op が、直にも入れ子でも呼ばれうるので、どちらを付けるかが、
     * 呼ばれ方で決まる
     */
    @adr.proposed
    D800;

    /**
     * 型の仕組み（核の型、model、scalar、union、classify、fn の引数と結果の型）は、変換後の言語や、保存先の語彙を持たない。
     * 型が言うのは、値の形と意味だけ。出力先ごとの補足（SQL の列の型、HTTP の上の JSON の形）は、語彙のデコレータか、語彙の文書が
     * 決める形が持ち、トランスパイラは、出力先の言語の型によらずに、それを守る。ある言語の中だけの型の表し方が要るなら、それも、
     * その言語の語彙のデコレータで書く。持ち主は docs/requirements.md「型の仕組みは、出力先の語彙を持たない」。
     *
     * @adr.context 文書に書かれていなかった。#164 の 7（日時の scalar を、Go では名前付きの型で出すので、
     * JSON で文字列にならない）を、型（scalar）の問題として扱いかけたことで、書かれていないことが分かった。
     * @adr.consequence 7 は、基底 go の scalar に JSON のメソッドを足すのではなく、go-http が、通信の形（scalar は、元の型の JSON）に
     * 合わせて直す（D802）。Go の型に JSON の形を任せている、ほかの所（go-cli の表示、go-sqlite の @db.json の中）は、未決の点に置いた。
     */
    @adr.proposed
    D801;

    /**
     * go-http は、元が日時の核の型（datetime、date、time。何段の scalar を経ても）の scalar の値を、通信の形のとおり、元の型の JSON で
     * 読み書きする。基底 go の scalar の形（type Stamp time.Time）は、変えない。読み書きの補助に、表 httpScalars（scalar の Go の型から、
     * 元の型の Go の型へ）を足し、union とリテラルの型と同じ補助（httpMarshal、httpUnmarshal）で読み書きする。go-http 自身の要求
     * hozo.gohttp.Requirement.ScalarJSON に書き、そこから作るテストで確かめる。
     *
     * @adr.context 基底 go の名前付きの型は、元の型の JSON の読み書き（MarshalJSON など）を引き継がないので、encoding/json に任せると、
     * 日時の scalar の値が、文字列にならなかった（#164 の 7）。JSON の形は、型ではなく、http の語彙の通信の形が持つ（D801）ので、
     * 合わせるのは go-http。
     * @adr.alternative 基底 go が、日時の scalar に、元の型へ委ねる JSON のメソッドを出す: 型の仕組みが、JSON という出力先の形を持つ
     * @adr.alternative scalar を、構造体に埋め込む形（type Stamp struct{ time.Time }）にする: 変換の書き方が変わり、基底と相乗りの出力の
     * 広い範囲が変わる
     * @adr.alternative scalar を、別名（type Stamp = time.Time）にする: time.Time と区別できなくなり、制約のある scalar に Validate を
     * 付けられない
     */
    @adr.proposed
    D802;

    /**
     * disjoint のアームの順を入れ替えても変わらないのは、起きた効果と、読む値と、外の val に入れた値。どの例外が出るかは、順で
     * 変わってよい。例外を投げうるアームが二つあれば、先に動いた方の例外が出る。計算の答え（Sig の例外の集まり）は、順によらない。
     * 持ち主は docs/check.md「disjoint」。
     *
     * @adr.context 例外は、効果ではない。295 の「前後を入れ替えても、結果が変わらず」の「結果」は、出る例外も含むと読めたが、
     *   334（例外は、ほかの文と同じに、中断して呼んだ側に返すだけ）、335（変わらないのは、計算の答え）、DISJ-1 の理由（入れ替えると、
     *   例外のときに起きている効果が変わる）は、どれも、例外を、起きた効果が変わるかを決めるためにだけ見ていて、どの例外が出るかは
     *   言っていなかった。DISJ-1 を通ったものは、例外を投げうるアームのほかのアームが効果を持たないので、仕様の例外で止まるときも、
     *   起きた効果は、順によらない。
     * @adr.consequence アームの順を入れ替えて結果を比べるテストを作るなら、例外は、どの順でも失敗することと、出た例外が Sig の例外の
     *   集まりに入っていることだけを比べ、どの例外かは比べない。
     * @adr.alternative 書いた順で、最初に例外を投げうるアームの例外を出す、と決める: 並列に動かすときは、先に止まったアームの例外を
     *   捨てて、ほかのアームを待つことになり、並列にできる、の意味と合わない
     * @adr.alternative 例外を投げうるアームを、一つのまとまりに二つ書いたら、検査のエラーにする: 読むだけのアームをいくつか並べる、
     *   ふつうの形（読みをいくつか集める）が、書けなくなる
     */
    @adr.proposed
    @adr.amends(Decision200.D295)
    D803;

    /**
     * go-http が生成するファイルに写している補助を、Hozo で設計した Go のパッケージ runtime/gohttp に移す。設計は、リポジトリの
     * ルートの runtime.hozo（名前空間 hozo.runtime.gohttp）。補助の振る舞いは、op と分類と例外で書き、基底 go が枠と単体テストの口を
     * 作り、人が葉を実装し、生成した http.go がそれを呼ぶ。型は、値の形で書く（D801）。まず、request body の読み方だけを、設計の段
     * （単位の対象にせず、コードにしない）で書き、形を確かめてから、生成と実装に進む。
     *
     * @adr.context プラグイン自身の振る舞いを要求に書き、テストの入れ物に結ぶだけでは、Hozo を、設計の正から枠とハーネスを作る
     * ものとして使っていない（docs/requirements.md「価値と位置づけ」）。要求の付く先もなく、補助の振る舞いは文書に残り、テストは
     * 人が手で書いて結ぶだけだった。補助を、仕様から枠とテストの口を作るパッケージにすれば、例外を足せばテストが要る形が、補助にも効き、
     * 出力ごとの写しもなくなる（#183）。置き場は、生成したコードが、もう import している runtime の下にし、使う側の依存を増やさない。
     * @adr.consequence 補助の呼び出しは、葉の op の形（ctx を取り、error を返す）になる。net/http と、値の形の型の間の橋渡しが要る。
     * @adr.alternative 補助を、出力ごとに写すまま、要求だけを仕様に書く（D795 の形）: 枠もハーネスも仕様から作られず、要求の付く先がない
     * @adr.alternative 補助を、plugins/go-http の下の公開のパッケージに置く: 使う側が、プラグインのパスを import する
     * @adr.alternative 補助の置き場と版の合わせ方（#183）を、先に決めてから始める: 設計の形を、具体的に確かめないまま決めることになる
     */
    @adr.proposed
    D804;
  }
}
