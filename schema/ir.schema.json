  "$id": "https://github.com/mew-ton/hozo/schema/ir.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Hozo の IR（docs/ir.md）の JSON の形。Program（hozoc の出力）か View（プラグインに渡すもの）。$defs にはプラグインのプロトコル（docs/plugin-protocol.md「要求と応答」）の要求と応答も含む。Go の ir / plugin パッケージから internal/tools/irschema が生成する。手で編集しない。",
  "oneOf": [
    {
      "$ref": "#/$defs/Program"
    },
    {
      "$ref": "#/$defs/View"
    }
  ],
  "title": "Hozo IR"
}
